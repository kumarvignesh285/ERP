@model IEnumerable<VMRPowerTools.Website.Controllers.SavedAddressDto>
@{
    ViewData["Title"] = "Saved Addresses";
}

<section class="py-5 bg-brand-black border-b border-white/5">
    <div class="container mx-auto px-4 md:px-8 max-w-7xl">
        <h1 class="text-3xl md:text-5xl font-syne font-extrabold uppercase tracking-luxury text-white">Saved Addresses</h1>
        <p class="text-zinc-500 font-inter text-sm mt-2">Manage delivery locations and warehouse pick-up codes to accelerate checkouts.</p>
    </div>
</section>

<section class="py-12 bg-brand-black">
    <div class="container mx-auto px-4 md:px-8 max-w-7xl">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert bg-green-950/20 border border-green-900/30 p-3 mb-4 rounded text-green-400">@TempData["SuccessMessage"]</div>
        }

        <div class="row g-4">
            <!-- Sidebar Navigation Links -->
            <div class="col-lg-3">
                <div class="glass-panel-custom p-2 mb-4" style="border-radius: 8px;">
                    <a asp-action="Profile" class="list-group-item list-group-item-action border-0 py-3 px-3 text-zinc-400 hover:text-white transition-all font-syne text-[11px] font-bold uppercase tracking-widest bg-transparent"><i class="fa-solid fa-gears me-2"></i> Account Dashboard</a>
                    <a asp-action="MyOrders" class="list-group-item list-group-item-action border-0 py-3 px-3 text-zinc-400 hover:text-white transition-all font-syne text-[11px] font-bold uppercase tracking-widest bg-transparent"><i class="fa-solid fa-clock-rotate-left me-2"></i> My Orders</a>
                    <a asp-action="Invoices" class="list-group-item list-group-item-action border-0 py-3 px-3 text-zinc-400 hover:text-white transition-all font-syne text-[11px] font-bold uppercase tracking-widest bg-transparent"><i class="fa-solid fa-receipt me-2"></i> My Invoices</a>
                    <a asp-action="Wishlist" class="list-group-item list-group-item-action border-0 py-3 px-3 text-zinc-400 hover:text-white transition-all font-syne text-[11px] font-bold uppercase tracking-widest bg-transparent"><i class="fa-solid fa-heart me-2"></i> Wishlist</a>
                    <a asp-action="SavedAddress" class="list-group-item list-group-item-action border-0 py-3 px-3 text-white transition-all font-syne text-[11px] font-bold uppercase tracking-widest bg-brand-orange/10 border-l-2 border-brand-orange" style="background: rgba(255, 92, 0, 0.05);"><i class="fa-solid fa-map-location-dot me-2 text-brand-orange"></i> Saved Addresses</a>
                </div>
            </div>

            <!-- Saved Addresses Grid and Add Address -->
            <div class="col-lg-9">
                <div class="glass-panel-custom p-4 mb-4">
                    <h5 class="mb-4 font-weight-bold font-syne text-white">Saved Delivery Locations</h5>
                    
                    <div class="row g-3 mb-5">
                        @if (Model != null && Model.Any())
                        {
                            foreach (var addr in Model)
                            {
                                <div class="col-md-6" id="address-card-@addr.Tag">
                                    <div class="payment-card-custom p-3 h-100">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <span class="badge bg-brand-orange/10 border border-brand-orange/20 text-brand-orange text-uppercase font-weight-bold px-2 py-1" style="font-size: 0.65rem; border-radius: 4px;">@addr.Tag</span>
                                            <button class="btn btn-link text-danger p-0" onclick="deleteAddress('@addr.Tag')" title="Delete"><i class="fa-regular fa-trash-can"></i></button>
                                        </div>
                                        <p class="text-zinc-300 fs-7 mb-0">
                                            @addr.AddressLine<br>
                                            @addr.City, @addr.State - @addr.Pincode
                                        </p>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="col-12">
                                <p class="text-zinc-500 italic py-3 text-center border border-white/5 rounded">No saved shipping addresses. Fill the form below to save one!</p>
                            </div>
                        }
                    </div>

                    <!-- Add Address Form -->
                    <h5 class="mb-3 border-t border-white/5 pt-4 font-weight-bold font-syne text-white">Add New Location</h5>
                    <form asp-action="AddAddress" method="post" class="fs-7">
                        @Html.AntiForgeryToken()
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label font-weight-semibold text-zinc-400">Address Tag (e.g. Home, Office, Site A)</label>
                                <input type="text" name="tag" class="form-control form-control-dark" required placeholder="Home">
                            </div>
                            <div class="col-md-8">
                                <label class="form-label font-weight-semibold text-zinc-400">Street Address</label>
                                <input type="text" name="address" class="form-control form-control-dark" required placeholder="Flat / House / Lane details">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label font-weight-semibold text-zinc-400">City</label>
                                <input type="text" name="city" class="form-control form-control-dark" required placeholder="Guindy">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label font-weight-semibold text-zinc-400">State</label>
                                <select name="state" class="form-select form-control-dark" required>
                                    <option value="Tamil Nadu">Tamil Nadu</option>
                                    <option value="Karnataka">Karnataka</option>
                                    <option value="Andhra Pradesh">Andhra Pradesh</option>
                                    <option value="Maharashtra">Maharashtra</option>
                                    <option value="Kerala">Kerala</option>
                                    <option value="Delhi">Delhi</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label font-weight-semibold text-zinc-400">Pincode</label>
                                <input type="text" name="pincode" class="form-control form-control-dark" required placeholder="600032">
                            </div>
                        </div>
                        <button type="submit" class="btn-magnetic btn btn-primary mt-4 py-2 px-4 bg-brand-orange border-brand-orange font-syne font-bold uppercase tracking-wider" style="border-radius: 4px !important; color: #ffffff;"><i class="fa-solid fa-floppy-disk me-2"></i> Save Address</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        function deleteAddress(tag) {
            Swal.fire({
                title: 'Delete Address?',
                text: `Remove your saved address marked as "${tag}"?`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#ef4444',
                cancelButtonColor: '#64748b',
                confirmButtonText: 'Yes, delete it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.post('/Account/DeleteAddress', { tag: tag }, function (res) {
                        if (res.success) {
                            $('#address-card-' + tag).fadeOut(400, function () {
                                $(this).remove();
                                if ($('.card.p-3.border-2').length === 0) {
                                    location.reload();
                                }
                            });
                        }
                    });
                }
            });
        }
    </script>
}
