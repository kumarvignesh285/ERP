@model IEnumerable<SalesOrder>
@{
    ViewData["Title"] = "My Orders";
}

<section class="py-5 bg-brand-black border-b border-white/5">
    <div class="container mx-auto px-4 md:px-8 max-w-7xl">
        <h1 class="text-3xl md:text-5xl font-syne font-extrabold uppercase tracking-luxury text-white">My Orders</h1>
        <p class="text-zinc-500 font-inter text-sm mt-2">Track dispatches, check pricing, and view invoice references for historical purchases.</p>
    </div>
</section>

<section class="py-12 bg-brand-black">
    <div class="container mx-auto px-4 md:px-8 max-w-7xl">
        <div class="row">
            <!-- Sidebar Navigation Links -->
            <div class="col-lg-3">
                <div class="glass-panel-custom p-2 mb-4" style="border-radius: 8px;">
                    <a asp-action="Profile" class="list-group-item list-group-item-action border-0 py-3 px-3 text-zinc-400 hover:text-white transition-all font-syne text-[11px] font-bold uppercase tracking-widest bg-transparent"><i class="fa-solid fa-gears me-2"></i> Account Dashboard</a>
                    <a asp-action="MyOrders" class="list-group-item list-group-item-action border-0 py-3 px-3 text-white transition-all font-syne text-[11px] font-bold uppercase tracking-widest bg-brand-orange/10 border-l-2 border-brand-orange" style="background: rgba(255, 92, 0, 0.05);"><i class="fa-solid fa-clock-rotate-left me-2 text-brand-orange"></i> My Orders</a>
                    <a asp-action="Invoices" class="list-group-item list-group-item-action border-0 py-3 px-3 text-zinc-400 hover:text-white transition-all font-syne text-[11px] font-bold uppercase tracking-widest bg-transparent"><i class="fa-solid fa-receipt me-2"></i> My Invoices</a>
                    <a asp-action="Wishlist" class="list-group-item list-group-item-action border-0 py-3 px-3 text-zinc-400 hover:text-white transition-all font-syne text-[11px] font-bold uppercase tracking-widest bg-transparent"><i class="fa-solid fa-heart me-2"></i> Wishlist</a>
                    <a asp-action="SavedAddress" class="list-group-item list-group-item-action border-0 py-3 px-3 text-zinc-400 hover:text-white transition-all font-syne text-[11px] font-bold uppercase tracking-widest bg-transparent"><i class="fa-solid fa-map-location-dot me-2"></i> Saved Addresses</a>
                </div>
            </div>

            <!-- Orders Table List -->
            <div class="col-lg-9">
                <div class="glass-panel-custom p-4">
                    <h5 class="mb-4 font-weight-bold font-syne text-white">Order History</h5>

                    <div class="table-responsive">
                        @if (Model != null && Model.Any())
                        {
                            <table class="table table-glass align-middle fs-7">
                                <thead>
                                    <tr class="text-zinc-500 font-weight-semibold">
                                        <th>Order Code</th>
                                        <th>Date</th>
                                        <th>Items Count</th>
                                        <th>Total Amount</th>
                                        <th>Status</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var order in Model)
                                    {
                                        <tr class="border-b border-white/5">
                                            <td><strong class="text-white">@order.OrderNumber</strong></td>
                                            <td class="text-zinc-400">@order.OrderDate.ToString("dd MMM yyyy")</td>
                                            <td class="text-zinc-400">@order.Items.Count items</td>
                                            <td class="font-weight-bold text-brand-orange">₹@order.GrandTotal.ToString("N2")</td>
                                            <td>
                                                <span class="badge bg-yellow-500/10 border border-yellow-500/20 text-yellow-500 px-2 py-1" style="border-radius: 4px;">@order.Status</span>
                                            </td>
                                            <td>
                                                <a class="btn-magnetic px-3 py-1.5 border border-zinc-800 text-white hover:border-zinc-500 font-syne text-[10px] text-decoration-none" asp-action="OrderDetails" asp-route-id="@order.Id" style="border-radius: 4px !important;"><i class="fa-regular fa-file-lines me-1"></i> Details</a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                        else
                        {
                            <div class="text-center py-5">
                                <i class="fa-solid fa-clock-rotate-left text-zinc-700 mb-3" style="font-size: 4rem; opacity: 0.5;"></i>
                                <h6 class="text-white font-syne">No past orders found</h6>
                                <p class="text-zinc-500 fs-8 mb-4">You have not completed any checkouts yet.</p>
                                <a asp-controller="Product" asp-action="Index" class="btn-magnetic btn btn-primary btn-sm bg-brand-orange border-brand-orange px-4 py-2 font-syne font-bold uppercase tracking-wider" style="border-radius: 4px !important; color: #ffffff;">Shop Now</a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
