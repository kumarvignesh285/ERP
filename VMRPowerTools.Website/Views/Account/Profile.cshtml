@model AppUser
@inject IOrderService OrderService
@inject VMRPowerTools.Infrastructure.Data.WebsiteDbContext DbContext
@{
    ViewData["Title"] = "Customer Portal";
    var orders = await OrderService.GetOrderHistoryAsync(Model.Email!);
    var invoices = DbContext.SalesInvoices.Where(i => i.CreatedBy == Model.Email).ToList();
    var outstandingBalance = invoices.Sum(i => i.BalanceAmount);
    
    // Get wishlist cookie item count
    var wishlistCookieValue = Context.Request.Cookies["VMR_Wishlist"];
    int wishlistCount = 0;
    if (!string.IsNullOrEmpty(wishlistCookieValue))
    {
        try {
            var list = System.Text.Json.JsonSerializer.Deserialize<List<int>>(wishlistCookieValue);
            wishlistCount = list?.Count ?? 0;
        } catch {}
    }
}

<section class="py-5 bg-white border-bottom">
    <div class="container">
        <h1>Account Dashboard</h1>
        <p class="text-muted mb-0">Manage profile specifications, watch saved items, and review transaction ledgers.</p>
    </div>
</section>

<section class="py-5">
    <div class="container">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success border-0 mb-4">@TempData["SuccessMessage"]</div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger border-0 mb-4">@TempData["ErrorMessage"]</div>
        }

        <div class="row g-4">
            <!-- Sidebar Navigation Links -->
            <div class="col-lg-3">
                <div class="list-group shadow-sm border-0 mb-4" style="border-radius: 12px; overflow: hidden;">
                    <a asp-action="Profile" class="list-group-item list-group-item-action border-0 py-3 active"><i class="fa-solid fa-gears me-2"></i> Account Dashboard</a>
                    <a asp-action="MyOrders" class="list-group-item list-group-item-action border-0 py-3"><i class="fa-solid fa-clock-rotate-left me-2"></i> My Orders</a>
                    <a asp-action="Invoices" class="list-group-item list-group-item-action border-0 py-3"><i class="fa-solid fa-receipt me-2"></i> My Invoices</a>
                    <a asp-action="Wishlist" class="list-group-item list-group-item-action border-0 py-3"><i class="fa-solid fa-heart me-2"></i> Wishlist</a>
                    <a asp-action="SavedAddress" class="list-group-item list-group-item-action border-0 py-3"><i class="fa-solid fa-map-location-dot me-2"></i> Saved Addresses</a>
                </div>
            </div>

            <!-- Portal Center Dashboard Content -->
            <div class="col-lg-9">
                <!-- Summary Stats Cards (WOW factor) -->
                <div class="row g-3 mb-4">
                    <div class="col-sm-4">
                        <div class="card border-0 shadow-sm p-3 text-center bg-white" style="border-radius: 10px;">
                            <span class="text-muted fs-8 font-weight-bold uppercase tracking-wider">Orders Count</span>
                            <h2 class="font-weight-bold text-primary mb-0 mt-1">@orders.Count()</h2>
                        </div>
                    </div>
                    <div class="col-sm-4">
                        <div class="card border-0 shadow-sm p-3 text-center bg-white" style="border-radius: 10px;">
                            <span class="text-muted fs-8 font-weight-bold uppercase tracking-wider">Wishlist Items</span>
                            <h2 class="font-weight-bold text-secondary mb-0 mt-1">@wishlistCount</h2>
                        </div>
                    </div>
                    <div class="col-sm-4">
                        <div class="card border-0 shadow-sm p-3 text-center bg-white" style="border-radius: 10px;">
                            <span class="text-muted fs-8 font-weight-bold uppercase tracking-wider">Outstanding</span>
                            <h2 class="font-weight-bold text-danger mb-0 mt-1">₹@outstandingBalance.ToString("N2")</h2>
                        </div>
                    </div>
                </div>

                <!-- Profile Update Section -->
                <div class="card border-0 shadow-sm p-4 bg-white mb-4" style="border-radius: 12px;">
                    <h5 class="mb-4 font-weight-bold"><i class="fa-regular fa-id-card text-primary me-2"></i> Personal Information</h5>
                    <form asp-action="UpdateProfile" method="post" class="fs-7">
                        @Html.AntiForgeryToken()
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label font-weight-semibold">Full Name</label>
                                <input type="text" name="fullName" class="form-control" value="@Model.FullName" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label font-weight-semibold">Phone Number</label>
                                <input type="text" name="phoneNumber" class="form-control" value="@Model.PhoneNumber" placeholder="e.g. +91 XXXXX XXXXX">
                            </div>
                            <div class="col-md-12">
                                <label class="form-label font-weight-semibold">Email Address (Registered Account)</label>
                                <input type="email" class="form-control" value="@Model.Email" readonly disabled>
                                <span class="fs-8 text-muted mt-1 d-block">Account emails cannot be altered for secure ERP synchronization integrity.</span>
                            </div>
                        </div>
                        <button type="submit" class="btn btn-primary"><i class="fa-solid fa-floppy-disk me-2"></i> Save Profile Details</button>
                    </form>
                </div>

                <!-- Password Changing Section -->
                <div class="card border-0 shadow-sm p-4 bg-white" style="border-radius: 12px;">
                    <h5 class="mb-4 font-weight-bold"><i class="fa-solid fa-key text-secondary me-2"></i> Change Password</h5>
                    <form asp-action="ChangePassword" method="post" class="fs-7">
                        @Html.AntiForgeryToken()
                        <div class="row g-3 mb-3">
                            <div class="col-md-4">
                                <label class="form-label font-weight-semibold">Current Password</label>
                                <input type="password" name="currentPassword" class="form-control" required placeholder="Enter current password">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label font-weight-semibold">New Password</label>
                                <input type="password" name="newPassword" class="form-control" required placeholder="Minimum 6 characters">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label font-weight-semibold">Confirm Password</label>
                                <input type="password" name="confirmPassword" class="form-control" required placeholder="Repeat password">
                            </div>
                        </div>
                        <button type="submit" class="btn btn-secondary"><i class="fa-solid fa-lock me-2"></i> Update Password</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
