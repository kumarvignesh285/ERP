@{
    ViewData["Title"] = "Sign In";
}

<section class="py-12 bg-brand-black min-h-screen d-flex align-items-center">
    <div class="container mx-auto px-4 md:px-8 max-w-7xl">
        <div class="row justify-content-center">
            <div class="col-md-5">
                <div class="glass-panel-custom p-4 p-md-5">
                    <div class="text-center mb-4">
                        <h2 class="font-weight-bold font-syne text-white">Sign In</h2>
                        <p class="text-zinc-500 fs-7">Access your customer portal dashboard</p>
                    </div>

                    <div asp-validation-summary="All" class="text-danger mb-3 small"></div>

                    <form asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label for="email" class="form-label fs-7 font-weight-semibold text-zinc-400">Email Address</label>
                            <div class="input-group">
                                <span class="input-group-text border-end-0" style="background-color: #0b0b0d; border-color: #1f1f23; color: #a1a1aa;"><i class="fa-solid fa-envelope"></i></span>
                                <input type="email" class="form-control form-control-dark py-2 border-start-0" id="email" name="email" required placeholder="name@example.com" style="background-color: #050505;">
                            </div>
                        </div>
                        <div class="mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label for="password" class="form-label fs-7 font-weight-semibold text-zinc-400 mb-0">Password</label>
                                <a asp-action="ForgotPassword" class="fs-8 text-brand-orange text-decoration-none">Forgot Password?</a>
                            </div>
                            <div class="input-group">
                                <span class="input-group-text border-end-0" style="background-color: #0b0b0d; border-color: #1f1f23; color: #a1a1aa;"><i class="fa-solid fa-lock"></i></span>
                                <input type="password" class="form-control form-control-dark py-2 border-start-0" id="password" name="password" required placeholder="••••••••" style="background-color: #050505;">
                            </div>
                        </div>
                        <div class="mb-4 form-check">
                            <input type="checkbox" class="form-check-input" id="rememberMe" name="rememberMe" value="true" style="background-color: #0b0b0d; border-color: #52525b;">
                            <label class="form-check-label fs-7 text-zinc-500" for="rememberMe">Remember me on this device</label>
                        </div>
                        <button type="submit" class="btn-magnetic btn btn-primary btn-lg w-100 py-2 fs-6 bg-brand-orange border-brand-orange font-syne font-bold uppercase tracking-wider" style="border-radius: 4px !important; color: #ffffff;">Sign In</button>
                    </form>

                    <div class="text-center mt-4">
                        <p class="text-zinc-500 fs-7 mb-0">Don't have an account yet? <a asp-action="Register" asp-route-returnUrl="@ViewData["ReturnUrl"]" class="text-brand-orange font-weight-semibold text-decoration-none">Register here</a></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
