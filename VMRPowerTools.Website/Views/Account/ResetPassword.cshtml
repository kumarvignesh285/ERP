@{
    ViewData["Title"] = "Reset Password";
}

<section class="py-12 bg-brand-black min-h-screen d-flex align-items-center">
    <div class="container mx-auto px-4 md:px-8 max-w-7xl">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5">
                <div class="glass-panel-custom p-4 p-md-5">
                    <div class="text-center mb-4">
                        <i class="fa-solid fa-lock text-brand-orange display-4 mb-3" style="filter: drop-shadow(0 0 10px rgba(255,92,0,0.3));"></i>
                        <h2 class="font-weight-bold font-syne text-white">Reset Password</h2>
                        <p class="text-zinc-500 fs-7 mt-2">Enter a new secure password below to regain account access.</p>
                    </div>

                    <form asp-action="ResetPassword" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="All" class="text-danger small font-weight-bold mb-3"></div>

                        <div class="mb-3">
                            <label class="form-label font-weight-semibold text-zinc-400 uppercase tracking-wider fs-8">New Password</label>
                            <input type="password" name="newPassword" class="form-control form-control-dark py-2" required placeholder="Minimum 6 characters">
                        </div>

                        <div class="mb-4">
                            <label class="form-label font-weight-semibold text-zinc-400 uppercase tracking-wider fs-8">Confirm New Password</label>
                            <input type="password" name="confirmPassword" class="form-control form-control-dark py-2" required placeholder="Repeat password">
                        </div>

                        <button type="submit" class="btn-magnetic btn btn-primary w-100 py-2 fs-6 bg-brand-orange border-brand-orange font-syne font-bold uppercase tracking-wider" style="border-radius: 4px !important; color: #ffffff;">Update Password</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
