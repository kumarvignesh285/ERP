@{
    ViewData["Title"] = "Reset Password";
}

<section class="py-5 bg-light d-flex align-items-center" style="min-height: 80vh;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5">
                <div class="card border-0 shadow-sm p-4 p-md-5 bg-white" style="border-radius: 16px;">
                    <div class="text-center mb-4">
                        <i class="fa-solid fa-lock-open text-success display-4 mb-3"></i>
                        <h2 class="font-weight-bold">Reset Password</h2>
                        <p class="text-muted">Enter a new secure password below to regain account access.</p>
                    </div>

                    <form asp-action="ResetPassword" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="All" class="text-danger small font-weight-bold mb-3"></div>

                        <div class="mb-3">
                            <label class="form-label font-weight-semibold text-muted uppercase tracking-wider fs-8">New Password</label>
                            <input type="password" name="newPassword" class="form-control py-2" required placeholder="Minimum 6 characters">
                        </div>

                        <div class="mb-4">
                            <label class="form-label font-weight-semibold text-muted uppercase tracking-wider fs-8">Confirm New Password</label>
                            <input type="password" name="confirmPassword" class="form-control py-2" required placeholder="Repeat password">
                        </div>

                        <button type="submit" class="btn btn-primary w-100 py-2 fs-6">Update Password</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
