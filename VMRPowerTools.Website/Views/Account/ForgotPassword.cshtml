@{
    ViewData["Title"] = "Forgot Password";
}

<section class="py-12 bg-brand-black min-h-screen d-flex align-items-center">
    <div class="container mx-auto px-4 md:px-8 max-w-7xl">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5">
                <div class="glass-panel-custom p-4 p-md-5">
                    <div class="text-center mb-4">
                        <i class="fa-solid fa-key text-brand-orange display-4 mb-3" style="filter: drop-shadow(0 0 10px rgba(255,92,0,0.3));"></i>
                        <h2 class="font-weight-bold font-syne text-white">Forgot Password</h2>
                        <p class="text-zinc-500 fs-7 mt-2">Enter your email and we'll send a 6-digit OTP verification code to reset your account.</p>
                    </div>

                    <form asp-action="ForgotPassword" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="All" class="text-danger small font-weight-bold mb-3"></div>

                        <div class="mb-4">
                            <label class="form-label font-weight-semibold text-zinc-400 uppercase tracking-wider fs-8">Email Address</label>
                            <input type="email" name="email" class="form-control form-control-dark py-2" required placeholder="name@example.com">
                        </div>

                        <button type="submit" class="btn-magnetic btn btn-primary w-100 py-2 fs-6 bg-brand-orange border-brand-orange font-syne font-bold uppercase tracking-wider" style="border-radius: 4px !important; color: #ffffff;">Send Verification Code</button>
                    </form>

                    <div class="text-center mt-4">
                        <a asp-action="Login" class="text-decoration-none text-brand-orange fs-7"><i class="fa-solid fa-arrow-left me-1"></i> Back to Login</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
