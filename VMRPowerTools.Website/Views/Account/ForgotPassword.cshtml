@{
    ViewData["Title"] = "Forgot Password";
}

<section class="py-5 bg-light d-flex align-items-center" style="min-height: 80vh;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5">
                <div class="card border-0 shadow-sm p-4 p-md-5 bg-white" style="border-radius: 16px;">
                    <div class="text-center mb-4">
                        <i class="fa-solid fa-key-skeleton text-primary display-4 mb-3"></i>
                        <h2 class="font-weight-bold">Forgot Password</h2>
                        <p class="text-muted">Enter your email and we'll send a 6-digit OTP verification code to reset your account.</p>
                    </div>

                    <form asp-action="ForgotPassword" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="All" class="text-danger small font-weight-bold mb-3"></div>

                        <div class="mb-4">
                            <label class="form-label font-weight-semibold text-muted uppercase tracking-wider fs-8">Email Address</label>
                            <input type="email" name="email" class="form-control py-2" required placeholder="name@example.com">
                        </div>

                        <button type="submit" class="btn btn-primary w-100 py-2 fs-6">Send Verification Code</button>
                    </form>

                    <div class="text-center mt-4">
                        <a asp-action="Login" class="text-decoration-none fs-7"><i class="fa-solid fa-arrow-left me-1"></i> Back to Login</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
