@model SalesInvoice
@{
    ViewData["Title"] = $"Invoice - {Model.InvoiceNumber}";
}

<div class="container py-5">
    <!-- Action buttons for printing -->
    <div class="d-flex justify-content-between align-items-center mb-4 no-print">
        <a asp-action="Invoices" class="btn btn-secondary"><i class="fa-solid fa-arrow-left me-2"></i> Back to Invoices</a>
        <button class="btn btn-primary" onclick="window.print()"><i class="fa-solid fa-print me-2"></i> Print Invoice</button>
    </div>

    <!-- Commercial Invoice Sheet -->
    <div class="card border border-2 shadow-sm p-4 p-md-5 bg-white" style="border-radius: 12px; border-color: #cbd5e1 !important;">
        <!-- Header -->
        <div class="row align-items-center mb-5">
            <div class="col-sm-6">
                <h2 class="font-weight-bold text-dark mb-1">VMR Power Tools</h2>
                <span class="fs-8 text-muted uppercase tracking-wider">Authorized Spares & Spinnery Hub</span>
                <p class="fs-7 text-muted mt-2 mb-0">
                    Guindy Industrial Estate,<br>
                    Chennai, Tamil Nadu - 600032<br>
                    GSTIN: 33AAFCD9876Q1Z2
                </p>
            </div>
            <div class="col-sm-6 text-sm-end mt-4 mt-sm-0">
                <h1 class="text-uppercase tracking-wide text-primary mb-2 font-weight-bold">Invoice</h1>
                <span class="fs-7 text-muted d-block">Invoice Code:</span>
                <strong class="text-dark fs-5">@Model.InvoiceNumber</strong>
                <span class="fs-7 text-muted d-block mt-2">Date: @Model.InvoiceDate.ToString("dd MMM yyyy")</span>
            </div>
        </div>

        <hr class="my-4">

        <!-- Customer & Order details -->
        <div class="row mb-5 g-4 fs-7">
            <div class="col-sm-6">
                <h6 class="font-weight-bold text-uppercase text-muted tracking-wider fs-8 mb-2">Billed To:</h6>
                @if (Model.Customer != null)
                {
                    <h5 class="font-weight-semibold text-dark mb-1">@Model.Customer.CustomerName</h5>
                    <p class="text-muted mb-0">
                        @Model.Customer.Address<br>
                        @Model.Customer.City, @Model.Customer.State - @Model.Customer.Pincode<br>
                        Phone: @Model.Customer.MobileNumber<br>
                        Email: @Model.Customer.Email
                    </p>
                }
            </div>
            <div class="col-sm-6 text-sm-end">
                <h6 class="font-weight-bold text-uppercase text-muted tracking-wider fs-8 mb-2">Billing Details:</h6>
                <p class="text-muted mb-0">
                    <strong>Payment Method:</strong> @Model.PaymentTerms<br>
                    <strong>ERP Reference:</strong> @Model.ReferenceNumber<br>
                    <strong>Due Date:</strong> @(Model.DueDate.HasValue ? Model.DueDate.Value.ToString("dd MMM yyyy") : "Due on receipt")<br>
                    <strong>Status:</strong> <span class="badge bg-success-subtle text-success px-2 py-1">@Model.Status</span>
                </p>
            </div>
        </div>

        <!-- Items Table -->
        <div class="table-responsive mb-4">
            <table class="table align-middle fs-7">
                <thead>
                    <tr class="text-muted font-weight-bold border-bottom-2">
                        <th>Description</th>
                        <th class="text-center">Qty</th>
                        <th class="text-end">Rate</th>
                        <th class="text-end">Tax %</th>
                        <th class="text-end">Amount</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>
                                <div class="font-weight-semibold text-dark">@item.ProductName</div>
                                <span class="fs-8 text-muted">HSN: @(item.HSNCode ?? "8467")</span>
                            </td>
                            <td class="text-center">@item.Quantity.ToString("N0")</td>
                            <td class="text-end">₹@item.Rate.ToString("N2")</td>
                            <td class="text-end">@item.TaxPercentage.ToString("G29")%</td>
                            <td class="text-end font-weight-semibold">₹@item.Amount.ToString("N2")</td>
                        </tr>
                    }
                    <tr class="border-top-0">
                        <td colspan="4" class="text-end text-muted py-1">Subtotal:</td>
                        <td class="text-end font-weight-semibold py-1">₹@Model.SubTotal.ToString("N2")</td>
                    </tr>
                    @if (Model.DiscountAmount > 0)
                    {
                        <tr>
                            <td colspan="4" class="text-end text-success py-1">Discount:</td>
                            <td class="text-end font-weight-semibold text-success py-1">-₹@Model.DiscountAmount.ToString("N2")</td>
                        </tr>
                    }
                    <tr>
                        <td colspan="4" class="text-end text-muted py-1">Tax Amount:</td>
                        <td class="text-end font-weight-semibold py-1">₹@Model.TaxAmount.ToString("N2")</td>
                    </tr>
                    <tr class="border-top fs-5 font-weight-bold">
                        <td colspan="4" class="text-end pt-3">Grand Total:</td>
                        <td class="text-end text-primary pt-3">₹@Model.GrandTotal.ToString("N2")</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- Footer notes -->
        <div class="mt-5 pt-3 border-top text-center text-muted fs-8">
            <p class="mb-1">This invoice is dynamically generated from SmartERP matching website transaction references.</p>
            <strong class="text-dark">Thank you for partnering with VMR Power Tools!</strong>
        </div>
    </div>
</div>

<style>
    @@media print {
        body {
            background-color: #ffffff;
        }
        .container {
            width: 100% !important;
            max-width: 100% !important;
            padding: 0 !important;
        }
        .card {
            border: 0 !important;
            box-shadow: none !important;
            padding: 0 !important;
        }
    }
</style>
