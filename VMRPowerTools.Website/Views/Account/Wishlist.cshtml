@model IEnumerable<Product>
@{
    ViewData["Title"] = "My Wishlist";
}

<section class="py-5 bg-brand-black border-b border-white/5">
    <div class="container mx-auto px-4 md:px-8 max-w-7xl">
        <h1 class="text-3xl md:text-5xl font-syne font-extrabold uppercase tracking-luxury text-white">My Wishlist</h1>
        <p class="text-zinc-500 font-inter text-sm mt-2">Saved tools and spare parts you're tracking for future orders.</p>
    </div>
</section>

<section class="py-12 bg-brand-black">
    <div class="container mx-auto px-4 md:px-8 max-w-7xl">
        <div class="row">
            <!-- Sidebar Navigation Links -->
            <div class="col-lg-3">
                <div class="glass-panel-custom p-2 mb-4" style="border-radius: 8px;">
                    <a asp-action="Profile" class="list-group-item list-group-item-action border-0 py-3 px-3 text-zinc-400 hover:text-white transition-all font-syne text-[11px] font-bold uppercase tracking-widest bg-transparent"><i class="fa-solid fa-gears me-2"></i> Account Dashboard</a>
                    <a asp-action="MyOrders" class="list-group-item list-group-item-action border-0 py-3 px-3 text-zinc-400 hover:text-white transition-all font-syne text-[11px] font-bold uppercase tracking-widest bg-transparent"><i class="fa-solid fa-clock-rotate-left me-2"></i> My Orders</a>
                    <a asp-action="Invoices" class="list-group-item list-group-item-action border-0 py-3 px-3 text-zinc-400 hover:text-white transition-all font-syne text-[11px] font-bold uppercase tracking-widest bg-transparent"><i class="fa-solid fa-receipt me-2"></i> My Invoices</a>
                    <a asp-action="Wishlist" class="list-group-item list-group-item-action border-0 py-3 px-3 text-white transition-all font-syne text-[11px] font-bold uppercase tracking-widest bg-brand-orange/10 border-l-2 border-brand-orange" style="background: rgba(255, 92, 0, 0.05);"><i class="fa-solid fa-heart me-2 text-brand-orange"></i> Wishlist</a>
                    <a asp-action="SavedAddress" class="list-group-item list-group-item-action border-0 py-3 px-3 text-zinc-400 hover:text-white transition-all font-syne text-[11px] font-bold uppercase tracking-widest bg-transparent"><i class="fa-solid fa-map-location-dot me-2"></i> Saved Addresses</a>
                </div>
            </div>

            <!-- Wishlist Products Grid -->
            <div class="col-lg-9">
                <div class="glass-panel-custom p-4">
                    <h5 class="mb-4 font-weight-bold font-syne text-white">Saved Items</h5>

                    @if (Model != null && Model.Any())
                    {
                        <div class="row g-4">
                            @foreach (var product in Model)
                            {
                                <div class="col-md-6 col-lg-4" id="wishlist-col-@product.Id">
                                    <div class="product-card">
                                        <div class="product-img-wrap">
                                            @if (!string.IsNullOrEmpty(product.ImagePath))
                                            {
                                                <img src="@product.ImagePath" alt="@product.ProductName" class="product-img">
                                            }
                                            else
                                            {
                                                <i class="fa-solid fa-toolbox text-zinc-600 fs-2"></i>
                                            }
                                        </div>
                                        <div class="product-body">
                                            <span class="product-category">@product.ProductCode</span>
                                            <h6 class="product-title text-truncate text-white font-syne">@product.ProductName</h6>
                                            <span class="product-price mb-3 d-block text-brand-orange font-bold">₹@product.SalesPrice.ToString("N2")</span>
                                            
                                            <div class="mt-auto d-flex gap-2 border-t border-white/5 pt-2">
                                                <button class="btn-magnetic btn btn-sm btn-primary flex-grow-1 bg-brand-orange border-brand-orange text-white font-syne font-bold uppercase tracking-wider" onclick="addToCart(@product.Id, '@product.ProductName')" style="border-radius: 4px !important;"><i class="fa-solid fa-cart-plus"></i> Cart</button>
                                                <button class="btn-magnetic btn btn-sm btn-outline-danger border border-red-950 text-red-500 hover:bg-red-500/10" onclick="removeFromWishlist(@product.Id)" title="Remove" style="border-radius: 4px !important; background: transparent;"><i class="fa-regular fa-trash-can"></i></button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fa-regular fa-heart text-zinc-700 mb-3" style="font-size: 4rem; opacity: 0.5;"></i>
                            <h6 class="text-white font-syne">Your wishlist is empty</h6>
                            <p class="text-zinc-500 fs-8 mb-4">Save products here as you browse our catalog.</p>
                            <a asp-controller="Product" asp-action="Index" class="btn-magnetic btn btn-primary btn-sm bg-brand-orange border-brand-orange px-4 py-2 font-syne font-bold uppercase tracking-wider" style="border-radius: 4px !important; color: #ffffff;">Browse Tools</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        function addToCart(productId, productName) {
            $.post('/Cart/Add', { productId: productId, quantity: 1 }, function (res) {
                if (res.success) {
                    Swal.fire({
                        title: 'Added!',
                        text: `${productName} added to cart.`,
                        icon: 'success',
                        timer: 1500,
                        showConfirmButton: false
                    }).then(() => {
                        location.reload();
                    });
                }
            });
        }

        function removeFromWishlist(productId) {
            $.post('/Account/RemoveFromWishlist', { productId: productId }, function (res) {
                if (res.success) {
                    $('#wishlist-col-' + productId).fadeOut(400, function () {
                        $(this).remove();
                        if ($('.product-card').length === 0) {
                            location.reload();
                        }
                    });
                }
            });
        }
    </script>
}
