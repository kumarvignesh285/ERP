@model SalesOrder
@{
    ViewData["Title"] = $"Order Details - {Model.OrderNumber}";
}

<section class="py-5 bg-brand-black border-b border-white/5">
    <div class="container mx-auto px-4 md:px-8 max-w-7xl">
        <h1 class="text-3xl md:text-5xl font-syne font-extrabold uppercase tracking-luxury text-white">Order Summary</h1>
        <p class="text-zinc-500 font-inter text-sm mt-2">Review product quantities, status updates, and invoice receipts for order <strong>@Model.OrderNumber</strong>.</p>
    </div>
</section>

<section class="py-12 bg-brand-black">
    <div class="container mx-auto px-4 md:px-8 max-w-7xl">
        <div class="row g-4">
            <!-- Sidebar Navigation Links -->
            <div class="col-lg-3">
                <div class="glass-panel-custom p-2 mb-4" style="border-radius: 8px;">
                    <a asp-action="Profile" class="list-group-item list-group-item-action border-0 py-3 px-3 text-zinc-400 hover:text-white transition-all font-syne text-[11px] font-bold uppercase tracking-widest bg-transparent"><i class="fa-solid fa-gears me-2"></i> Account Dashboard</a>
                    <a asp-action="MyOrders" class="list-group-item list-group-item-action border-0 py-3 px-3 text-white transition-all font-syne text-[11px] font-bold uppercase tracking-widest bg-brand-orange/10 border-l-2 border-brand-orange" style="background: rgba(255, 92, 0, 0.05);"><i class="fa-solid fa-clock-rotate-left me-2 text-brand-orange"></i> My Orders</a>
                    <a asp-action="Invoices" class="list-group-item list-group-item-action border-0 py-3 px-3 text-zinc-400 hover:text-white transition-all font-syne text-[11px] font-bold uppercase tracking-widest bg-transparent"><i class="fa-solid fa-receipt me-2"></i> My Invoices</a>
                    <a asp-action="Wishlist" class="list-group-item list-group-item-action border-0 py-3 px-3 text-zinc-400 hover:text-white transition-all font-syne text-[11px] font-bold uppercase tracking-widest bg-transparent"><i class="fa-solid fa-heart me-2"></i> Wishlist</a>
                    <a asp-action="SavedAddress" class="list-group-item list-group-item-action border-0 py-3 px-3 text-zinc-400 hover:text-white transition-all font-syne text-[11px] font-bold uppercase tracking-widest bg-transparent"><i class="fa-solid fa-map-location-dot me-2"></i> Saved Addresses</a>
                </div>
            </div>

            <!-- Detailed Summary Grid -->
            <div class="col-lg-9">
                <div class="glass-panel-custom p-4 mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-4 border-b border-white/5 pb-2">
                        <h5 class="mb-0 font-weight-bold font-syne text-white">Order #@Model.OrderNumber</h5>
                        <span class="badge bg-yellow-500/10 border border-yellow-500/20 text-yellow-500 px-3 py-2 fs-8 font-weight-bold" style="border-radius: 4px;">@Model.Status</span>
                    </div>

                    <div class="row g-3 fs-7 mb-4">
                        <div class="col-sm-6 col-md-3">
                            <span class="text-zinc-500 d-block">Order Date:</span>
                            <strong class="text-white">@Model.OrderDate.ToString("dd MMMM yyyy")</strong>
                        </div>
                        <div class="col-sm-6 col-md-3">
                            <span class="text-zinc-500 d-block">Estimated Delivery:</span>
                            <strong class="text-white">@(Model.DeliveryDate.HasValue ? Model.DeliveryDate.Value.ToString("dd MMMM yyyy") : "Reconciling dispatches")</strong>
                        </div>
                        <div class="col-sm-6 col-md-3">
                            <span class="text-zinc-500 d-block">Shipping Address:</span>
                            <strong class="text-white">@Model.ShippingAddress</strong>
                        </div>
                        <div class="col-sm-6 col-md-3">
                            <span class="text-zinc-500 d-block">Reference Notes:</span>
                            <strong class="text-white">@(Model.ReferenceNumber ?? "No notes submitted")</strong>
                        </div>
                    </div>

                    <h6 class="mb-3 border-b border-white/5 pb-1 font-weight-bold fs-7 font-syne text-white">Ordered Items</h6>
                    <div class="table-responsive mb-4">
                        <table class="table table-glass align-middle fs-7 mb-0">
                            <thead>
                                <tr class="text-zinc-500 font-weight-bold">
                                    <th>Product Name</th>
                                    <th>Quantity</th>
                                    <th>Unit Rate</th>
                                    <th class="text-end">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Items)
                                {
                                    <tr class="border-b border-white/5">
                                        <td>
                                            <div class="font-weight-semibold text-white">@item.ProductName</div>
                                            <span class="fs-8 text-zinc-500">@item.Product?.ProductCode</span>
                                        </td>
                                        <td class="text-zinc-300">@item.Quantity.ToString("N0")</td>
                                        <td class="text-zinc-300">₹@item.Rate.ToString("N2")</td>
                                        <td class="text-end font-weight-semibold text-white">₹@item.Amount.ToString("N2")</td>
                                    </tr>
                                }
                                <tr class="border-top-0">
                                    <td colspan="3" class="text-end text-zinc-500 py-1">Subtotal:</td>
                                    <td class="text-end font-weight-semibold text-white py-1">₹@Model.SubTotal.ToString("N2")</td>
                                </tr>
                                @if (Model.DiscountAmount > 0)
                                {
                                    <tr>
                                        <td colspan="3" class="text-end text-success py-1">Discount:</td>
                                        <td class="text-end font-weight-semibold text-success py-1">-₹@Model.DiscountAmount.ToString("N2")</td>
                                    </tr>
                                }
                                <tr>
                                    <td colspan="3" class="text-end text-zinc-500 py-1">Tax:</td>
                                    <td class="text-end font-weight-semibold text-white py-1">₹@Model.TaxAmount.ToString("N2")</td>
                                </tr>
                                <tr class="border-t border-white/5 fs-6 font-weight-bold">
                                    <td colspan="3" class="text-end pt-3 text-white">Grand Total:</td>
                                    <td class="text-end text-brand-orange pt-3">₹@Model.GrandTotal.ToString("N2")</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <div class="d-flex justify-content-between mt-3 pt-3 border-t border-white/5">
                        <a asp-action="MyOrders" class="btn-magnetic btn btn-secondary border border-zinc-800 hover:border-zinc-500 bg-transparent text-white font-syne font-bold uppercase tracking-wider px-4 py-2" style="border-radius: 4px !important;"><i class="fa-solid fa-arrow-left me-2"></i> Back to Orders</a>
                        @if (Model.Items != null && Model.Items.Any())
                        {
                            <a href="https://wa.me/919876543210?text=Hi%2C%20I%20want%20to%20enquire%20about%20Order%20%23@Model.OrderNumber" target="_blank" rel="noopener noreferrer" class="btn-magnetic btn btn-success py-2 px-3 text-white font-syne font-bold uppercase tracking-wider" style="border-radius: 4px !important; background-color: #25D366; border-color: #25D366;"><i class="fa-brands fa-whatsapp me-2"></i> Inquiry WhatsApp</a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
