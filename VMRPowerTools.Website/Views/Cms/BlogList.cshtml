@model IEnumerable<VMRPowerTools.Domain.Entities.CmsBlogPost>
@using System.Text.Encodings.Web
@{
    ViewData["Title"] = "CMS Blogs Editor";
}

<div class="container-fluid py-4">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <a asp-action="Index" class="text-decoration-none fs-7"><i class="fa-solid fa-arrow-left me-1"></i> Back to Dashboard</a>
            <h1 class="h3 mb-0 text-gray-800 mt-2"><i class="fa-solid fa-newspaper me-2 text-primary"></i> Blog Articles Management</h1>
        </div>
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#blogModal" onclick="clearBlogForm()"><i class="fa-solid fa-circle-plus me-1"></i> New Blog Article</button>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Blog Posts Table -->
    <div class="card border-0 shadow-sm p-4 bg-white" style="border-radius: 12px;">
        <div class="table-responsive">
            <table class="table align-middle fs-7">
                <thead class="table-light">
                    <tr>
                        <th style="width: 5%;">ID</th>
                        <th style="width: 40%;">Title / Slug</th>
                        <th style="width: 15%;">Category</th>
                        <th style="width: 15%;">Publish Date</th>
                        <th style="width: 15%;">Author</th>
                        <th style="width: 10%;" class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var post in Model)
                        {
                            <tr id="row-@post.Id">
                                <td>@post.Id</td>
                                <td>
                                    <div class="font-weight-bold text-dark text-truncate" style="max-width: 300px;">@post.Title</div>
                                    <div class="text-muted fs-8">/blog/@post.Slug</div>
                                </td>
                                <td><span class="badge bg-primary-subtle text-primary">@post.Category</span></td>
                                <td class="text-muted">@post.PublishedDate.ToString("dd MMM yyyy")</td>
                                <td>@post.Author</td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-secondary me-1" onclick="editBlogPost(@post.Id, '@Html.Raw(JavaScriptEncoder.Default.Encode(post.Title))', '@post.Category', '@Html.Raw(JavaScriptEncoder.Default.Encode(post.Summary))', '@Html.Raw(JavaScriptEncoder.Default.Encode(post.Content))', '@post.ImagePath')"><i class="fa-solid fa-pen-to-square"></i></button>
                                    <button class="btn btn-sm btn-outline-danger" onclick="deleteBlogPost(@post.Id)"><i class="fa-solid fa-trash"></i></button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">No blog articles recorded. Click "New Blog Article" to create one.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Blog Modal -->
<div class="modal fade" id="blogModal" tabindex="-1" aria-labelledby="blogModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 16px;">
            <div class="modal-header border-bottom-0 p-4">
                <h5 class="modal-title font-weight-bold" id="blogModalLabel">New Blog Article</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="SaveBlog" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4 fs-7">
                    <input type="hidden" name="id" id="blogId" value="0" />
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label font-weight-semibold">Article Title <span class="text-danger">*</span></label>
                            <input type="text" name="title" id="blogTitle" class="form-control py-2" required placeholder="e.g. New Armature Models Introduced">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label font-weight-semibold">Category <span class="text-danger">*</span></label>
                            <select name="category" id="blogCategory" class="form-select py-2" required>
                                <option value="Maintenance">Maintenance</option>
                                <option value="Product Guides">Product Guides</option>
                                <option value="Industry News">Industry News</option>
                                <option value="Safety">Safety</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label font-weight-semibold">Image URL (Optional)</label>
                            <input type="url" name="imagePath" id="blogImagePath" class="form-control py-2" placeholder="https://images.unsplash.com/photo-...">
                        </div>
                        <div class="col-12">
                            <label class="form-label font-weight-semibold">Summary <span class="text-danger">*</span></label>
                            <input type="text" name="summary" id="blogSummary" class="form-control py-2" required placeholder="Short summary displaying on list card...">
                        </div>
                        <div class="col-12">
                            <label class="form-label font-weight-semibold">Rich Text Content (HTML allowed) <span class="text-danger">*</span></label>
                            <textarea name="content" id="blogContent" class="form-control" rows="8" required placeholder="<p>Article body content...</p>"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-top-0 p-4">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary px-4">Save Article</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function clearBlogForm() {
        document.getElementById('blogId').value = '0';
        document.getElementById('blogTitle').value = '';
        document.getElementById('blogCategory').value = 'Maintenance';
        document.getElementById('blogImagePath').value = '';
        document.getElementById('blogSummary').value = '';
        document.getElementById('blogContent').value = '';
        document.getElementById('blogModalLabel').innerText = 'New Blog Article';
    }

    function editBlogPost(id, title, category, summary, content, imagePath) {
        document.getElementById('blogId').value = id;
        document.getElementById('blogTitle').value = title;
        document.getElementById('blogCategory').value = category;
        document.getElementById('blogImagePath').value = imagePath;
        document.getElementById('blogSummary').value = summary;
        document.getElementById('blogContent').value = content;
        document.getElementById('blogModalLabel').innerText = 'Edit Blog Article';
        
        var modal = new bootstrap.Modal(document.getElementById('blogModal'));
        modal.show();
    }

    async function deleteBlogPost(id) {
        if (!confirm("Are you sure you want to delete this blog post?")) return;
        
        var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
        var response = await fetch('/Cms/DeleteBlog', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'RequestVerificationToken': token
            },
            body: 'id=' + id
        });
        
        var result = await response.json();
        if (result.success) {
            document.getElementById('row-' + id).remove();
        } else {
            alert("Failed to delete blog post.");
        }
    }
</script>
