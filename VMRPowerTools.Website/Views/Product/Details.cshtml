@model Product
@{
    ViewData["Title"] = Model.ProductName;
    ViewData["MetaDescription"] = Model.Description ?? $"Purchase VMR {Model.ProductName} (Product Code: {Model.ProductCode}) online at ₹{Model.SalesPrice:N2}. Premium industrial calibration equipment with instant dispatch from Chennai.";
    ViewData["MetaKeywords"] = $"{Model.ProductName}, {Model.ProductCode}, VMR Spares, Industrial Power Tools, Heavy Duty Machinery";
    ViewData["OGTitle"] = $"{Model.ProductName} - VMR Power Tools";
    ViewData["OGDescription"] = Model.Description;
    ViewData["OGImage"] = Model.ImagePath;

    var related = ViewBag.RelatedProducts as IEnumerable<Product> ?? new List<Product>();
    var viewed = ViewBag.RecentlyViewed as IEnumerable<Product> ?? new List<Product>();
    var whatsappUrl = $"https://wa.me/919876543210?text=Hi%2C%20I%20am%20interested%20in%20{Uri.EscapeDataString(Model.ProductName)}%20(Code%3A%20{Model.ProductCode})%20priced%20at%20%E2%82%B9{Model.SalesPrice:N2}.%20Please%20provide%20quotation%20details.";
    var isDrill = Model.ProductName.ToLower().Contains("drill") || (Model.Category != null && Model.Category.CategoryName.ToLower().Contains("drill"));
    var isGrinder = Model.ProductName.ToLower().Contains("grinder") || (Model.Category != null && Model.Category.CategoryName.ToLower().Contains("grinder"));
    var isSaw = Model.ProductName.ToLower().Contains("saw") || (Model.Category != null && Model.Category.CategoryName.ToLower().Contains("saw"));

    var discountPercent = Model.MRP > Model.SalesPrice ? Math.Round(((Model.MRP - Model.SalesPrice) / Model.MRP) * 100) : (Model.Discount > 0 ? Model.Discount : 0);
    var emiStartingAmount = Math.Round(Model.SalesPrice / 6);
    var defaultImage = !string.IsNullOrEmpty(Model.ImagePath) ? Model.ImagePath : "https://images.unsplash.com/photo-1504917595217-d4dc5ebe6122?auto=format&fit=crop&q=80&w=800";
}

<!-- Structured Data for Production E-commerce SEO -->
<script type="application/ld+json">
{
  "@@context": "https://schema.org",
  "@@type": "Product",
  "name": "@Html.Raw(Model.ProductName)",
  "image": "@defaultImage",
  "description": "@Html.Raw(Model.Description ?? "Industrial grade power equipment.")",
  "sku": "@Model.ProductCode",
  "mpn": "@Model.ProductCode",
  "brand": {
    "@@type": "Brand",
    "name": "@(Model.Brand?.BrandName ?? "VMR Power Tools")"
  },
  "aggregateRating": {
    "@@type": "AggregateRating",
    "ratingValue": "4.9",
    "reviewCount": "128"
  },
  "offers": {
    "@@type": "Offer",
    "url": "@($"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}")",
    "priceCurrency": "INR",
    "price": "@Model.SalesPrice",
    "itemCondition": "https://schema.org/NewCondition",
    "availability": "@(Model.CurrentStock > 0 ? "https://schema.org/InStock" : "https://schema.org/OutOfStock")"
  }
}
</script>

<div class="bg-brand-black min-h-screen text-white overflow-x-hidden no-print">

    <!-- ==========================================
         1. HERO SECTION (Max 70% Viewport Height, Split Layout, Zero Text Overlap)
         ========================================== -->
    <section class="relative max-h-[70vh] min-h-[480px] py-6 overflow-hidden hero-light-beam border-b border-white/10 flex items-center">
        <div class="absolute inset-0 hero-subtle-mesh opacity-15 pointer-events-none"></div>

        <div class="container mx-auto px-4 md:px-8 max-w-7xl relative z-10 w-full">
            
            <!-- Breadcrumb Navigation -->
            <nav aria-label="breadcrumb" class="mb-4">
                <ol class="flex items-center flex-wrap gap-2 text-zinc-400 font-syne text-[11px] tracking-widest uppercase">
                    <li><a asp-controller="Home" asp-action="Index" class="hover:text-brand-orange transition-colors">HOME</a></li>
                    <li><i class="fa-solid fa-chevron-right text-[8px] mx-1 text-zinc-600"></i></li>
                    <li><a asp-controller="Product" asp-action="Index" class="hover:text-brand-orange transition-colors">PRODUCTS</a></li>
                    <li><i class="fa-solid fa-chevron-right text-[8px] mx-1 text-zinc-600"></i></li>
                    @if (Model.Category != null)
                    {
                        <li><a asp-controller="Product" asp-action="Index" asp-route-categoryId="@Model.CategoryId" class="hover:text-brand-orange transition-colors">@Model.Category.CategoryName.ToUpper()</a></li>
                        <li><i class="fa-solid fa-chevron-right text-[8px] mx-1 text-zinc-600"></i></li>
                    }
                    <li class="text-zinc-200 font-bold">@Model.ProductCode</li>
                </ol>
            </nav>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
                
                <!-- Left 60%: Large Clear Hero Product Image (No Text Overlap) -->
                <div class="lg:col-span-7 relative">
                    <div class="gallery-main-stage relative w-full h-[320px] md:h-[380px] flex items-center justify-center p-6 bg-gradient-to-b from-zinc-950 via-zinc-900/40 to-zinc-950 rounded-2xl border border-white/10">
                        <div class="absolute top-3 left-3 flex items-center gap-2 z-20">
                            <span class="bg-brand-orange text-black font-syne text-[10px] font-extrabold uppercase px-2.5 py-0.5 tracking-wider rounded">
                                FLAGSHIP SERIES
                            </span>
                            @if (discountPercent > 0)
                            {
                                <span class="bg-red-500/20 border border-red-500/40 text-red-400 font-syne text-[10px] font-bold uppercase px-2.5 py-0.5 rounded">
                                    @discountPercent% OFF
                                </span>
                            }
                        </div>

                        <!-- Product Image -->
                        <div id="hero-img-wrap" class="relative w-full h-full flex items-center justify-center">
                            <img id="hero-main-image" src="@defaultImage" alt="@Model.ProductName" class="max-h-full max-w-full object-contain filter drop-shadow-[0_15px_25px_rgba(0,0,0,0.8)] transition-transform duration-300 hover:scale-105">
                        </div>
                    </div>
                </div>

                <!-- Right 40%: Typography & Conversion Controls (Never Covering Product) -->
                <div class="lg:col-span-5 flex flex-col justify-center">
                    
                    <!-- Badges -->
                    <div class="flex items-center flex-wrap gap-2 mb-2">
                        <span class="bg-white/5 border border-white/10 text-brand-orange font-syne text-[10px] font-extrabold tracking-widest uppercase px-2.5 py-0.5 rounded-full">
                            CODE: @Model.ProductCode
                        </span>
                        @if (Model.Brand != null)
                        {
                            <span class="bg-zinc-900 border border-zinc-800 text-zinc-300 font-syne text-[10px] font-bold tracking-widest uppercase px-2.5 py-0.5 rounded-full flex items-center gap-1">
                                <i class="fa-solid fa-shield-halved text-brand-orange"></i> @Model.Brand.BrandName
                            </span>
                        }
                    </div>

                    <!-- Title -->
                    <h1 class="text-2xl md:text-4xl font-syne font-extrabold uppercase leading-tight tracking-luxury text-white mb-3">
                        @Model.ProductName
                    </h1>

                    <!-- Live Rating & Stock Status -->
                    <div class="flex items-center gap-4 mb-4 pb-3 border-b border-white/10">
                        <div class="flex items-center gap-1.5">
                            <div class="flex text-amber-400 text-xs gap-0.5">
                                <i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star-half-stroke"></i>
                            </div>
                            <span class="font-syne font-extrabold text-xs text-white">4.9</span>
                            <span class="text-zinc-500 font-inter text-[11px]">(128 Reviews)</span>
                        </div>

                        <div>
                            @if (Model.CurrentStock > 0)
                            {
                                <span class="flex items-center gap-1.5 text-emerald-400 font-syne text-[10px] font-bold tracking-wider uppercase bg-emerald-500/10 border border-emerald-500/20 px-2.5 py-0.5 rounded-full">
                                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-ping"></span> IN STOCK
                                </span>
                            }
                            else
                            {
                                <span class="text-red-400 font-syne text-[10px] font-bold tracking-wider uppercase bg-red-500/10 border border-red-500/20 px-2 py-0.5 rounded-full">
                                    OUT OF STOCK
                                </span>
                            }
                        </div>
                    </div>

                    <!-- Pricing & EMI -->
                    <div class="mb-4">
                        <div class="flex items-baseline gap-3 mb-1">
                            <span class="text-brand-orange font-syne font-extrabold text-3xl md:text-4xl">
                                ₹@Model.SalesPrice.ToString("N0")
                            </span>
                            @if (Model.MRP > Model.SalesPrice)
                            {
                                <span class="text-zinc-500 line-through font-syne text-lg">
                                    ₹@Model.MRP.ToString("N0")
                                </span>
                            }
                        </div>
                        <p class="text-zinc-400 font-inter text-xs flex items-center gap-1.5">
                            <i class="fa-solid fa-credit-card text-brand-orange"></i> EMI from <span class="text-white font-bold">₹@emiStartingAmount.ToString("N0")/mo</span> (0% processing).
                        </p>
                    </div>

                    <!-- Conversion Buttons -->
                    <div class="grid grid-cols-2 gap-3 mb-3">
                        <button onclick="triggerAddToCart(@Model.Id, '@Html.Raw(Model.ProductName)')" class="py-3 bg-zinc-900 border border-zinc-700 hover:border-brand-orange text-white font-syne text-xs font-extrabold uppercase tracking-wider rounded-xl transition-all flex items-center justify-center gap-2">
                            <i class="fa-solid fa-cart-shopping text-brand-orange"></i> ADD TO CART
                        </button>
                        <button onclick="triggerBuyNow(@Model.Id)" class="py-3 bg-brand-orange hover:bg-orange-600 text-white font-syne text-xs font-extrabold uppercase tracking-wider rounded-xl transition-all shadow-md flex items-center justify-center gap-2">
                            <i class="fa-solid fa-bolt"></i> BUY NOW
                        </button>
                    </div>

                    <div class="grid grid-cols-2 gap-3">
                        <a asp-controller="Home" asp-action="Contact" asp-route-message="Quotation request for @Model.ProductName (Code: @Model.ProductCode)." class="py-2.5 bg-zinc-950 border border-white/10 hover:border-white/30 text-center text-zinc-300 hover:text-white font-syne text-[11px] font-bold uppercase rounded-xl transition-colors flex items-center justify-center gap-1.5">
                            <i class="fa-solid fa-file-invoice text-zinc-400"></i> REQUEST QUOTE
                        </a>
                        <a href="@whatsappUrl" target="_blank" rel="noopener noreferrer" class="py-2.5 bg-emerald-500/10 border border-emerald-500/30 hover:bg-emerald-500/20 text-center text-emerald-400 font-syne text-[11px] font-bold uppercase rounded-xl transition-colors flex items-center justify-center gap-1.5">
                            <i class="fa-brands fa-whatsapp text-xs"></i> WHATSAPP
                        </a>
                    </div>

                </div>

            </div>
        </div>
    </section>

    <!-- ==========================================
         2. CATEGORY QUICK SWITCHER (RULE 6: IMMEDIATELY SHOW CATEGORIES AFTER HERO)
         ========================================== -->
    <section class="py-4 bg-zinc-950 border-b border-white/10">
        <div class="container mx-auto px-4 md:px-8 max-w-7xl">
            <div class="flex items-center justify-between gap-4 overflow-x-auto no-scrollbar py-2">
                <span class="text-zinc-400 font-syne text-xs font-bold uppercase tracking-wider shrink-0 flex items-center gap-2">
                    <i class="fa-solid fa-layer-group text-brand-orange"></i> EXPLORE CATEGORIES:
                </span>
                
                <div class="flex items-center gap-3 shrink-0">
                    <a asp-controller="Product" asp-action="Index" class="px-4 py-2 bg-zinc-900 hover:bg-brand-orange border border-white/10 hover:border-brand-orange text-zinc-300 hover:text-white font-syne text-xs font-bold uppercase rounded-lg transition-colors flex items-center gap-2">
                        ⚡ Drilling & Drivers
                    </a>
                    <a asp-controller="Product" asp-action="Index" class="px-4 py-2 bg-zinc-900 hover:bg-brand-orange border border-white/10 hover:border-brand-orange text-zinc-300 hover:text-white font-syne text-xs font-bold uppercase rounded-lg transition-colors flex items-center gap-2">
                        ⚙️ Grinders & Cutters
                    </a>
                    <a asp-controller="Product" asp-action="Index" class="px-4 py-2 bg-zinc-900 hover:bg-brand-orange border border-white/10 hover:border-brand-orange text-zinc-300 hover:text-white font-syne text-xs font-bold uppercase rounded-lg transition-colors flex items-center gap-2">
                        🔨 Demolition Hammers
                    </a>
                    <a asp-controller="Product" asp-action="Index" class="px-4 py-2 bg-zinc-900 hover:bg-brand-orange border border-white/10 hover:border-brand-orange text-zinc-300 hover:text-white font-syne text-xs font-bold uppercase rounded-lg transition-colors flex items-center gap-2">
                        🪚 Saws & Cutting
                    </a>
                    <a asp-controller="Product" asp-action="Index" class="px-4 py-2 bg-zinc-900 hover:bg-brand-orange border border-white/10 hover:border-brand-orange text-zinc-300 hover:text-white font-syne text-xs font-bold uppercase rounded-lg transition-colors flex items-center gap-2">
                        🧰 Original Spares
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- ==========================================
         3. PRODUCT PURCHASE PANEL (STICKY ON SCROLL) & DETAILS
         ========================================== -->
    <section class="py-12 bg-brand-black">
        <div class="container mx-auto px-4 md:px-8 max-w-7xl">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
                
                <!-- Left 8 Cols: Detailed Product Info & Logistics -->
                <div class="lg:col-span-8 flex flex-col gap-6">
                    
                    <!-- Express Delivery Calculator -->
                    <div class="industrial-card p-6">
                        <h3 class="text-lg font-syne font-bold uppercase text-white mb-2 flex items-center gap-2">
                            <i class="fa-solid fa-truck-fast text-brand-orange"></i> CHECK EXPRESS DISPATCH ESTIMATE
                        </h3>
                        <p class="text-zinc-400 font-inter text-xs mb-4">Enter your 6-digit delivery pincode for instant logistics calculation from our Chennai hub.</p>
                        
                        <div class="flex flex-col sm:flex-row gap-3 max-w-md">
                            <input type="text" id="pincode-input" placeholder="Enter Pincode (e.g. 600032)" maxlength="6" class="form-control-dark px-4 py-2.5 rounded-lg text-xs flex-grow font-mono">
                            <button onclick="calculateDelivery()" class="bg-brand-orange hover:bg-orange-600 text-white font-syne font-bold text-xs uppercase px-5 py-2.5 rounded-lg transition-all">
                                CHECK DISPATCH
                            </button>
                        </div>
                        <div id="pincode-result" class="mt-3 text-xs font-syne hidden"></div>
                    </div>

                    <!-- Warranty & Quality Certification Card -->
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                        <div class="border border-white/10 bg-zinc-950 p-5 rounded-xl text-center">
                            <i class="fa-solid fa-award text-2xl text-brand-orange mb-2"></i>
                            <h5 class="font-syne font-bold text-xs text-white mb-1 uppercase">3-YEAR WARRANTY</h5>
                            <p class="text-zinc-500 font-inter text-[11px]">Official VMR Heavy-Duty Warranty Included.</p>
                        </div>
                        <div class="border border-white/10 bg-zinc-950 p-5 rounded-xl text-center">
                            <i class="fa-solid fa-gears text-2xl text-brand-orange mb-2"></i>
                            <h5 class="font-syne font-bold text-xs text-white mb-1 uppercase">SPARE PARTS READY</h5>
                            <p class="text-zinc-500 font-inter text-[11px]">100% Genuine Spares In Stock.</p>
                        </div>
                        <div class="border border-white/10 bg-zinc-950 p-5 rounded-xl text-center">
                            <i class="fa-solid fa-boxes-packing text-2xl text-brand-orange mb-2"></i>
                            <h5 class="font-syne font-bold text-xs text-white mb-1 uppercase">FREE EXPRESS SHIPPING</h5>
                            <p class="text-zinc-500 font-inter text-[11px]">Transit Insurance on all orders.</p>
                        </div>
                    </div>

                </div>

                <!-- Right 4 Cols: STICKY PURCHASE PANEL -->
                <div class="lg:col-span-4 sticky-purchase-panel p-6">
                    <div class="flex items-center justify-between pb-4 border-b border-white/10 mb-4">
                        <div>
                            <span class="text-zinc-500 font-syne text-[10px] tracking-widest uppercase block mb-1">TOTAL UNIT PRICE</span>
                            <span class="text-brand-orange font-syne font-extrabold text-2xl">₹@Model.SalesPrice.ToString("N0")</span>
                        </div>
                        @if (discountPercent > 0)
                        {
                            <span class="bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 font-syne text-[10px] font-extrabold px-2.5 py-0.5 rounded-full uppercase">
                                SAVE @discountPercent%
                            </span>
                        }
                    </div>

                    <!-- Quantity Selector -->
                    <div class="mb-4">
                        <label class="text-zinc-400 font-syne text-[10px] font-bold tracking-wider uppercase block mb-1.5">QUANTITY SELECTOR</label>
                        <div class="flex items-center border border-white/10 bg-zinc-950 rounded-lg overflow-hidden p-1">
                            <button onclick="adjustQty(-1)" class="w-10 h-8 flex items-center justify-center text-zinc-400 hover:text-white hover:bg-zinc-800 rounded font-bold text-base">-</button>
                            <input type="number" id="purchase-qty" value="1" min="1" max="@(Model.CurrentStock > 0 ? Model.CurrentStock : 99)" class="w-full bg-transparent text-center font-syne font-extrabold text-white text-sm outline-none" readonly>
                            <button onclick="adjustQty(1)" class="w-10 h-8 flex items-center justify-center text-zinc-400 hover:text-white hover:bg-zinc-800 rounded font-bold text-base">+</button>
                        </div>
                    </div>

                    <!-- Availability & GST Note -->
                    <div class="space-y-2 mb-6">
                        <div class="flex items-center justify-between text-xs font-syne">
                            <span class="text-zinc-500 uppercase">AVAILABILITY:</span>
                            <span class="text-emerald-400 font-bold">@Model.CurrentStock UNITS IN STOCK</span>
                        </div>
                        <div class="flex items-center justify-between text-xs font-syne">
                            <span class="text-zinc-500 uppercase">GST INVOICE:</span>
                            <span class="text-zinc-300 font-bold">@Model.GSTPercentage.ToString("G29")% TAX INCLUDED</span>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="flex flex-col gap-2.5">
                        <button onclick="triggerAddToCart(@Model.Id, '@Html.Raw(Model.ProductName)')" class="w-full py-3 bg-zinc-900 border border-zinc-700 hover:border-brand-orange text-white font-syne text-xs font-extrabold uppercase tracking-wider rounded-lg transition-all flex items-center justify-center gap-2">
                            <i class="fa-solid fa-cart-arrow-down text-brand-orange"></i> ADD TO CART
                        </button>
                        <button onclick="triggerBuyNow(@Model.Id)" class="w-full py-3 bg-brand-orange hover:bg-orange-600 text-white font-syne text-xs font-extrabold uppercase tracking-wider rounded-lg transition-all flex items-center justify-center gap-2 shadow-md">
                            <i class="fa-solid fa-credit-card"></i> INSTANT CHECKOUT
                        </button>
                    </div>

                    <!-- Wishlist & Compare Toggles -->
                    <div class="grid grid-cols-2 gap-2 mt-4 pt-3 border-t border-white/10">
                        <button onclick="toggleWishlist(@Model.Id)" class="py-2 bg-zinc-950 border border-white/10 hover:border-white/20 text-zinc-400 hover:text-white font-syne text-[10px] font-bold uppercase rounded transition-colors flex items-center justify-center gap-1">
                            <i class="fa-regular fa-heart text-brand-orange"></i> WISHLIST
                        </button>
                        <button onclick="toggleCompare(@Model.Id, '@Html.Raw(Model.ProductName)')" class="py-2 bg-zinc-950 border border-white/10 hover:border-white/20 text-zinc-400 hover:text-white font-syne text-[10px] font-bold uppercase rounded transition-colors flex items-center justify-center gap-1">
                            <i class="fa-solid fa-code-compare text-brand-orange"></i> COMPARE
                        </button>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- ==========================================
         4. INTERACTIVE 3D PRODUCT SHOWCASE
         ========================================== -->
    <section class="py-12 bg-zinc-950 border-t border-b border-white/10">
        <div class="container mx-auto px-4 md:px-8 max-w-7xl">
            <div class="text-center max-w-3xl mx-auto mb-8">
                <span class="text-brand-orange font-syne font-extrabold text-xs tracking-widest uppercase block mb-1">INTERACTIVE SHOWCASE</span>
                <h2 class="text-2xl md:text-4xl font-syne font-extrabold uppercase tracking-luxury text-white">ENGINEERING BREAKDOWN</h2>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-center">
                <!-- 3D Canvas -->
                <div class="lg:col-span-8 relative">
                    <div class="relative w-full h-[400px] rounded-xl border border-white/10 bg-gradient-to-b from-zinc-950 via-zinc-900 to-zinc-950 overflow-hidden flex items-center justify-center">
                        <canvas id="details-3d-canvas" class="absolute inset-0 w-full h-full z-10 cursor-grab active:cursor-grabbing"></canvas>

                        <div class="absolute top-3 left-3 z-20 bg-black/80 border border-white/10 px-3 py-1 rounded text-[10px] font-syne text-zinc-300 flex items-center gap-2">
                            <span class="w-2 h-2 rounded-full bg-brand-orange animate-ping"></span> Interactive 3D Orbit Active
                        </div>
                    </div>
                </div>

                <!-- Specs Breakdown -->
                <div class="lg:col-span-4 flex flex-col gap-3">
                    <div class="industrial-card p-5">
                        <h4 class="text-white font-syne font-bold text-xs uppercase mb-1">01. BRUSHLESS POWER CORE</h4>
                        <p class="text-zinc-400 font-inter text-xs leading-relaxed">Heavy-duty magnetic rotor provides constant torque output without friction loss or thermal throttling.</p>
                    </div>
                    <div class="industrial-card p-5">
                        <h4 class="text-white font-syne font-bold text-xs uppercase mb-1">02. PLANETARY GEARBOX</h4>
                        <p class="text-zinc-400 font-inter text-xs leading-relaxed">Precision CNC-milled planetary transmission ensures seamless power transfer under heavy loads.</p>
                    </div>
                    <div class="industrial-card p-5">
                        <h4 class="text-white font-syne font-bold text-xs uppercase mb-1">03. VIBRO-SHIELD SUSPENSION</h4>
                        <p class="text-zinc-400 font-inter text-xs leading-relaxed">Internal rubberized isolation shock mounts absorb 68% of recoil forces, reducing fatigue.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ==========================================
         5. KEY FEATURES SECTION
         ========================================== -->
    <section class="py-12 bg-brand-black">
        <div class="container mx-auto px-4 md:px-8 max-w-7xl">
            <div class="text-center max-w-3xl mx-auto mb-10">
                <span class="text-brand-orange font-syne font-extrabold text-xs tracking-widest uppercase block mb-1">KEY FEATURES</span>
                <h2 class="text-2xl md:text-4xl font-syne font-extrabold uppercase tracking-luxury text-white">KEY INDUSTRIAL ADVANTAGES</h2>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                <div class="industrial-card p-6">
                    <span class="text-2xl mb-3 block">⚡</span>
                    <h4 class="text-lg font-syne font-bold uppercase text-white mb-2">HIGH PERFORMANCE ENGINE</h4>
                    <p class="text-zinc-400 font-inter text-xs leading-relaxed">High torque density motor configured to sustain heavy continuous output without thermal drops.</p>
                </div>

                <div class="industrial-card p-6">
                    <span class="text-2xl mb-3 block">🛡</span>
                    <h4 class="text-lg font-syne font-bold uppercase text-white mb-2">HEAVY DUTY BUILD</h4>
                    <p class="text-zinc-400 font-inter text-xs leading-relaxed">Reinforced alloy housing engineered to withstand site drops onto concrete.</p>
                </div>

                <div class="industrial-card p-6">
                    <span class="text-2xl mb-3 block">⛽</span>
                    <h4 class="text-lg font-syne font-bold uppercase text-white mb-2">FUEL & ENERGY EFFICIENT</h4>
