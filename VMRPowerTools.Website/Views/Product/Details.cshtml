@section Scripts {
    <script>
        function adjustQty(change) {
            const input = document.getElementById('purchase-qty');
            let val = parseInt(input.value) || 1;
            val = Math.max(1, Math.min(val + change, parseInt(input.max) || 99));
            input.value = val;
        }

        function triggerAddToCart(productId, itemName) {
            const qty = parseInt(document.getElementById('purchase-qty')?.value) || 1;
            $('#cartToastMessage').text(itemName + ' (' + qty + ' unit/s) added to cart!');
            var toastEl = document.getElementById('cartToast');
            var toast = new bootstrap.Toast(toastEl);
            toast.show();

            $.post('/Cart/Add', { productId: productId, quantity: qty }, function(res) {
                setTimeout(() => { location.reload(); }, 800);
            });
        }

        function triggerBuyNow(productId) {
            const qty = parseInt(document.getElementById('purchase-qty')?.value) || 1;
            $.post('/Cart/Add', { productId: productId, quantity: qty }, function(res) {
                window.location.href = '/Checkout';
            });
        }

        function calculateDelivery() {
            const pin = document.getElementById('pincode-input').value.trim();
            const resEl = document.getElementById('pincode-result');
            resEl.classList.remove('hidden');
            
            if (pin.length === 6 && /^\d+$/.test(pin)) {
                if (pin.startsWith('600')) {
                    resEl.className = "mt-3 text-xs font-syne text-emerald-400 font-bold flex items-center gap-1.5";
                    resEl.innerHTML = '<i class="fa-solid fa-circle-check"></i> CHENNAI HUB DISPATCH: Delivered within 24 Hours via Guindy Dock.';
                } else {
                    resEl.className = "mt-3 text-xs font-syne text-brand-orange font-bold flex items-center gap-1.5";
                    resEl.innerHTML = '<i class="fa-solid fa-truck-ramp-box"></i> EXPRESS HIGHWAY DISPATCH: Delivered in 2-3 Business Days.';
                }
            } else {
                resEl.className = "mt-3 text-xs font-syne text-red-400 font-bold flex items-center gap-1.5";
                resEl.innerHTML = '<i class="fa-solid fa-triangle-exclamation"></i> Enter a valid 6-digit Pincode.';
            }
        }

        function openLightbox(imgUrl) {
            document.getElementById('lightbox-img').src = imgUrl;
            document.getElementById('lightbox-modal').classList.remove('hidden');
        }

        function closeLightbox() {
            document.getElementById('lightbox-modal').classList.add('hidden');
        }

        function toggleWishlist(id) {
            alert('Product #' + id + ' saved to wishlist!');
        }

        function toggleCompare(id, title) {
            alert(title + ' added to compare tray!');
        }

        function toggleFaq(trigger) {
            const item = trigger.parentElement;
            item.classList.toggle('open');
        }

        document.addEventListener("DOMContentLoaded", function () {
            // GSAP Counter numbers
            if (typeof gsap !== 'undefined' && typeof ScrollTrigger !== 'undefined') {
                gsap.registerPlugin(ScrollTrigger);

                document.querySelectorAll('.counter').forEach(el => {
                    const target = parseInt(el.getAttribute('data-target'));
                    gsap.to(el, {
                        innerText: target,
                        duration: 1.5,
                        snap: { innerText: 1 },
                        scrollTrigger: { trigger: el, start: "top 90%" }
                    });
                });
            }

            // Three.js Canvas
            const dCanvas = document.getElementById("details-3d-canvas");
            if (!dCanvas || typeof THREE === 'undefined') return;

            const dRenderer = new THREE.WebGLRenderer({ canvas: dCanvas, antialias: true, alpha: true });
            dRenderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
            dRenderer.setSize(dCanvas.clientWidth, dCanvas.clientHeight);

            const dScene = new THREE.Scene();
            const dCamera = new THREE.PerspectiveCamera(40, dCanvas.clientWidth / dCanvas.clientHeight, 0.1, 100);
            dCamera.position.set(0, 0, 10);

            const controls = new THREE.OrbitControls(dCamera, dCanvas);
            controls.enableDamping = true;

            const ambient = new THREE.AmbientLight(0xffffff, 0.5);
            dScene.add(ambient);

            const keyLight = new THREE.DirectionalLight(0xffffff, 1.8);
            keyLight.position.set(5, 8, 5);
            dScene.add(keyLight);

            const orangeLight = new THREE.DirectionalLight(0xFF5C00, 1.2);
            orangeLight.position.set(-5, -2, -3);
            dScene.add(orangeLight);

            const itemGroup = new THREE.Group();
            dScene.add(itemGroup);

            const metalMat = new THREE.MeshStandardMaterial({ color: 0x1a1a1e, metalness: 0.9, roughness: 0.2 });
            const steelMat = new THREE.MeshStandardMaterial({ color: 0xd0d0d0, metalness: 0.95, roughness: 0.1 });
            const orangeMat = new THREE.MeshStandardMaterial({ color: 0xFF5C00, metalness: 0.7, roughness: 0.15 });

            const base = new THREE.Mesh(new THREE.CylinderGeometry(0.8, 0.8, 3.2, 16), orangeMat);
            base.rotation.x = Math.PI / 2;
            itemGroup.add(base);

            const chuck = new THREE.Mesh(new THREE.CylinderGeometry(0.6, 0.7, 1.2, 16), steelMat);
            chuck.rotation.x = Math.PI / 2;
            chuck.position.z = 2.0;
            itemGroup.add(chuck);

            function animate3D() {
                requestAnimationFrame(animate3D);
                itemGroup.rotation.y += 0.005;
                controls.update();
                dRenderer.render(dScene, dCamera);
            }
            animate3D();
        });
    </script>
}
