@model Product
@{
    ViewData["Title"] = Model.ProductName;
    ViewData["MetaDescription"] = Model.Description ?? $"Purchase VMR {Model.ProductName} (Product Code: {Model.ProductCode}) online at ₹{Model.SalesPrice:N2}. Authentic calibration spares ready in Chennai.";
    ViewData["MetaKeywords"] = $"{Model.ProductName}, {Model.ProductCode}, VMR Spares, Industrial Power Tools, Chennai Logistics Warehouse";
    ViewData["OGTitle"] = $"{Model.ProductName} - VMR Power Tools";
    ViewData["OGDescription"] = Model.Description;
    ViewData["OGImage"] = Model.ImagePath;

    var related = ViewBag.RelatedProducts as IEnumerable<Product> ?? new List<Product>();
    var viewed = ViewBag.RecentlyViewed as IEnumerable<Product> ?? new List<Product>();
    var whatsappUrl = $"https://wa.me/919876543210?text=Hi%2C%20I%20am%20interested%20in%20{Uri.EscapeDataString(Model.ProductName)}%20(Code%3A%20{Model.ProductCode})%20priced%20at%20%E2%82%B9{Model.SalesPrice:N2}.%20Please%20provide%20more%20details.";
    var isDrill = Model.ProductName.ToLower().Contains("drill") || (Model.Category != null && Model.Category.CategoryName.ToLower().Contains("drill"));
    var isGrinder = Model.ProductName.ToLower().Contains("grinder") || (Model.Category != null && Model.Category.CategoryName.ToLower().Contains("grinder"));
    var isSaw = Model.ProductName.ToLower().Contains("saw") || (Model.Category != null && Model.Category.CategoryName.ToLower().Contains("saw"));
}

<script type="application/ld+json">
{
  "@@context": "https://schema.org",
  "@@type": "Product",
  "name": "@Html.Raw(Model.ProductName)",
  "image": "@(Model.ImagePath ?? "")",
  "description": "@Html.Raw(Model.Description ?? "")",
  "sku": "@Model.ProductCode",
  "mpn": "@Model.ProductCode",
  "offers": {
    "@@type": "Offer",
    "url": "@($"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}")",
    "priceCurrency": "INR",
    "price": "@Model.SalesPrice",
    "availability": "@(Model.CurrentStock > 0 ? "https://schema.org/InStock" : "https://schema.org/OutOfStock")",
    "priceValidUntil": "2030-12-31"
  }
}
</script>

<div class="bg-brand-black min-h-screen pt-8 no-print">
    <!-- Breadcrumb -->
    <section class="py-4 bg-brand-black border-b border-white/5">
        <div class="container mx-auto px-4 md:px-8 max-w-7xl">
            <nav aria-label="breadcrumb">
                <ol class="flex items-center gap-2 text-zinc-500 font-syne text-[10px] tracking-widest uppercase">
                    <li><a asp-controller="Home" asp-action="Index" class="hover:text-white transition-colors duration-300">Home</a></li>
                    <li><i class="fa-solid fa-chevron-right text-[8px] mx-1"></i></li>
                    <li><a asp-controller="Product" asp-action="Index" class="hover:text-white transition-colors duration-300">Products</a></li>
                    <li><i class="fa-solid fa-chevron-right text-[8px] mx-1"></i></li>
                    <li class="text-zinc-300 font-bold">@Model.ProductName</li>
                </ol>
            </nav>
        </div>
    </section>

    <!-- Product Layout: Split 3D Canvas / Details -->
    <section class="py-12 bg-brand-black">
        <div class="container mx-auto px-4 md:px-8 max-w-7xl">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
                
                <!-- Left: 3D Interactive Canvas & Static Image Backup -->
                <div class="lg:col-span-6 flex flex-col gap-6">
                    <div class="relative w-full h-[480px] border border-white/5 bg-zinc-950/40 overflow-hidden flex items-center justify-center">
                        <!-- Technical grids background -->
                        <div class="absolute inset-0 grid-mesh opacity-10 pointer-events-none"></div>
                        <div class="absolute inset-0 orange-glow-radial opacity-60 pointer-events-none"></div>
                        
                        <!-- WebGL 3D Canvas -->
                        <canvas id="details-3d-canvas" class="absolute inset-0 w-full h-full z-10 cursor-grab active:cursor-grabbing"></canvas>
                        
                        <!-- Static fallback/backup overlay for rendering reference -->
                        @if (!string.IsNullOrEmpty(Model.ImagePath))
                        {
                            <div class="absolute bottom-4 right-4 z-20 bg-brand-black/80 border border-white/10 px-3 py-1.5 text-[9px] font-syne tracking-widest uppercase flex items-center gap-2 opacity-65 hover:opacity-100 transition-opacity duration-300">
                                <i class="fa-solid fa-camera text-brand-orange"></i> Image Reference
                                <img src="@Model.ImagePath" alt="@Model.ProductName" class="w-8 h-8 object-contain bg-zinc-900 border border-zinc-800 p-0.5 ml-2">
                            </div>
                        }
                        
                        <!-- 3D Interactions HUD -->
                        <div class="absolute top-4 right-4 z-20 bg-brand-black/80 border border-white/10 px-3 py-1.5 text-[9px] font-syne tracking-widest uppercase flex items-center gap-1.5 pointer-events-none">
                            <i class="fa-solid fa-arrows-spin text-brand-orange animate-spin"></i> Interactive 3D Orbit Active
                        </div>
                    </div>

                    <!-- Hotspots specs list -->
                    <div class="grid grid-cols-3 gap-4">
                        <div class="border border-white/5 bg-brand-card-bg p-4 text-center">
                            <span class="text-brand-orange font-syne font-bold text-[9px] tracking-widest block mb-1">DAMPING</span>
                            <span class="text-white font-syne font-extrabold text-xs uppercase">Vibro-Shield</span>
                        </div>
                        <div class="border border-white/5 bg-brand-card-bg p-4 text-center">
                            <span class="text-brand-orange font-syne font-bold text-[9px] tracking-widest block mb-1">TRANSMISSION</span>
                            <span class="text-white font-syne font-extrabold text-xs uppercase">Planetary Gears</span>
                        </div>
                        <div class="border border-white/5 bg-brand-card-bg p-4 text-center">
                            <span class="text-brand-orange font-syne font-bold text-[9px] tracking-widest block mb-1">POWER CORE</span>
                            <span class="text-white font-syne font-extrabold text-xs uppercase">Brushless</span>
                        </div>
                    </div>
                </div>

                <!-- Right: Product Specifications & Actions -->
                <div class="lg:col-span-6 flex flex-col justify-between">
                    <div>
                        <!-- Category / Code / Brand tags -->
                        <div class="flex items-center gap-3 mb-6">
                            <span class="bg-brand-orange/10 border border-brand-orange/20 text-brand-orange font-syne text-[10px] font-extrabold tracking-widest uppercase px-3 py-1">CODE: @Model.ProductCode</span>
                            @if (Model.Brand != null)
                            {
                                <span class="bg-zinc-900 border border-zinc-800 text-zinc-400 font-syne text-[10px] font-bold tracking-widest uppercase px-3 py-1">@Model.Brand.BrandName</span>
                            }
                        </div>
                        
                        <h1 class="text-4xl md:text-5xl font-syne font-extrabold uppercase leading-none tracking-luxury text-white mb-6">@Model.ProductName</h1>
                        
                        <!-- Pricing Grid -->
                        <div class="flex items-end gap-4 mb-8">
                            <span class="text-brand-orange font-syne font-extrabold text-3xl md:text-4xl leading-none">₹@Model.SalesPrice.ToString("N0")</span>
                            @if (Model.MRP > Model.SalesPrice)
                            {
                                <span class="text-zinc-600 text-lg text-decoration-line-through font-syne leading-none mb-1">₹@Model.MRP.ToString("N0")</span>
                            }
                        </div>

                        <!-- Live Stock Indicator -->
                        <div class="mb-8 flex items-center gap-3 font-syne text-[10px] tracking-wider uppercase">
                            <span class="text-zinc-500">AVAILABILITY STATUS:</span>
                            @if (Model.CurrentStock > 0)
                            {
                                <span class="bg-green-500/10 border border-green-500/20 text-green-400 font-bold px-3 py-1 flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-green-400 animate-ping"></span> Live Stock Synced</span>
                            }
                            else
                            {
                                <span class="bg-red-500/10 border border-red-500/20 text-red-400 font-bold px-3 py-1">OUT OF STOCK</span>
                            }
                        </div>

                        <p class="text-zinc-400 font-inter text-sm leading-relaxed mb-8">@(Model.Description ?? "No technical description configured for this industrial item yet.")</p>

                        <!-- Primary Purchase Actions -->
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
                            <button onclick="triggerCartToast('@Model.ProductName')" class="btn-magnetic w-full py-4 border border-zinc-700 hover:border-white text-white font-syne text-xs font-extrabold uppercase tracking-widest transition-colors duration-300">ADD TO CART</button>
                            <button onclick="triggerCheckout('@Model.Id', '@Model.ProductName')" class="btn-magnetic w-full py-4 bg-brand-orange text-white font-syne text-xs font-extrabold uppercase tracking-widest shadow-[0_0_15px_rgba(255,92,0,0.35)]">BUY NOW</button>
                        </div>

                        <!-- Secondary Inquiries -->
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-8">
                            <a asp-controller="Home" asp-action="Contact" asp-route-message="Hi, I would like to request a quotation for @Model.ProductName (Code: @Model.ProductCode). Please call me back." class="btn-magnetic w-full py-4 bg-zinc-950/80 border border-white/5 hover:border-brand-orange text-center text-zinc-300 hover:text-brand-orange font-syne text-xs font-bold uppercase tracking-widest transition-colors duration-300 flex items-center justify-center gap-2"><i class="fa-solid fa-file-invoice-dollar"></i> REQUEST WHolesale QUOTE</a>
                            <a href="@whatsappUrl" target="_blank" rel="noopener noreferrer" class="btn-magnetic w-full py-4 bg-green-500/10 hover:bg-green-500/20 border border-green-500/20 text-center text-green-400 font-syne text-xs font-bold uppercase tracking-widest transition-colors duration-300 flex items-center justify-center gap-2"><i class="fa-brands fa-whatsapp text-sm"></i> WHATSAPP INQUIRY</a>
                        </div>
                    </div>

                    <!-- Tech Specs Table Tabs -->
                    <div class="border border-white/5 bg-brand-card-bg p-6 mt-6">
                        <div class="flex border-b border-white/5 mb-6 font-syne text-[10px] tracking-widest uppercase font-bold">
                            <button class="pb-3 pr-6 text-brand-orange border-b-2 border-brand-orange outline-none" id="btn-tab-specs" onclick="switchTabs('specs')">TECHNICAL SPECS</button>
                            <button class="pb-3 px-6 text-zinc-500 hover:text-white outline-none" id="btn-tab-logistics" onclick="switchTabs('logistics')">LOGISTICS & DISPATCH</button>
                        </div>

                        <!-- Tab contents -->
                        <div id="content-tab-specs" class="font-inter text-xs text-zinc-400 leading-relaxed">
                            <table class="w-full text-left">
                                <tbody class="divide-y divide-white/5">
                                    <tr class="h-10">
                                        <td class="text-zinc-600 font-syne font-bold text-[10px] tracking-wider uppercase w-1/3">Product Code</td>
                                        <td class="text-white font-bold font-syne">@Model.ProductCode</td>
                                    </tr>
                                    @if (Model.Brand != null)
                                    {
                                        <tr class="h-10">
                                            <td class="text-zinc-600 font-syne font-bold text-[10px] tracking-wider uppercase">Brand</td>
                                            <td class="text-white">@Model.Brand.BrandName</td>
                                        </tr>
                                    }
                                    @if (Model.Category != null)
                                    {
                                        <tr class="h-10">
                                            <td class="text-zinc-600 font-syne font-bold text-[10px] tracking-wider uppercase">Category</td>
                                            <td class="text-white">@Model.Category.CategoryName</td>
                                        </tr>
                                    }
                                    @if (!string.IsNullOrEmpty(Model.HSNCode))
                                    {
                                        <tr class="h-10">
                                            <td class="text-zinc-600 font-syne font-bold text-[10px] tracking-wider uppercase">HSN Code</td>
                                            <td class="text-white">@Model.HSNCode</td>
                                        </tr>
                                    }
                                    <tr class="h-10">
                                        <td class="text-zinc-600 font-syne font-bold text-[10px] tracking-wider uppercase">GST Tax Rate</td>
                                        <td class="text-white">@Model.GSTPercentage.ToString("G29")%</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <div id="content-tab-logistics" class="font-inter text-xs text-zinc-500 leading-relaxed hidden">
                            <h6 class="font-syne font-bold text-[10px] text-white tracking-wider uppercase mb-2">DELIVERY DESK DETAILS</h6>
                            <p class="mb-4">
                                Orders completed through our online portal route directly to our central Guindy logistics dispatch queue via real-time SmartERP ledger integrations. Consignments are dispatched within 24 hours across primary highway corridors.
                            </p>
                            <h6 class="font-syne font-bold text-[10px] text-white tracking-wider uppercase mb-2">WAREHOUSE COLLECT</h6>
                            <p class="mb-0">
                                Corporate partners can coordinate localized truck collection directly at our Chennai warehouse loading dock by quoting their digital SmartERP ledger customer ID.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Related Products -->
            @if (related != null && related.Any())
            {
                <div class="mt-24 pt-12 border-t border-white/5">
                    <span class="text-brand-orange font-syne font-extrabold text-xs tracking-widest uppercase block mb-3">RELATED EQUIPMENT</span>
                    <h2 class="text-3xl md:text-5xl font-syne font-extrabold uppercase leading-none text-white tracking-luxury mb-12">
                        COMPLEMENTARY<br><span class="text-zinc-600">UNITS</span>
                    </h2>
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
                        @foreach (var prod in related)
                        {
                            <div class="luxury-card flex flex-col h-full group">
                                <div class="relative w-full h-56 bg-zinc-950/40 border-b border-white/5 flex items-center justify-center p-6 overflow-hidden">
                                    <img src="@prod.ImagePath" alt="@prod.ProductName" class="max-h-full max-w-full object-contain filter brightness-95 group-hover:scale-105 transition-transform duration-750 ease-out" loading="lazy">
                                </div>
                                <div class="p-6 flex flex-col flex-grow">
                                    <span class="text-brand-orange font-syne font-bold text-[9px] tracking-wider uppercase mb-2 block">@(prod.Category?.CategoryName ?? "EQUIPMENT")</span>
                                    <h4 class="text-white font-syne font-bold text-sm mb-2 group-hover:text-brand-orange transition-colors duration-300 line-clamp-1">@prod.ProductName</h4>
                                    <span class="text-white font-syne font-extrabold text-base mt-auto block">₹@prod.SalesPrice.ToString("N0")</span>
                                    
                                    <a asp-action="Details" asp-route-id="@prod.Id" class="mt-4 py-2.5 bg-zinc-900 border border-zinc-800 hover:border-zinc-500 text-center text-white font-syne text-[9px] font-bold uppercase tracking-widest transition-colors duration-300">VIEW DETAILS</a>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </section>
</div>

<!-- Custom Toast Notification for Cart -->
<div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1100;">
    <div id="cartToast" class="toast align-items-center text-white bg-dark border-0" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body">
                <i class="fa-solid fa-cart-arrow-down text-brand-orange me-2"></i> <span id="cartToastMessage">Item added to cart!</span>
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // 1. Tab switches
        function switchTabs(tab) {
            const btnSpecs = document.getElementById('btn-tab-specs');
            const btnLogistics = document.getElementById('btn-tab-logistics');
            const contentSpecs = document.getElementById('content-tab-specs');
            const contentLogistics = document.getElementById('content-tab-logistics');

            if (tab === 'specs') {
                btnSpecs.className = 'pb-3 pr-6 text-brand-orange border-b-2 border-brand-orange outline-none';
                btnLogistics.className = 'pb-3 px-6 text-zinc-500 hover:text-white outline-none';
                contentSpecs.classList.remove('hidden');
                contentLogistics.classList.add('hidden');
            } else {
                btnLogistics.className = 'pb-3 px-6 text-brand-orange border-b-2 border-brand-orange outline-none';
                btnSpecs.className = 'pb-3 pr-6 text-zinc-500 hover:text-white outline-none';
                contentLogistics.classList.remove('hidden');
                contentSpecs.classList.add('hidden');
            }
        }

        // 2. Add to cart alerts & backend updates
        function triggerCartToast(itemName) {
            $('#cartToastMessage').text(itemName + ' added to shopping cart!');
            var toastEl = document.getElementById('cartToast');
            var toast = new bootstrap.Toast(toastEl);
            toast.show();

            $.post('/Cart/Add', { productId: @Model.Id, quantity: 1 }, function(res) {
                setTimeout(() => { location.reload(); }, 800);
            });
        }

        function triggerCheckout(productId, name) {
            $.post('/Cart/Add', { productId: productId, quantity: 1 }, function(res) {
                window.location.href = '/Checkout';
            });
        }

        // 3. Three.js Interactive 3D Product rendering
        document.addEventListener("DOMContentLoaded", function () {
            const dCanvas = document.getElementById("details-3d-canvas");
            if (!dCanvas) return;

            const dRenderer = new THREE.WebGLRenderer({ canvas: dCanvas, antialias: true, alpha: true });
            dRenderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
            dRenderer.setSize(dCanvas.clientWidth, dCanvas.clientHeight);

            const dScene = new THREE.Scene();
            const dCamera = new THREE.PerspectiveCamera(40, dCanvas.clientWidth / dCanvas.clientHeight, 0.1, 100);
            dCamera.position.set(0, 0, 10);

            // Orbit controls for interactive user grab
            const controls = new THREE.OrbitControls(dCamera, dCanvas);
            controls.enableDamping = true;
            controls.dampingFactor = 0.05;
            controls.enableZoom = true;
            controls.maxDistance = 15;
            controls.minDistance = 4;

            // Lights
            const ambient = new THREE.AmbientLight(0xffffff, 0.25);
            dScene.add(ambient);

            const keyLight = new THREE.DirectionalLight(0xffffff, 1.8);
            keyLight.position.set(5, 8, 5);
            dScene.add(keyLight);

            const fillLight = new THREE.DirectionalLight(0xFF5C00, 1.2);
            fillLight.position.set(-5, 4, -3);
            dScene.add(fillLight);

            // Create geometry based on product features
            const itemGroup = new THREE.Group();
            dScene.add(itemGroup);

            // Material config
            const metalMat = new THREE.MeshStandardMaterial({ color: 0x1f1f23, metalness: 0.9, roughness: 0.2 });
            const steelMat = new THREE.MeshStandardMaterial({ color: 0xdcdcdc, metalness: 0.95, roughness: 0.1 });
            const orangeMat = new THREE.MeshStandardMaterial({ color: 0xFF5C00, metalness: 0.7, roughness: 0.15 });

            // Detect category patterns in JS
            const isDrill = @(isDrill ? "true" : "false");
            const isGrinder = @(isGrinder ? "true" : "false");
            const isSaw = @(isSaw ? "true" : "false");

            let rotatingElement = null;

            if (isDrill) {
                // Drill Casing
                const body = new THREE.Mesh(new THREE.CylinderGeometry(0.8, 0.8, 3.2, 16), orangeMat);
                body.rotation.x = Math.PI / 2;
                itemGroup.add(body);

                const handle = new THREE.Mesh(new THREE.BoxGeometry(0.5, 2.2, 0.8), metalMat);
                handle.position.set(-0.8, -1.5, -0.5);
                handle.rotation.z = 0.2;
                itemGroup.add(handle);

                const chuck = new THREE.Mesh(new THREE.CylinderGeometry(0.6, 0.7, 1.2, 16), steelMat);
                chuck.rotation.x = Math.PI / 2;
                chuck.position.z = 2.0;
                itemGroup.add(chuck);

                const drillBit = new THREE.Mesh(new THREE.CylinderGeometry(0.2, 0.2, 3.0, 8), steelMat);
                drillBit.rotation.x = Math.PI / 2;
                drillBit.position.z = 3.6;
                itemGroup.add(drillBit);
                rotatingElement = drillBit;
            } 
            else if (isGrinder) {
                // Grinder Casing
                const body = new THREE.Mesh(new THREE.CylinderGeometry(0.6, 0.6, 3.5, 16), metalMat);
                body.rotation.x = Math.PI / 2;
                itemGroup.add(body);

                const head = new THREE.Mesh(new THREE.CylinderGeometry(0.9, 0.9, 1.2, 16), steelMat);
                head.position.z = 1.8;
                head.rotation.x = Math.PI / 2;
                itemGroup.add(head);

                const guard = new THREE.Mesh(new THREE.CylinderGeometry(1.5, 1.5, 0.4, 16, 1, false, 0, Math.PI), orangeMat);
                guard.position.z = 1.8;
                guard.rotation.x = Math.PI / 2;
                itemGroup.add(guard);

                const disc = new THREE.Mesh(new THREE.CylinderGeometry(1.4, 1.4, 0.05, 32), steelMat);
                disc.position.z = 1.85;
                disc.rotation.x = Math.PI / 2;
                itemGroup.add(disc);
                rotatingElement = disc;
            } 
            else if (isSaw) {
                // Circular Saw
                const motor = new THREE.Mesh(new THREE.CylinderGeometry(0.8, 0.8, 1.8, 16), metalMat);
                motor.position.x = -0.9;
                itemGroup.add(motor);

                const guard = new THREE.Mesh(new THREE.CylinderGeometry(2.0, 2.0, 0.4, 16, 1, false, 0, Math.PI), orangeMat);
                guard.rotation.y = Math.PI / 2;
                itemGroup.add(guard);

                const blade = new THREE.Mesh(new THREE.CylinderGeometry(1.8, 1.8, 0.04, 32), steelMat);
                blade.rotation.y = Math.PI / 2;
                itemGroup.add(blade);
                rotatingElement = blade;
            } 
            else {
                // Default sleek Tool Box / Battery system
                const base = new THREE.Mesh(new THREE.BoxGeometry(2.8, 2.0, 1.6), metalMat);
                itemGroup.add(base);

                const topPlate = new THREE.Mesh(new THREE.BoxGeometry(2.9, 0.2, 1.7), orangeMat);
                topPlate.position.y = 1.0;
                itemGroup.add(topPlate);

                const handle = new THREE.Mesh(new THREE.BoxGeometry(0.3, 0.8, 1.5), steelMat);
                handle.position.y = 1.4;
                itemGroup.add(handle);
            }

            // Animation render
            function render3D() {
                requestAnimationFrame(render3D);

                // Auto rotate model slightly
                if (!controls.state === -1) {
                    itemGroup.rotation.y += 0.005;
                }

                // Spin rotating parts (e.g. disc or drill bit)
                if (rotatingElement) {
                    if (isDrill) rotatingElement.rotation.y += 0.08;
                    else rotatingElement.rotation.y += 0.05;
                }

                controls.update();
                dRenderer.render(dScene, dCamera);
            }
            render3D();

            // Resize handling
            window.addEventListener("resize", () => {
                dCamera.aspect = dCanvas.clientWidth / dCanvas.clientHeight;
                dCamera.updateProjectionMatrix();
                dRenderer.setSize(dCanvas.clientWidth, dCanvas.clientHeight);
            });
        });
    </script>
}
