@model CartSummary
@{
    ViewData["Title"] = "Shopping Cart";
}

<section class="py-5 bg-white border-bottom">
    <div class="container">
        <h1>Shopping Cart</h1>
        <p class="text-muted mb-0">Manage your orders and configure bulk coupons before proceeding to delivery options.</p>
    </div>
</section>

<section class="py-5">
    <div class="container">
        @if (Model.Items != null && Model.Items.Any())
        {
            <div class="row g-4">
                <!-- Cart Items List -->
                <div class="col-lg-8">
                    <div class="card border-0 shadow-sm p-4 bg-white" style="border-radius: 12px;">
                        <div class="table-responsive">
                            <table class="table align-middle">
                                <thead>
                                    <tr class="text-muted fs-8 font-weight-bold uppercase tracking-wider">
                                        <th colspan="2">Product Details</th>
                                        <th>Qty</th>
                                        <th>Rate</th>
                                        <th>Subtotal</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.Items)
                                    {
                                        <tr id="cart-row-@item.ProductId">
                                            <td style="width: 80px;">
                                                <div class="bg-light p-2 rounded d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                                                    @if (!string.IsNullOrEmpty(item.ImagePath))
                                                    {
                                                        <img src="@item.ImagePath" alt="@item.ProductName" class="img-fluid" style="max-height: 100%;">
                                                    }
                                                    else
                                                    {
                                                        <i class="fa-solid fa-toolbox text-muted fs-3"></i>
                                                    }
                                                </div>
                                            </td>
                                            <td>
                                                <a asp-controller="Product" asp-action="Details" asp-route-id="@item.ProductId" class="text-dark text-decoration-none font-weight-semibold text-truncate d-block" style="max-width: 250px;">@item.ProductName</a>
                                                <span class="fs-8 text-muted">@item.ProductCode</span>
                                            </td>
                                            <td style="width: 140px;">
                                                <div class="input-group input-group-sm border rounded" style="width: 110px; overflow: hidden;">
                                                    <button class="btn btn-light border-0" type="button" onclick="updateQty(@item.ProductId, @(item.Quantity - 1))"><i class="fa-solid fa-minus fs-8"></i></button>
                                                    <input type="text" class="form-control border-0 text-center font-weight-bold" value="@item.Quantity" readonly>
                                                    <button class="btn btn-light border-0" type="button" onclick="updateQty(@item.ProductId, @(item.Quantity + 1))"><i class="fa-solid fa-plus fs-8"></i></button>
                                                </div>
                                            </td>
                                            <td>₹@item.Rate.ToString("N2")</td>
                                            <td>₹@item.SubTotal.ToString("N2")</td>
                                            <td class="text-end">
                                                <button class="btn btn-link text-danger p-0" onclick="removeItem(@item.ProductId)" title="Remove Item"><i class="fa-regular fa-trash-can fs-5"></i></button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        
                        <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
                            <a asp-controller="Product" asp-action="Index" class="btn btn-outline-primary"><i class="fa-solid fa-arrow-left me-2"></i> Back to Catalog</a>
                            <button class="btn btn-outline-danger" onclick="clearCart()"><i class="fa-solid fa-trash-arrow-up me-2"></i> Clear Cart</button>
                        </div>
                    </div>
                </div>

                <!-- Summary Panel -->
                <div class="col-lg-4">
                    <!-- Coupon Card -->
                    <div class="card border-0 shadow-sm p-4 bg-white mb-4" style="border-radius: 12px;">
                        <h5 class="mb-3 font-weight-bold"><i class="fa-solid fa-tag text-primary me-2"></i> Apply Coupon</h5>
                        <div class="input-group mb-2">
                            <input type="text" id="couponInput" class="form-control" placeholder="Promo Code (e.g. VMR10)" value="@Model.CouponCode">
                            <button class="btn btn-primary" onclick="applyCoupon()"><i class="fa-solid fa-check"></i></button>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.CouponCode))
                        {
                            <span class="fs-8 text-success font-weight-bold d-block"><i class="fa-solid fa-circle-check"></i> Coupon "@Model.CouponCode" applied!</span>
                            <a href="#" class="fs-8 text-danger mt-1 d-inline-block" onclick="removeCoupon()">Remove Coupon</a>
                        }
                        else
                        {
                            <span class="fs-8 text-muted d-block">Try VMR10 (10% Off) or WELCOME15 (15% Off)</span>
                        }
                    </div>

                    <!-- Totals Card -->
                    <div class="card border-0 shadow-sm p-4 bg-white" style="border-radius: 12px;">
                        <h5 class="mb-4 font-weight-bold border-bottom pb-2">Order Summary</h5>
                        <table class="table table-borderless align-middle mb-4">
                            <tbody>
                                <tr class="fs-7 text-muted">
                                    <td>Cart Subtotal</td>
                                    <td class="text-end text-dark font-weight-semibold">₹@Model.SubTotal.ToString("N2")</td>
                                </tr>
                                @if (Model.DiscountAmount > 0)
                                {
                                    <tr class="fs-7 text-success">
                                        <td>Coupon Discount</td>
                                        <td class="text-end font-weight-semibold">-₹@Model.DiscountAmount.ToString("N2")</td>
                                    </tr>
                                }
                                <tr class="fs-7 text-muted">
                                    <td>Tax (@Model.TaxBreakdown)</td>
                                    <td class="text-end text-dark font-weight-semibold">₹@Model.TaxAmount.ToString("N2")</td>
                                </tr>
                                <tr class="fs-7 text-muted">
                                    <td>Shipping Rate</td>
                                    <td class="text-end text-dark font-weight-semibold">
                                        @if (Model.ShippingCharge > 0)
                                        {
                                            <span>₹@Model.ShippingCharge.ToString("N2")</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success-subtle text-success px-2 py-1">Free</span>
                                        }
                                    </td>
                                </tr>
                                <tr class="border-top fs-5 font-weight-bold">
                                    <td class="pt-3">Grand Total</td>
                                    <td class="text-end text-primary pt-3">₹@Model.GrandTotal.ToString("N2")</td>
                                </tr>
                            </tbody>
                        </table>
                        
                        <a asp-controller="Checkout" asp-action="Index" class="btn btn-primary btn-lg w-100 py-3 fs-6"><i class="fa-solid fa-credit-card me-2"></i> Proceed to Checkout</a>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="text-center py-5 bg-white rounded shadow-sm border">
                <i class="fa-solid fa-cart-shopping text-muted mb-3" style="font-size: 6rem; opacity: 0.3;"></i>
                <h3>Your Cart is Empty</h3>
                <p class="text-muted mb-4">Looks like you haven't added any power tools to your cart yet.</p>
                <a asp-controller="Product" asp-action="Index" class="btn btn-primary btn-lg"><i class="fa-solid fa-toolbox me-2"></i> Browse Products</a>
            </div>
        }
    </div>
</section>

@section Scripts {
    <script>
        function updateQty(productId, newQty) {
            $.post('/Cart/UpdateQuantity', { productId: productId, quantity: newQty }, function (res) {
                if (res.success) {
                    location.reload();
                } else {
                    Swal.fire('Error', res.message, 'error');
                }
            });
        }

        function removeItem(productId) {
            Swal.fire({
                title: 'Remove Item?',
                text: 'Are you sure you want to remove this tool from your cart?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#ef4444',
                cancelButtonColor: '#64748b',
                confirmButtonText: 'Yes, remove it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.post('/Cart/Remove', { productId: productId }, function (res) {
                        if (res.success) {
                            location.reload();
                        } else {
                            Swal.fire('Error', res.message, 'error');
                        }
                    });
                }
            });
        }

        function clearCart() {
            Swal.fire({
                title: 'Clear Cart?',
                text: 'Remove all power tools from your cart?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#ef4444',
                cancelButtonColor: '#64748b',
                confirmButtonText: 'Yes, clear all!'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.post('/Cart/Clear', function (res) {
                        if (res.success) {
                            location.reload();
                        }
                    });
                }
            });
        }

        function applyCoupon() {
            var code = $('#couponInput').val();
            if (!code) return;
            $.post('/Cart/ApplyCoupon', { couponCode: code }, function (res) {
                if (res.success) {
                    location.reload();
                } else {
                    Swal.fire('Invalid Coupon', res.message, 'error');
                }
            });
        }

        function removeCoupon() {
            $.post('/Cart/ApplyCoupon', { couponCode: '' }, function (res) {
                if (res.success) {
                    location.reload();
                }
            });
        }
    </script>
}
