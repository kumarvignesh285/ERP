@{
    ViewData["Title"] = "About Our Heritage";
}

<!-- Premium Header Section -->
<section class="py-5 text-white border-b border-white/5 bg-brand-black animate-fade-up">
    <div class="container mx-auto px-4 md:px-8 max-w-7xl py-3">
        <span class="badge bg-brand-orange/10 border border-brand-orange/20 text-brand-orange px-3.5 py-2 mb-3 text-uppercase font-weight-bold" style="border-radius: 4px; font-size: 0.75rem;">Industrial Heritage</span>
        <h1 class="display-5 font-weight-extrabold text-white font-syne">About VMR Power Tools</h1>
        <p class="text-zinc-400 mb-0 fs-6 mt-2" style="max-width: 700px;">Learn about our rich manufacturing history and dedication to supplying premium construction spares and calibrating industrial machinery.</p>
    </div>
</section>

<!-- Our Journey Section -->
<section class="py-12 bg-brand-black">
    <div class="container mx-auto px-4 md:px-8 max-w-7xl py-2">
        <div class="row g-5 align-items-center mb-5">
            <div class="col-lg-6 animate-fade-right">
                <span class="text-brand-orange text-uppercase font-weight-bold tracking-wider fs-7 d-block mb-2 font-syne">Our Corporate Journey</span>
                <h2 class="font-weight-bold mb-4 text-white font-syne">Over a Decade of Engineering Integrity</h2>
                <p class="text-zinc-400 fs-7" style="line-height: 1.6;">Established in 2012 at Chennai, VMR Power Tools has evolved into one of Tamil Nadu's premier distributors of heavy-duty industrial machinery, brush cutters, water pumps, earth augers, and genuine calibration spares.</p>
                <p class="text-zinc-400 fs-7" style="line-height: 1.6;">We partner with leading manufacturing brands worldwide to deliver high-duty, durable spares. By synchronizing our website directly with our SmartERP warehousing database, we offer contractors live stock counts and lightning-fast logistics.</p>
            </div>
            <div class="col-lg-6 text-center animate-fade-left">
                <div class="p-5 shadow-lg position-relative overflow-hidden glass-panel-custom" style="border: 1px solid rgba(255,92,0,0.2) !important;">
                    <div class="position-absolute" style="top: -50px; right: -50px; width: 150px; height: 150px; background-color: var(--brand-orange); opacity: 0.15; border-radius: 50%;"></div>
                    <div class="position-relative z-index-1 text-white">
                        <i class="fa-solid fa-industry text-brand-orange mb-3" style="font-size: 5rem; filter: drop-shadow(0 0 10px rgba(255,92,0,0.3));"></i>
                        <h4 class="mt-3 font-weight-bold text-white font-syne">Guindy Logistics Hub</h4>
                        <p class="text-zinc-400 fs-7 mb-0" style="line-height: 1.5;">Our central Guindy warehouse processes over 1,500 daily shipments via direct courier integrations and real-time SmartERP ledger tracking.</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Corporate Statistics Grid -->
        <div class="row g-4 text-center mb-5 animate-zoom">
            <div class="col-6 col-md-3">
                <div class="glass-panel-custom p-4">
                    <span class="display-6 font-weight-bold text-brand-orange d-block mb-1 font-montserrat">12+</span>
                    <span class="text-zinc-500 fs-8 font-weight-semibold uppercase tracking-wider font-syne">Years of Trust</span>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="glass-panel-custom p-4">
                    <span class="display-6 font-weight-bold text-brand-orange d-block mb-1 font-montserrat">1,500+</span>
                    <span class="text-zinc-500 fs-8 font-weight-semibold uppercase tracking-wider font-syne">Daily Shipments</span>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="glass-panel-custom p-4">
                    <span class="display-6 font-weight-bold text-brand-orange d-block mb-1 font-montserrat">50k+</span>
                    <span class="text-zinc-500 fs-8 font-weight-semibold uppercase tracking-wider font-syne">Spares Calibrated</span>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="glass-panel-custom p-4">
                    <span class="display-6 font-weight-bold text-brand-orange d-block mb-1 font-montserrat">100%</span>
                    <span class="text-zinc-500 fs-8 font-weight-semibold uppercase tracking-wider font-syne">Genuine Spares</span>
                </div>
            </div>
        </div>

        <!-- Professional Gallery (Masonry) -->
        <div class="mt-5 pt-3 animate-fade-up">
            <div class="text-center mb-5">
                <span class="text-brand-orange text-uppercase font-weight-bold tracking-wider fs-7 d-block mb-1 font-syne">Visual Portfolio</span>
                <h3 class="font-weight-extrabold display-6 text-white font-syne">Industrial Worksite Gallery</h3>
                <div class="mx-auto bg-brand-orange mt-2" style="width: 50px; height: 3px;"></div>
            </div>

            <div class="masonry-gallery">
                <!-- Gallery 1: Power Tools -->
                <div class="gallery-item">
                    <img src="https://images.unsplash.com/photo-1530124566582-ab0510492f27?auto=format&fit=crop&w=600&q=80" alt="Power Tools Selection" loading="lazy">
                    <div class="gallery-item-overlay">
                        <div class="gallery-item-title">Premium Tools</div>
                        <div class="gallery-item-desc">Hardware Store</div>
                    </div>
                </div>

                <!-- Gallery 2: Industrial Workshop -->
                <div class="gallery-item">
                    <img src="https://images.unsplash.com/photo-1581092160607-ee22621dd758?auto=format&fit=crop&w=600&q=80" alt="Industrial Testing Floor" loading="lazy">
                    <div class="gallery-item-overlay">
                        <div class="gallery-item-title">Assembly Calibration</div>
                        <div class="gallery-item-desc">Industrial Workshop</div>
                    </div>
                </div>

                <!-- Gallery 3: Chain Saw -->
                <div class="gallery-item">
                    <img src="https://images.unsplash.com/photo-1608613304899-ea8098577e38?auto=format&fit=crop&w=600&q=80" alt="STIHL Chainsaw on site" loading="lazy">
                    <div class="gallery-item-overlay">
                        <div class="gallery-item-title">Timber Processing</div>
                        <div class="gallery-item-desc">Chainsaw Forestry</div>
                    </div>
                </div>

                <!-- Gallery 4: Customers / Mechanics -->
                <div class="gallery-item">
                    <img src="https://images.unsplash.com/photo-1504917595217-d4dc5ebe6122?auto=format&fit=crop&w=600&q=80" alt="Site Mechanics" loading="lazy">
                    <div class="gallery-item-overlay">
                        <div class="gallery-item-title">Authorized Engineers</div>
                        <div class="gallery-item-desc">Professional Mechanics</div>
                    </div>
                </div>

                <!-- Gallery 5: Agriculture -->
                <div class="gallery-item">
                    <img src="https://images.unsplash.com/photo-1500937386664-56d1dfef3854?auto=format&fit=crop&w=600&q=80" alt="Brush Cutter clearing land" loading="lazy">
                    <div class="gallery-item-overlay">
                        <div class="gallery-item-title">Orchard Maintenance</div>
                        <div class="gallery-item-desc">Agricultural Equipment</div>
                    </div>
                </div>

                <!-- Gallery 6: Construction -->
                <div class="gallery-item">
                    <img src="https://images.unsplash.com/photo-1541888946425-d81bb19240f5?auto=format&fit=crop&w=600&q=80" alt="Concrete Cutter Sparking" loading="lazy">
                    <div class="gallery-item-overlay">
                        <div class="gallery-item-title">Concrete Cutting</div>
                        <div class="gallery-item-desc">Construction Equipment</div>
                    </div>
                </div>

                <!-- Gallery 7: Service Center -->
                <div class="gallery-item">
                    <img src="https://images.unsplash.com/photo-1595206133361-b1fe343e5e23?auto=format&fit=crop&w=600&q=80" alt="Calibration Spares" loading="lazy">
                    <div class="gallery-item-overlay">
                        <div class="gallery-item-title">Armature Repairs</div>
                        <div class="gallery-item-desc">Service Center</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
