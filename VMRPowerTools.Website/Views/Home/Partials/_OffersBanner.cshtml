<section class="py-16 no-print bg-brand-black">
    <div class="container mx-auto px-4 md:px-8 max-w-7xl">
        <div class="relative overflow-hidden border border-white/5 bg-brand-card-bg p-8 md:p-16 flex flex-col lg:flex-row items-center justify-between gap-12">
            <!-- Diagonal Tech Lines Grid background -->
            <div class="absolute inset-0 grid-mesh opacity-10 pointer-events-none"></div>
            <div class="absolute -right-32 -top-32 w-96 h-96 orange-glow-radial pointer-events-none"></div>
            
            <div class="max-w-2xl relative z-10">
                <span class="bg-brand-orange/10 border border-brand-orange/20 text-brand-orange font-syne text-[10px] tracking-widest uppercase px-3 py-1.5 block w-fit mb-6">EXCLUSIVE PARTNER SYSTEM</span>
                <h2 class="text-3xl md:text-5xl font-syne font-extrabold uppercase leading-tight text-white mb-6 tracking-luxury">
                    SAVE <span class="text-brand-orange">FLAT 15%</span> ON YOUR FIRST BULK ORDER
                </h2>
                <p class="text-zinc-500 font-inter text-sm leading-relaxed mb-8 max-w-xl">
                    Deploy premium machinery at scale. Register your contractor ID to auto-unlock exclusive wholesale quotes. SmartERP sync automates billing directly from our Chennai logistics docks.
                </p>
                <div class="flex flex-wrap gap-4">
                    <a asp-controller="Account" asp-action="Register" class="btn-magnetic px-6 py-3.5 bg-brand-orange text-white font-syne text-xs font-extrabold uppercase tracking-widest shadow-[0_0_15px_rgba(255,92,0,0.3)]">Create Partner Account</a>
                    <a asp-controller="Home" asp-action="Contact" class="btn-magnetic px-6 py-3.5 border border-zinc-700 hover:border-white text-white font-syne text-xs font-bold uppercase tracking-widest transition-colors duration-300">Contact Corporate Desk</a>
                </div>
            </div>

            <div class="hidden lg:flex items-center justify-center relative w-72 h-72 border border-white/5 bg-zinc-950/40 relative z-10">
                <div class="absolute inset-4 border border-brand-orange/10 flex items-center justify-center">
                    <span class="text-7xl font-syne font-extrabold text-white leading-none font-montserrat tracking-tighter">15<span class="text-brand-orange text-3xl align-top">%</span></span>
                </div>
                <div class="absolute bottom-4 right-4 text-[9px] font-syne tracking-widest text-zinc-600">OFFER ID: VMR-15</div>
            </div>
        </div>
    </div>
</section>
