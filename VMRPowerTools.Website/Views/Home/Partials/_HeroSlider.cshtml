                    <div class="flex items-center gap-2 text-zinc-300">
                        <i class="fa-solid fa-check text-brand-orange"></i>
                        <span><strong class="text-white counter" data-target="15000">0</strong>+ Customers</span>
                    </div>
                    <div class="flex items-center gap-2 text-zinc-300">
                        <i class="fa-solid fa-check text-brand-orange"></i>
                        <span><strong class="text-white counter" data-target="500">0</strong>+ Products</span>
                    </div>
                    <div class="flex items-center gap-2 text-zinc-300">
                        <i class="fa-solid fa-check text-brand-orange"></i>
                        <span><strong class="text-white counter" data-target="100">0</strong>+ Dealers</span>
