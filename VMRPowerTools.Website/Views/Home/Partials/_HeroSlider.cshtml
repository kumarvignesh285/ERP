    0%, 100% {
        opacity: 0.65;
        transform: translate3d(0, -50%, 0) scale(0.98);
    }
    50% {
        opacity: 0.90;
        transform: translate3d(0, -50%, 0) scale(1.04);
    }
}
.animate-pulse-slow {
    animation: pulseSlow 4.5s ease-in-out infinite;
}
</style>

<!-- Fully Layered 3D WebGL Assembly & Exploded Engineering View Engine -->
<script>
document.addEventListener("DOMContentLoaded", function () {
    const canvas = document.getElementById("hero-3d-canvas");
    const container = document.getElementById("hero-drill-container");
    if (!canvas || typeof THREE === 'undefined') return;

    // High Precision WebGL Studio Renderer
    const renderer = new THREE.WebGLRenderer({ canvas: canvas, antialias: true, alpha: true, powerPreference: "high-performance" });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.setSize(canvas.clientWidth, canvas.clientHeight);
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.18;

    const scene = new THREE.Scene();

    // Studio Camera Setup
    const camera = new THREE.PerspectiveCamera(32, canvas.clientWidth / canvas.clientHeight, 0.1, 100);
    camera.position.set(3.2, 1.4, 7.0);

    // Smooth Orbit Controls
    const controls = new THREE.OrbitControls(camera, canvas);
    controls.enableDamping = true;
    controls.dampingFactor = 0.04;
    controls.enableZoom = false;
    controls.target.set(0, 0, 0);

    // 1. STUDIO LIGHTING SETUP
    const ambientLight = new THREE.AmbientLight(0xffffff, 0.55);
    scene.add(ambientLight);

    const keyLight = new THREE.DirectionalLight(0xffffff, 3.2);
    keyLight.position.set(7, 10, 8);
    scene.add(keyLight);

    const orangeRimLight = new THREE.SpotLight(0xFF5C00, 4.2, 22, Math.PI / 4, 0.5, 1);
    orangeRimLight.position.set(-7, 4, -4);
    scene.add(orangeRimLight);

    const fillLight = new THREE.DirectionalLight(0xe0e7ff, 1.6);
    fillLight.position.set(-2, 6, 5);
    scene.add(fillLight);

    // Soft Studio Contact Floor Shadow
    const shadowGeo = new THREE.PlaneGeometry(9, 9);
    const canvasShadow = document.createElement('canvas');
    canvasShadow.width = 256; canvasShadow.height = 256;
    const ctx = canvasShadow.getContext('2d');
    const grad = ctx.createRadialGradient(128, 128, 10, 128, 128, 120);
    grad.addColorStop(0, 'rgba(0,0,0,0.72)');
    grad.addColorStop(0.5, 'rgba(0,0,0,0.25)');
    grad.addColorStop(1, 'rgba(0,0,0,0)');
    ctx.fillStyle = grad; ctx.fillRect(0,0,256,256);

    const shadowTex = new THREE.CanvasTexture(canvasShadow);
    const shadowMat = new THREE.MeshBasicMaterial({ map: shadowTex, transparent: true, opacity: 0.85 });
    const shadowMesh = new THREE.Mesh(shadowGeo, shadowMat);
    shadowMesh.rotation.x = -Math.PI / 2;
    shadowMesh.position.set(0, -2.1, 0);
    scene.add(shadowMesh);

    // 2. MATERIALS
    const orangeCompositeMat = new THREE.MeshStandardMaterial({ color: 0xFF5C00, metalness: 0.12, roughness: 0.30 });
    const dieCastMetalMat = new THREE.MeshStandardMaterial({ color: 0x2e3036, metalness: 0.90, roughness: 0.18 });
    const polishedSteelMat = new THREE.MeshStandardMaterial({ color: 0xe8e8e8, metalness: 0.98, roughness: 0.06 });
    const rubberGripMat = new THREE.MeshStandardMaterial({ color: 0x121214, metalness: 0.02, roughness: 0.88 });
    const batteryPackMat = new THREE.MeshStandardMaterial({ color: 0x18181c, metalness: 0.22, roughness: 0.32 });
    const selectorRedMat = new THREE.MeshStandardMaterial({ color: 0xFF3300, metalness: 0.3, roughness: 0.2 });
    const ledActiveMat = new THREE.MeshBasicMaterial({ color: 0x00FF66 });
    const lineLaserMat = new THREE.LineBasicMaterial({ color: 0xFF5C00, transparent: true, opacity: 0.0 });

    // 3. LAYERED MULTI-COMPONENT 3D DRILL CONTAINER
    const drillGroup = new THREE.Group();
    scene.add(drillGroup);

    // Component Groups
    const parts = {
        drillBit: new THREE.Group(),
        chuck: new THREE.Group(),
        frontGearbox: new THREE.Group(),
        sideHandle: new THREE.Group(),
        selectorDial: new THREE.Group(),
        motorHousing: new THREE.Group(),
        ventCover: new THREE.Group(),
        trigger: new THREE.Group(),
        mainHandle: new THREE.Group(),
        batteryBase: new THREE.Group(),
        logoPlate: new THREE.Group(),
        screws: new THREE.Group()
    };

    Object.values(parts).forEach(p => drillGroup.add(p));

    // A. Drill Bit Component
    const sdsBitMesh = new THREE.Mesh(new THREE.CylinderGeometry(0.24, 0.24, 4.2, 16), polishedSteelMat);
    sdsBitMesh.rotation.x = Math.PI / 2;
    sdsBitMesh.position.set(0, 0.3, 5.2);
    parts.drillBit.add(sdsBitMesh);

    for (let i = 0; i < 22; i++) {
        const flute = new THREE.Mesh(new THREE.BoxGeometry(0.35, 0.09, 0.2), polishedSteelMat);
        flute.position.set(0, 0.3, 4.1 + (i * 0.16));
        flute.rotation.z = i * 0.48;
        parts.drillBit.add(flute);
    }

    // B. Chuck Component
    const sdsCollar = new THREE.Mesh(new THREE.CylinderGeometry(0.75, 0.68, 1.4, 32), polishedSteelMat);
    sdsCollar.rotation.x = Math.PI / 2;
    sdsCollar.position.set(0, 0.3, 2.9);
    parts.chuck.add(sdsCollar);

    const dustCap = new THREE.Mesh(new THREE.CylinderGeometry(0.62, 0.52, 0.6, 32), rubberGripMat);
    dustCap.rotation.x = Math.PI / 2;
    dustCap.position.set(0, 0.3, 3.8);
    parts.chuck.add(dustCap);

    // C. Front Gearbox Component
    const gearCasing = new THREE.Mesh(new THREE.CylinderGeometry(0.85, 0.78, 1.8, 32), dieCastMetalMat);
    gearCasing.rotation.x = Math.PI / 2;
    gearCasing.position.set(0, 0.3, 1.4);
    parts.frontGearbox.add(gearCasing);

    for (let i = 0; i < 6; i++) {
        const fin = new THREE.Mesh(new THREE.BoxGeometry(1.76, 0.08, 0.15), dieCastMetalMat);
        fin.position.set(0, 0.3, 0.8 + (i * 0.22));
        parts.frontGearbox.add(fin);
    }

    // D. Side Handle Component
    const auxCollar = new THREE.Mesh(new THREE.CylinderGeometry(0.92, 0.92, 0.35, 32), dieCastMetalMat);
    auxCollar.rotation.x = Math.PI / 2;
    auxCollar.position.set(0, 0.3, 1.8);
    parts.sideHandle.add(auxCollar);

    const auxHandleGrip = new THREE.Mesh(new THREE.CylinderGeometry(0.26, 0.26, 2.2, 24), rubberGripMat);
    auxHandleGrip.position.set(-1.4, -0.6, 1.8);
    auxHandleGrip.rotation.z = 0.5;
    parts.sideHandle.add(auxHandleGrip);

    const depthRod = new THREE.Mesh(new THREE.CylinderGeometry(0.08, 0.08, 3.6, 12), polishedSteelMat);
    depthRod.rotation.x = Math.PI / 2;
    depthRod.position.set(-0.95, 0.95, 3.4);
    parts.sideHandle.add(depthRod);

    // E. Selector Dial Component
    const modeDial = new THREE.Mesh(new THREE.CylinderGeometry(0.42, 0.42, 0.3, 24), dieCastMetalMat);
    modeDial.rotation.z = Math.PI / 2;
    modeDial.position.set(-0.88, 0.4, 1.3);
    parts.selectorDial.add(modeDial);

    const modeLockBtn = new THREE.Mesh(new THREE.CylinderGeometry(0.12, 0.12, 0.32, 16), selectorRedMat);
    modeLockBtn.rotation.z = Math.PI / 2;
    modeLockBtn.position.set(-0.92, 0.4, 1.3);
    parts.selectorDial.add(modeLockBtn);

    // F. Motor Housing Component
    const motorBody = new THREE.Mesh(new THREE.CylinderGeometry(0.88, 0.88, 2.6, 32), orangeCompositeMat);
    motorBody.rotation.x = Math.PI / 2;
    motorBody.position.set(0, 0.3, -0.4);
    parts.motorHousing.add(motorBody);

    // G. Vent Cover Component
    for (let i = 0; i < 6; i++) {
        const ventL = new THREE.Mesh(new THREE.BoxGeometry(0.08, 0.75, 0.16), dieCastMetalMat);
        ventL.position.set(-0.85, 0.3, -0.8 + (i * 0.22));
        parts.ventCover.add(ventL);

        const ventR = new THREE.Mesh(new THREE.BoxGeometry(0.08, 0.75, 0.16), dieCastMetalMat);
        ventR.position.set(0.85, 0.3, -0.8 + (i * 0.22));
        parts.ventCover.add(ventR);
    }
    const rearCap = new THREE.Mesh(new THREE.CylinderGeometry(0.86, 0.86, 0.4, 32), rubberGripMat);
    rearCap.rotation.x = Math.PI / 2;
    rearCap.position.set(0, 0.3, -1.8);
    parts.ventCover.add(rearCap);

    // H. Trigger Component
    const triggerBtn = new THREE.Mesh(new THREE.BoxGeometry(0.28, 0.75, 0.42), polishedSteelMat);
    triggerBtn.position.set(0, -0.45, -0.72);
    parts.trigger.add(triggerBtn);

    const fwdRevSwitch = new THREE.Mesh(new THREE.CylinderGeometry(0.12, 0.12, 0.85, 16), orangeCompositeMat);
    fwdRevSwitch.rotation.z = Math.PI / 2;
    fwdRevSwitch.position.set(0, 0.08, -0.75);
    parts.trigger.add(fwdRevSwitch);

    // I. Main Handle Component
    const handleFrame = new THREE.Mesh(new THREE.BoxGeometry(0.58, 2.6, 0.9), orangeCompositeMat);
    handleFrame.position.set(0, -1.2, -1.1);
    handleFrame.rotation.x = 0.18;
    parts.mainHandle.add(handleFrame);

    const rubberGripOverlay = new THREE.Mesh(new THREE.BoxGeometry(0.62, 2.5, 0.48), rubberGripMat);
    rubberGripOverlay.position.set(0, -1.2, -1.32);
    rubberGripOverlay.rotation.x = 0.18;
    parts.mainHandle.add(rubberGripOverlay);

    // J. Battery Base Component
    const batteryBaseMesh = new THREE.Mesh(new THREE.BoxGeometry(1.65, 0.95, 2.5), batteryPackMat);
    batteryBaseMesh.position.set(0, -2.6, -1.1);
    parts.batteryBase.add(batteryBaseMesh);

    const latchL = new THREE.Mesh(new THREE.BoxGeometry(0.16, 0.42, 0.6), orangeCompositeMat);
    latchL.position.set(-0.85, -2.4, -1.1);
    parts.batteryBase.add(latchL);

    const latchR = new THREE.Mesh(new THREE.BoxGeometry(0.16, 0.42, 0.6), orangeCompositeMat);
    latchR.position.set(0.85, -2.4, -1.1);
    parts.batteryBase.add(latchR);

    for (let i = 0; i < 4; i++) {
        const led = new THREE.Mesh(new THREE.BoxGeometry(0.12, 0.06, 0.06), ledActiveMat);
        led.position.set(-0.35 + (i * 0.24), -2.3, 0.18);
        parts.batteryBase.add(led);
    }

    // K. Logo Plate & Screws Components
    const nameplate = new THREE.Mesh(new THREE.BoxGeometry(0.04, 0.38, 1.3), polishedSteelMat);
    nameplate.position.set(0.9, 0.35, -0.2);
    parts.logoPlate.add(nameplate);

    const screwHeadGeo = new THREE.CylinderGeometry(0.08, 0.08, 0.04, 12);
    const screwPositions = [
        [0.88, 0.5, 0.4], [-0.88, 0.5, 0.4],
        [0.88, 0.5, -0.6], [-0.88, 0.5, -0.6],
        [0.32, -1.8, -1.4], [-0.32, -1.8, -1.4]
    ];
    screwPositions.forEach(p => {
        const screw = new THREE.Mesh(screwHeadGeo, polishedSteelMat);
        screw.position.set(p[0], p[1], p[2]);
        screw.rotation.z = Math.PI / 2;
        parts.screws.add(screw);
    });

    // 4. LASER EXPLODED VIEW CONNECTION LINES
    const lineGeo = new THREE.BufferGeometry();
    const linePos = new Float32Array(24 * 3); // 12 line segments connecting component pairs
    lineGeo.setAttribute('position', new THREE.BufferAttribute(linePos, 3));
    const laserLines = new THREE.LineSegments(lineGeo, lineLaserMat);
    drillGroup.add(laserLines);

    // Initial Assembled & Exploded Offsets Configuration
    const explodeOffsets = {
        drillBit:     { x: 0,    y: 0,    z: 1.6 },
        chuck:        { x: 0,    y: 0,    z: 0.9 },
        frontGearbox: { x: 0,    y: 0,    z: 0.4 },
        sideHandle:   { x: -0.9, y: -0.4, z: 0.3 },
        selectorDial: { x: -0.7, y: 0.2,  z: 0.1 },
        motorHousing: { x: 0,    y: 0,    z: 0 },
        ventCover:    { x: 0,    y: 0,    z: -0.5 },
        trigger:      { x: 0,    y: -0.4, z: -0.2 },
        mainHandle:   { x: 0,    y: -0.6, z: -0.5 },
        batteryBase:  { x: 0,    y: -1.2, z: -0.5 },
        logoPlate:    { x: 0.6,  y: 0.1,  z: 0 },
        screws:       { x: 0.4,  y: 0.3,  z: 0.4 }
    };

    const initialFlyInOffsets = {
        drillBit:     { x: 0,    y: 2,    z: 8 },
        chuck:        { x: 0,    y: 1.5,  z: 5 },
        frontGearbox: { x: 0,    y: -1,   z: 4 },
        sideHandle:   { x: -5,   y: -2,   z: 2 },
        selectorDial: { x: -4,   y: 2,    z: 1 },
        motorHousing: { x: 0,    y: 0,    z: 0 },
        ventCover:    { x: 0,    y: 2,    z: -6 },
        trigger:      { x: 0,    y: -4,   z: -2 },
        mainHandle:   { x: 0,    y: -5,   z: -3 },
        batteryBase:  { x: 0,    y: -6,   z: -2 },
        logoPlate:    { x: 5,    y: 1,    z: 0 },
        screws:       { x: 3,    y: 4,    z: 2 }
    };

    // Set initial flying-in positions
    Object.keys(parts).forEach(key => {
        parts[key].position.set(
            initialFlyInOffsets[key].x,
            initialFlyInOffsets[key].y,
            initialFlyInOffsets[key].z
        );
    });

    // Orient Drill Group
    drillGroup.position.set(0, 0.15, 0);
    drillGroup.rotation.y = -Math.PI / 4.8;
    drillGroup.rotation.x = Math.PI / 16;

    // 5. PAGE LOAD ASSEMBLY ANIMATION (2.8s Duration Smooth Easing)
    let isAssembled = false;
    let isExploded = false;
    const flyInDuration = 2800; // 2.8s
    const startTime = Date.now();

    function easeOutCubic(t) {
        return 1 - Math.pow(1 - t, 3);
    }

    // 6. MOUSE PARALLAX & HOVER EXPLODED EVENT LISTENERS
    let mouseX = 0, mouseY = 0;
    let targetRotationX = 0, targetRotationY = 0;

    document.addEventListener("mousemove", (e) => {
        mouseX = (e.clientX / window.innerWidth) - 0.5;
        mouseY = (e.clientY / window.innerHeight) - 0.5;
        targetRotationY = mouseX * 0.22;
        targetRotationX = mouseY * 0.14;
    });

    if (container) {
        container.addEventListener("mouseenter", () => {
            if (isAssembled) isExploded = true;
        });
        container.addEventListener("mouseleave", () => {
            isExploded = false;
        });
    }

    // 7. 60 FPS RENDER & ANIMATION LOOP
    let time = 0;
    function renderLoop() {
        requestAnimationFrame(renderLoop);
        time += 0.012;

        const now = Date.now();
        const elapsed = now - startTime;
        const progress = Math.min(elapsed / flyInDuration, 1.0);
        const easeProgress = easeOutCubic(progress);

        if (progress >= 1.0) isAssembled = true;

        // Smooth position interpolation per component
        let lineIdx = 0;
        const positions = lineGeo.attributes.position.array;

        Object.keys(parts).forEach(key => {
            const part = parts[key];
            let target = { x: 0, y: 0, z: 0 };

            if (!isAssembled) {
                // Fly-in Assembly Phase
                const init = initialFlyInOffsets[key];
                target.x = init.x * (1 - easeProgress);
                target.y = init.y * (1 - easeProgress);
                target.z = init.z * (1 - easeProgress);
            } else if (isExploded) {
                // Hover Exploded View Phase
                target = explodeOffsets[key];
            }

            // Damped linear interpolation (Lerp)
            part.position.x += (target.x - part.position.x) * 0.08;
            part.position.y += (target.y - part.position.y) * 0.08;
            part.position.z += (target.z - part.position.z) * 0.08;

            // Connect Laser Lines during Exploded View
            if (isExploded && key !== 'motorHousing') {
                positions[lineIdx++] = 0; positions[lineIdx++] = 0.3; positions[lineIdx++] = 0;
                positions[lineIdx++] = part.position.x; positions[lineIdx++] = part.position.y + 0.3; positions[lineIdx++] = part.position.z;
            }
        });

        lineGeo.attributes.position.needsUpdate = true;
        lineLaserMat.opacity += ((isExploded ? 0.85 : 0.0) - lineLaserMat.opacity) * 0.1;

        // Slow, ultra-smooth floating movement after assembly
        drillGroup.position.y = 0.15 + Math.sin(time * 1.2) * 0.1;
        
        // Spin SDS bit shaft during preview
        parts.drillBit.rotation.y += 0.05;

        // Damped Mouse Parallax Rotation
        drillGroup.rotation.y += ((-Math.PI / 4.8 + targetRotationY) - drillGroup.rotation.y) * 0.04;
        drillGroup.rotation.x += ((Math.PI / 16 + targetRotationX) - drillGroup.rotation.x) * 0.04;

        controls.update();
        renderer.render(scene, camera);
    }
    renderLoop();

    // 8. 60 FPS FLOATING DUST PARTICLES CANVAS
    const pCanvas = document.getElementById("hero-particles-canvas");
    if (pCanvas) {
        const pCtx = pCanvas.getContext("2d");
        let width = pCanvas.width = window.innerWidth;
        let height = pCanvas.height = window.innerHeight;

        window.addEventListener("resize", () => {
            width = pCanvas.width = window.innerWidth;
            height = pCanvas.height = window.innerHeight;
            if (canvas) {
                camera.aspect = canvas.clientWidth / canvas.clientHeight;
                camera.updateProjectionMatrix();
                renderer.setSize(canvas.clientWidth, canvas.clientHeight);
            }
        });

        const particles = [];
        for (let i = 0; i < 35; i++) {
            particles.push({
                x: Math.random() * width,
                y: Math.random() * height,
                radius: Math.random() * 1.8 + 0.5,
                color: Math.random() > 0.4 ? "rgba(255, 92, 0, " + (Math.random() * 0.4 + 0.2) + ")" : "rgba(255, 255, 255, " + (Math.random() * 0.2 + 0.1) + ")",
                speedX: (Math.random() - 0.5) * 0.4,
                speedY: -Math.random() * 0.5 - 0.2
            });
        }

        function renderParticles() {
            pCtx.clearRect(0, 0, width, height);
            particles.forEach(p => {
                p.x += p.speedX; p.y += p.speedY;
                if (p.y < 0) { p.y = height; p.x = Math.random() * width; }
                pCtx.beginPath();
                pCtx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
                pCtx.fillStyle = p.color;
                pCtx.fill();
            });
            requestAnimationFrame(renderParticles);
        }
        renderParticles();
    }

    // GSAP Counter Animations for Trust Section
    if (typeof gsap !== 'undefined' && typeof ScrollTrigger !== 'undefined') {
        gsap.registerPlugin(ScrollTrigger);

        document.querySelectorAll('.counter').forEach(el => {
            const target = parseInt(el.getAttribute('data-target'));
            gsap.to(el, {
                innerText: target,
                duration: 2,
                snap: { innerText: 1 },
                scrollTrigger: { trigger: el, start: "top 95%" }
            });
        });
    }
});
</script>
