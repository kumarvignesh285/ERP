<section class="relative w-full h-[320vh] bg-brand-black overflow-x-hidden no-print" id="story-section">
    <!-- Grid Mesh & Glow Overlay -->
    <div class="absolute inset-0 grid-mesh opacity-40 pointer-events-none z-0"></div>
    <div class="absolute top-[20vh] left-[10%] w-[80vw] h-[80vh] orange-glow-radial pointer-events-none z-0"></div>
    <div class="absolute top-[120vh] right-[10%] w-[80vw] h-[80vh] orange-glow-radial pointer-events-none z-0"></div>

    <!-- Sticky 3D WebGL Canvas Layer -->
    <div class="sticky top-0 left-0 w-full h-screen overflow-hidden z-10 pointer-events-none">
        <canvas id="hero-3d-canvas" class="absolute inset-0 w-full h-full pointer-events-auto"></canvas>
        
        <!-- Interactive Mouse Follow Spotlight Glow -->
        <div class="absolute inset-0 pointer-events-none z-20 mix-blend-screen bg-[radial-gradient(circle_300px_at_var(--mouse-x,_50%)_var(--mouse-y,_50%),_rgba(255,92,0,0.15),_transparent_80%)]"></div>
        
        <!-- Technical Specification Hotspot Callouts (Connected to 3D coordinates via GSAP) -->
        <div class="absolute top-1/2 left-[20%] -translate-y-1/2 z-30 pointer-events-none opacity-0" id="hotspot-casing">
            <div class="flex items-center gap-3">
                <div class="specs-dot"></div>
                <div class="h-[1px] w-24 bg-gradient-to-r from-brand-orange to-transparent"></div>
                <div class="bg-brand-black/90 backdrop-blur-md border border-brand-orange/30 p-4 text-left max-w-xs">
                    <span class="text-brand-orange font-syne font-bold text-xs tracking-wider uppercase">Titanium Casing</span>
                    <p class="text-zinc-400 text-xs mt-1">Die-cast magnesium housing for extreme thermal control and structural integrity.</p>
                </div>
            </div>
        </div>

        <div class="absolute top-[25%] right-[20%] z-30 pointer-events-none opacity-0" id="hotspot-motor">
            <div class="flex items-center gap-3 flex-row-reverse">
                <div class="specs-dot"></div>
                <div class="h-[1px] w-24 bg-gradient-to-l from-brand-orange to-transparent"></div>
                <div class="bg-brand-black/90 backdrop-blur-md border border-brand-orange/30 p-4 text-left max-w-xs">
                    <span class="text-brand-orange font-syne font-bold text-xs tracking-wider uppercase">Brushless Stator</span>
                    <p class="text-zinc-400 text-xs mt-1">High-output brushless copper core delivering 2,200W of uninterrupted impact power.</p>
                </div>
            </div>
        </div>

        <div class="absolute bottom-[25%] left-[25%] z-30 pointer-events-none opacity-0" id="hotspot-gears">
            <div class="flex items-center gap-3">
                <div class="specs-dot"></div>
                <div class="h-[1px] w-24 bg-gradient-to-r from-brand-orange to-transparent"></div>
                <div class="bg-brand-black/90 backdrop-blur-md border border-brand-orange/30 p-4 text-left max-w-xs">
                    <span class="text-brand-orange font-syne font-bold text-xs tracking-wider uppercase">Planetary Gearbox</span>
                    <p class="text-zinc-400 text-xs mt-1">High-torque steel gearing with dual-clutch slips for heavy drilling torque loads.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Scrolling Text Overlay Content -->
    <!-- Screen 1: Cinematic Intro Title -->
    <div class="relative w-full h-screen flex flex-col justify-between items-center text-center px-4 py-16 z-20" id="stage-intro">
        <div>
            <span class="text-zinc-500 font-syne font-bold text-xs tracking-widest uppercase mb-4 block" id="intro-badge">VMR ENGINEERING LABS</span>
            <h1 class="text-5xl md:text-8xl lg:text-[10rem] font-syne font-extrabold uppercase leading-none tracking-luxury" id="intro-title">
                FORCE OF<br><span class="text-brand-orange orange-glow-sm">PRECISION</span>
            </h1>
        </div>
        <div class="flex flex-col items-center gap-4 animate-bounce">
            <span class="text-zinc-600 font-syne text-[10px] tracking-widest uppercase">Scroll to Ignite</span>
            <i class="fa-solid fa-chevron-down text-brand-orange text-sm"></i>
        </div>
    </div>

    <!-- Screen 2: Exploded view details trigger -->
    <div class="relative w-full h-screen flex items-center justify-between px-8 md:px-24 z-20 pointer-events-none" id="stage-details">
        <div class="max-w-md pointer-events-auto">
            <span class="text-brand-orange font-syne font-extrabold text-xs tracking-widest uppercase block mb-3">INTERNAL CORE SYNC</span>
            <h2 class="text-4xl md:text-6xl font-syne font-extrabold uppercase leading-tight mb-4 text-white">
                EXPLODED<br>ENGINEERING
            </h2>
            <p class="text-zinc-400 font-inter text-sm leading-relaxed mb-6">
                See the mechanical anatomy behind VMR's demolition line. Each component is machined from forged alloy and calibrated for extreme durability.
            </p>
            <div class="flex gap-4">
                <a href="#featured-showcase" class="btn-magnetic px-6 py-3 bg-white hover:bg-zinc-200 text-brand-black font-syne font-bold text-xs uppercase tracking-widest transition-colors duration-300">Explore Internals</a>
            </div>
        </div>
        <div class="hidden lg:flex flex-col gap-6 text-right max-w-xs font-syne text-xs uppercase tracking-widest text-zinc-500">
            <div>
                <span class="text-brand-orange font-bold">STAGE 01</span>
                <p class="text-[10px] mt-1 text-zinc-400">CHASSIS SPLIT</p>
            </div>
            <div>
                <span class="text-white">STAGE 02</span>
                <p class="text-[10px] mt-1">MOTOR SHIFT</p>
            </div>
            <div>
                <span class="text-white">STAGE 03</span>
                <p class="text-[10px] mt-1">GEAR EXTRACTION</p>
            </div>
        </div>
    </div>

    <!-- Screen 3: Performance statistics and Assembly -->
    <div class="relative w-full h-screen flex flex-col justify-center items-center text-center px-4 z-20" id="stage-performance">
        <div class="max-w-4xl">
            <span class="text-brand-orange font-syne font-extrabold text-xs tracking-widest uppercase block mb-4">ENGINE PERFORMANCE</span>
            <h2 class="text-4xl md:text-7xl font-syne font-extrabold uppercase leading-tight mb-12 text-white">
                POWER THAT DOMINATES
            </h2>
            
            <div class="grid grid-cols-1 md:grid-cols-3 gap-12 max-w-3xl mx-auto">
                <div class="flex flex-col items-center">
                    <span class="text-6xl md:text-8xl font-syne font-extrabold text-white leading-none font-montserrat">75<span class="text-brand-orange text-3xl md:text-5xl align-top">J</span></span>
                    <span class="text-zinc-500 text-xs font-bold uppercase tracking-widest mt-2">Impact Energy</span>
                </div>
                <div class="flex flex-col items-center border-y md:border-y-0 md:border-x border-white/5 py-8 md:py-0">
                    <span class="text-6xl md:text-8xl font-syne font-extrabold text-white leading-none font-montserrat">2.2<span class="text-brand-orange text-3xl md:text-5xl align-top">kW</span></span>
                    <span class="text-zinc-500 text-xs font-bold uppercase tracking-widest mt-2">Brushless Motor</span>
                </div>
                <div class="flex flex-col items-center">
                    <span class="text-6xl md:text-8xl font-syne font-extrabold text-white leading-none font-montserrat">8.2<span class="text-brand-orange text-3xl md:text-5xl align-top">m/s²</span></span>
                    <span class="text-zinc-500 text-xs font-bold uppercase tracking-widest mt-2">Vibration Control</span>
                </div>
            </div>

            <div class="mt-16 flex gap-6 justify-center">
                <a asp-controller="Product" asp-action="Index" class="btn-magnetic px-8 py-4 bg-brand-orange text-white font-syne font-extrabold text-xs uppercase tracking-widest shadow-[0_0_20px_rgba(255,92,0,0.4)] hover:bg-brand-orange/95">Order VMR Pro Series</a>
                <a asp-controller="Home" asp-action="Contact" class="btn-magnetic px-8 py-4 border border-zinc-700 hover:border-white text-white font-syne font-bold text-xs uppercase tracking-widest transition-colors duration-300">Request Live Demo</a>
            </div>
        </div>
    </div>
</section>

<!-- Three.js Cinematic Scene and GSAP ScrollTrigger Script -->
<script>
document.addEventListener("DOMContentLoaded", function () {
    const canvas = document.getElementById("hero-3d-canvas");
    if (!canvas) return;

    // 1. Mouse Follow Glow coordinate setup
    document.addEventListener("mousemove", (e) => {
        const x = (e.clientX / window.innerWidth) * 100;
        const y = (e.clientY / window.innerHeight) * 100;
        document.documentElement.style.setProperty('--mouse-x', `${x}%`);
        document.documentElement.style.setProperty('--mouse-y', `${y}%`);
    });

    // 2. Setup Three.js scene
    const renderer = new THREE.WebGLRenderer({ canvas: canvas, antialias: true, alpha: true });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.setSize(canvas.clientWidth, canvas.clientHeight);
    renderer.shadowMap.enabled = true;
    
    const scene = new THREE.Scene();
    
    // Camera
    const camera = new THREE.PerspectiveCamera(45, canvas.clientWidth / canvas.clientHeight, 0.1, 100);
    camera.position.set(0, 0, 18);
    
    // Volumetric particles (Floating Dust)
    const particleGeo = new THREE.BufferGeometry();
    const particleCount = 400;
    const posArray = new Float32Array(particleCount * 3);
    for(let i = 0; i < particleCount * 3; i++) {
        posArray[i] = (Math.random() - 0.5) * 30;
    }
    particleGeo.setAttribute('position', new THREE.BufferAttribute(posArray, 3));
    
    const particleMat = new THREE.PointsMaterial({
        size: 0.05,
        color: 0xFF5C00,
        transparent: true,
        opacity: 0.5,
        blending: THREE.AdditiveBlending
    });
    const dustParticles = new THREE.Points(particleGeo, particleMat);
    scene.add(dustParticles);

    // Light setups
    const ambientLight = new THREE.AmbientLight(0xffffff, 0.15);
    scene.add(ambientLight);

    const dirLight = new THREE.DirectionalLight(0xffffff, 1.5);
    dirLight.position.set(5, 10, 7);
    scene.add(dirLight);

    // Premium glowing orange backlight
    const orangeSpot = new THREE.SpotLight(0xFF5C00, 8, 30, Math.PI / 4, 0.5, 1);
    orangeSpot.position.set(-8, 5, -5);
    scene.add(orangeSpot);

    // Mouse interactive point light
    const mouseLight = new THREE.PointLight(0xFF5C00, 3, 15);
    mouseLight.position.set(0, 0, 5);
    scene.add(mouseLight);

    // Procedural Industrial Tool Model (VMR Demolition Hammer)
    const toolGroup = new THREE.Group();
    scene.add(toolGroup);

    // Sub-components for exploded views
    const chassisLeft = new THREE.Group();
    const chassisRight = new THREE.Group();
    const motorGroup = new THREE.Group();
    const gearGroup = new THREE.Group();
    const drillBitGroup = new THREE.Group();
    const batteryGroup = new THREE.Group();

    toolGroup.add(chassisLeft);
    toolGroup.add(chassisRight);
    toolGroup.add(motorGroup);
    toolGroup.add(gearGroup);
    toolGroup.add(drillBitGroup);
    toolGroup.add(batteryGroup);

    // Materials
    const metalMaterial = new THREE.MeshStandardMaterial({
        color: 0x1f1f23,
        metalness: 0.9,
        roughness: 0.15,
        envMapIntensity: 1.0
    });
    
    const orangeAlloyMat = new THREE.MeshStandardMaterial({
        color: 0xFF5C00,
        metalness: 0.7,
        roughness: 0.2
    });

    const steelMaterial = new THREE.MeshStandardMaterial({
        color: 0x8e8e93,
        metalness: 0.95,
        roughness: 0.1
    });

    const copperWireMat = new THREE.MeshStandardMaterial({
        color: 0xd97706,
        metalness: 0.8,
        roughness: 0.3
    });

    const glowMaterial = new THREE.MeshBasicMaterial({
        color: 0xFF5C00,
        transparent: true,
        opacity: 0.8
    });

    // 1. Drill Chuck & Bit (Drill bit Group)
    const chuckGeo = new THREE.CylinderGeometry(0.8, 0.9, 2.0, 16);
    const chuck = new THREE.Mesh(chuckGeo, steelMaterial);
    chuck.rotation.x = Math.PI / 2;
    chuck.position.z = 3.5;
    drillBitGroup.add(chuck);

    const bitGeo = new THREE.CylinderGeometry(0.3, 0.3, 4.5, 8);
    const bit = new THREE.Mesh(bitGeo, steelMaterial);
    bit.rotation.x = Math.PI / 2;
    bit.position.z = 6.25;
    drillBitGroup.add(bit);

    // Spiral flutes on drill bit
    for (let i = 0; i < 20; i++) {
        const fluteGeo = new THREE.BoxGeometry(0.45, 0.15, 0.45);
        const flute = new THREE.Mesh(fluteGeo, steelMaterial);
        flute.position.set(0, 0, 4.5 + (i * 0.18));
        flute.rotation.z = i * 0.6;
        drillBitGroup.add(flute);
    }

    // 2. Chassis Left & Right (Splits along X-axis)
    const bodyGeoLeft = new THREE.CylinderGeometry(1.2, 1.2, 5.0, 16, 1, false, 0, Math.PI);
    const bodyLeft = new THREE.Mesh(bodyGeoLeft, metalMaterial);
    bodyLeft.rotation.x = Math.PI / 2;
    bodyLeft.position.x = -0.05;
    chassisLeft.add(bodyLeft);

    const handleLeftGeo = new THREE.BoxGeometry(0.4, 3.5, 0.8);
    const handleLeft = new THREE.Mesh(handleLeftGeo, metalMaterial);
    handleLeft.position.set(-1.8, -1.8, -1.5);
    handleLeft.rotation.z = 0.2;
    chassisLeft.add(handleLeft);

    const bodyGeoRight = new THREE.CylinderGeometry(1.2, 1.2, 5.0, 16, 1, false, Math.PI, Math.PI);
    const bodyRight = new THREE.Mesh(bodyGeoRight, orangeAlloyMat);
    bodyRight.rotation.x = Math.PI / 2;
    bodyRight.position.x = 0.05;
    chassisRight.add(bodyRight);

    // 3. Motor Core (Slides along -Z axis)
    const statorGeo = new THREE.CylinderGeometry(1.0, 1.0, 2.5, 12);
    const stator = new THREE.Mesh(statorGeo, metalMaterial);
    stator.rotation.x = Math.PI / 2;
    stator.position.z = -0.5;
    motorGroup.add(stator);

    // Glowing copper coils inside stator
    for (let i = 0; i < 8; i++) {
        const coilGeo = new THREE.TorusGeometry(0.85, 0.06, 8, 16);
        const coil = new THREE.Mesh(coilGeo, copperWireMat);
        coil.position.z = -1.2 + (i * 0.22);
        coil.rotation.x = Math.PI / 2;
        motorGroup.add(coil);
    }

    // 4. Gear Assembly (Slides along +Z axis)
    const gearCenterGeo = new THREE.CylinderGeometry(0.9, 0.9, 1.2, 16);
    const gearCenter = new THREE.Mesh(gearCenterGeo, steelMaterial);
    gearCenter.rotation.x = Math.PI / 2;
    gearCenter.position.z = 1.6;
    gearGroup.add(gearCenter);

    for (let i = 0; i < 12; i++) {
        const toothGeo = new THREE.BoxGeometry(0.2, 0.2, 1.1);
        const tooth = new THREE.Mesh(toothGeo, steelMaterial);
        tooth.position.set(Math.sin(i * 0.52) * 1.0, Math.cos(i * 0.52) * 1.0, 1.6);
        tooth.rotation.z = -i * 0.52;
        gearGroup.add(tooth);
    }

    // 5. Battery Pack (Slides down along -Y axis)
    const batteryBaseGeo = new THREE.BoxGeometry(1.6, 1.2, 2.6);
    const batteryBase = new THREE.Mesh(batteryBaseGeo, metalMaterial);
    batteryBase.position.set(0, -3.2, -1.8);
    batteryGroup.add(batteryBase);

    const batteryIndicator = new THREE.Mesh(new THREE.BoxGeometry(0.8, 0.1, 0.2), glowMaterial);
    batteryIndicator.position.set(0, -3.2, -0.4);
    batteryGroup.add(batteryIndicator);

    // Center pivot adjust
    toolGroup.position.set(0, 0.5, 0);
    toolGroup.rotation.y = -Math.PI / 6;
    toolGroup.rotation.x = Math.PI / 12;

    // 3. Coordinate mapping helper
    function getCanvasCoordinates(obj) {
        const vector = new THREE.Vector3();
        obj.getWorldPosition(vector);
        vector.project(camera);
        
        const x = (vector.x *  .5 + .5) * canvas.clientWidth;
        const y = (vector.y * -.5 + .5) * canvas.clientHeight;
        return { x, y };
    }

    // 4. Screen Resize management
    window.addEventListener("resize", onWindowResize);
    function onWindowResize() {
        camera.aspect = canvas.clientWidth / canvas.clientHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(canvas.clientWidth, canvas.clientHeight);
    }

    // 5. Animation loop (60fps requestAnimationFrame)
    let time = 0;
    function animate() {
        requestAnimationFrame(animate);
        time += 0.01;

        // Slow automatic spin during idling
        if (!gsap.isTweening(toolGroup.rotation)) {
            toolGroup.rotation.y = -Math.PI/6 + Math.sin(time * 0.3) * 0.15;
            dustParticles.rotation.y = time * 0.02;
        }

        // Spin chuck/bit while it is assembled
        drillBitGroup.rotation.z += 0.05;

        // Mouse light coordinate update
        if (mouseLight) {
            const tempX = (mouseX / window.innerWidth - 0.5) * 16;
            const tempY = -(mouseY / window.innerHeight - 0.5) * 10;
            mouseLight.position.x += (tempX - mouseLight.position.x) * 0.1;
            mouseLight.position.y += (tempY - mouseLight.position.y) * 0.1;
        }

        // Render scene
        renderer.render(scene, camera);
        
        // Dynamic Hotspot Line coordinates follow-up
        updateHotspotLines();
    }
    
    // Mouse coords trackers
    let mouseX = 0, mouseY = 0;
    document.addEventListener("mousemove", (e) => {
        mouseX = e.clientX;
        mouseY = e.clientY;
    });

    function updateHotspotLines() {
        const hotspots = [
            { id: "hotspot-casing", group: chassisRight },
            { id: "hotspot-motor", group: motorGroup },
            { id: "hotspot-gears", group: gearGroup }
        ];

        hotspots.forEach(h => {
            const el = document.getElementById(h.id);
            if (el && el.style.opacity > 0) {
                const coords = getCanvasCoordinates(h.group);
                // Adjust position on overlay screen
                el.style.left = `${coords.x}px`;
                el.style.top = `${coords.y}px`;
            }
        });
    }

    // Begin render loop
    animate();

    // 6. GSAP ScrollTrigger Sequence Timeline
    const tl = gsap.timeline({
        scrollTrigger: {
            trigger: "#story-section",
            start: "top top",
            end: "bottom bottom",
            scrub: 1.2,
        }
    });

    // Page 1 -> Page 2: Explode tool
    tl.to(chassisLeft.position, { x: -3.8, duration: 1.5, ease: "power2.out" }, 0)
      .to(chassisRight.position, { x: 3.8, duration: 1.5, ease: "power2.out" }, 0)
      .to(motorGroup.position, { z: -3.2, y: 1.2, duration: 1.5, ease: "power2.out" }, 0)
      .to(gearGroup.position, { z: 1.8, y: -1.2, duration: 1.5, ease: "power2.out" }, 0)
      .to(batteryGroup.position, { y: -2.8, z: -1.5, duration: 1.5, ease: "power2.out" }, 0)
      .to(drillBitGroup.position, { z: 3.5, duration: 1.5, ease: "power2.out" }, 0)
      .to(toolGroup.rotation, { y: Math.PI / 3, x: Math.PI / 8, duration: 1.5 }, 0)
      .to(camera.position, { z: 14, duration: 1.5 }, 0)
      
      // Reveal technical specifications overlays
      .to("#hotspot-casing", { opacity: 1, duration: 0.3 }, 0.8)
      .to("#hotspot-motor", { opacity: 1, duration: 0.3 }, 0.9)
      .to("#hotspot-gears", { opacity: 1, duration: 0.3 }, 1.0)
      
      // Page 2 -> Page 3: Reassemble into stats layout
      .to(chassisLeft.position, { x: 0, duration: 1.5, ease: "power3.inOut" }, 1.5)
      .to(chassisRight.position, { x: 0, duration: 1.5, ease: "power3.inOut" }, 1.5)
      .to(motorGroup.position, { z: 0, y: 0, duration: 1.5, ease: "power3.inOut" }, 1.5)
      .to(gearGroup.position, { z: 0, y: 0, duration: 1.5, ease: "power3.inOut" }, 1.5)
      .to(batteryGroup.position, { y: 0, z: 0, duration: 1.5, ease: "power3.inOut" }, 1.5)
      .to(drillBitGroup.position, { z: 0, duration: 1.5, ease: "power3.inOut" }, 1.5)
      
      .to("#hotspot-casing", { opacity: 0, duration: 0.3 }, 1.5)
      .to("#hotspot-motor", { opacity: 0, duration: 0.3 }, 1.5)
      .to("#hotspot-gears", { opacity: 0, duration: 0.3 }, 1.5)
      
      .to(toolGroup.rotation, { y: -Math.PI / 4, x: -Math.PI / 18, duration: 1.5 }, 1.5)
      .to(camera.position, { z: 11, x: -1.5, duration: 1.5 }, 1.5);
});
</script>
