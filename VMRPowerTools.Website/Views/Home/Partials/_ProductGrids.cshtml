@inject IProductService ProductService
@{
    var activeProducts = await ProductService.GetFeaturedProductsAsync(8);
    var featured = activeProducts.Take(4);
    var latest = activeProducts.Skip(4).Take(4);
}

<!-- Featured Products Section (Luxury Award-Winning Industrial Layout) -->
<section class="py-24 bg-brand-black border-t border-white/5 no-print" id="featured-showcase">
    <div class="container mx-auto px-4 md:px-8 max-w-7xl">
        <div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-6 mb-16">
            <div>
                <span class="text-brand-orange font-syne font-extrabold text-xs tracking-widest uppercase block mb-3">HEAVY INDUSTRY SPECIFICATIONS</span>
                <h2 class="text-4xl md:text-6xl font-syne font-extrabold uppercase leading-none text-white tracking-luxury">
                    FEATURED<br><span class="text-zinc-600">MACHINERY</span>
                </h2>
            </div>
            <a asp-controller="Product" asp-action="Index" class="btn-magnetic px-6 py-3 border border-zinc-700 hover:border-brand-orange text-white font-syne font-bold text-xs uppercase tracking-widest transition-colors duration-300 rounded-xl">
                Browse Full Catalog
            </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
            @if (featured != null && featured.Any())
            {
                foreach (var product in featured)
                {
                    var pImg = !string.IsNullOrEmpty(product.ImagePath) ? product.ImagePath : "https://images.unsplash.com/photo-1504917595217-d4dc5ebe6122?auto=format&fit=crop&q=80&w=400";
                    <div class="industrial-card flex flex-col h-full group transition-all duration-500 hover:-translate-y-2 hover:rotate-[1deg] hover:shadow-[0_20px_40px_rgba(0,0,0,0.8),0_0_25px_rgba(255,92,0,0.15)]">
                        <!-- Image wrapper with scale effect and hover overlay actions -->
                        <div class="relative w-full h-64 bg-zinc-950/60 border-b border-white/5 flex items-center justify-center p-6 overflow-hidden">
                            @if (product.CurrentStock > 0)
                            {
                                <span class="absolute top-4 left-4 bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 font-syne text-[9px] tracking-wider uppercase px-2.5 py-1 z-10 rounded-full">IN STOCK</span>
                            }
                            else
                            {
                                <span class="absolute top-4 left-4 bg-red-500/10 border border-red-500/20 text-red-400 font-syne text-[9px] tracking-wider uppercase px-2.5 py-1 z-10 rounded-full">OUT OF STOCK</span>
                            }

                            <img src="@pImg" alt="@product.ProductName" class="max-h-full max-w-full object-contain filter drop-shadow-lg group-hover:scale-110 transition-transform duration-700 ease-out" loading="lazy">

                            <!-- Hover Overlay Action Triggers (Quick View, Wishlist, Compare) -->
                            <div class="absolute inset-0 bg-black/70 backdrop-blur-sm opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center gap-3 z-20">
                                <a asp-controller="Product" asp-action="Details" asp-route-id="@product.Id" class="quick-action-btn" title="Quick View">
                                    <i class="fa-solid fa-eye"></i>
                                </a>
                                <button onclick="alert('@product.ProductName added to compare')" class="quick-action-btn" title="Compare">
                                    <i class="fa-solid fa-code-compare"></i>
                                </button>
                                <button onclick="alert('@product.ProductName saved to wishlist')" class="quick-action-btn" title="Wishlist">
                                    <i class="fa-regular fa-heart"></i>
                                </button>
                            </div>
                        </div>

                        <!-- Card details -->
                        <div class="p-6 flex flex-col flex-grow">
                            <div class="flex justify-between items-center gap-2 mb-2">
                                <span class="text-brand-orange font-syne font-bold text-[9px] tracking-wider uppercase">@(product.Category?.CategoryName ?? "INDUSTRIAL")</span>
                                @if (product.Brand != null)
                                {
                                    <span class="text-zinc-400 font-syne text-[9px] tracking-wider uppercase border border-zinc-800 px-2 py-0.5 rounded">@product.Brand.BrandName</span>
                                }
                            </div>
                            
                            <h3 class="text-white font-syne font-bold text-base mb-1 group-hover:text-brand-orange transition-colors duration-300 line-clamp-1">@product.ProductName</h3>
                            <span class="text-brand-orange font-syne font-extrabold text-xl mb-4 block">₹@product.SalesPrice.ToString("N0")</span>

                            <!-- Buttons -->
                            <div class="grid grid-cols-2 gap-2 mt-auto">
                                <a asp-controller="Product" asp-action="Details" asp-route-id="@product.Id" class="py-2.5 bg-zinc-900 border border-zinc-800 hover:border-brand-orange text-center text-white font-syne text-[10px] font-bold uppercase tracking-widest rounded-lg transition-colors">DETAILS</a>
                                <button onclick="addToCart(event, @product.Id)" class="py-2.5 bg-brand-orange hover:bg-orange-600 text-center text-white font-syne text-[10px] font-extrabold uppercase tracking-widest rounded-lg transition-colors flex items-center justify-center gap-1.5 shadow-md">
                                    <i class="fa-solid fa-cart-shopping text-xs"></i> ADD
                                </button>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</section>

