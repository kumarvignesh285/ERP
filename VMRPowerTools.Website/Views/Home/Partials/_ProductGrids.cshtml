@inject IProductService ProductService
@{
    var activeProducts = await ProductService.GetFeaturedProductsAsync(8);
    var featured = activeProducts.Take(4);
    var latest = activeProducts.Skip(4).Take(4);
}

<!-- Featured Products Section -->
<section class="py-24 bg-brand-black border-t border-white/5 no-print" id="featured-showcase">
    <div class="container mx-auto px-4 md:px-8 max-w-7xl">
        <div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-6 mb-16">
            <div>
                <span class="text-brand-orange font-syne font-extrabold text-xs tracking-widest uppercase block mb-3">HEAVY INDUSTRY SPECIFICATIONS</span>
                <h2 class="text-4xl md:text-6xl font-syne font-extrabold uppercase leading-none text-white tracking-luxury">
                    FEATURED<br><span class="text-zinc-600">MACHINERY</span>
                </h2>
            </div>
            <a asp-controller="Product" asp-action="Index" class="btn-magnetic px-6 py-3 border border-zinc-700 hover:border-white text-white font-syne font-bold text-xs uppercase tracking-widest transition-colors duration-300">
                Browse Full Catalog
            </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
            @if (featured != null && featured.Any())
            {
                foreach (var product in featured)
                {
                    <div class="luxury-card flex flex-col h-full group">
                        <!-- Image wrapper with scale effect and badge -->
                        <div class="relative w-full h-64 bg-zinc-950/40 border-b border-white/5 flex items-center justify-center p-6 overflow-hidden">
                            @if (product.CurrentStock > 0)
                            {
                                <span class="absolute top-4 left-4 bg-green-500/10 border border-green-500/20 text-green-400 font-syne text-[9px] tracking-wider uppercase px-2.5 py-1 z-10">IN STOCK</span>
                            }
                            else
                            {
                                <span class="absolute top-4 left-4 bg-red-500/10 border border-red-500/20 text-red-400 font-syne text-[9px] tracking-wider uppercase px-2.5 py-1 z-10">OUT OF STOCK</span>
                            }
                            
                            @if (!string.IsNullOrEmpty(product.ImagePath))
                            {
                                <img src="@product.ImagePath" alt="@product.ProductName" class="max-h-full max-w-full object-contain filter brightness-95 group-hover:scale-105 transition-transform duration-750 ease-out" loading="lazy">
                            }
                            else
                            {
                                <i class="fa-solid fa-toolbox text-zinc-700 text-5xl"></i>
                            }
                        </div>

                        <!-- Card details -->
                        <div class="p-6 flex flex-col flex-grow">
                            <div class="flex justify-between items-center gap-2 mb-3">
                                <span class="text-brand-orange font-syne font-bold text-[9px] tracking-wider uppercase">@(product.Category?.CategoryName ?? "EQUIPMENT")</span>
                                @if (product.Brand != null)
                                {
                                    <span class="text-zinc-500 font-syne text-[9px] tracking-wider uppercase border border-zinc-800 px-2 py-0.5">@product.Brand.BrandName</span>
                                }
                            </div>
                            
                            <h3 class="text-white font-syne font-bold text-base mb-2 group-hover:text-brand-orange transition-colors duration-300 line-clamp-1">@product.ProductName</h3>
                            <p class="text-zinc-500 font-inter text-xs leading-relaxed mb-6 line-clamp-2">@product.Description</p>

                            <!-- Key Specs -->
                            <ul class="border-t border-white/5 pt-4 flex flex-col gap-2 mb-6 font-inter text-[10px] text-zinc-400">
                                <li class="flex items-center gap-2"><i class="fa-solid fa-circle-check text-brand-orange"></i> High Endurance Duty Cycle</li>
                                <li class="flex items-center gap-2"><i class="fa-solid fa-circle-check text-brand-orange"></i> Live Sync Calibration</li>
                            </ul>

                            <!-- Bottom Price & Cart Action -->
                            <div class="mt-auto border-t border-white/5 pt-4 flex items-center justify-between">
                                <span class="text-white font-syne font-extrabold text-lg">₹@product.SalesPrice.ToString("N0")</span>
                                <button onclick="addToCart(event, @product.Id)" class="w-10 h-10 border border-white/10 rounded-full hover:border-brand-orange hover:bg-brand-orange/5 text-white hover:text-brand-orange flex items-center justify-center transition-colors duration-300" title="Add to Cart">
                                    <i class="fa-solid fa-cart-plus text-sm"></i>
                                </button>
                            </div>

                            <!-- Buttons -->
                            <div class="grid grid-cols-2 gap-3 mt-4">
                                <a asp-controller="Product" asp-action="Details" asp-route-id="@product.Id" class="py-2.5 bg-zinc-900 border border-zinc-800 hover:border-zinc-500 text-center text-white font-syne text-[10px] font-bold uppercase tracking-widest transition-colors duration-300">DETAILS</a>
                                <a asp-controller="Home" asp-action="Contact" asp-route-message="Hi, I am interested in @product.ProductName (Code: @product.ProductCode). Please send a quote." class="py-2.5 bg-brand-orange text-center text-white font-syne text-[10px] font-extrabold uppercase tracking-widest transition-colors duration-300">QUOTE</a>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</section>

