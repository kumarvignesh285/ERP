@{
    ViewData["Title"] = "Contact Support Desk";
    var queryMessage = Context.Request.Query["message"].ToString();
}

<!-- Premium Header Section -->
<section class="py-5 text-white border-bottom bg-industrial-dark animate-fade-up">
    <div class="container py-3">
        <span class="badge bg-primary px-3.5 py-2 mb-3 text-uppercase font-weight-bold" style="border-radius: 50px; font-size: 0.75rem;">Inquiry & Support Desk</span>
        <h1 class="display-5 font-weight-extrabold text-white">Contact VMR Support</h1>
        <p class="text-light mb-0 opacity-75 fs-6" style="max-width: 700px;">Submit wholesale quotation inquiries, reach our Chennai sales desk, or request technical support.</p>
    </div>
</section>

<!-- Content Section -->
<section class="py-5 bg-light">
    <div class="container py-2">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success border-0 mb-4 p-4 shadow-sm" style="border-radius: 16px; background-color: #d1e7dd; color: #0f5132;">
                <div class="d-flex align-items-center gap-3">
                    <i class="fa-solid fa-circle-check fs-4 text-success"></i>
                    <span class="font-weight-semibold">@TempData["Success"]</span>
                </div>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger border-0 mb-4 p-4 shadow-sm" style="border-radius: 16px; background-color: #f8d7da; color: #842029;">
                <div class="d-flex align-items-center gap-3">
                    <i class="fa-solid fa-triangle-exclamation fs-4 text-danger"></i>
                    <span class="font-weight-semibold">@TempData["Error"]</span>
                </div>
            </div>
        }

        <div class="row g-5">
            <!-- Left: Contact Details Cards -->
            <div class="col-lg-5 animate-fade-right">
                <div class="card border-0 shadow-sm p-4 bg-white h-100" style="border-radius: 24px; border: 1px solid var(--grey-border) !important;">
                    <h4 class="font-weight-bold mb-3 text-dark">Support Channels</h4>
                    <p class="text-muted fs-8 mb-4">Reach out via any of our communications lines below. For urgent dispatches, please call our hotline directly.</p>
                    
                    <div class="d-flex gap-3 align-items-start mb-4">
                        <div class="bg-primary-subtle text-primary rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 54px; height: 54px; background-color: rgba(255, 107, 0, 0.1); flex-shrink: 0;">
                            <i class="fa-solid fa-location-dot fs-5"></i>
                        </div>
                        <div>
                            <h6 class="font-weight-bold mb-1 text-dark">Corporate Headquarters</h6>
                            <p class="text-muted fs-8 mb-0" style="line-height: 1.5;">
                                Guindy Industrial Estate,<br>
                                Chennai, Tamil Nadu - 600032
                            </p>
                        </div>
                    </div>

                    <div class="d-flex gap-3 align-items-start mb-4">
                        <div class="bg-primary-subtle text-primary rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 54px; height: 54px; background-color: rgba(255, 107, 0, 0.1); flex-shrink: 0;">
                            <i class="fa-solid fa-phone fs-5"></i>
                        </div>
                        <div>
                            <h6 class="font-weight-bold mb-1 text-dark">Call Sales Desk</h6>
                            <p class="text-muted fs-8 mb-0" style="line-height: 1.5;">
                                <a href="tel:+914498765432" class="text-decoration-none text-muted">+91 (44) 9876 5432</a><br>
                                <a href="tel:+919876543210" class="text-decoration-none text-muted">+91 98765 43210</a>
                            </p>
                        </div>
                    </div>

                    <div class="d-flex gap-3 align-items-start mb-4">
                        <div class="bg-primary-subtle text-primary rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 54px; height: 54px; background-color: rgba(255, 107, 0, 0.1); flex-shrink: 0;">
                            <i class="fa-solid fa-envelope fs-5"></i>
                        </div>
                        <div>
                            <h6 class="font-weight-bold mb-1 text-dark">Email Inquiries</h6>
                            <p class="text-muted fs-8 mb-0" style="line-height: 1.5;">
                                <a href="mailto:sales@@vmrpowertools.com" class="text-decoration-none text-muted">sales@@vmrpowertools.com</a><br>
                                <a href="mailto:support@@vmrpowertools.com" class="text-decoration-none text-muted">support@@vmrpowertools.com</a>
                            </p>
                        </div>
                    </div>

                    <div class="d-flex gap-3 align-items-start mb-0">
                        <div class="bg-success-subtle text-success rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 54px; height: 54px; background-color: rgba(37, 211, 102, 0.1); flex-shrink: 0;">
                            <i class="fa-brands fa-whatsapp fs-4" style="color: #25D366;"></i>
                        </div>
                        <div>
                            <h6 class="font-weight-bold mb-1 text-dark">Instant WhatsApp Help</h6>
                            <p class="text-muted fs-8 mb-2">Directly sync with our technical sales engineers for price quotes.</p>
                            <a href="https://wa.me/919876543210" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-success py-2 px-3 text-white fs-8"><i class="fa-solid fa-comments me-1"></i> Chat on WhatsApp</a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right: Contact Form -->
            <div class="col-lg-7 animate-fade-left">
                <div class="card border-0 shadow-sm p-4 p-md-5 bg-white" style="border-radius: 24px; border: 1px solid var(--grey-border) !important;">
                    <h4 class="font-weight-bold mb-4 text-dark">Send a Message</h4>
                    <form asp-action="SubmitInquiry" method="post" class="fs-7">
                        @Html.AntiForgeryToken()
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label font-weight-semibold text-dark">Full Name <span class="text-danger">*</span></label>
                                <input type="text" name="name" class="form-control py-2" required placeholder="John Doe">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label font-weight-semibold text-dark">Company Name (Optional)</label>
                                <input type="text" name="companyName" class="form-control py-2" placeholder="VMR Engineering Ltd.">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label font-weight-semibold text-dark">Email Address <span class="text-danger">*</span></label>
                                <input type="email" name="email" class="form-control py-2" required placeholder="name@@example.com">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label font-weight-semibold text-dark">Phone Number</label>
                                <input type="tel" name="phone" class="form-control py-2" placeholder="+91 XXXXX XXXXX">
                            </div>
                            <div class="col-12">
                                <label class="form-label font-weight-semibold text-dark">Inquiry Details <span class="text-danger">*</span></label>
                                <textarea name="message" class="form-control" rows="5" required placeholder="Please outline the tool models, spares required, or warranty questions...">@queryMessage</textarea>
                            </div>
                        </div>
                        <button type="submit" class="btn btn-primary mt-4 py-2.5 px-4"><i class="fa-solid fa-paper-plane me-2"></i> Submit Inquiry</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Full-Width Map Section with Elegant Border -->
<section class="no-print bg-light border-top">
    <div class="w-100 animate-zoom" style="height: 400px; border-top: 1px solid var(--grey-border);">
        <iframe 
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3887.3503117498336!2d80.21099857507567!3d13.010531587303036!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3a52678c1873111f%3A0x6b445582736136e0!2sGuindy%20Industrial%20Estate%2C%20Chennai%2C%20Tamil%20Nadu!5e0!3m2!1sen!2sin!4v1726240000000!5m2!1sen!2sin" 
            width="100%" 
            height="100%" 
            style="border:0; filter: grayscale(15%) contrast(1.1);" 
            allowfullscreen="" 
            loading="lazy" 
            referrerpolicy="no-referrer-when-downgrade">
        </iframe>
    </div>
</section>
