@{
    ViewData["Title"] = "FAQ";
}

<section class="py-5 bg-white border-bottom">
    <div class="container">
        <h1>Frequently Asked Questions</h1>
        <p class="text-muted mb-0">Find quick technical and logistical answers regarding VMR spares calibration and dispatch methods.</p>
    </div>
</section>

<section class="py-5">
    <div class="container" style="max-width: 900px;">
        <div class="accordion" id="faqAccordion">
            <!-- FAQ 1 -->
            <div class="accordion-item border-light mb-3 shadow-sm rounded overflow-hidden">
                <h2 class="accordion-header" id="headingOne">
                    <button class="accordion-button font-weight-bold" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="true" aria-controls="collapseOne">
                        How does the website database sync with SmartERP?
                    </button>
                </h2>
                <div id="collapseOne" class="accordion-collapse collapse show" aria-labelledby="headingOne" data-bs-parent="#faqAccordion">
                    <div class="accordion-body text-muted fs-7">
                        VMR Power Tools website is connected to the core ERP billing SQL Server database tables (`Products`, `Categories`, `Brands`). Whenever stock increases inside the warehouse ledger or a checkout occurs, the counts are updated in real-time, preventing out-of-stock ordering.
                    </div>
                </div>
            </div>

            <!-- FAQ 2 -->
            <div class="accordion-item border-light mb-3 shadow-sm rounded overflow-hidden">
                <h2 class="accordion-header" id="headingTwo">
                    <button class="accordion-button collapsed font-weight-bold" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTwo" aria-expanded="false" aria-controls="collapseTwo">
                        Are custom spare components warrantied?
                    </button>
                </h2>
                <div id="collapseTwo" class="accordion-collapse collapse" aria-labelledby="headingTwo" data-bs-parent="#faqAccordion">
                    <div class="accordion-body text-muted fs-7">
                        Yes. All factory armatures, field coils, gear modules, carbon brushes, and carbon holders come with a 6-month authorized spare warranty, provided they are fitted by certified service hub technicians.
                    </div>
                </div>
            </div>

            <!-- FAQ 3 -->
            <div class="accordion-item border-light mb-3 shadow-sm rounded overflow-hidden">
                <h2 class="accordion-header" id="headingThree">
                    <button class="accordion-button collapsed font-weight-bold" type="button" data-bs-toggle="collapse" data-bs-target="#collapseThree" aria-expanded="false" aria-controls="collapseThree">
                        What are the available delivery modes inside Chennai?
                    </button>
                </h2>
                <div id="collapseThree" class="accordion-collapse collapse" aria-labelledby="headingThree" data-bs-parent="#faqAccordion">
                    <div class="accordion-body text-muted fs-7">
                        For Guindy local warehouse pickup, select "Warehouse Pickup" at checkout. Alternatively, select Cash on Delivery or Bank Transfer for standard dispatches. Local dispatches in Chennai are completed within 24 hours.
                    </div>
                </div>
            </div>

            <!-- FAQ 4 -->
            <div class="accordion-item border-light mb-0 shadow-sm rounded overflow-hidden">
                <h2 class="accordion-header" id="headingFour">
                    <button class="accordion-button collapsed font-weight-bold" type="button" data-bs-toggle="collapse" data-bs-target="#collapseFour" aria-expanded="false" aria-controls="collapseFour">
                        How can I request custom bulk wholesale quotations?
                    </button>
                </h2>
                <div id="collapseFour" class="accordion-collapse collapse" aria-labelledby="headingFour" data-bs-parent="#faqAccordion">
                    <div class="accordion-body text-muted fs-7">
                        If you are an authorized contractor ordering in bulk, click "Request Quote" on the product detail page, or navigate to our Contact Us page and fill in the form. Our sales desk will verify your details and insert a custom quote in the ERP backend.
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
