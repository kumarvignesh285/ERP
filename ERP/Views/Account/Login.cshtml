@model LoginViewModel
@using ERP.Data
@inject AppDbContext _context
@{
    Layout = null;
    ViewData["Title"] = "Log in";
    var company = _context.Companies.FirstOrDefault();
    var logoPath = company?.Logo;
    var companyName = company?.CompanyName ?? "SmartERP";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @companyName</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary: #2563eb;
            --primary-hover: #1d4ed8;
            --background: #f1f5f9;
            --card: #ffffff;
            --border: #e2e8f0;
            --text: #0f172a;
            --text-muted: #64748b;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', sans-serif;
            min-height: 100vh;
            background: radial-gradient(circle at 10% 20%, rgba(219, 234, 254, 0.6) 0%, rgba(241, 245, 249, 1) 90%);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1rem;
            color: var(--text);
        }

        .login-wrapper {
            width: min(100%, 1050px);
            margin: 1rem auto;
            display: flex;
            flex-direction: column;
            background: #ffffff;
            border-radius: 24px;
            overflow: hidden;
            box-shadow: 0 20px 50px rgba(15, 23, 42, 0.08);
            border: 1px solid var(--border);
        }

        @@media (min-width: 992px) {
            .login-wrapper {
                flex-direction: row;
            }
        }

        .login-info {
            flex: 1;
            background: linear-gradient(135deg, #1e293b 0%, #2563eb 100%);
            color: #ffffff;
            padding: 2rem 1.5rem;
            display: flex;
            flex-direction: column;
            justify-content: center;
            position: relative;
        }

        @@media (min-width: 768px) {
            .login-info {
                padding: 3rem 2.5rem;
            }
        }

        @@media (min-width: 992px) {
            .login-info {
                padding: 4rem 3.5rem;
            }
        }

        .brand-header {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 2rem;
        }

        .brand-logo-container {
            display: flex;
            align-items: center;
            justify-content: center;
            background: #ffffff;
            border-radius: 14px;
            padding: 8px;
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
            height: 48px;
            width: 48px;
            min-width: 48px;
            overflow: hidden;
        }

        @@media (min-width: 768px) {
            .brand-logo-container {
                height: 56px;
                width: 56px;
                min-width: 56px;
                border-radius: 16px;
            }
        }

        .brand-logo-image {
            max-height: 100%;
            max-width: 100%;
            object-fit: contain;
        }

        .brand-logo-container.fallback-logo {
            background: rgba(255, 255, 255, 0.15);
            backdrop-filter: blur(12px);
            color: #ffffff;
            border: 1px solid rgba(255, 255, 255, 0.25);
        }

        .brand-logo-svg {
            width: 28px;
            height: 28px;
        }

        .brand-details {
            display: flex;
            flex-direction: column;
        }

        .brand-name {
            font-size: clamp(1.25rem, 3vw, 1.6rem);
            font-weight: 800;
            color: #ffffff;
            margin: 0;
            line-height: 1.1;
            letter-spacing: -0.02em;
        }

        .brand-tagline {
            font-size: 0.7rem;
            font-weight: 600;
            color: rgba(255, 255, 255, 0.75);
            text-transform: uppercase;
            letter-spacing: 0.12em;
            margin-top: 2px;
        }

        .login-info h1 {
            font-size: clamp(1.75rem, 4vw, 2.75rem);
            font-weight: 800;
            margin-bottom: 1rem;
            line-height: 1.2;
            letter-spacing: -0.03em;
        }

        .login-info p {
            font-size: clamp(0.9rem, 2vw, 1.1rem);
            line-height: 1.6;
            opacity: .9;
            margin: 0;
        }

        .login-form-container {
            width: 100%;
            padding: 2rem 1.5rem;
            background: #ffffff;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        @@media (min-width: 768px) {
            .login-form-container {
                padding: 3rem 2.5rem;
            }
        }

        @@media (min-width: 992px) {
            .login-form-container {
                width: 460px;
                min-width: 460px;
                padding: 4rem 3.5rem;
            }
        }

        .login-form-container h3 {
            color: var(--text);
            font-weight: 700;
            margin-bottom: 6px;
            font-size: 1.5rem;
        }

        .login-form-container p {
            color: var(--text-muted);
            margin-bottom: 1.75rem;
            font-size: 0.875rem;
        }

        .form-label {
            font-size: 0.85rem;
            font-weight: 600;
            color: var(--text);
            margin-bottom: 6px;
        }

        .form-control {
            height: 48px;
            border-radius: 12px;
            border: 1px solid var(--border);
            padding-left: 45px;
            font-size: 0.925rem;
            width: 100%;
            background-color: #f8fafc;
            transition: all 0.2s ease;
        }

        .form-control:focus {
            background-color: #ffffff;
            border-color: var(--primary);
            box-shadow: 0 0 0 3.5px rgba(37, 99, 235, 0.15);
        }

        .btn-primary {
            height: 48px;
            background-color: var(--primary);
            border: none;
            border-radius: 12px;
            font-weight: 600;
            font-size: 0.95rem;
            width: 100%;
            transition: all 0.2s ease;
        }

        .btn-primary:hover {
            background-color: var(--primary-hover);
            transform: translateY(-1px);
        }
    </style>
</head>
<body>
    <div class="login-wrapper">
        <!-- Responsive Branding Panel -->
        <div class="login-info">
            <div class="brand-header">
                @if (!string.IsNullOrEmpty(logoPath))
                {
                    <div class="brand-logo-container">
                        <img src="@logoPath" alt="@companyName Logo" class="brand-logo-image" />
                    </div>
                }
                else
                {
                    <div class="brand-logo-container fallback-logo">
                        <svg class="brand-logo-svg" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M12 2L2 7L12 12L22 7L12 2Z" fill="currentColor" />
                            <path d="M2 17L12 22L22 17" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                            <path d="M2 12L12 17L22 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </div>
                }
                <div class="brand-details">
                    <span class="brand-name">@companyName</span>
                    <span class="brand-tagline">Enterprise Platform</span>
                </div>
            </div>
            <h1>Enterprise<br class="d-none d-md-inline" /> Intelligence.</h1>
            <p>Welcome back to your workspace. Manage sales, inventory, accounts, and reports from a unified platform.</p>
        </div>

        <!-- Responsive Login Form Panel -->
        <div class="login-form-container">
            <div>
                <h3>Sign In</h3>
                <p>Enter your credentials to access your ERP dashboard</p>
            </div>

            <form method="post" action="/Account/Login?returnUrl=@Model.ReturnUrl">
                @Html.AntiForgeryToken()
                <div class="text-danger mb-3 small" asp-validation-summary="ModelOnly" role="alert"></div>

                <div class="mb-3">
                    <label class="form-label">Username / Email</label>
                    <div class="position-relative">
                        <i class="fa-solid fa-user position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
                        <input name="email" type="text" class="form-control ps-5" placeholder="Enter username or email" required autocomplete="username" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Password</label>
                    <div class="position-relative">
                        <i class="fa-solid fa-lock position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
                        <input name="password" type="password" class="form-control ps-5" placeholder="Enter password" required autocomplete="current-password" />
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="rememberMe" value="true" id="rememberMe" />
                        <label class="form-check-label user-select-none small text-muted fw-medium" for="rememberMe">
                            Remember me on this device
                        </label>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary shadow-sm">
                    Sign In <i class="fa-solid fa-arrow-right ms-2"></i>
                </button>
            </form>
        </div>
    </div>
</body>
</html>
