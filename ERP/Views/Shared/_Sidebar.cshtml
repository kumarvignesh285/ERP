            new MenuLink("Supplier Master", "/Masters/Supplier"),
            new MenuLink("Product Master", "/Masters/Product"),
            new MenuLink("Category Master", "/Masters/Category"),
            new MenuLink("Brand Master", "/Masters/Brand"),
            new MenuLink("Unit Master", "/Masters/Unit"),
            new MenuLink("Warehouse Master", "/Masters/Warehouse"),
            new MenuLink("Ledger Master", "/Masters/Ledger"),
            new MenuLink("Employee Master", "/Masters/Employee"),
            new MenuLink("Account Groups", "/Masters/AccountGroup"),
            new MenuLink("Bank Master", "/Masters/Bank"),
            new MenuLink("Tax Settings", "/Masters/Tax"),
            new MenuLink("Payment Modes", "/Masters/PaymentMode")
        }),
