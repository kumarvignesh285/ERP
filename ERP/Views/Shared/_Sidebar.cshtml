            new MenuLink("Sales Invoice", "/Sales/Invoice"),
            new MenuLink("Sales Return", "/Sales/Return")
        }),
        new MenuSection("Purchase", "fa-bag-shopping", "/Purchase", new[] { "Super Admin", "Admin", "Manager", "Purchase User" }, new[]
