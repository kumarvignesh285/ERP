@functions {
    private sealed record MenuLink(string Text, string Url);
    private sealed record MenuSection(string Text, string Icon, string Url, string[] Roles, MenuLink[] Children);

    private bool CanAccess(string[] roles)
    {
        return roles.Length == 0 || roles.Any(User.IsInRole);
    }

    private bool IsActive(string url)
    {
        var path = Context.Request.Path.Value ?? "/";
        return url == "/" ? path == "/" : path.StartsWith(url, StringComparison.OrdinalIgnoreCase);
    }
}

@{
