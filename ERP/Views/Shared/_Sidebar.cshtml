        }),
        new MenuSection("CRM", "fa-users-rectangle", "/CRM", new[] { "Super Admin", "Admin", "Manager", "Sales User" }, new[]
        {
            new MenuLink("Leads", "/CRM/Leads"),
            new MenuLink("Follow Ups", "/CRM/FollowUps"),
            new MenuLink("Opportunities", "/CRM/Opportunities"),
