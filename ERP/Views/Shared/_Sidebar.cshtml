}

<aside class="erp-sidebar" id="erpSidebar">
    <div class="erp-brand">
        <div class="brand-sidebar-icon">
            <svg class="brand-logo-svg" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 2L2 7L12 12L22 7L12 2Z" fill="currentColor" />
                <path d="M2 17L12 22L22 17" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                <path d="M2 12L12 17L22 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
        </div>
        <span>SMART ERP</span>
    </div>
    <ul class="sidebar-menu">
        <li class="menu-item @(IsActive("/") ? "active" : "")">
            <a href="/"><i class="fa-solid fa-gauge"></i> <span>Dashboard</span></a>
        </li>

        <li class="menu-header">Modules</li>

        @foreach (var menu in moduleSections.Where(s => CanAccess(s.Roles)))
        {
            var collapseId = $"{menu.Text.Replace(" ", "")}Submenu";
            var active = IsActive(menu.Url);
            <li class="menu-item @(active ? "active open" : "")">
                <a href="#@collapseId" data-bs-toggle="collapse" class="@(active ? "" : "collapsed")" aria-expanded="@(active.ToString().ToLowerInvariant())">
                    <i class="fa-solid @menu.Icon"></i> <span>@menu.Text</span> <i class="fa-solid fa-chevron-down ms-auto fs-7"></i>
                </a>
                <ul class="collapse list-unstyled ps-4 @(active ? "show" : "")" id="@collapseId">
                    @foreach (var child in menu.Children)
                    {
                        <li class="@(IsActive(child.Url) ? "active" : "")"><a href="@child.Url">@child.Text</a></li>
                    }
                </ul>
            </li>
        }

        <li class="menu-header">Reports & Settings</li>

        @foreach (var menu in adminSections.Where(s => CanAccess(s.Roles)))
        {
            var collapseId = $"{menu.Text.Replace(" ", "")}Submenu";
            var active = IsActive(menu.Url);
            <li class="menu-item @(active ? "active open" : "")">
                <a href="#@collapseId" data-bs-toggle="collapse" class="@(active ? "" : "collapsed")" aria-expanded="@(active.ToString().ToLowerInvariant())">
                    <i class="fa-solid @menu.Icon"></i> <span>@menu.Text</span> <i class="fa-solid fa-chevron-down ms-auto fs-7"></i>
                </a>
                <ul class="collapse list-unstyled ps-4 @(active ? "show" : "")" id="@collapseId">
                    @foreach (var child in menu.Children)
                    {
                        <li class="@(IsActive(child.Url) ? "active" : "")"><a href="@child.Url">@child.Text</a></li>
                    }
                </ul>
            </li>
        }

        <li class="menu-item @(IsActive("/Help") ? "active" : "")">
            <a href="/Help"><i class="fa-solid fa-circle-question text-info"></i> <span>Help & Guide</span></a>
        </li>

        <li class="menu-item mt-4">
            <form method="post" action="/Account/Logout" id="logoutForm" class="d-none"></form>
            <a href="javascript:document.getElementById('logoutForm').submit();" class="text-danger">
                <i class="fa-solid fa-right-from-bracket text-danger"></i> <span>Logout</span>
            </a>
        </li>
    </ul>
</aside>
<div class="sidebar-backdrop" data-sidebar-close></div>
