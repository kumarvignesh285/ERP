@inject SignInManager<AppUser> SignInManager
@inject UserManager<AppUser> UserManager
<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SmartERP - MVC Billing & Accounting</title>
    
    <!-- Theme loading script to prevent FOUT (Flash of Unstyled Theme) -->
    <script>
        (function() {
            var savedTheme = localStorage.getItem('theme') || 'light';
            document.documentElement.setAttribute('data-theme', savedTheme);
            var sidebarCollapsed = localStorage.getItem('sidebarCollapsed') === 'true';
            if (sidebarCollapsed && window.innerWidth >= 992) {
                document.documentElement.classList.add('sidebar-collapsed');
            }
        })();
    </script>

    <!-- CSS libraries -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.5/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/responsive/2.5.0/css/responsive.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.1/css/buttons.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11.7.12/dist/sweetalert2.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/erp.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ERP.styles.css" asp-append-version="true" />
</head>
<body>
    @if (SignInManager.IsSignedIn(User))
    {
        var roleLabel = User.IsInRole("Super Admin") ? "Super Admin" :
            User.IsInRole("Admin") ? "Admin" :
            User.IsInRole("Manager") ? "Manager" :
            User.IsInRole("Accountant") ? "Accountant" :
            User.IsInRole("Purchase User") ? "Purchase User" :
            User.IsInRole("Sales User") ? "Sales User" : "User";

        <partial name="_Sidebar" />
        
        <div class="erp-wrapper">
            <!-- Glassmorphism Navbar -->
            <header class="erp-header no-print">
                <div class="header-left d-flex align-items-center gap-3">
                    <button class="btn btn-light icon-btn sidebar-toggle d-lg-none" type="button" aria-label="Open navigation" data-sidebar-toggle>
                        <i class="fa-solid fa-bars"></i>
                    </button>
                    
                    <!-- Global Search Bar Trigger -->
                    <div class="header-search-box d-none d-md-flex align-items-center" onclick="window.focusGlobalSearch()">
                        <i class="fa-solid fa-magnifying-glass search-icon text-muted"></i>
                        <input type="text" id="globalHeaderSearch" class="form-control header-search-input" placeholder="Search invoices, products, customers..." />
                        <span class="search-kbd-badge">Ctrl K</span>
                    </div>
                </div>

                <div class="header-right d-flex align-items-center gap-2 gap-sm-3">
                    <!-- Quick Action Add Button -->
                    <div class="dropdown d-none d-sm-block">
                        <button class="btn btn-primary btn-sm d-flex align-items-center gap-1.5 px-3 py-1.5 rounded-pill shadow-sm" type="button" id="quickAddDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="fa-solid fa-plus"></i>
                            <span class="fw-semibold">Create</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow border-0 p-2" aria-labelledby="quickAddDropdown">
                            <li><h6 class="dropdown-header">Quick Actions</h6></li>
                            <li><a class="dropdown-item rounded py-1.5" href="/Sales/Invoice"><i class="fa-solid fa-file-invoice-dollar me-2 text-primary"></i> New Sales Invoice</a></li>
                            <li><a class="dropdown-item rounded py-1.5" href="/Purchase/Order"><i class="fa-solid fa-cart-shopping me-2 text-success"></i> New Purchase Order</a></li>
                            <li><a class="dropdown-item rounded py-1.5" href="/Masters/Customer"><i class="fa-solid fa-user-plus me-2 text-info"></i> Add Customer</a></li>
                            <li><a class="dropdown-item rounded py-1.5" href="/Masters/Product"><i class="fa-solid fa-box-open me-2 text-warning"></i> Add Product</a></li>
                        </ul>
                    </div>

                    <!-- Theme Switcher Palette -->
                    <div class="dropdown">
                        <button class="btn btn-light icon-btn position-relative" type="button" id="themeDropdown" data-bs-toggle="dropdown" aria-expanded="false" title="Switch Theme">
                            <i class="fa-solid fa-palette"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow border-0 p-2 theme-picker-dropdown" aria-labelledby="themeDropdown">
                            <li><h6 class="dropdown-header">Design Theme</h6></li>
                            <li><hr class="dropdown-divider m-1"></li>
                            <li><button class="dropdown-item py-2 d-flex align-items-center justify-content-between rounded" data-theme-value="light"><span>Light Minimal</span><span class="theme-swatch swatch-light"></span></button></li>
                            <li><button class="dropdown-item py-2 d-flex align-items-center justify-content-between rounded" data-theme-value="dark"><span>Dark Obsidian</span><span class="theme-swatch swatch-dark"></span></button></li>
                            <li><button class="dropdown-item py-2 d-flex align-items-center justify-content-between rounded" data-theme-value="emerald"><span>Emerald Glass</span><span class="theme-swatch swatch-emerald"></span></button></li>
                            <li><button class="dropdown-item py-2 d-flex align-items-center justify-content-between rounded" data-theme-value="indigo"><span>Indigo Premium</span><span class="theme-swatch swatch-indigo"></span></button></li>
                        </ul>
                    </div>

                    <!-- Notifications Dropdown -->
                    <div class="dropdown">
                        <button class="btn btn-light icon-btn position-relative" type="button" id="notifDropdown" data-bs-toggle="dropdown" aria-expanded="false" title="Notifications">
                            <i class="fa-regular fa-bell"></i>
                            <span class="position-absolute top-0 start-100 translate-middle p-1 bg-danger border border-light rounded-circle notif-badge-pulse" id="notif-count" style="display:none">
                                <span class="visually-hidden">New alerts</span>
                            </span>
                        </button>
                        <div class="dropdown-menu dropdown-menu-end shadow border-0 p-0 notif-popover-menu" aria-labelledby="notifDropdown">
                            <div class="notif-header p-3 border-bottom d-flex justify-content-between align-items-center">
                                <h6 class="m-0 fw-bold">Notifications</h6>
                                <span class="badge bg-primary-light text-primary fw-semibold fs-8" id="notif-badge-label">Live Sync</span>
                            </div>
                            <ul class="list-group list-group-flush notif-list-container" id="notif-list">
                                <li class="list-group-item text-center text-muted py-4">
                                    <i class="fa-solid fa-bell-slash fa-2x mb-2 opacity-40"></i>
                                    <p class="m-0 fs-7">No new alerts</p>
                                </li>
                            </ul>
                            <div class="notif-footer p-2 text-center border-top">
                                <a href="/Help" class="fs-8 text-decoration-none text-primary fw-semibold">View System Logs</a>
                            </div>
                        </div>
                    </div>
                    
                    <!-- User Account Dropdown -->
                    <div class="dropdown">
                        <button class="btn btn-link d-flex align-items-center gap-2 text-decoration-none text-dark p-0" type="button" id="userMenuDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                            <div class="user-avatar-wrapper position-relative">
                                <div class="avatar-circle bg-primary text-white shadow-sm">
                                    @User.Identity?.Name?[..1].ToUpper()
                                </div>
                                <span class="user-online-dot"></span>
                            </div>
                            <div class="user-meta text-start d-none d-md-block">
                                <p class="m-0 lh-1 fs-7 fw-bold text-dark">@User.Identity?.Name</p>
                                <span class="text-muted fs-8 fw-medium">@roleLabel</span>
                            </div>
                            <i class="fa-solid fa-chevron-down text-muted fs-8 d-none d-md-inline ms-1"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow border-0 p-2 user-menu-dropdown" aria-labelledby="userMenuDropdown">
                            <li class="px-2 py-1.5 border-bottom mb-1">
                                <span class="d-block fw-bold fs-7">@User.Identity?.Name</span>
                                <span class="badge bg-light text-primary border border-primary-subtle fs-8 font-monospace mt-1">@roleLabel</span>
                            </li>
                            <li><a class="dropdown-item rounded py-2" href="/Settings/CompanySettings"><i class="fa-solid fa-building me-2 text-primary"></i> Company Setup</a></li>
                            <li><a class="dropdown-item rounded py-2" href="/Settings/Users"><i class="fa-solid fa-user-gear me-2 text-info"></i> Profile Settings</a></li>
                            <li><a class="dropdown-item rounded py-2" href="/Help"><i class="fa-solid fa-circle-question me-2 text-warning"></i> System Help</a></li>
                            <li><hr class="dropdown-divider my-1"></li>
                            <li>
                                <form class="form-inline m-0" action="/Account/Logout" method="post">
                                    <button type="submit" class="dropdown-item rounded py-2 text-danger"><i class="fa-solid fa-right-from-bracket me-2"></i> Sign Out</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </header>

            <!-- Main Content View -->
            <main role="main" class="erp-content">
                <!-- Dynamic Breadcrumb Navigation -->
                <partial name="_Breadcrumb" />
                
                <!-- Page View Content -->
                @RenderBody()
            </main>

            <!-- Shared Footer Partial -->
            <partial name="_Footer" />
        </div>
    }
    else
    {
        <main role="main">
            @RenderBody()
        </main>
    }

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.5/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.5/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/dataTables.responsive.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/responsive.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.bootstrap5.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.print.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.7.12/dist/sweetalert2.all.min.js"></script>
    <script src="~/lib/chart.js/chart.umd.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/erp-print.js" asp-append-version="true"></script>
    <script src="~/js/erp-voucher.js" asp-append-version="true"></script>

    <script>
        $(document).ready(function() {
            // Apply beautiful DataTable defaults with dynamic S.No. (serial number) column prepended
            $('.datatable').each(function() {
                var $table = $(this);
                
                // 1. Add "S.No." column header
                $table.find('thead tr').each(function() {
                    if ($(this).find('th:first').text() !== 'S.No.') {
                        $(this).prepend('<th style="width: 60px;" class="text-center">S.No.</th>');
                    }
                });
                
                // 2. Add empty cell in body rows so DataTables has a column to write into
                $table.find('tbody tr').each(function() {
                    if (!$(this).find('td:first').hasClass('sno-cell')) {
                        $(this).prepend('<td class="text-center fw-semibold sno-cell"></td>');
                    }
                });

                // 3. Add empty cell in footer rows if any
                $table.find('tfoot tr').each(function() {
                    if ($(this).find('th:first').text() !== '') {
                        $(this).prepend('<th></th>');
                    }
                });

                // Initialize DataTable on this specific table element
                var table = $table.DataTable({
                    responsive: true,
                    lengthChange: false,
                    dom: "<'dt-top-bar'<'dt-search-wrap'f><'dt-btn-wrap'B>>" +
                         "<'row'<'col-12'tr>>" +
                         "<'dt-bottom-bar'<'dt-info-wrap'i><'dt-paging-wrap'p>>",
                    buttons: [
                        {
                            extend: 'excelHtml5',
                            text: '<i class="fa-solid fa-file-excel me-1"></i> Excel',
                            className: 'btn-dt-export btn-dt-excel',
                            exportOptions: { columns: ':not(.no-print)' },
                            title: document.title.split(' - ')[0]
                        },
                        {
                            extend: 'csvHtml5',
                            text: '<i class="fa-solid fa-file-csv me-1"></i> CSV',
                            className: 'btn-dt-export btn-dt-csv',
                            exportOptions: { columns: ':not(.no-print)' },
                            title: document.title.split(' - ')[0]
                        },
                        {
                            extend: 'pdfHtml5',
                            text: '<i class="fa-solid fa-file-pdf me-1"></i> PDF',
                            className: 'btn-dt-export btn-dt-pdf',
                            exportOptions: { columns: ':not(.no-print)' },
                            title: document.title.split(' - ')[0],
                            orientation: 'landscape',
                            pageSize: 'A4'
                        },
                        {
                            extend: 'print',
                            text: '<i class="fa-solid fa-print me-1"></i> Print',
                            className: 'btn-dt-export btn-dt-print',
                            exportOptions: { columns: ':not(.no-print)' },
                            title: document.title.split(' - ')[0]
                        }
                    ],
                    language: {
                        searchPlaceholder: "Search records...",
                        search: "",
                        info: "Showing _START_ to _END_ of _TOTAL_ records",
                        infoEmpty: "No records found",
                        paginate: {
                            previous: '<i class="fa-solid fa-chevron-left"></i>',
                            next: '<i class="fa-solid fa-chevron-right"></i>'
                        }
                    },
                    columnDefs: [
                        {
                            searchable: false,
                            orderable: false,
                            targets: 0
                        }
                    ],
                    order: [[1, 'asc']]
                });

                // Keep the S.No column populated sequentially on draw
                table.on('order.dt search.dt', function () {
                    let i = 1;
                    table.cells(null, 0, { search: 'applied', order: 'applied' }).every(function (cell) {
                        this.data(i++);
                    });
                }).draw();
            });

            // Initialize select2 elements
            if (window.initializeSelect2) {
                window.initializeSelect2('.select2');
            }

            // Load Notifications list via AJAX
            $.getJSON('/api/erp/notifications', function(data) {
                if (data && data.length > 0) {
                    $('#notif-count').show();
                    var list = $('#notif-list');
                    list.empty();
                    $.each(data, function(i, item) {
                        list.append('<li class="list-group-item p-3 hover-light">' +
                            '<a class="text-decoration-none text-dark" href="' + (item.linkUrl || '#') + '">' +
                            '<div class="d-flex justify-content-between align-items-center mb-1">' +
                            '<span class="badge bg-light text-primary fw-medium">' + item.notificationType + '</span>' +
                            '<span class="text-muted fs-8">' + new Date(item.createdAt).toLocaleDateString() + '</span>' +
                            '</div>' +
                            '<p class="m-0 fs-7 text-wrap text-dark">' + item.message + '</p>' +
                            '</a></li>');
                    });
                }
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
