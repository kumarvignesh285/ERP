@model SalesPageViewModel<SalesOrder>
@{
    ViewData["Title"] = "Sales Order";
}

<div id="listView">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="m-0 font-weight-bold text-primary"><i class="fa-solid fa-cart-shopping me-2"></i> Sales Orders</h4>
        <button class="btn btn-primary" onclick="showForm()"><i class="fa-solid fa-plus me-1"></i> New Order</button>
    </div>

    <!-- Filters Row -->
    <div class="card mb-3 no-print">
        <div class="card-body p-3">
            <div class="row g-2 align-items-center">
                <div class="col-md-3">
                    <label class="form-label font-weight-semibold mb-1 small text-muted">From Date</label>
                    <input type="date" id="filterFromDate" class="form-control form-control-sm" />
                </div>
                <div class="col-md-3">
                    <label class="form-label font-weight-semibold mb-1 small text-muted">To Date</label>
                    <input type="date" id="filterToDate" class="form-control form-control-sm" />
                </div>
                <div class="col-md-3">
                    <label class="form-label font-weight-semibold mb-1 small text-muted">Status</label>
                    <select id="filterStatus" class="form-select form-select-sm">
                        <option value="">All Statuses</option>
                        <option value="Draft">Draft</option>
                        <option value="Pending">Pending</option>
                        <option value="Approved">Approved</option>
                        <option value="Completed">Completed</option>
                        <option value="Cancelled">Cancelled</option>
                    </select>
                </div>
                <div class="col-md-3 d-flex gap-2 align-self-end">
                    <button class="btn btn-sm btn-primary w-100" onclick="applyFilters()"><i class="fa-solid fa-filter me-1"></i> Filter</button>
                    <button class="btn btn-sm btn-outline-secondary w-100" onclick="resetFilters()"><i class="fa-solid fa-rotate me-1"></i> Reset</button>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover datatable align-middle">
                    <thead>
                        <tr>
                            <th>Order No</th>
                            <th>Date</th>
                            <th>Customer</th>
                            <th>Grand Total</th>
                            <th>Status</th>
                            <th class="text-center no-print">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var o in Model.Items)
                        {
                            <tr id="row-@o.Id">
                                <td class="font-weight-bold">@o.OrderNumber</td>
                                <td>@o.OrderDate.ToString("dd-MM-yyyy")</td>
                                <td>@o.Customer?.CustomerName</td>
                                <td class="font-weight-semibold text-dark">₹@o.GrandTotal.ToString("N2")</td>
                                @{
                                    var statusBadgeClass = o.Status switch
                                    {
                                        "Pending" or "Draft" => "badge-pending",
                                        "Sent" or "Issued" or "Active" => "badge-sent",
                                        "Completed" or "Paid" or "Accepted" or "Approved" => "badge-accepted",
                                        "Cancelled" or "Rejected" or "Expired" => "badge-rejected",
                                        _ => "badge-accepted"
                                    };
                                }
                                <td><span class="badge @statusBadgeClass">@o.Status</span></td>
                                <td class="text-center no-print">
                                    <div class="btn-group">
                                        <button class="btn btn-sm btn-outline-primary" onclick="editOrder(@o.Id)" title="Edit"><i class="fa-solid fa-pen"></i></button>
                                        <button class="btn btn-sm btn-outline-success" onclick="convertOrderToInvoice(@o.Id)" title="Convert to invoice"><i class="fa-solid fa-file-invoice-dollar"></i></button>
                                        <button class="btn btn-sm btn-outline-danger" onclick="deleteOrder(@o.Id)"><i class="fa-solid fa-trash"></i></button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div id="formView" style="display:none">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="m-0 font-weight-bold text-primary"><i class="fa-solid fa-plus me-2"></i> Create Sales Order</h4>
        <button class="btn btn-outline-secondary" onclick="hideForm()"><i class="fa-solid fa-arrow-left me-1"></i> Back to List</button>
    </div>

    <div class="card">
        <div class="card-body">
            <form id="orderForm">
                <input type="hidden" id="Id" value="0" />
                <div class="row">
                    <div class="col-md-3 mb-3">
                        <label class="form-label font-weight-semibold">Order Number *</label>
                        <input type="text" id="OrderNumber" class="form-control" required />
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="form-label font-weight-semibold">Date *</label>
                        <input type="date" id="OrderDate" class="form-control" required value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="form-label font-weight-semibold">Customer *</label>
                        <select id="CustomerId" class="form-select select2" required>
                            <option value="">Select Customer</option>
                            @foreach (var c in Model.Customers)
                            {
                                <option value="@c.Id">@c.CustomerName</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="form-label font-weight-semibold">Status *</label>
                        <select id="Status" class="form-select" required>
                            <option value="Pending">Pending</option>
                            <option value="Confirmed">Confirmed</option>
                            <option value="Partially Delivered">Partially Delivered</option>
                            <option value="Completed">Completed</option>
                            <option value="Cancelled">Cancelled</option>
                        </select>
                    </div>
                </div>

                <hr />

                <h5>Line Items</h5>
                <div class="table-responsive mb-3">
                    <table class="table table-bordered align-middle" id="itemsTable">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 20%">Category</th>
                                <th style="width: 30%">Product *</th>
                                <th style="width: 15%">Quantity *</th>
                                <th style="width: 15%">Rate *</th>
                                <th style="width: 15%">Total</th>
                                <th style="width: 5%" class="text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>

                <div class="d-flex justify-content-between mb-4">
                    <button type="button" class="btn btn-outline-primary" onclick="addRow()"><i class="fa-solid fa-plus me-1"></i> Add Row</button>
                    <div class="text-end" style="width: 300px;">
                        <div class="d-flex justify-content-between border-top pt-2">
                            <span class="font-weight-bold">Grand Total:</span>
                            <span id="lblGrandTotal" class="font-weight-bold text-primary fs-5">₹0.00</span>
                        </div>
                    </div>
                </div>

                <div class="text-end">
                    <button type="button" class="btn btn-secondary me-2" onclick="hideForm()">Cancel</button>
                    <button type="button" class="btn btn-primary px-4" onclick="saveOrder()">Save Order</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var productsList = @Json.Serialize(Model.ProductLookups);
        if (productsList) {
            productsList = productsList.map(function(p) {
                return {
                    id: window.getVal(p, 'id'),
                    productCode: window.getVal(p, 'productCode'),
                    productName: window.getVal(p, 'productName'),
                    salesPrice: window.getVal(p, 'salesPrice'),
                    purchasePrice: window.getVal(p, 'purchasePrice'),
                    gstPercentage: window.getVal(p, 'gstPercentage'),
                    categoryId: window.getVal(p, 'categoryId')
                };
            });
        }

        function showForm() {
            $('#listView').hide();
            $('#formView').show();
            $('#orderForm')[0].reset();
            $('#Id').val('0');
            $('#OrderNumber').val("SO-" + Date.now().toString().slice(-6));
            $('#itemsTable tbody').empty();
            $('#CustomerId').val('').trigger('change');
            $('#Status').val('Pending');
            addRow();
        }

        function editOrder(id) {
            $.getJSON('/Sales/GetOrder/' + id, function(order) {
                $('#listView').hide();
                $('#formView').show();
                $('#Id').val(window.getVal(order, 'id'));
                $('#OrderNumber').val(window.getVal(order, 'orderNumber'));
                
                var oDate = window.getVal(order, 'orderDate');
                if (oDate) {
                    $('#OrderDate').val(oDate.split('T')[0]);
                }
                
                $('#CustomerId').val(window.getVal(order, 'customerId')).trigger('change');
                $('#Status').val(window.getVal(order, 'status'));
                $('#itemsTable tbody').empty();
                
                var items = window.getVal(order, 'items') || [];
                items.forEach(function(item) {
                    var normalizedItem = {
                        productId: window.getVal(item, 'productId'),
                        quantity: window.getVal(item, 'quantity'),
                        rate: window.getVal(item, 'rate')
                    };
                    addRow(normalizedItem);
                });
                calculateTotals();
            });
        }

        function hideForm() {
            $('#formView').hide();
            $('#listView').show();
        }

        function addRow(existingItem) {
            var catOptionsHtml = '<option value="">All Categories</option>';
            var categoriesList = @Json.Serialize(Model.Categories);
            if (categoriesList) {
                categoriesList = categoriesList.map(function(c) {
                    return {
                        id: window.getVal(c, 'id'),
                        categoryName: window.getVal(c, 'categoryName')
                    };
                });
            }
            categoriesList.forEach(function(c) {
                catOptionsHtml += `<option value="${c.id}">${c.categoryName}</option>`;
            });

            var optionsHtml = '<option value="">Select Product</option>';
            productsList.forEach(function(p) {
                optionsHtml += `<option value="${p.id}">${p.productName}</option>`;
            });

            var rowHtml = `
                <tr class="grid-item-row">
                    <td>
                        <select class="form-select select2-category" onchange="onCategorySelect(this)">
                            ${catOptionsHtml}
                        </select>
                    </td>
                    <td>
                        <select class="form-select select2-row" onchange="onProductSelect(this)" required>
                            ${optionsHtml}
                        </select>
                    </td>
                    <td>
                        <input type="number" class="form-control qty-input" value="1" min="1" oninput="calculateRow(this)" required />
                    </td>
                    <td>
                        <input type="number" class="form-control rate-input" value="0.00" step="0.01" oninput="calculateRow(this)" required />
                    </td>
                    <td>
                        <input type="text" class="form-control total-input" value="0.00" readonly />
                    </td>
                    <td class="text-center">
                        <button type="button" class="btn btn-sm btn-outline-danger" onclick="removeRow(this)"><i class="fa-solid fa-trash"></i></button>
                    </td>
                </tr>
            `;
            var $row = $(rowHtml);
            $('#itemsTable tbody').append($row);
            window.initializeSelect2($row.find('.select2-row'));
            window.initializeSelect2($row.find('.select2-category'));
            if (existingItem) {
                $row.find('.select2-row').val(existingItem.productId).trigger('change');
                $row.find('.qty-input').val(existingItem.quantity);
                $row.find('.rate-input').val(existingItem.rate);
                $row.find('.total-input').val((existingItem.quantity * existingItem.rate).toFixed(2));
            }
        }

        function removeRow(btn) {
            $(btn).closest('tr').remove();
            calculateTotals();
        }

        function onCategorySelect(select) {
            var catId = $(select).val();
            var $row = $(select).closest('tr');
            var $prodSelect = $row.find('.select2-row');
            
            $prodSelect.empty();
            $prodSelect.append('<option value="">Select Product</option>');
            
            productsList.forEach(function(p) {
                if (!catId || p.categoryId == catId) {
                    var prodName = p.productCode ? `${p.productName} (${p.productCode})` : p.productName;
                    $prodSelect.append(`<option value="${p.id}">${prodName}</option>`);
                }
            });
            $prodSelect.trigger('change');
        }

        function onProductSelect(select) {
            var prodId = $(select).val();
            var product = productsList.find(p => p.id == prodId);
            var $row = $(select).closest('tr');
            if (product) {
                $row.find('.rate-input').val(product.salesPrice);
            }
            calculateRow(select);
        }

        function calculateRow(elem) {
            var $row = $(elem).closest('tr');
            var qty = parseFloat($row.find('.qty-input').val()) || 0;
            var rate = parseFloat($row.find('.rate-input').val()) || 0;
            $row.find('.total-input').val((qty * rate).toFixed(2));
            calculateTotals();
        }

        function calculateTotals() {
            var total = 0;
            $('#itemsTable tbody tr').each(function() {
                var qty = parseFloat($(this).find('.qty-input').val()) || 0;
                var rate = parseFloat($(this).find('.rate-input').val()) || 0;
                total += (qty * rate);
            });
            $('#lblGrandTotal').text('₹' + total.toFixed(2));
        }

        function saveOrder() {
            var items = [];
            var isValid = true;
            $('#itemsTable tbody tr').each(function() {
                var prodId = $(this).find('.select2-row').val();
                var qty = parseFloat($(this).find('.qty-input').val()) || 0;
                var rate = parseFloat($(this).find('.rate-input').val()) || 0;
                if (!prodId || qty <= 0 || rate <= 0) {
                    isValid = false;
                    return false;
                }
                var product = productsList.find(p => p.id == prodId);
                items.push({
                    productId: parseInt(prodId),
                    productName: product ? product.productName : '',
                    quantity: qty,
                    rate: rate,
                    amount: qty * rate
                });
            });

            var customerId = $('#CustomerId').val();
            if (!customerId || !$('#OrderNumber').val() || items.length === 0 || !isValid) {
                Swal.fire('Error!', 'Please fill all fields.', 'error');
                return;
            }

            var order = {
                id: parseInt($('#Id').val()) || 0,
                orderNumber: $('#OrderNumber').val(),
                orderDate: $('#OrderDate').val(),
                customerId: parseInt(customerId),
                grandTotal: parseFloat($('#lblGrandTotal').text().replace('₹', '')) || 0,
                status: $('#Status').val(),
                items: items
            };

            $.ajax({
                url: '/Sales/SaveOrder',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(order),
                success: function(res) {
                    if (res.success) {
                        Swal.fire('Saved!', res.message, 'success').then(() => { location.reload(); });
                    }
                }
            });
        }

        function deleteOrder(id) {
            Swal.fire({
                title: 'Are you sure?',
                text: "Do you want to delete this order?",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Yes, delete!'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.post('/Sales/DeleteOrder', { id: id }, function(res) {
                        if (res.success) {
                            Swal.fire('Deleted!', 'Order deleted.', 'success');
                            $('#row-' + id).fadeOut(300, function() { $(this).remove(); });
                        }
                    });
                }
            });
        }

        function convertOrderToInvoice(id) {
            Swal.fire({
                title: 'Convert order?',
                text: 'This will create a sales invoice from this order.',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#16a34a',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Convert'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.post('/Sales/ConvertOrderToInvoice', { id: id }, function(res) {
                        if (res.success) {
                            Swal.fire('Converted!', res.message, 'success').then(() => {
                                window.location.href = '/Sales/Invoice';
                            });
                        } else {
                            Swal.fire('Error!', res.message || 'Conversion failed.', 'error');
                        }
                    });
                }
            });
        }
    </script>
}

