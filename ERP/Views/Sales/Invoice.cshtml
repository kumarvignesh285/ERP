@model SalesPageViewModel<SalesInvoice>
@{
    ViewData["Title"] = "Sales Invoice";
}

<!-- List View -->
<div id="listView">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="m-0 font-weight-bold text-primary"><i class="fa-solid fa-file-invoice-dollar me-2"></i> Sales Invoices</h4>
        <button class="btn btn-primary" onclick="showForm()"><i class="fa-solid fa-plus me-1"></i> New Invoice</button>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover datatable align-middle">
                    <thead>
                        <tr>
                            <th>Invoice No</th>
                            <th>Date</th>
                            <th>Customer</th>
                            <th>Grand Total</th>
                            <th>Paid Amount</th>
                            <th>Balance</th>
                            <th>Status</th>
                            <th class="text-center no-print">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var inv in Model.Items)
                        {
                            <tr id="row-@inv.Id">
                                <td class="font-weight-bold">@inv.InvoiceNumber</td>
                                <td>@inv.InvoiceDate.ToString("dd-MM-yyyy")</td>
                                <td>@inv.Customer?.CustomerName</td>
                                <td class="font-weight-semibold text-dark">₹@inv.GrandTotal.ToString("N2")</td>
                                <td>₹@inv.PaidAmount.ToString("N2")</td>
                                <td class="text-danger font-weight-semibold">₹@inv.BalanceAmount.ToString("N2")</td>
                                <td><span class="badge bg-info">@inv.Status</span></td>
                                <td class="text-center no-print">
                                    <div class="btn-group">
                                        <button class="btn btn-sm btn-outline-primary" onclick="editInvoice(@inv.Id)" title="Edit"><i class="fa-solid fa-pen"></i></button>
                                        <button class="btn btn-sm btn-outline-secondary" onclick="ErpPrint.printBillById('salesInvoice', @inv.Id)" title="Print"><i class="fa-solid fa-print"></i></button>
                                        <button class="btn btn-sm btn-outline-danger" onclick="deleteInvoice(@inv.Id)"><i class="fa-solid fa-trash"></i></button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Entry Form View (hidden initially) -->
<div id="formView" style="display:none">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="m-0 font-weight-bold text-primary" id="formTitle"><i class="fa-solid fa-plus me-2"></i> Create Sales Invoice</h4>
        <button class="btn btn-outline-secondary" onclick="hideForm()"><i class="fa-solid fa-arrow-left me-1"></i> Back to List</button>
    </div>

    <div class="card">
        <div class="card-body">
            <form id="invoiceForm">
                <input type="hidden" id="Id" name="Id" value="0" />
                
                <div class="row">
                    <div class="col-md-2 mb-3">
                        <label class="form-label font-weight-semibold">Invoice Number *</label>
                        <input type="text" id="InvoiceNumber" class="form-control" required readonly />
                        <small class="text-muted">Auto from company settings</small>
                    </div>
                    <div class="col-md-2 mb-3">
                        <label class="form-label font-weight-semibold">Invoice Date *</label>
                        <input type="date" id="InvoiceDate" class="form-control" required value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="form-label font-weight-semibold">Customer *</label>
                        <select id="CustomerId" class="form-select select2" required>
                            <option value="">Select Customer</option>
                            @foreach (var c in Model.Customers)
                            {
                                <option value="@c.Id">@c.CustomerName (@c.CustomerCode)</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="form-label font-weight-semibold">Terms (Days)</label>
                        <input type="number" id="CreditDays" class="form-control" value="0" />
                    </div>
                    <div class="col-md-2 mb-3">
                        <label class="form-label font-weight-semibold">Status *</label>
                        <select id="Status" class="form-select" required>
                            <option value="Draft">Draft</option>
                            <option value="Issued">Issued</option>
                            <option value="Partially Paid">Partially Paid</option>
                            <option value="Paid">Paid</option>
                            <option value="Cancelled">Cancelled</option>
                        </select>
                    </div>
                </div>

                <hr />

                <h5>Line Items</h5>
                <div class="table-responsive mb-3">
                    <table class="table table-bordered align-middle" id="itemsTable">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 20%">Category</th>
                                <th style="width: 20%">Product *</th>
                                <th style="width: 12%">Quantity *</th>
                                <th style="width: 15%">Rate *</th>
                                <th style="width: 10%">GST %</th>
                                <th style="width: 15%">Total</th>
                                <th style="width: 8%" class="text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- Dynamic rows will be inserted here -->
                        </tbody>
                    </table>
                </div>

                <div class="d-flex justify-content-between mb-4">
                    <button type="button" class="btn btn-outline-primary" onclick="addRow()"><i class="fa-solid fa-plus me-1"></i> Add Row</button>
                    
                    <div class="text-end" style="width: 300px;">
                        <div class="d-flex justify-content-between mb-2">
                            <span>Sub Total:</span>
                            <span id="lblSubTotal" class="font-weight-semibold">₹0.00</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Total GST:</span>
                            <span id="lblTotalGST" class="font-weight-semibold">₹0.00</span>
                        </div>
                        <div class="d-flex justify-content-between border-top pt-2">
                            <span class="font-weight-bold">Grand Total:</span>
                            <span id="lblGrandTotal" class="font-weight-bold text-primary fs-5">₹0.00</span>
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label font-weight-semibold">Remarks / Terms</label>
                    <textarea id="Remarks" class="form-control" rows="2"></textarea>
                </div>

                <div class="text-end">
                    <button type="button" class="btn btn-secondary me-2" onclick="hideForm()">Cancel</button>
                    <button type="button" class="btn btn-primary px-4" onclick="saveInvoice()">Save Invoice</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // List of all products preloaded for easy lookup in lines
        var productsList = @Json.Serialize(Model.ProductLookups);

        function showForm() {
            $('#formTitle').html('<i class="fa-solid fa-plus me-2"></i> Create Sales Invoice');
            $('#listView').hide();
            $('#formView').show();
            $('#invoiceForm')[0].reset();
            $('#Id').val("0");
            $('#InvoiceNumber').prop('readonly', true);
            $('#itemsTable tbody').empty();
            $('#CustomerId').val('').trigger('change');
            $('#Status').val('Draft');
            $('#InvoiceDate').val('@DateTime.Today.ToString("yyyy-MM-dd")');
            ErpPrint.fetchNextBillNumber('sales').done(function(res) {
                $('#InvoiceNumber').val(res.billNumber);
            });
            addRow();
        }

        function editInvoice(id) {
            $.getJSON('/Sales/GetInvoice/' + id, function(inv) {
                $('#formTitle').html('<i class="fa-solid fa-pen me-2"></i> Edit Sales Invoice');
                $('#listView').hide();
                $('#formView').show();
                $('#Id').val(inv.id);
                $('#InvoiceNumber').val(inv.invoiceNumber).prop('readonly', true);
                $('#InvoiceDate').val(inv.invoiceDate.split('T')[0]);
                $('#CustomerId').val(inv.customerId).trigger('change');
                $('#Status').val(inv.status);
                $('#Remarks').val(inv.notes || '');
                if (inv.paymentTerms) {
                    var days = parseInt(inv.paymentTerms) || 0;
                    $('#CreditDays').val(days);
                }
                $('#itemsTable tbody').empty();
                (inv.items || []).forEach(function(item) {
                    addRow(item);
                });
                calculateTotals();
            });
        }

        function hideForm() {
            $('#formView').hide();
            $('#listView').show();
        }

        function addRow(existingItem) {
            var index = $('#itemsTable tbody tr').length;
            
            var catOptionsHtml = '<option value="">All Categories</option>';
            var categoriesList = @Json.Serialize(Model.Categories);
            categoriesList.forEach(function(c) {
                catOptionsHtml += `<option value="${c.id}">${c.categoryName}</option>`;
            });

            var optionsHtml = '<option value="">Select Product</option>';
            productsList.forEach(function(p) {
                optionsHtml += `<option value="${p.id}">${p.productName} (${p.productCode})</option>`;
            });

            var rowHtml = `
                <tr class="grid-item-row">
                    <td>
                        <select class="form-select select2-category" onchange="onCategorySelect(this)">
                            ${catOptionsHtml}
                        </select>
                    </td>
                    <td>
                        <select class="form-select select2-row" onchange="onProductSelect(this)" required>
                            ${optionsHtml}
                        </select>
                    </td>
                    <td>
                        <input type="number" class="form-control qty-input" value="1" min="1" oninput="calculateRow(this)" required />
                    </td>
                    <td>
                        <input type="number" class="form-control rate-input" value="0.00" step="0.01" oninput="calculateRow(this)" required />
                    </td>
                    <td>
                        <input type="number" class="form-control gst-input" value="18" oninput="calculateRow(this)" required />
                    </td>
                    <td>
                        <input type="text" class="form-control total-input" value="0.00" readonly />
                    </td>
                    <td class="text-center">
                        <button type="button" class="btn btn-sm btn-outline-danger" onclick="removeRow(this)"><i class="fa-solid fa-trash"></i></button>
                    </td>
                </tr>
            `;

            var $row = $(rowHtml);
            $('#itemsTable tbody').append($row);
            window.initializeSelect2($row.find('.select2-row'));
            window.initializeSelect2($row.find('.select2-category'));

            if (existingItem) {
                $row.find('.select2-row').val(existingItem.productId).trigger('change');
                $row.find('.qty-input').val(existingItem.quantity);
                $row.find('.rate-input').val(existingItem.rate);
                $row.find('.gst-input').val(existingItem.taxPercentage);
                $row.find('.total-input').val((existingItem.quantity * existingItem.rate).toFixed(2));
            }
        }

        function removeRow(btn) {
            $(btn).closest('tr').remove();
            calculateTotals();
        }

        function onCategorySelect(select) {
            var catId = $(select).val();
            var $row = $(select).closest('tr');
            var $prodSelect = $row.find('.select2-row');
            
            $prodSelect.empty();
            $prodSelect.append('<option value="">Select Product</option>');
            
            productsList.forEach(function(p) {
                if (!catId || p.categoryId == catId) {
                    $prodSelect.append(`<option value="${p.id}">${p.productName} (${p.productCode})</option>`);
                }
            });
            $prodSelect.trigger('change');
        }

        function onProductSelect(select) {
            var prodId = $(select).val();
            var product = productsList.find(p => p.id == prodId);
            var $row = $(select).closest('tr');
            if (product) {
                $row.find('.rate-input').val(product.salesPrice);
                $row.find('.gst-input').val(product.gstPercentage);
            }
            calculateRow(select);
        }

        function calculateRow(elem) {
            var $row = $(elem).closest('tr');
            var qty = parseFloat($row.find('.qty-input').val()) || 0;
            var rate = parseFloat($row.find('.rate-input').val()) || 0;
            var gst = parseFloat($row.find('.gst-input').val()) || 0;

            var total = qty * rate;
            $row.find('.total-input').val(total.toFixed(2));

            calculateTotals();
        }

        function calculateTotals() {
            var subTotal = 0;
            var totalGST = 0;

            $('#itemsTable tbody tr').each(function() {
                var qty = parseFloat($(this).find('.qty-input').val()) || 0;
                var rate = parseFloat($(this).find('.rate-input').val()) || 0;
                var gst = parseFloat($(this).find('.gst-input').val()) || 0;

                var lineTotal = qty * rate;
                var lineGST = lineTotal * (gst / 100);

                subTotal += lineTotal;
                totalGST += lineGST;
            });

            var grandTotal = subTotal + totalGST;

            $('#lblSubTotal').text('₹' + subTotal.toFixed(2));
            $('#lblTotalGST').text('₹' + totalGST.toFixed(2));
            $('#lblGrandTotal').text('₹' + grandTotal.toFixed(2));
        }

        function saveInvoice() {
            var items = [];
            var isValid = true;

            $('#itemsTable tbody tr').each(function() {
                var prodId = $(this).find('.select2-row').val();
                var qty = parseFloat($(this).find('.qty-input').val()) || 0;
                var rate = parseFloat($(this).find('.rate-input').val()) || 0;
                var gst = parseFloat($(this).find('.gst-input').val()) || 0;

                if (!prodId || qty <= 0 || rate <= 0) {
                    isValid = false;
                    return false;
                }

                var product = productsList.find(p => p.id == prodId);
                items.push({
                    productId: parseInt(prodId),
                    productName: product ? product.productName : '',
                    quantity: qty,
                    rate: rate,
                    taxPercentage: gst,
                    discount: 0,
                    taxAmount: qty * rate * (gst / 100),
                    amount: (qty * rate) + (qty * rate * (gst / 100))
                });
            });

            var customerId = $('#CustomerId').val();
            if (!customerId || items.length === 0 || !isValid) {
                Swal.fire('Error!', 'Please fill all required fields and add at least one valid line item.', 'error');
                return;
            }

            var invoice = {
                id: parseInt($('#Id').val()) || 0,
                invoiceNumber: $('#InvoiceNumber').val(),
                invoiceDate: $('#InvoiceDate').val(),
                customerId: parseInt(customerId),
                notes: $('#Remarks').val(),
                paymentTerms: $('#CreditDays').val() + " Days",
                status: $('#Status').val(),
                subTotal: parseFloat($('#lblSubTotal').text().replace('₹', '')) || 0,
                taxAmount: parseFloat($('#lblTotalGST').text().replace('₹', '')) || 0,
                grandTotal: parseFloat($('#lblGrandTotal').text().replace('₹', '')) || 0,
                balanceAmount: parseFloat($('#lblGrandTotal').text().replace('₹', '')) || 0,
                items: items
            };

            $.ajax({
                url: '/Sales/SaveInvoice',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(invoice),
                success: function(res) {
                    if (res.success) {
                        Swal.fire('Saved!', res.message, 'success').then(() => {
                            location.reload();
                        });
                    } else {
                        Swal.fire('Error!', res.message, 'error');
                    }
                },
                error: function(xhr) {
                    Swal.fire('Error!', xhr.responseJSON?.message || 'Failed to save invoice.', 'error');
                }
            });
        }

        function deleteInvoice(id) {
            Swal.fire({
                title: 'Are you sure?',
                text: "This will restore stock levels and revert journal accounting voucher entries!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Yes, delete!'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.post('/Sales/DeleteInvoice', { id: id }, function(res) {
                        if (res.success) {
                            Swal.fire('Deleted!', 'Invoice has been deleted.', 'success');
                            $('#row-' + id).fadeOut(300, function() { $(this).remove(); });
                        }
                    });
                }
            });
        }
    </script>
}

