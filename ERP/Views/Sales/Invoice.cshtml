@model SalesPageViewModel<SalesInvoice>
@{
    ViewData["Title"] = "Sales Invoice";
}

<!-- List View -->
<div id="listView">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="m-0 fw-bold text-primary"><i class="fa-solid fa-file-invoice-dollar me-2"></i> Sales Invoices</h4>
            <p class="text-muted small m-0 mt-1">Manage billing invoices, track payments, print receipts, and monitor outstanding balances</p>
        </div>
        <button class="btn btn-primary shadow-sm" onclick="showForm()"><i class="fa-solid fa-plus me-1.5"></i> New Sales Invoice</button>
    </div>

    <!-- Filters Row -->
    <div class="card mb-3 no-print shadow-sm border-0">
        <div class="card-body p-3">
            <div class="row g-3 align-items-center">
                <div class="col-12 col-sm-6 col-md-3">
                    <label class="form-label fw-semibold mb-1 small text-muted">From Date</label>
                    <input type="date" id="filterFromDate" class="form-control form-control-sm" />
                </div>
                <div class="col-12 col-sm-6 col-md-3">
                    <label class="form-label fw-semibold mb-1 small text-muted">To Date</label>
                    <input type="date" id="filterToDate" class="form-control form-control-sm" />
                </div>
                <div class="col-12 col-sm-6 col-md-3">
                    <label class="form-label fw-semibold mb-1 small text-muted">Status</label>
                    <select id="filterStatus" class="form-select form-select-sm">
                        <option value="">All Statuses</option>
                        <option value="Draft">Draft</option>
                        <option value="Pending">Pending</option>
                        <option value="Paid">Paid</option>
                        <option value="Cancelled">Cancelled</option>
                    </select>
                </div>
                <div class="col-12 col-sm-6 col-md-3 d-flex gap-2 align-self-end">
                    <button class="btn btn-sm btn-primary w-100" onclick="applyFilters()"><i class="fa-solid fa-filter me-1"></i> Filter</button>
                    <button class="btn btn-sm btn-outline-secondary w-100" onclick="resetFilters()"><i class="fa-solid fa-rotate me-1"></i> Reset</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Datatable Card -->
    <div class="card shadow-sm border-0">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover datatable align-middle">
                    <thead class="table-light text-uppercase fs-8 fw-bold text-muted">
                        <tr>
                            <th>Invoice No</th>
                            <th>Date</th>
                            <th>Customer</th>
                            <th>Grand Total</th>
                            <th>Paid Amount</th>
                            <th>Balance</th>
                            <th>Status</th>
                            <th class="text-center no-print">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var inv in Model.Items)
                        {
                            <tr id="row-@inv.Id">
                                <td class="fw-bold text-primary">@inv.InvoiceNumber</td>
                                <td>@inv.InvoiceDate.ToString("dd-MM-yyyy")</td>
                                <td class="fw-semibold text-dark">@inv.Customer?.CustomerName</td>
                                <td class="fw-bold text-dark">₹@inv.GrandTotal.ToString("N2")</td>
                                <td>₹@inv.PaidAmount.ToString("N2")</td>
                                <td class="text-danger fw-bold">₹@inv.BalanceAmount.ToString("N2")</td>
                                @{
                                    var statusBadgeClass = inv.Status switch
                                    {
                                        "Pending" or "Draft" => "badge-pending",
                                        "Sent" or "Issued" or "Active" => "badge-sent",
                                        "Completed" or "Paid" or "Accepted" or "Approved" => "badge-accepted",
                                        "Cancelled" or "Rejected" or "Expired" => "badge-rejected",
                                        _ => "badge-accepted"
                                    };
                                    var isLocked = inv.Status == "Paid" || inv.Status == "Cancelled";
                                }
                                <td><span class="badge @statusBadgeClass">@inv.Status</span></td>
                                <td class="text-center no-print">
                                    <div class="btn-group">
                                        @if (isLocked)
                                        {
                                            <button class="btn btn-sm btn-outline-secondary" disabled title="Locked - Cannot edit Paid/Cancelled invoices"><i class="fa-solid fa-lock"></i></button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-sm btn-outline-primary" onclick="editInvoice(@inv.Id)" title="Edit"><i class="fa-solid fa-pen"></i></button>
                                        }
                                        <button class="btn btn-sm btn-outline-secondary" onclick="ErpPrint.printBillById('salesInvoice', @inv.Id)" title="Print"><i class="fa-solid fa-print"></i></button>
                                        <button class="btn btn-sm btn-outline-danger" onclick="deleteInvoice(@inv.Id)" @(isLocked ? "disabled" : "") title="Delete"><i class="fa-solid fa-trash"></i></button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Entry Form View (hidden initially) -->
<div id="formView" style="display:none">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="m-0 fw-bold text-primary" id="formTitle"><i class="fa-solid fa-plus me-2"></i> Create Sales Invoice</h4>
        <button class="btn btn-outline-secondary" onclick="hideForm()"><i class="fa-solid fa-arrow-left me-1.5"></i> Back to List</button>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <form id="invoiceForm">
                <input type="hidden" id="Id" name="Id" value="0" />
                
                <div class="row g-3 mb-4">
                    <div class="col-12 col-sm-6 col-md-2">
                        <label class="form-label fw-semibold text-dark">Invoice Number <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-hashtag text-muted"></i></span>
                            <input type="text" id="InvoiceNumber" class="form-control border-start-0 fw-bold" required readonly />
                        </div>
                    </div>
                    <div class="col-12 col-sm-6 col-md-2">
                        <label class="form-label fw-semibold text-dark">Invoice Date <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="fa-regular fa-calendar text-muted"></i></span>
                            <input type="date" id="InvoiceDate" class="form-control border-start-0" required value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        </div>
                    </div>
                    <div class="col-12 col-sm-6 col-md-3">
                        <label class="form-label fw-semibold text-dark">Customer <span class="text-danger">*</span></label>
                        <select id="CustomerId" class="form-select select2" required>
                            <option value="">Select Customer</option>
                            @foreach (var c in Model.Customers)
                            {
                                <option value="@c.Id">@c.CustomerName (@c.CustomerCode)</option>
                            }
                        </select>
                    </div>
                    <div class="col-12 col-sm-6 col-md-2">
                        <label class="form-label fw-semibold text-dark">Terms (Days)</label>
                        <input type="number" id="CreditDays" class="form-control" value="0" placeholder="0" />
                    </div>
                    <div class="col-12 col-sm-6 col-md-2">
                        <label class="form-label fw-semibold text-dark">Status <span class="text-danger">*</span></label>
                        <select id="Status" class="form-select" required>
                            <option value="Draft">Draft</option>
                            <option value="Issued">Issued</option>
                            <option value="Partially Paid">Partially Paid</option>
                            <option value="Paid">Paid</option>
                            <option value="Cancelled">Cancelled</option>
                        </select>
                    </div>
                    <div class="col-12 col-sm-6 col-md-1 d-flex align-items-center pt-md-4">
                        <div class="form-check form-switch m-0">
                            <input class="form-check-input" type="checkbox" id="WithGST" name="WithGST" onchange="toggleGST(this)" />
                            <label class="form-check-label fw-bold text-dark" for="WithGST">
                                GST
                            </label>
                        </div>
                    </div>
                </div>

                <hr class="my-4" />

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="m-0 fw-bold text-dark"><i class="fa-solid fa-list-check me-2 text-primary"></i> Line Items</h5>
                    <button type="button" class="btn btn-sm btn-outline-primary" onclick="addRow()"><i class="fa-solid fa-plus me-1"></i> Add Item Row</button>
                </div>

                <div class="table-responsive mb-4">
                    <table class="table table-bordered align-middle shadow-sm" id="itemsTable">
                        <thead class="table-light text-uppercase fs-8 fw-bold text-muted">
                            <tr>
                                <th style="width: 200px;">Category</th>
                                <th>Product *</th>
                                <th class="w-100px">Quantity *</th>
                                <th class="w-150px">Rate *</th>
                                <th class="w-100px gst-column">GST %</th>
                                <th class="w-150px">Total</th>
                                <th class="w-60px text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- Dynamic rows inserted via JS -->
                        </tbody>
                    </table>
                </div>

                <div class="d-flex justify-content-between flex-wrap gap-3 mb-4">
                    <div class="flex-grow-1" style="max-width: 500px;">
                        <label class="form-label fw-semibold text-dark">Notes / Terms & Conditions</label>
                        <textarea id="Remarks" class="form-control" rows="3" placeholder="Additional instructions or payment terms..."></textarea>
                    </div>
                    
                    <div class="summary-calc-card text-end ms-auto shadow-sm">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Sub Total:</span>
                            <span id="lblSubTotal" class="fw-bold text-dark">₹0.00</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Total GST:</span>
                            <span id="lblTotalGST" class="fw-bold text-dark">₹0.00</span>
                        </div>
                        <div class="d-flex justify-content-between border-top pt-2 mt-2">
                            <span class="fw-bold text-dark">Grand Total:</span>
                            <span id="lblGrandTotal" class="fw-bold text-primary fs-5">₹0.00</span>
                        </div>
                    </div>
                </div>

                <!-- Sticky Bottom Actions Bar -->
                <div class="d-flex justify-content-end gap-2 border-top pt-3 sticky-bottom bg-white">
                    <button type="button" class="btn btn-secondary px-3" onclick="hideForm()">Cancel</button>
                    <button type="button" class="btn btn-primary px-4 shadow-sm" onclick="saveInvoice()"><i class="fa-solid fa-floppy-disk me-1.5"></i> Save Sales Invoice</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // List of all products preloaded for easy lookup in lines
        var productsList = @Json.Serialize(Model.ProductLookups);
        if (productsList) {
            productsList = productsList.map(function(p) {
                return {
                    id: window.getVal(p, 'id'),
                    productCode: window.getVal(p, 'productCode'),
                    productName: window.getVal(p, 'productName'),
                    salesPrice: window.getVal(p, 'salesPrice'),
                    purchasePrice: window.getVal(p, 'purchasePrice'),
                    gstPercentage: window.getVal(p, 'gstPercentage'),
                    categoryId: window.getVal(p, 'categoryId'),
                    currentStock: window.getVal(p, 'currentStock')
                };
            });
        }

        function showForm() {
            $('#formTitle').html('<i class="fa-solid fa-plus me-2"></i> Create Sales Invoice');
            $('#listView').hide();
            $('#formView').show();
            $('#invoiceForm')[0].reset();
            $('#Id').val("0");
            $('#InvoiceNumber').prop('readonly', true);
            $('#itemsTable tbody').empty();
            $('#CustomerId').val('').trigger('change');
            $('#Status').val('Draft');
            $('#InvoiceDate').val('@DateTime.Today.ToString("yyyy-MM-dd")');
            $('#WithGST').prop('checked', false);
            $('.gst-column').hide();
            ErpPrint.fetchNextBillNumber('sales').done(function(res) {
                $('#InvoiceNumber').val(res.billNumber);
            });
            addRow();
        }

        function editInvoice(id) {
            $.getJSON('/Sales/GetInvoice/' + id, function(inv) {
                $('#formTitle').html('<i class="fa-solid fa-pen me-2"></i> Edit Sales Invoice');
                $('#listView').hide();
                $('#formView').show();
                $('#Id').val(window.getVal(inv, 'id'));
                $('#InvoiceNumber').val(window.getVal(inv, 'invoiceNumber')).prop('readonly', true);
                
                var invDate = window.getVal(inv, 'invoiceDate');
                if (invDate) {
                    $('#InvoiceDate').val(invDate.split('T')[0]);
                }
                
                $('#CustomerId').val(window.getVal(inv, 'customerId')).trigger('change');
                $('#Status').val(window.getVal(inv, 'status'));
                $('#Remarks').val(window.getVal(inv, 'notes') || '');
                
                var payTerms = window.getVal(inv, 'paymentTerms') || '';
                if (payTerms) {
                    var days = parseInt(payTerms) || 0;
                    $('#CreditDays').val(days);
                }

                var withGst = window.getVal(inv, 'withGST') || false;
                $('#WithGST').prop('checked', withGst);
                if (withGst) {
                    $('.gst-column').show();
                } else {
                    $('.gst-column').hide();
                }

                $('#itemsTable tbody').empty();
                
                var items = window.getVal(inv, 'items') || [];
                items.forEach(function(item) {
                    var normalizedItem = {
                        productId: window.getVal(item, 'productId'),
                        quantity: window.getVal(item, 'quantity'),
                        rate: window.getVal(item, 'rate'),
                        taxPercentage: window.getVal(item, 'taxPercentage')
                    };
                    addRow(normalizedItem);
                });
                calculateTotals();
            });
        }

        function hideForm() {
            $('#formView').hide();
            $('#listView').show();
        }

        function addRow(existingItem) {
            var index = $('#itemsTable tbody tr').length;
            
            var catOptionsHtml = '<option value="">All Categories</option>';
            var categoriesList = @Json.Serialize(Model.Categories.Select(c => new { id = c.Id, categoryName = c.CategoryName }));
            if (categoriesList) {
                categoriesList = categoriesList.map(function(c) {
                    return {
                        id: window.getVal(c, 'id'),
                        categoryName: window.getVal(c, 'categoryName')
                    };
                });
            }
            categoriesList.forEach(function(c) {
                catOptionsHtml += `<option value="${c.id}">${c.categoryName}</option>`;
            });

            var optionsHtml = '<option value="">Select Product</option>';
            productsList.forEach(function(p) {
                var optionText = `${p.productName} (${p.productCode}) | Stock: ${p.currentStock || 0} | Price: ₹${(p.salesPrice || 0).toFixed(2)} | GST: ${p.gstPercentage || 0}%`;
                optionsHtml += `<option value="${p.id}">${optionText}</option>`;
            });

            var rowHtml = `
                <tr class="grid-item-row">
                    <td>
                        <select class="form-select select2-category" onchange="onCategorySelect(this)">
                            ${catOptionsHtml}
                        </select>
                    </td>
                    <td>
                        <select class="form-select select2-row" onchange="onProductSelect(this)" required>
                            ${optionsHtml}
                        </select>
                    </td>
                    <td>
                        <input type="number" class="form-control qty-input fw-semibold" value="1" min="1" oninput="calculateRow(this)" required />
                    </td>
                    <td>
                        <input type="number" class="form-control rate-input fw-semibold" value="0.00" step="0.01" oninput="calculateRow(this)" required />
                    </td>
                    <td class="gst-column">
                        <input type="number" class="form-control gst-input" value="18" oninput="calculateRow(this)" required />
                    </td>
                    <td>
                        <input type="text" class="form-control total-input fw-bold text-dark" value="0.00" readonly />
                    </td>
                    <td class="text-center">
                        <button type="button" class="btn btn-sm btn-outline-danger" onclick="removeRow(this)"><i class="fa-solid fa-trash"></i></button>
                    </td>
                </tr>
            `;

            var $row = $(rowHtml);
            $('#itemsTable tbody').append($row);
            window.initializeSelect2($row.find('.select2-row'));
            window.initializeSelect2($row.find('.select2-category'));

            if ($('#WithGST').is(':checked')) {
                $row.find('.gst-column').show();
            } else {
                $row.find('.gst-column').hide();
                $row.find('.gst-input').val(0);
            }

            if (existingItem) {
                $row.find('.select2-row').val(existingItem.productId).trigger('change');
                $row.find('.qty-input').val(existingItem.quantity);
                $row.find('.rate-input').val(existingItem.rate);
                $row.find('.gst-input').val(existingItem.taxPercentage);
                $row.find('.total-input').val((existingItem.quantity * existingItem.rate).toFixed(2));
            }
        }

        function removeRow(btn) {
            $(btn).closest('tr').remove();
            calculateTotals();
        }

        function onCategorySelect(select) {
            var catId = $(select).val();
            var $row = $(select).closest('tr');
            var $prodSelect = $row.find('.select2-row');
            
            $prodSelect.empty();
            $prodSelect.append('<option value="">Select Product</option>');
            
            productsList.forEach(function(p) {
                if (!catId || p.categoryId == catId) {
                    var optionText = `${p.productName} (${p.productCode}) | Stock: ${p.currentStock || 0} | Price: ₹${(p.salesPrice || 0).toFixed(2)} | GST: ${p.gstPercentage || 0}%`;
                    $prodSelect.append(`<option value="${p.id}">${optionText}</option>`);
                }
            });
            $prodSelect.trigger('change');
        }

        function onProductSelect(select) {
            var prodId = $(select).val();
            var product = productsList.find(p => p.id == prodId);
            var $row = $(select).closest('tr');
            if (product) {
                $row.find('.rate-input').val(product.salesPrice);
                $row.find('.gst-input').val(product.gstPercentage);
            }
            calculateRow(select);
        }

        function calculateRow(elem) {
            var $row = $(elem).closest('tr');
            var qty = parseFloat($row.find('.qty-input').val()) || 0;
            var rate = parseFloat($row.find('.rate-input').val()) || 0;
            var gst = parseFloat($row.find('.gst-input').val()) || 0;

            var total = qty * rate;
            $row.find('.total-input').val(total.toFixed(2));

            calculateTotals();
        }

        function toggleGST(elem) {
            var isChecked = $(elem).is(':checked');
            if (isChecked) {
                $('.gst-column').show();
            } else {
                $('.gst-column').hide();
                $('.gst-input').val(0);
            }
            calculateTotals();
        }

        function calculateTotals() {
            var subTotal = 0;
            var totalGST = 0;
            var withGst = $('#WithGST').is(':checked');

            $('#itemsTable tbody tr').each(function() {
                var qty = parseFloat($(this).find('.qty-input').val()) || 0;
                var rate = parseFloat($(this).find('.rate-input').val()) || 0;
                var gst = withGst ? (parseFloat($(this).find('.gst-input').val()) || 0) : 0;

                var lineTotal = qty * rate;
                var lineGST = lineTotal * (gst / 100);

                subTotal += lineTotal;
                totalGST += lineGST;
            });

            var grandTotal = subTotal + totalGST;

            $('#lblSubTotal').text('₹' + subTotal.toFixed(2));
            $('#lblTotalGST').text('₹' + totalGST.toFixed(2));
            $('#lblGrandTotal').text('₹' + grandTotal.toFixed(2));

            if (withGst) {
                $('#lblTotalGST').closest('div').show();
            } else {
                $('#lblTotalGST').closest('div').hide();
            }
        }

        function saveInvoice() {
            var items = [];
            var isValid = true;

            $('#itemsTable tbody tr').each(function() {
                var prodId = $(this).find('.select2-row').val();
                var qty = parseFloat($(this).find('.qty-input').val()) || 0;
                var rate = parseFloat($(this).find('.rate-input').val()) || 0;
                var gst = parseFloat($(this).find('.gst-input').val()) || 0;

                if (!prodId || qty <= 0 || rate <= 0) {
                    isValid = false;
                    return false;
                }

                var product = productsList.find(p => p.id == prodId);
                items.push({
                    productId: parseInt(prodId),
                    productName: product ? product.productName : '',
                    quantity: qty,
                    rate: rate,
                    taxPercentage: gst,
                    discount: 0,
                    taxAmount: qty * rate * (gst / 100),
                    amount: (qty * rate) + (qty * rate * (gst / 100))
                });
            });

            var customerId = $('#CustomerId').val();
            if (!customerId || items.length === 0 || !isValid) {
                Swal.fire('Error!', 'Please fill all required fields and add at least one valid line item.', 'error');
                return;
            }

            var invoice = {
                id: parseInt($('#Id').val()) || 0,
                invoiceNumber: $('#InvoiceNumber').val(),
                invoiceDate: $('#InvoiceDate').val(),
                customerId: parseInt(customerId),
                notes: $('#Remarks').val(),
                paymentTerms: $('#CreditDays').val() + " Days",
                status: $('#Status').val(),
                subTotal: parseFloat($('#lblSubTotal').text().replace('₹', '')) || 0,
                taxAmount: parseFloat($('#lblTotalGST').text().replace('₹', '')) || 0,
                grandTotal: parseFloat($('#lblGrandTotal').text().replace('₹', '')) || 0,
                balanceAmount: parseFloat($('#lblGrandTotal').text().replace('₹', '')) || 0,
                items: items,
                withGST: $('#WithGST').is(':checked')
            };

            $.ajax({
                url: '/Sales/SaveInvoice',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(invoice),
                success: function(res) {
                    if (res.success) {
                        Swal.fire('Saved!', res.message, 'success').then(() => {
                            location.reload();
                        });
                    } else {
                        Swal.fire('Error!', res.message, 'error');
                    }
                },
                error: function(xhr) {
                    Swal.fire('Error!', xhr.responseJSON?.message || 'Failed to save invoice.', 'error');
                }
            });
        }

        function deleteInvoice(id) {
            Swal.fire({
                title: 'Are you sure?',
                text: "This will restore stock levels and revert journal accounting voucher entries!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Yes, delete!'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.post('/Sales/DeleteInvoice', { id: id }, function(res) {
                        if (res.success) {
                            Swal.fire('Deleted!', 'Invoice has been deleted.', 'success');
                            $('#row-' + id).fadeOut(300, function() { $(this).remove(); });
                        }
                    });
                }
            });
        }
    </script>
}
