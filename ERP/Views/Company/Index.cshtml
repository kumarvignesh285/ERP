                                                        <span class="input-group-text bg-white border-end-0"><i class="fa-regular fa-envelope text-muted"></i></span>
                                                        <input type="email" name="AdminEmail" id="createAdminEmail" class="form-control border-start-0" placeholder="admin@company.com" maxlength="100" />
                                                    </div>
                                                </div>
                                                <div class="col-12 col-md-6">
                                                    <label class="form-label fw-semibold text-dark">Admin Mobile</label>
