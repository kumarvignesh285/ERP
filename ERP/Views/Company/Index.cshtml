@model List<ERP.Models.Company>
@{
    ViewData["Title"] = "Company Management";
    var totalCompanies = Model?.Count ?? 0;
    var activeCompanies = Model?.Count(c => c.IsActive) ?? 0;
    var inactiveCompanies = totalCompanies - activeCompanies;
}

@Html.AntiForgeryToken()

<!-- Page Header -->
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h4 class="m-0 fw-bold text-primary">
            <i class="fa-solid fa-building-user me-2"></i> Company Management
        </h4>
        <p class="text-muted small m-0 mt-1">
            System-level tenant administration, company provisioning, and multi-tenant isolation
        </p>
    </div>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-primary shadow-sm" data-bs-toggle="modal" data-bs-target="#createCompanyModal">
            <i class="fa-solid fa-circle-plus me-1.5"></i> Create New Company
        </button>
    </div>
</div>

<!-- Metric Cards Row -->
<div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-xl-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body d-flex align-items-center gap-3 py-3">
                <div class="bg-primary-subtle text-primary p-3 rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                    <i class="fa-solid fa-buildings fs-5"></i>
                </div>
                <div>
                    <h6 class="text-muted small text-uppercase fw-semibold mb-1">Total Companies</h6>
                    <h4 class="fw-bold mb-0 text-dark">@totalCompanies</h4>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body d-flex align-items-center gap-3 py-3">
                <div class="bg-success-subtle text-success p-3 rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                    <i class="fa-solid fa-circle-check fs-5"></i>
                </div>
                <div>
                    <h6 class="text-muted small text-uppercase fw-semibold mb-1">Active Tenants</h6>
                    <h4 class="fw-bold mb-0 text-success">@activeCompanies</h4>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body d-flex align-items-center gap-3 py-3">
                <div class="bg-danger-subtle text-danger p-3 rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                    <i class="fa-solid fa-ban fs-5"></i>
                </div>
                <div>
                    <h6 class="text-muted small text-uppercase fw-semibold mb-1">Inactive Tenants</h6>
                    <h4 class="fw-bold mb-0 text-danger">@inactiveCompanies</h4>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Alerts -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 mb-4" role="alert">
        <i class="fa-solid fa-circle-check fs-5"></i>
        <div>@TempData["Success"]</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 mb-4" role="alert">
        <i class="fa-solid fa-triangle-exclamation fs-5"></i>
        <div>@TempData["Error"]</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Company Table Card -->
<div class="card shadow-sm border-0">
    <div class="card-header bg-transparent border-bottom py-3">
        <div class="row g-2 align-items-center justify-content-between">
            <div class="col-12 col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0">
                        <i class="fa-solid fa-magnifying-glass text-muted"></i>
                    </span>
                    <input type="text" id="companyTableSearch" class="form-control border-start-0" placeholder="Search by Code, Name, Phone, Email, GST..." value="@ViewBag.Search" />
                </div>
            </div>
            <div class="col-12 col-md-4 col-lg-3 d-flex align-items-center gap-2 justify-content-md-end">
                <label for="statusFilter" class="form-label small fw-semibold text-muted mb-0 text-nowrap">Status:</label>
                <select id="statusFilter" class="form-select form-select-sm">
                    <option value="All" selected="@(ViewBag.Status == "All")">All Statuses</option>
                    <option value="Active" selected="@(ViewBag.Status == "Active")">Active Only</option>
                    <option value="Inactive" selected="@(ViewBag.Status == "Inactive")">Inactive Only</option>
                </select>
            </div>
        </div>
    </div>

    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="companiesTable">
                <thead class="table-light text-uppercase fs-8 fw-bold text-muted border-bottom">
                    <tr>
                        <th style="width: 50px;" class="text-center">#</th>
                        <th style="min-width: 220px;">Company</th>
                        <th style="min-width: 110px;">Tenant Code</th>
                        <th style="min-width: 140px;">Business Type</th>
                        <th style="min-width: 180px;">Contact Info</th>
                        <th style="min-width: 140px;">Location</th>
                        <th style="min-width: 110px;" class="text-center">Status</th>
                        <th style="min-width: 140px;" class="text-center no-print">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        var rowIdx = 1;
                        foreach (var item in Model)
                        {
                            <tr id="company-row-@item.Id" data-status="@(item.IsActive ? "Active" : "Inactive")" data-search="@(item.CompanyCode.ToLower()) @(item.CompanyName.ToLower()) @(item.Phone?.ToLower() ?? "") @(item.Email?.ToLower() ?? "") @(item.GSTNumber?.ToLower() ?? "")">
                                <td class="text-center text-muted fw-semibold fs-8">@rowIdx</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2.5">
                                        @if (!string.IsNullOrEmpty(item.Logo))
                                        {
                                            <img src="@item.Logo" alt="Logo" class="rounded border" style="width: 38px; height: 38px; object-fit: contain;" />
                                        }
                                        else
                                        {
                                            <div class="bg-primary-subtle text-primary fw-bold rounded d-flex align-items-center justify-content-center border" style="width: 38px; height: 38px; font-size: 14px;">
                                                @(item.CompanyName.Length > 0 ? item.CompanyName.Substring(0, 1).ToUpper() : "C")
                                            </div>
                                        }
                                        <div>
                                            <div class="fw-bold text-dark text-truncate" style="max-width: 220px;" title="@item.CompanyName">
                                                @item.CompanyName
                                            </div>
                                            @if (!string.IsNullOrEmpty(item.GSTNumber))
                                            {
                                                <div class="text-muted fs-8">GST: <span class="font-monospace">@item.GSTNumber</span></div>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border font-monospace px-2 py-1 fs-8 fw-semibold">
                                        <i class="fa-solid fa-hashtag text-muted me-1"></i>@item.CompanyCode
                                    </span>
                                </td>
                                <td>
                                    <span class="text-muted small">
                                        @(string.IsNullOrEmpty(item.BusinessType) ? "—" : item.BusinessType)
                                    </span>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.Phone))
                                    {
                                        <div class="small text-dark"><i class="fa-solid fa-phone fs-8 text-muted me-1"></i>@item.Phone</div>
                                    }
                                    @if (!string.IsNullOrEmpty(item.Email))
                                    {
                                        <div class="small text-muted text-truncate" style="max-width: 170px;" title="@item.Email">
                                            <i class="fa-regular fa-envelope fs-8 text-muted me-1"></i>@item.Email
                                        </div>
                                    }
                                    @if (string.IsNullOrEmpty(item.Phone) && string.IsNullOrEmpty(item.Email))
                                    {
                                        <span class="text-muted small">—</span>
                                    }
                                </td>
                                <td>
                                    <div class="small text-dark">@(item.City ?? "—")</div>
                                    <div class="text-muted fs-8">@(item.State ?? "")</div>
                                </td>
                                <td class="text-center status-col">
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2.5 py-1 fw-bold">
                                            <i class="fa-solid fa-circle-check me-1 fs-8"></i> Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2.5 py-1 fw-bold">
                                            <i class="fa-solid fa-circle-xmark me-1 fs-8"></i> Inactive
                                        </span>
                                    }
                                </td>
                                <td class="text-center no-print">
                                    <div class="btn-group">
                                        <button type="button" class="btn btn-sm btn-outline-info view-company-btn" data-id="@item.Id" title="View Company Details">
                                            <i class="fa-regular fa-eye"></i>
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-primary edit-company-btn" data-id="@item.Id" title="Edit Company">
                                            <i class="fa-solid fa-pen-to-square"></i>
                                        </button>
                                        @if (item.IsActive)
                                        {
                                            <form action="/Company/SwitchCompany" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="companyId" value="@item.Id" />
                                                <input type="hidden" name="returnUrl" value="/Company" />
                                                <button type="submit" class="btn btn-sm btn-outline-secondary" title="Switch Working Context to @item.CompanyCode">
                                                    <i class="fa-solid fa-arrow-right-to-bracket"></i>
                                                </button>
                                            </form>
                                        }
                                        <button type="button" class="btn btn-sm btn-outline-info init-sample-data-btn"
                                                data-id="@item.Id"
                                                data-name="@item.CompanyName"
                                                data-code="@item.CompanyCode"
                                                title="Initialize Sample Data for @item.CompanyCode">
                                            <i class="fa-solid fa-wand-magic-sparkles"></i>
                                        </button>
                                        <button type="button" class="btn btn-sm @(item.IsActive ? "btn-outline-warning" : "btn-outline-success") toggle-status-btn"
                                                data-id="@item.Id"
                                                data-name="@item.CompanyName"
                                                data-active="@item.IsActive.ToString().ToLowerInvariant()"
                                                title="@(item.IsActive ? "Deactivate Company" : "Activate Company")">
                                            <i class="fa-solid @(item.IsActive ? "fa-ban text-warning" : "fa-check text-success")"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                            rowIdx++;
                        }
                    }
                    else
                    {
                        <tr id="emptyRow">
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="fa-solid fa-building-circle-xmark fs-1 d-block mb-3 text-secondary"></i>
                                <div class="fw-semibold">No companies found</div>
                                <p class="small text-muted mb-3">Get started by creating your first ERP company tenant.</p>
                                <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#createCompanyModal">
                                    <i class="fa-solid fa-plus me-1"></i> Create Company
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ================= CREATE COMPANY MODAL ================= -->
<div class="modal fade" id="createCompanyModal" tabindex="-1" aria-labelledby="createCompanyModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white py-3">
                <h5 class="modal-title fw-bold" id="createCompanyModalLabel">
                    <i class="fa-solid fa-building-circle-check me-2"></i> Create New Company
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="Create" asp-controller="Company" method="post" enctype="multipart/form-data" id="createCompanyForm" class="needs-validation" novalidate>
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <!-- Nav Tabs inside Modal -->
                    <ul class="nav nav-pills nav-fill mb-4 p-1 bg-light rounded" id="createCompanyTabs" role="tablist">
                        <li class="nav-item">
                            <button class="nav-link active py-2 fw-semibold" id="tab-create-info-btn" data-bs-toggle="pill" data-bs-target="#tab-create-info" type="button">
                                <i class="fa-solid fa-id-card me-1"></i> Basic Info
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link py-2 fw-semibold" id="tab-create-contact-btn" data-bs-toggle="pill" data-bs-target="#tab-create-contact" type="button">
                                <i class="fa-solid fa-location-dot me-1"></i> Contact & Address
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link py-2 fw-semibold" id="tab-create-tax-btn" data-bs-toggle="pill" data-bs-target="#tab-create-tax" type="button">
                                <i class="fa-solid fa-file-invoice-dollar me-1"></i> Tax & Legal
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link py-2 fw-semibold" id="tab-create-settings-btn" data-bs-toggle="pill" data-bs-target="#tab-create-settings" type="button">
                                <i class="fa-solid fa-sliders me-1"></i> Branding & Settings
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link py-2 fw-semibold" id="tab-create-users-btn" data-bs-toggle="pill" data-bs-target="#tab-create-users" type="button">
                                <i class="fa-solid fa-users-gear me-1"></i> Admin & Users
                            </button>
                        </li>
                    </ul>

                    <div class="tab-content" id="createCompanyTabsContent">
                        <!-- Tab 1: Basic Info -->
                        <div class="tab-pane fade show active" id="tab-create-info">
                            <div class="row g-3">
                                <div class="col-12 col-md-7">
                                    <label class="form-label fw-semibold text-dark">Company Name <span class="text-danger">*</span></label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-building text-muted"></i></span>
                                        <input type="text" name="CompanyName" id="createCompanyName" class="form-control border-start-0" placeholder="e.g. Acme Industrial Tools" required maxlength="200" />
                                    </div>
                                    <div class="invalid-feedback">Company Name is required.</div>
                                </div>
                                <div class="col-12 col-md-5">
                                    <label class="form-label fw-semibold text-dark">Company Code <span class="text-danger">*</span></label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-barcode text-muted"></i></span>
                                        <input type="text" name="CompanyCode" id="createCompanyCode" class="form-control border-start-0 text-uppercase font-monospace" placeholder="e.g. ACM001" required maxlength="20" />
                                    </div>
                                    <div id="createCodeFeedback" class="small mt-1 d-none"></div>
                                    <div class="invalid-feedback">Company Code is required (alphanumeric).</div>
                                </div>
                                <div class="col-12 col-md-6">
                                    <label class="form-label fw-semibold text-dark">Business Type</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-briefcase text-muted"></i></span>
                                        <input type="text" name="BusinessType" class="form-control border-start-0" placeholder="e.g. Retail, Manufacturing, Wholesale" maxlength="100" />
                                    </div>
                                </div>
                                <div class="col-12 col-md-6">
                                    <label class="form-label fw-semibold text-dark">Initial Status</label>
                                    <select name="IsActive" class="form-select">
                                        <option value="true" selected>Active (Standard)</option>
                                        <option value="false">Inactive (Suspended)</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <!-- Tab 2: Contact & Address -->
                        <div class="tab-pane fade" id="tab-create-contact">
                            <div class="row g-3">
                                <div class="col-12">
                                    <label class="form-label fw-semibold text-dark">Address</label>
                                    <textarea name="Address" class="form-control" rows="2" placeholder="Street Address, Industrial Area..." maxlength="500"></textarea>
                                </div>
                                <div class="col-12 col-sm-6 col-md-3">
                                    <label class="form-label fw-semibold text-dark">City</label>
                                    <input type="text" name="City" class="form-control" placeholder="City" maxlength="100" />
                                </div>
                                <div class="col-12 col-sm-6 col-md-3">
                                    <label class="form-label fw-semibold text-dark">State</label>
                                    <input type="text" name="State" class="form-control" placeholder="State" maxlength="100" />
                                </div>
                                <div class="col-12 col-sm-6 col-md-3">
                                    <label class="form-label fw-semibold text-dark">Country</label>
                                    <input type="text" name="Country" class="form-control" value="India" maxlength="100" />
                                </div>
                                <div class="col-12 col-sm-6 col-md-3">
                                    <label class="form-label fw-semibold text-dark">Pincode</label>
                                    <input type="text" name="Pincode" class="form-control" placeholder="Pincode / ZIP" maxlength="20" />
                                </div>
                                <div class="col-12 col-md-6">
                                    <label class="form-label fw-semibold text-dark">Primary Phone</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-phone text-muted"></i></span>
                                        <input type="tel" name="Phone" class="form-control border-start-0" placeholder="e.g. 9876543210" maxlength="20" />
                                    </div>
                                </div>
                                <div class="col-12 col-md-6">
                                    <label class="form-label fw-semibold text-dark">Alternate Phone</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-phone-volume text-muted"></i></span>
                                        <input type="tel" name="AlternatePhone" class="form-control border-start-0" placeholder="e.g. 044-23456789" maxlength="20" />
                                    </div>
                                </div>
                                <div class="col-12 col-md-6">
                                    <label class="form-label fw-semibold text-dark">Email Address</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light border-end-0"><i class="fa-regular fa-envelope text-muted"></i></span>
                                        <input type="email" name="Email" class="form-control border-start-0" placeholder="info@company.com" maxlength="100" />
                                    </div>
                                </div>
                                <div class="col-12 col-md-6">
                                    <label class="form-label fw-semibold text-dark">Website</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-globe text-muted"></i></span>
                                        <input type="url" name="Website" class="form-control border-start-0" placeholder="https://www.company.com" maxlength="200" />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Tab 3: Tax & Legal -->
                        <div class="tab-pane fade" id="tab-create-tax">
                            <div class="row g-3">
                                <div class="col-12 col-md-6">
                                    <label class="form-label fw-semibold text-dark">GST Number</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-file-invoice text-muted"></i></span>
                                        <input type="text" name="GSTNumber" class="form-control border-start-0 text-uppercase font-monospace" placeholder="33AAAAA0000A1Z5" maxlength="20" />
                                    </div>
                                </div>
                                <div class="col-12 col-md-6">
                                    <label class="form-label fw-semibold text-dark">PAN Number</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-address-card text-muted"></i></span>
                                        <input type="text" name="PANNumber" class="form-control border-start-0 text-uppercase font-monospace" placeholder="AAAAA0000A" maxlength="15" />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Tab 4: Branding & Settings -->
                        <div class="tab-pane fade" id="tab-create-settings">
                            <div class="row g-3">
                                <div class="col-12 col-md-6">
                                    <label class="form-label fw-semibold text-dark">Currency</label>
                                    <input type="text" name="Currency" class="form-control" value="INR" maxlength="10" placeholder="INR" />
                                </div>
                                <div class="col-12 col-md-6">
                                    <label class="form-label fw-semibold text-dark">Financial Year</label>
                                    <input type="text" name="FinancialYear" class="form-control" value="@($"{DateTime.Now.Year}-{(DateTime.Now.Year + 1)}")" maxlength="20" placeholder="e.g. 2026-2027" />
                                </div>
                                <div class="col-12">
                                    <label class="form-label fw-semibold text-dark">Company Logo</label>
                                    <input type="file" name="logoFile" class="form-control" accept=".png,.jpg,.jpeg,.webp" id="createLogoInput" />
                                    <div class="form-text small">Upload PNG, JPG, or WEBP under 2MB.</div>
                                    <div id="createLogoPreviewContainer" class="mt-2 d-none">
                                        <img id="createLogoPreview" src="" alt="Preview" class="rounded border p-1" style="max-height: 70px;" />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Tab 5: Admin & Users Provisioning -->
                        <div class="tab-pane fade" id="tab-create-users">
                            <div class="row g-3">
                                <!-- Company Admin Section -->
                                <div class="col-12">
                                    <div class="card border-primary border-opacity-25 bg-light bg-opacity-50 shadow-none">
                                        <div class="card-body p-3">
                                            <div class="d-flex align-items-center justify-content-between mb-3 border-bottom pb-2">
                                                <div class="d-flex align-items-center gap-2">
                                                    <span class="badge bg-primary text-white p-2 rounded"><i class="fa-solid fa-user-shield"></i></span>
                                                    <div>
                                                        <h6 class="fw-bold mb-0 text-primary">Company Administrator Account</h6>
                                                        <span class="text-muted fs-8">Primary system manager for this company (Role: CompanyAdmin)</span>
                                                    </div>
                                                </div>
                                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle font-monospace">CompanyAdmin</span>
                                            </div>

                                            <div class="row g-3">
                                                <div class="col-12 col-md-6">
                                                    <label class="form-label fw-semibold text-dark">Admin Full Name <span class="text-danger">*</span></label>
                                                    <div class="input-group">
                                                        <span class="input-group-text bg-white border-end-0"><i class="fa-regular fa-user text-muted"></i></span>
                                                        <input type="text" name="AdminFullName" id="createAdminFullName" class="form-control border-start-0" placeholder="e.g. John Smith" required maxlength="100" />
                                                    </div>
                                                    <div class="invalid-feedback">Admin Name is required.</div>
                                                </div>
                                                <div class="col-12 col-md-6">
                                                    <label class="form-label fw-semibold text-dark">Admin Username</label>
                                                    <div class="input-group">
