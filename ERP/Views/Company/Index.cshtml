@section Scripts {
<script>
$(document).ready(function () {
    const antiForgeryToken = $('input[name="__RequestVerificationToken"]').first().val();

    // ================= CLIENT-SIDE SEARCH & STATUS FILTER =================
    function filterTable() {
        const searchTerm = $('#companyTableSearch').val().toLowerCase().trim();
        const statusFilter = $('#statusFilter').val();
        let visibleCount = 0;

        $('#companiesTable tbody tr').each(function () {
            if ($(this).attr('id') === 'emptyRow') return;

            const rowSearch = $(this).attr('data-search') || '';
            const rowStatus = $(this).attr('data-status') || '';

            const matchesSearch = !searchTerm || rowSearch.includes(searchTerm);
            const matchesStatus = (statusFilter === 'All') || (rowStatus === statusFilter);

            if (matchesSearch && matchesStatus) {
                $(this).show();
                visibleCount++;
            } else {
                $(this).hide();
            }
        });

        if (visibleCount === 0 && $('#companiesTable tbody tr[id!="emptyRow"]').length > 0) {
            if ($('#noResultsRow').length === 0) {
                $('#companiesTable tbody').append('<tr id="noResultsRow"><td colspan="8" class="text-center py-4 text-muted"><i class="fa-solid fa-search me-1"></i> No companies match the search/filter criteria.</td></tr>');
            } else {
                $('#noResultsRow').show();
            }
        } else {
            $('#noResultsRow').hide();
        }
    }

    $('#companyTableSearch').on('input', filterTable);
    $('#statusFilter').on('change', filterTable);

    // ================= LIVE COMPANY CODE AVAILABILITY CHECK =================
    let codeCheckTimeout;
    $('#createCompanyCode').on('input', function () {
        const input = $(this);
        const code = input.val().trim().toUpperCase();
        input.val(code);

        const feedback = $('#createCodeFeedback');
        clearTimeout(codeCheckTimeout);

        if (!code) {
            feedback.addClass('d-none').text('');
            return;
        }

        if (code.length < 2) {
            feedback.removeClass('d-none text-success').addClass('text-danger').text('Code must be at least 2 characters.');
            return;
        }

        feedback.removeClass('d-none text-success text-danger').addClass('text-muted').html('<i class="fa-solid fa-spinner fa-spin me-1"></i> Checking availability...');

        codeCheckTimeout = setTimeout(function () {
            $.ajax({
                url: '/Company/CheckCode',
                type: 'GET',
                data: { code: code },
                success: function (res) {
                    if (res.isAvailable) {
                        feedback.removeClass('d-none text-danger text-muted').addClass('text-success').html('<i class="fa-solid fa-check me-1"></i> Company Code is available');
                        $('#btnSubmitCreate').prop('disabled', false);

                        // Auto-populate Admin & User usernames
                        $.get('/Company/GetProvisioningDefaults', { code: code }, function (defs) {
                            $('#createAdminUsername').val(defs.adminUsername || (code + '_ADMIN'));
                            $('#createUserUsername').val(defs.userUsername || (code + '_USER01'));
                        });
                    } else {
                        feedback.removeClass('d-none text-success text-muted').addClass('text-danger').html('<i class="fa-solid fa-xmark me-1"></i> ' + res.message);
                        $('#btnSubmitCreate').prop('disabled', true);
                    }
                },
                error: function () {
                    feedback.addClass('d-none');
                }
            });
        }, 350);
    });

    // ================= INITIAL USER TOGGLE =================
    $('#chkCreateInitialUser').on('change', function () {
        if ($(this).is(':checked')) {
            $('#initialUserFields').removeClass('d-none');
            $('#createUserPassword').prop('required', true);
            $('#createUserConfirmPassword').prop('required', true);
        } else {
            $('#initialUserFields').addClass('d-none');
            $('#createUserPassword').prop('required', false).val('');
            $('#createUserConfirmPassword').prop('required', false).val('');
        }
    });

    // ================= TOGGLE PASSWORD VISIBILITY =================
    $(document).on('click', '.toggle-pwd-btn', function () {
        const targetSelector = $(this).data('target');
        const input = $(targetSelector);
        const icon = $(this).find('i');
        if (input.attr('type') === 'password') {
            input.attr('type', 'text');
            icon.removeClass('fa-eye').addClass('fa-eye-slash');
        } else {
            input.attr('type', 'password');
            icon.removeClass('fa-eye-slash').addClass('fa-eye');
        }
    });

    // ================= CHECK PROVISIONING SUCCESS FLASH =================
    @if (TempData["ProvisionSuccessJson"] != null)
    {
        <text>
        try {
            var provData = @Html.Raw(TempData["ProvisionSuccessJson"]);
            if (provData && provData.Success) {
                $('#provModalCompanyName').text(provData.CompanyName || '—');
                $('#provModalCompanyCode').text(provData.CompanyCode || '—');
                $('#provModalAdminUsername').text(provData.AdminUsername || '—');
                $('#provModalAdminName').text(provData.AdminFullName || '—');

                if (provData.InitialUsername) {
                    $('#provModalUserUsername').text(provData.InitialUsername);
                    $('#provModalUserName').text(provData.InitialUserFullName || '—');
                    $('#provModalUserRole').text(provData.InitialUserRole || 'CompanyUser');
                    $('#provModalUserCard').removeClass('d-none');
                } else {
                    $('#provModalUserCard').addClass('d-none');
                }

                if (provData.SampleDataInitialized) {
                    $('#provModalSampleSummary').text(provData.SampleDataSummary || 'Master catalog, products, customers, and suppliers generated.');
                    $('#provModalSampleCard').removeClass('d-none');
                } else {
                    $('#provModalSampleCard').addClass('d-none');
                }

                var provModal = new bootstrap.Modal(document.getElementById('provisionSuccessModal'));
                provModal.show();
            }
        } catch (e) {
            console.error('Error rendering provisioning modal:', e);
        }
        </text>
    }

    // ================= INITIALIZE SAMPLE DATA MODAL HANDLER =================
    let targetInitCompanyId = null;
    $(document).on('click', '.init-sample-data-btn', function () {
        targetInitCompanyId = $(this).data('id');
        const companyName = $(this).data('name');
        const companyCode = $(this).data('code');

        $('#initSampleCompanyName').text(companyName);
        $('#initSampleCompanyCode').text(companyCode);
        $('#initSampleDataModal').modal('show');
    });

    // ================= FORM SUBMISSION HANDLERS =================
    var createCompanyModalEl = document.getElementById('createCompanyModal');
    var createCompanyModal = createCompanyModalEl ? new bootstrap.Modal(createCompanyModalEl) : null;
    var editCompanyModalEl = document.getElementById('editCompanyModal');
    var editCompanyModal = editCompanyModalEl ? new bootstrap.Modal(editCompanyModalEl) : null;

    $('#createCompanyForm').on('submit', function (e) {
        e.preventDefault();
        ErpApp.submitForm(this, {
            button: '#btnSubmitCreate',
            modal: createCompanyModal,
            loadingText: 'Provisioning Company...',
            onSuccess: function (res) {
                $('#createCompanyForm')[0].reset();
                $('#createLogoPreviewContainer').addClass('d-none');
                $('#createCodeFeedback').addClass('d-none').text('');
                $('#initialUserFields').addClass('d-none');
                $('#createAdminPassword').val('');
                $('#createAdminConfirmPassword').val('');
                $('#createUserPassword').val('');
                $('#createUserConfirmPassword').val('');
                var firstTab = new bootstrap.Tab(document.querySelector('#tab-create-info-btn'));
                if (firstTab) firstTab.show();
            },
            reloadPage: true
        });
    });

    $('#editCompanyForm').on('submit', function (e) {
        e.preventDefault();
        ErpApp.submitForm(this, {
            button: '#btnSubmitEdit',
            modal: editCompanyModal,
            loadingText: 'Saving Company...',
            onSuccess: function (res) {
                $('#editAdminNewPassword').val('');
                $('#editAdminConfirmPassword').val('');
            },
            reloadPage: true
        });
    });

    $('#confirmInitSampleBtn').on('click', function () {
        if (!targetInitCompanyId) return;

        const btn = $(this);
        ErpApp.setButtonLoading(btn, true, 'Initializing...');

        $.ajax({
            url: '/Company/InitializeSampleData/' + targetInitCompanyId,
            type: 'POST',
            headers: { 'RequestVerificationToken': antiForgeryToken },
            success: function (res) {
                $('#initSampleDataModal').modal('hide');
                ErpApp.setButtonLoading(btn, false);

                if (res && res.success) {
                    ErpApp.notify(res.message || 'Sample data initialized.', 'success');
                    setTimeout(function () { location.reload(); }, 600);
                } else {
                    ErpApp.notify(res?.message || 'Failed to initialize sample data.', 'error');
                }
            },
            error: function (xhr) {
                $('#initSampleDataModal').modal('hide');
                ErpApp.setButtonLoading(btn, false);
                var msg = xhr.responseJSON?.message || 'A server error occurred while initializing sample data.';
                ErpApp.notify(msg, 'error');
            }
        });
    });

    // ================= LOGO FILE PREVIEW =================
    $('#createLogoInput').on('change', function () {
        const file = this.files[0];
        if (file) {
            if (file.size > 2 * 1024 * 1024) {
                ErpApp.notify('File size must be less than 2 MB.', 'warning', 'File Size Limit');
                this.value = '';
                $('#createLogoPreviewContainer').addClass('d-none');
                return;
            }
            const reader = new FileReader();
            reader.onload = function (e) {
                $('#createLogoPreview').attr('src', e.target.result);
                $('#createLogoPreviewContainer').removeClass('d-none');
            };
            reader.readAsDataURL(file);
        } else {
            $('#createLogoPreviewContainer').addClass('d-none');
        }
    });

    $('#editLogoInput').on('change', function () {
        const file = this.files[0];
        if (file) {
            if (file.size > 2 * 1024 * 1024) {
                ErpApp.notify('File size must be less than 2 MB.', 'warning', 'File Size Limit');
                this.value = '';
                return;
            }
            const reader = new FileReader();
            reader.onload = function (e) {
                $('#editLogoPreview').attr('src', e.target.result);
                $('#editLogoPreviewContainer').removeClass('d-none');
            };
            reader.readAsDataURL(file);
        }
    });

    // ================= VIEW DETAILS MODAL =================
    $(document).on('click', '.view-company-btn', function () {
        const companyId = $(this).data('id');
        $.ajax({
            url: '/Company/GetCompany/' + companyId,
            type: 'GET',
            success: function (c) {
                $('#viewCompanyName').text(c.companyName || '—');
                $('#viewCompanyCode').text(c.companyCode || '—');
                $('#viewBusinessType').text(c.businessType || '—');
                $('#viewCurrency').text(c.currency || 'INR');
                $('#viewFinancialYear').text(c.financialYear || '—');
                $('#viewPhone').text(c.phone || '—');
                $('#viewAlternatePhone').text(c.alternatePhone || '—');
                $('#viewEmail').text(c.email || '—');
                $('#viewGSTNumber').text(c.gstNumber || '—');
                $('#viewPANNumber').text(c.panNumber || '—');
                $('#viewCreatedAt').text(c.createdAt || '—');
                $('#viewCreatedBy').text(c.createdBy || '—');
                $('#viewUpdatedAt').text(c.updatedAt || '—');
                $('#viewUpdatedBy').text(c.updatedBy || '—');

                // Administrator Details
                $('#viewAdminFullName').text(c.adminFullName || '—');
                $('#viewAdminUsername').text(c.adminUsername || '—');
                $('#viewAdminEmail').text(c.adminEmail || '—');
                $('#viewAdminMobile').text(c.adminMobile || '—');
                $('#viewAdminRole').text(c.adminRole || 'CompanyAdmin');

                // Registered Users Roster
                const users = c.users || [];
                $('#viewUsersCount').text(users.length);
                let usersHtml = '';
                if (users.length > 0) {
                    users.forEach(function (u) {
                        const statusBadge = u.isActive
                            ? '<span class="badge bg-success-subtle text-success border border-success-subtle fs-9">Active</span>'
                            : '<span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle fs-9">Inactive</span>';
                        usersHtml += `<tr>
                            <td class="ps-2">
                                <div class="fw-semibold text-dark">${u.fullName}</div>
                                <span class="font-monospace text-muted fs-9">${u.userName}</span>
                            </td>
                            <td>
                                <div>${u.email}</div>
                            </td>
                            <td>
                                <span>${u.mobile}</span>
                            </td>
                            <td><span class="badge bg-primary-subtle text-primary border border-primary-subtle fs-9">${u.roles}</span></td>
                            <td class="text-center">${statusBadge}</td>
                            <td class="text-end pe-2 text-muted fs-9">${u.createdAt}</td>
                        </tr>`;
                    });
                } else {
                    usersHtml = '<tr><td colspan="6" class="text-center py-2 text-muted">No users found.</td></tr>';
                }
                $('#viewCompanyUsersTableBody').html(usersHtml);

                if (c.website) {
                    $('#viewWebsite').html('<a href="' + c.website + '" target="_blank" class="text-decoration-none">' + c.website + ' <i class="fa-solid fa-arrow-up-right-from-square fs-9"></i></a>');
                } else {
                    $('#viewWebsite').text('—');
                }

                const addressParts = [c.address, c.city, c.state, c.pincode, c.country].filter(Boolean);
                $('#viewAddressFull').text(addressParts.length > 0 ? addressParts.join(', ') : '—');

                const statusBadge = $('#viewCompanyStatus');
                if (c.isActive) {
                    statusBadge.removeClass('bg-secondary-subtle text-secondary border-secondary-subtle').addClass('bg-success-subtle text-success border border-success-subtle fw-bold').text('Active');
                } else {
                    statusBadge.removeClass('bg-success-subtle text-success border-success-subtle').addClass('bg-secondary-subtle text-secondary border border-secondary-subtle fw-bold').text('Inactive');
                }

                const logoContainer = $('#viewCompanyLogoContainer');
                if (c.logo) {
                    logoContainer.html('<img src="' + c.logo + '" class="rounded border" style="width: 44px; height: 44px; object-fit: contain;" />');
                } else {
                    const initial = (c.companyName && c.companyName.length > 0) ? c.companyName.charAt(0).toUpperCase() : 'C';
                    logoContainer.html('<div class="bg-primary text-white fw-bold rounded d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; font-size: 18px;">' + initial + '</div>');
                }

                $('#viewCompanyModal').modal('show');
            },
            error: function () {
                ErpApp.notify('Failed to retrieve company details.', 'error');
            }
        });
    });

    // ================= EDIT COMPANY MODAL =================
    $(document).on('click', '.edit-company-btn', function () {
        const companyId = $(this).data('id');
        $.ajax({
            url: '/Company/GetCompany/' + companyId,
            type: 'GET',
            success: function (c) {
                $('#editCompanyId').val(c.id);
                $('#editCompanyName').val(c.companyName);
                $('#editCompanyCode').val(c.companyCode);
                $('#editBusinessType').val(c.businessType || '');
                $('#editIsActive').val(c.isActive ? 'true' : 'false');
                $('#editAddress').val(c.address || '');
                $('#editCity').val(c.city || '');
                $('#editState').val(c.state || '');
                $('#editCountry').val(c.country || 'India');
                $('#editPincode').val(c.pincode || '');
                $('#editPhone').val(c.phone || '');
                $('#editAlternatePhone').val(c.alternatePhone || '');
                $('#editEmail').val(c.email || '');
                $('#editWebsite').val(c.website || '');
                $('#editGSTNumber').val(c.gstNumber || '');
                $('#editPANNumber').val(c.panNumber || '');
                $('#editCurrency').val(c.currency || 'INR');
                $('#editFinancialYear').val(c.financialYear || '');

                // Administrator Profile in Edit Modal
                $('#editAdminUserId').val(c.adminUserId || '');
                $('#editAdminUsername').val(c.adminUsername || '');
                $('#editAdminFullName').val(c.adminFullName || '');
                $('#editAdminEmail').val(c.adminEmail || '');
                $('#editAdminMobile').val(c.adminMobile || '');
                $('#editAdminRoleBadge').text(c.adminRole || 'CompanyAdmin');
                $('#editAdminNewPassword').val('');
                $('#editAdminConfirmPassword').val('');

                // Registered Users Roster in Edit Modal
                const users = c.users || [];
                $('#editUsersCountBadge').text(users.length + (users.length === 1 ? ' User' : ' Users'));
                let usersHtml = '';
                if (users.length > 0) {
                    users.forEach(function (u) {
                        const statusBadge = u.isActive
                            ? '<span class="badge bg-success-subtle text-success border border-success-subtle fs-9">Active</span>'
                            : '<span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle fs-9">Inactive</span>';
                        usersHtml += `<tr>
                            <td class="ps-2.5">
                                <div class="fw-semibold text-dark">${u.fullName}</div>
                                <span class="font-monospace text-muted fs-9">${u.userName}</span>
                            </td>
                            <td>
                                <div>${u.email}</div>
                                <small class="text-muted">${u.mobile}</small>
                            </td>
                            <td><span class="badge bg-primary-subtle text-primary border border-primary-subtle fs-9">${u.roles}</span></td>
                            <td class="text-center">${statusBadge}</td>
                            <td class="text-end pe-2.5 text-muted fs-9">${u.createdAt}</td>
                        </tr>`;
                    });
                } else {
                    usersHtml = '<tr><td colspan="5" class="text-center py-3 text-muted">No additional users found.</td></tr>';
                }
                $('#editCompanyUsersTableBody').html(usersHtml);

                if (c.logo) {
                    $('#editLogoPreview').attr('src', c.logo);
                    $('#editLogoPreviewContainer').removeClass('d-none');
                } else {
                    $('#editLogoPreviewContainer').addClass('d-none');
                }

                // Reset tabs to first tab
                var firstTab = new bootstrap.Tab(document.querySelector('#tab-edit-info-btn'));
                firstTab.show();

                $('#editCompanyModal').modal('show');
            },
            error: function () {
                ErpApp.notify('Failed to retrieve company data for editing.', 'error');
            }
        });
    });

    // ================= ACTIVATE / DEACTIVATE MODAL =================
    let targetCompanyId = 0;
    let willActivate = false;

    $(document).on('click', '.toggle-status-btn', function () {
        targetCompanyId = $(this).data('id');
        const companyName = $(this).data('name');
        const isActive = $(this).data('active') === true || $(this).data('active') === 'true';
        willActivate = !isActive;

        $('#toggleModalCompanyName').text(companyName);

        if (willActivate) {
            $('#toggleModalHeader').removeClass('bg-warning text-dark').addClass('bg-success text-white');
            $('#toggleModalTitle').text('Activate Company');
            $('#toggleModalIcon').html('<i class="fa-solid fa-circle-check text-success display-4"></i>');
            $('#toggleModalMessage').text('Are you sure you want to activate this company? Normal user access will be restored.');
            $('#toggleModalWarning').hide();
            $('#confirmToggleStatusBtn').removeClass('btn-danger btn-warning').addClass('btn-success').text('Activate');
        } else {
            $('#toggleModalHeader').removeClass('bg-success').addClass('bg-warning text-dark');
            $('#toggleModalTitle').text('Deactivate Company');
            $('#toggleModalIcon').html('<i class="fa-solid fa-triangle-exclamation text-warning display-4"></i>');
            $('#toggleModalMessage').text('Are you sure you want to deactivate this company?');
            $('#toggleModalWarning').show();
            $('#confirmToggleStatusBtn').removeClass('btn-success btn-warning').addClass('btn-danger').text('Deactivate');
        }

        $('#toggleStatusModal').modal('show');
    });

    $('#confirmToggleStatusBtn').on('click', function () {
        if (!targetCompanyId) return;

        const btn = $(this);
        ErpApp.setButtonLoading(btn, true, 'Processing...');

        $.ajax({
            url: '/Company/ToggleStatus/' + targetCompanyId,
            type: 'POST',
            headers: { 'RequestVerificationToken': antiForgeryToken },
            success: function (res) {
                $('#toggleStatusModal').modal('hide');
                ErpApp.setButtonLoading(btn, false);

                if (res && res.success) {
                    ErpApp.notify(res.message || 'Status updated.', 'success');
                    setTimeout(function () { location.reload(); }, 600);
                } else {
                    ErpApp.notify(res?.message || 'Failed to update company status.', 'error');
                }
            },
            error: function (xhr) {
                $('#toggleStatusModal').modal('hide');
                ErpApp.setButtonLoading(btn, false);
                var msg = xhr.responseJSON?.message || 'A server error occurred while updating status.';
                ErpApp.notify(msg, 'error');
            }
        });
    });
});
</script>
}
