                                                    <div class="col-12 col-md-6">
                                                        <label class="form-label fw-semibold text-dark">User Full Name</label>
                                                        <input type="text" name="UserFullName" id="createUserFullName" class="form-control" placeholder="e.g. Jane Doe" maxlength="100" />
                                                    </div>
                                                    <div class="col-12 col-md-6">
                                                        <label class="form-label fw-semibold text-dark">User Username</label>
                                                        <input type="text" name="UserUsername" id="createUserUsername" class="form-control bg-light font-monospace text-uppercase" readonly placeholder="Auto: CODE_USER01" />
                                                        <span class="text-muted fs-8">Auto-generated format: {CompanyCode}_USER01</span>
                                                    </div>
                                                    <div class="col-12 col-md-6">
                                                        <label class="form-label fw-semibold text-dark">User Password</label>
                                                        <div class="input-group">
                                                            <span class="input-group-text bg-white border-end-0"><i class="fa-solid fa-key text-muted"></i></span>
                                                            <input type="password" name="UserPassword" id="createUserPassword" class="form-control border-start-0" placeholder="••••••••" />
                                                            <button type="button" class="btn btn-outline-secondary toggle-pwd-btn" data-target="#createUserPassword"><i class="fa-regular fa-eye"></i></button>
                                                        </div>
                                                    </div>
                                                    <div class="col-12 col-md-6">
                                                        <label class="form-label fw-semibold text-dark">Confirm Password</label>
                                                        <div class="input-group">
                                                            <span class="input-group-text bg-white border-end-0"><i class="fa-solid fa-lock text-muted"></i></span>
                                                            <input type="password" name="UserConfirmPassword" id="createUserConfirmPassword" class="form-control border-start-0" placeholder="••••••••" />
                                                            <button type="button" class="btn btn-outline-secondary toggle-pwd-btn" data-target="#createUserConfirmPassword"><i class="fa-regular fa-eye"></i></button>
                                                        </div>
                                                    </div>
                                                    <div class="col-12 col-md-6">
                                                        <label class="form-label fw-semibold text-dark">Assigned Role</label>
                                                        <select name="UserRole" class="form-select">
                                                            <option value="CompanyUser" selected>CompanyUser (Standard Operator)</option>
                                                            <option value="Sales User">Sales User</option>
                                                            <option value="Purchase User">Purchase User</option>
                                                            <option value="Accountant">Accountant</option>
                                                        </select>
                                                    </div>
                                                    <div class="col-12 col-md-6">
                                                        <label class="form-label fw-semibold text-dark">User Email</label>
                                                        <input type="email" name="UserEmail" class="form-control" placeholder="user@company.com" maxlength="100" />
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Sample / Test Data Selection Section -->
                                <div class="col-12">
                                    <div class="card border shadow-none bg-light bg-opacity-50">
                                        <div class="card-body p-3">
                                            <label class="form-label fw-bold text-dark mb-2">
                                                <i class="fa-solid fa-database text-primary me-1"></i> Sample / Test Master Data
                                            </label>
                                                <div class="form-check">
                                                    <input class="form-check-input" type="radio" name="CreateSampleData" id="sampleDataNo" value="false" checked />
                                                    <label class="form-check-label fw-semibold text-dark" for="sampleDataNo">
                                                        <i class="fa-solid fa-folder-open text-primary me-1"></i> Clean / Empty Company Setup (Default)
                                                        <div class="text-muted small fw-normal">Creates clean tenant with administrator user and zero sample or dummy records.</div>
                                                    </label>
                                                </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light py-3">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="btnSubmitCreate">
                        <i class="fa-solid fa-floppy-disk me-1.5"></i> Create Company
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ================= EDIT COMPANY MODAL ================= -->
