@model PurchasePageViewModel<PurchaseInvoice>
@{
    ViewData["Title"] = "Purchase Invoice";
}

<!-- List View -->
<div id="listView">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="m-0 font-weight-bold text-primary"><i class="fa-solid fa-file-invoice me-2"></i> Purchase Invoices</h4>
        <button class="btn btn-primary" onclick="showForm()"><i class="fa-solid fa-plus me-1"></i> New Purchase Invoice</button>
    </div>

    <!-- Filters Row -->
    <div class="card mb-3 no-print">
        <div class="card-body p-3">
            <div class="row g-2 align-items-center">
                <div class="col-md-3">
                    <label class="form-label font-weight-semibold mb-1 small text-muted">From Date</label>
                    <input type="date" id="filterFromDate" class="form-control form-control-sm" />
                </div>
                <div class="col-md-3">
                    <label class="form-label font-weight-semibold mb-1 small text-muted">To Date</label>
                    <input type="date" id="filterToDate" class="form-control form-control-sm" />
                </div>
                <div class="col-md-3">
                    <label class="form-label font-weight-semibold mb-1 small text-muted">Status</label>
                    <select id="filterStatus" class="form-select form-select-sm">
                        <option value="">All Statuses</option>
                        <option value="Draft">Draft</option>
                        <option value="Pending">Pending</option>
                        <option value="Paid">Paid</option>
                        <option value="Cancelled">Cancelled</option>
                    </select>
                </div>
                <div class="col-md-3 d-flex gap-2 align-self-end">
                    <button class="btn btn-sm btn-primary w-100" onclick="applyFilters()"><i class="fa-solid fa-filter me-1"></i> Filter</button>
                    <button class="btn btn-sm btn-outline-secondary w-100" onclick="resetFilters()"><i class="fa-solid fa-rotate me-1"></i> Reset</button>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover datatable align-middle">
                    <thead>
                        <tr>
                            <th>Invoice No</th>
                            <th>Date</th>
                            <th>Supplier</th>
                            <th>Grand Total</th>
                            <th>Paid Amount</th>
                            <th>Balance</th>
                            <th class="text-center no-print">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var inv in Model.Items)
                        {
                            <tr id="row-@inv.Id">
                                <td class="font-weight-bold">@inv.InvoiceNumber</td>
                                <td>@inv.InvoiceDate.ToString("dd-MM-yyyy")</td>
                                <td>@inv.Supplier?.SupplierName</td>
                                <td class="font-weight-semibold text-dark">₹@inv.GrandTotal.ToString("N2")</td>
                                <td>₹@inv.PaidAmount.ToString("N2")</td>
                                <td class="text-danger font-weight-semibold">₹@inv.BalanceAmount.ToString("N2")</td>
                                <td class="text-center no-print">
                                    <div class="btn-group">
                                        <button class="btn btn-sm btn-outline-primary" onclick="editInvoice(@inv.Id)" title="Edit"><i class="fa-solid fa-pen"></i></button>
                                        <button class="btn btn-sm btn-outline-secondary" onclick="ErpPrint.printBillById('purchaseInvoice', @inv.Id)" title="Print"><i class="fa-solid fa-print"></i></button>
                                        <button class="btn btn-sm btn-outline-danger" onclick="deleteInvoice(@inv.Id)"><i class="fa-solid fa-trash"></i></button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Entry Form View -->
<div id="formView" style="display:none">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="m-0 font-weight-bold text-primary"><i class="fa-solid fa-plus me-2"></i> Record Purchase Invoice</h4>
        <button class="btn btn-outline-secondary" onclick="hideForm()"><i class="fa-solid fa-arrow-left me-1"></i> Back to List</button>
    </div>

    <div class="card">
        <div class="card-body">
            <form id="invoiceForm">
                <input type="hidden" id="Id" value="0" />
                <div class="row">
                    <div class="col-md-2 mb-3">
                        <label class="form-label font-weight-semibold">Invoice Number *</label>
                        <input type="text" id="InvoiceNumber" class="form-control" required readonly />
                        <small class="text-muted">Auto from company settings</small>
                    </div>
                    <div class="col-md-2 mb-3">
                        <label class="form-label font-weight-semibold">Invoice Date *</label>
                        <input type="date" id="InvoiceDate" class="form-control" required value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="form-label font-weight-semibold">Supplier *</label>
                        <select id="SupplierId" class="form-select select2" required>
                            <option value="">Select Supplier</option>
                            @foreach (var s in Model.Suppliers)
                            {
                                <option value="@s.Id">@s.SupplierName (@s.SupplierCode)</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2 mb-3">
                        <label class="form-label font-weight-semibold">Terms (Days)</label>
                        <input type="number" id="CreditDays" class="form-control" value="0" />
                    </div>
                    <div class="col-md-3 mb-3 align-self-end">
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" id="WithGST" name="WithGST" onchange="toggleGST(this)" />
                            <label class="form-check-label font-weight-bold" for="WithGST">
                                With GST
                            </label>
                        </div>
                    </div>
                </div>

                <hr />

                <h5>Line Items</h5>
                <div class="table-responsive mb-3">
                    <table class="table table-bordered align-middle" id="itemsTable">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 20%">Category</th>
                                <th style="width: 20%">Product *</th>
                                <th style="width: 12%">Quantity *</th>
                                <th style="width: 15%">Rate *</th>
                                <th style="width: 10%" class="gst-column">GST %</th>
                                <th style="width: 15%">Total</th>
                                <th style="width: 8%" class="text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>

                <div class="d-flex justify-content-between align-items-start mb-4">
                    <button type="button" class="btn btn-outline-primary" onclick="addRow()"><i class="fa-solid fa-plus me-1"></i> Add Row</button>
                    
                    <div class="text-end" style="width: 300px;">
                        <div class="d-flex justify-content-between mb-2">
                            <span>Sub Total:</span>
                            <span id="lblSubTotal" class="font-weight-semibold">₹0.00</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Total GST:</span>
                            <span id="lblTotalGST" class="font-weight-semibold">₹0.00</span>
                        </div>
                        <div class="d-flex justify-content-between border-top pt-2">
                            <span class="font-weight-bold">Grand Total:</span>
                            <span id="lblGrandTotal" class="font-weight-bold text-primary fs-5">₹0.00</span>
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label font-weight-semibold">Remarks / Terms</label>
                    <textarea id="Remarks" class="form-control" rows="2"></textarea>
                </div>

                <div class="text-end">
                    <button type="button" class="btn btn-secondary me-2" onclick="hideForm()">Cancel</button>
                    <button type="button" class="btn btn-primary px-4" onclick="saveInvoice()">Save Invoice</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var productsList = @Json.Serialize(Model.ProductLookups);
        if (productsList) {
            productsList = productsList.map(function(p) {
                return {
                    id: window.getVal(p, 'id'),
                    productCode: window.getVal(p, 'productCode'),
                    productName: window.getVal(p, 'productName'),
                    salesPrice: window.getVal(p, 'salesPrice'),
                    purchasePrice: window.getVal(p, 'purchasePrice'),
                    gstPercentage: window.getVal(p, 'gstPercentage'),
                    categoryId: window.getVal(p, 'categoryId'),
                    currentStock: window.getVal(p, 'currentStock')
                };
            });
        }

        function showForm() {
            $('#listView').hide();
            $('#formView').show();
            $('#invoiceForm')[0].reset();
            $('#Id').val('0');
            $('#InvoiceNumber').prop('readonly', true);
            $('#itemsTable tbody').empty();
            $('#SupplierId').val('').trigger('change');
            $('#InvoiceDate').val('@DateTime.Today.ToString("yyyy-MM-dd")');
            $('#WithGST').prop('checked', false);
            $('.gst-column').hide();
            ErpPrint.fetchNextBillNumber('purchase').done(function(res) {
                $('#InvoiceNumber').val(res.billNumber);
            });
            addRow();
        }

        function editInvoice(id) {
            $.getJSON('/Purchase/GetInvoice/' + id, function(inv) {
                $('#listView').hide();
                $('#formView').show();
                $('#Id').val(window.getVal(inv, 'id'));
                $('#InvoiceNumber').val(window.getVal(inv, 'invoiceNumber')).prop('readonly', true);
                
                var invDate = window.getVal(inv, 'invoiceDate');
                if (invDate) {
                    $('#InvoiceDate').val(invDate.split('T')[0]);
                }
                
                $('#SupplierId').val(window.getVal(inv, 'supplierId')).trigger('change');
                $('#Remarks').val(window.getVal(inv, 'notes') || '');
                
                var payTerms = window.getVal(inv, 'paymentTerms') || '';
                if (payTerms) {
                    $('#CreditDays').val(parseInt(payTerms) || 0);
                }

                var withGst = window.getVal(inv, 'withGST') || false;
                $('#WithGST').prop('checked', withGst);
                if (withGst) {
                    $('.gst-column').show();
                } else {
                    $('.gst-column').hide();
                }

                $('#itemsTable tbody').empty();
                
                var items = window.getVal(inv, 'items') || [];
                items.forEach(function(item) {
                    var normalizedItem = {
                        productId: window.getVal(item, 'productId'),
                        quantity: window.getVal(item, 'quantity'),
                        rate: window.getVal(item, 'rate'),
                        taxPercentage: window.getVal(item, 'taxPercentage')
                    };
                    addRow(normalizedItem);
                });
                calculateTotals();
            });
        }

        function hideForm() {
            $('#formView').hide();
            $('#listView').show();
        }

        function addRow(existingItem) {
            var catOptionsHtml = '<option value="">All Categories</option>';
            var categoriesList = @Json.Serialize(Model.Categories.Select(c => new { id = c.Id, categoryName = c.CategoryName }));
            if (categoriesList) {
                categoriesList = categoriesList.map(function(c) {
                    return {
                        id: window.getVal(c, 'id'),
                        categoryName: window.getVal(c, 'categoryName')
                    };
                });
            }
            categoriesList.forEach(function(c) {
                catOptionsHtml += `<option value="${c.id}">${c.categoryName}</option>`;
            });

            var optionsHtml = '<option value="">Select Product</option>';
            productsList.forEach(function(p) {
                var optionText = `${p.productName} (${p.productCode}) | Stock: ${p.currentStock || 0} | Cost: ₹${(p.purchasePrice || 0).toFixed(2)} | GST: ${p.gstPercentage || 0}%`;
                optionsHtml += `<option value="${p.id}">${optionText}</option>`;
            });

            var rowHtml = `
                <tr class="grid-item-row">
                    <td>
                        <select class="form-select select2-category" onchange="onCategorySelect(this)">
                            ${catOptionsHtml}
                        </select>
                    </td>
                    <td>
                        <select class="form-select select2-row" onchange="onProductSelect(this)" required>
                            ${optionsHtml}
                        </select>
                    </td>
                    <td>
                        <input type="number" class="form-control qty-input" value="1" min="1" oninput="calculateRow(this)" required />
                    </td>
                    <td>
                        <input type="number" class="form-control rate-input" value="0.00" step="0.01" oninput="calculateRow(this)" required />
                    </td>
                    <td class="gst-column">
                        <input type="number" class="form-control gst-input" value="18" oninput="calculateRow(this)" required />
                    </td>
                    <td>
                        <input type="text" class="form-control total-input" value="0.00" readonly />
                    </td>
                    <td class="text-center">
                        <button type="button" class="btn btn-sm btn-outline-danger" onclick="removeRow(this)"><i class="fa-solid fa-trash"></i></button>
                    </td>
                </tr>
            `;

            var $row = $(rowHtml);
            $('#itemsTable tbody').append($row);
            window.initializeSelect2($row.find('.select2-row'));
            window.initializeSelect2($row.find('.select2-category'));

            if ($('#WithGST').is(':checked')) {
                $row.find('.gst-column').show();
            } else {
                $row.find('.gst-column').hide();
                $row.find('.gst-input').val(0);
            }

            if (existingItem) {
                $row.find('.select2-row').val(existingItem.productId).trigger('change');
                $row.find('.qty-input').val(existingItem.quantity);
                $row.find('.rate-input').val(existingItem.rate);
                $row.find('.gst-input').val(existingItem.taxPercentage);
                $row.find('.total-input').val((existingItem.quantity * existingItem.rate).toFixed(2));
            }
        }

        function removeRow(btn) {
            $(btn).closest('tr').remove();
            calculateTotals();
        }

        function onCategorySelect(select) {
            var catId = $(select).val();
            var $row = $(select).closest('tr');
            var $prodSelect = $row.find('.select2-row');
            
            $prodSelect.empty();
            $prodSelect.append('<option value="">Select Product</option>');
            
            productsList.forEach(function(p) {
                if (!catId || p.categoryId == catId) {
                    var optionText = `${p.productName} (${p.productCode}) | Stock: ${p.currentStock || 0} | Cost: ₹${(p.purchasePrice || 0).toFixed(2)} | GST: ${p.gstPercentage || 0}%`;
                    $prodSelect.append(`<option value="${p.id}">${optionText}</option>`);
                }
            });
            $prodSelect.trigger('change');
        }

        function onProductSelect(select) {
            var prodId = $(select).val();
            var product = productsList.find(p => p.id == prodId);
            var $row = $(select).closest('tr');
            if (product) {
                $row.find('.rate-input').val(product.purchasePrice);
                $row.find('.gst-input').val(product.gstPercentage);
            }
            calculateRow(select);
        }

        function calculateRow(elem) {
            var $row = $(elem).closest('tr');
            var qty = parseFloat($row.find('.qty-input').val()) || 0;
            var rate = parseFloat($row.find('.rate-input').val()) || 0;
            $row.find('.total-input').val((qty * rate).toFixed(2));
            calculateTotals();
        }

        function toggleGST(elem) {
            var isChecked = $(elem).is(':checked');
            if (isChecked) {
                $('.gst-column').show();
            } else {
                $('.gst-column').hide();
                $('.gst-input').val(0);
            }
            calculateTotals();
        }

        function calculateTotals() {
            var subTotal = 0;
            var totalGST = 0;
            var withGst = $('#WithGST').is(':checked');

            $('#itemsTable tbody tr').each(function() {
                var qty = parseFloat($(this).find('.qty-input').val()) || 0;
                var rate = parseFloat($(this).find('.rate-input').val()) || 0;
                var gst = withGst ? (parseFloat($(this).find('.gst-input').val()) || 0) : 0;
                var lineTotal = qty * rate;
                subTotal += lineTotal;
                totalGST += (lineTotal * (gst / 100));
            });
            var grandTotal = subTotal + totalGST;
            $('#lblSubTotal').text('₹' + subTotal.toFixed(2));
            $('#lblTotalGST').text('₹' + totalGST.toFixed(2));
            $('#lblGrandTotal').text('₹' + grandTotal.toFixed(2));

            if (withGst) {
                $('#lblTotalGST').closest('div').show();
            } else {
                $('#lblTotalGST').closest('div').hide();
            }
        }

        function saveInvoice() {
            var items = [];
            var isValid = true;
            $('#itemsTable tbody tr').each(function() {
                var prodId = $(this).find('.select2-row').val();
                var qty = parseFloat($(this).find('.qty-input').val()) || 0;
                var rate = parseFloat($(this).find('.rate-input').val()) || 0;
                var gst = parseFloat($(this).find('.gst-input').val()) || 0;
                if (!prodId || qty <= 0 || rate <= 0) {
                    isValid = false;
                    return false;
                }
                var product = productsList.find(p => p.id == prodId);
                items.push({
                    productId: parseInt(prodId),
                    productName: product ? product.productName : '',
                    quantity: qty,
                    rate: rate,
                    taxPercentage: gst,
                    discount: 0,
                    taxAmount: qty * rate * (gst / 100),
                    amount: (qty * rate) + (qty * rate * (gst / 100))
                });
            });

            var supplierId = $('#SupplierId').val();
            if (!supplierId || items.length === 0 || !isValid) {
                Swal.fire('Error!', 'Please fill all fields.', 'error');
                return;
            }

            var invoice = {
                id: parseInt($('#Id').val()) || 0,
                invoiceNumber: $('#InvoiceNumber').val(),
                invoiceDate: $('#InvoiceDate').val(),
                supplierId: parseInt(supplierId),
                notes: $('#Remarks').val(),
                paymentTerms: $('#CreditDays').val() + " Days",
                subTotal: parseFloat($('#lblSubTotal').text().replace('₹', '')) || 0,
                taxAmount: parseFloat($('#lblTotalGST').text().replace('₹', '')) || 0,
                grandTotal: parseFloat($('#lblGrandTotal').text().replace('₹', '')) || 0,
                balanceAmount: parseFloat($('#lblGrandTotal').text().replace('₹', '')) || 0,
                items: items,
                withGST: $('#WithGST').is(':checked')
            };

            $.ajax({
                url: '/Purchase/SaveInvoice',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(invoice),
                success: function(res) {
                    if (res.success) {
                        Swal.fire('Saved!', res.message, 'success').then(() => { location.reload(); });
                    } else {
                        Swal.fire('Error!', res.message, 'error');
                    }
                },
                error: function(xhr) {
                    Swal.fire('Error!', xhr.responseJSON?.message || 'Failed to save invoice.', 'error');
                }
            });
        }

        function deleteInvoice(id) {
            Swal.fire({
                title: 'Are you sure?',
                text: "Do you want to delete this purchase invoice?",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Yes, delete!'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.post('/Purchase/DeleteInvoice', { id: id }, function(res) {
                        if (res.success) {
                            Swal.fire('Deleted!', 'Invoice deleted.', 'success');
                            $('#row-' + id).fadeOut(300, function() { $(this).remove(); });
                        }
                    });
                }
            });
        }
    </script>
}

