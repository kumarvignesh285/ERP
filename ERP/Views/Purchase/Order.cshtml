@model PurchasePageViewModel<PurchaseOrder>
@{
    ViewData["Title"] = "Purchase Order";
}

<div id="listView">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="m-0 fw-bold text-primary"><i class="fa-solid fa-cart-shopping me-2"></i> Purchase Orders</h4>
            <p class="text-muted small m-0 mt-1">Issue orders to vendors, track procurement status, and convert to purchase invoices</p>
        </div>
        <button class="btn btn-primary shadow-sm" onclick="showForm()"><i class="fa-solid fa-plus me-1.5"></i> New Purchase Order</button>
    </div>

    <!-- Filters Row -->
    <div class="card mb-3 no-print shadow-sm border-0">
        <div class="card-body p-3">
            <div class="row g-3 align-items-center">
                <div class="col-12 col-sm-6 col-md-3">
                    <label class="form-label fw-semibold mb-1 small text-muted">From Date</label>
                    <input type="date" id="filterFromDate" class="form-control form-control-sm" />
                </div>
                <div class="col-12 col-sm-6 col-md-3">
                    <label class="form-label fw-semibold mb-1 small text-muted">To Date</label>
                    <input type="date" id="filterToDate" class="form-control form-control-sm" />
                </div>
                <div class="col-12 col-sm-6 col-md-3">
                    <label class="form-label fw-semibold mb-1 small text-muted">Status</label>
                    <select id="filterStatus" class="form-select form-select-sm">
                        <option value="">All Statuses</option>
                        <option value="Draft">Draft</option>
                        <option value="Pending">Pending</option>
                        <option value="Approved">Approved</option>
                        <option value="Completed">Completed</option>
                        <option value="Cancelled">Cancelled</option>
                    </select>
                </div>
                <div class="col-12 col-sm-6 col-md-3 d-flex gap-2 align-self-end">
                    <button class="btn btn-sm btn-primary w-100" onclick="applyFilters()"><i class="fa-solid fa-filter me-1"></i> Filter</button>
                    <button class="btn btn-sm btn-outline-secondary w-100" onclick="resetFilters()"><i class="fa-solid fa-rotate me-1"></i> Reset</button>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover datatable align-middle">
                    <thead class="table-light text-uppercase fs-8 fw-bold text-muted">
                        <tr>
                            <th>Order No</th>
                            <th>Date</th>
                            <th>Supplier</th>
                            <th>Grand Total</th>
                            <th>Status</th>
                            <th class="text-center no-print">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var o in Model.Items)
                        {
                            <tr id="row-@o.Id">
                                <td class="fw-bold text-primary">@o.OrderNumber</td>
                                <td>@o.OrderDate.ToString("dd-MM-yyyy")</td>
                                <td class="fw-semibold text-dark">@o.Supplier?.SupplierName</td>
                                <td class="fw-bold text-dark">₹@o.GrandTotal.ToString("N2")</td>
                                @{
                                    var statusBadgeClass = o.Status switch
                                    {
                                        "Pending" or "Draft" => "badge-pending",
                                        "Sent" or "Issued" or "Active" => "badge-sent",
                                        "Completed" or "Paid" or "Accepted" or "Approved" => "badge-accepted",
                                        "Cancelled" or "Rejected" or "Expired" => "badge-rejected",
                                        _ => "badge-accepted"
                                    };
                                }
                                <td><span class="badge @statusBadgeClass">@o.Status</span></td>
                                <td class="text-center no-print">
                                    <div class="btn-group">
                                        <button class="btn btn-sm btn-outline-success" onclick="convertOrderToInvoice(@o.Id)" title="Convert to invoice"><i class="fa-solid fa-file-invoice"></i></button>
                                        <button class="btn btn-sm btn-outline-danger" onclick="deleteOrder(@o.Id)" title="Delete"><i class="fa-solid fa-trash"></i></button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div id="formView" style="display:none">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="m-0 font-weight-bold text-primary"><i class="fa-solid fa-plus me-2"></i> Create Purchase Order</h4>
        <button class="btn btn-outline-secondary" onclick="hideForm()"><i class="fa-solid fa-arrow-left me-1"></i> Back to List</button>
    </div>

    <!-- Auto-Fill from Image / Document section -->
    <div class="card mb-4 no-print border-dashed-primary bg-light-soft">
        <div class="card-body text-center py-4">
            <div class="d-flex flex-column align-items-center">
                <div class="action-icon-circle bg-primary-light text-primary mb-2" style="width: 50px; height: 50px; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                    <i class="fa-solid fa-file-arrow-up fs-4"></i>
                </div>
                <h6 class="font-weight-bold text-dark mb-1">Auto-Fill from PDF Supplier Invoice / Excel List</h6>
                <p class="text-muted small mb-3 max-w-500">Upload a PDF invoice or Excel product list. The system will accurately parse items, rates, and quantities, check matches against the database, and pre-fill the Purchase Order line items table automatically.</p>
                <button type="button" class="btn btn-primary btn-sm px-4" onclick="openImportModal()">
                    <i class="fa-solid fa-file-import me-2"></i>Upload Excel / PDF Invoice
                </button>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <form id="orderForm">
                <div class="row">
                    <div class="col-md-3 mb-3">
                        <label class="form-label font-weight-semibold">Order Number *</label>
                        <input type="text" id="OrderNumber" class="form-control" required />
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="form-label font-weight-semibold">Date *</label>
                        <input type="date" id="OrderDate" class="form-control" required value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="form-label font-weight-semibold">Supplier *</label>
                        <select id="SupplierId" class="form-select select2" required>
                            <option value="">Select Supplier</option>
                            @foreach (var s in Model.Suppliers)
                            {
                                <option value="@s.Id">@s.SupplierName</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="form-label font-weight-semibold">Status *</label>
                        <select id="Status" class="form-select" required>
                            <option value="Pending">Pending</option>
                            <option value="Confirmed">Confirmed</option>
                            <option value="Partially Received">Partially Received</option>
                            <option value="Completed">Completed</option>
                            <option value="Cancelled">Cancelled</option>
                        </select>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label font-weight-semibold">PDF Document</label>
                        <input type="file" id="poDocument" class="form-control" accept="application/pdf" />
                        <input type="hidden" id="DocumentPath" />
                        <div id="uploadingDocSpinner" class="spinner-border spinner-border-sm text-primary mt-2" style="display:none;" role="status"><span class="visually-hidden">Loading...</span></div>
                        <a id="poDocumentLink" href="#" target="_blank" class="btn btn-sm btn-outline-info mt-2" style="display:none;"><i class="fa-solid fa-file-pdf"></i> View Doc</a>
                    </div>
                    <div class="col-md-6 mb-3 align-self-end">
                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" id="WithGST" name="WithGST" onchange="toggleGST(this)" />
                            <label class="form-check-label font-weight-bold" for="WithGST">
                                With GST
                            </label>
                        </div>
                    </div>
                </div>

                <hr />

                <h5>Line Items</h5>
                <div class="table-responsive mb-3">
                    <table class="table table-bordered align-middle" id="itemsTable">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 20%">Category</th>
                                <th style="width: 20%">Product *</th>
                                <th style="width: 15%">Quantity *</th>
                                <th style="width: 15%">Rate *</th>
                                <th style="width: 10%" class="gst-column">GST %</th>
                                <th style="width: 15%">Total</th>
                                <th style="width: 5%" class="text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>

                <div class="d-flex justify-content-between mb-4">
                    <button type="button" class="btn btn-outline-primary" onclick="addRow()"><i class="fa-solid fa-plus me-1"></i> Add Row</button>
                    <div class="text-end" style="width: 300px;">
                        <div class="d-flex justify-content-between mb-2">
                            <span>Sub Total:</span>
                            <span id="lblSubTotal" class="font-weight-semibold">₹0.00</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2" id="divTotalGST">
                            <span>Total GST:</span>
                            <span id="lblTotalGST" class="font-weight-semibold">₹0.00</span>
                        </div>
                        <div class="d-flex justify-content-between border-top pt-2">
                            <span class="font-weight-bold">Grand Total:</span>
                            <span id="lblGrandTotal" class="font-weight-bold text-primary fs-5">₹0.00</span>
                        </div>
                    </div>
                </div>

                <div class="text-end">
                    <button type="button" class="btn btn-secondary me-2" onclick="hideForm()">Cancel</button>
                    <button type="button" class="btn btn-primary px-4" onclick="saveOrder()">Save Order</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Upload & Verification Modal Dialog -->
<div class="modal fade" id="uploadModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-xl">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title"><i class="fa-solid fa-file-import me-2"></i> Import Products (Excel / PDF)</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <!-- Step 1: Upload File Area -->
                <div id="uploadFileSection" class="text-center py-4">
                    <div id="importDropZone" class="border border-2 border-dashed rounded-3 p-5 bg-light mb-3 cursor-pointer" style="border-style: dashed !important; border-width: 2px !important; border-color: #0d6efd !important;">
                        <i class="fa-solid fa-cloud-arrow-up text-primary fa-3x mb-3"></i>
                        <h5>Drag and drop your file here, or click to browse</h5>
                        <p class="text-muted small mb-0">Supports Excel (.xlsx, .xls) and PDF invoice/purchase documents (.pdf)</p>
                    </div>
                    <input type="file" id="importFileSelect" class="d-none" accept=".xlsx,.xls,.pdf" />
                    <div class="d-flex justify-content-center gap-3">
                        <a href="/Masters/DownloadProductTemplate" class="btn btn-sm btn-outline-secondary"><i class="fa-solid fa-file-excel me-1"></i> Download Excel Template</a>
                    </div>
                </div>

                <!-- Step 2: Verification Workspace (hidden initially) -->
                <div id="verificationSection" class="d-none">
                    <div class="alert alert-info border-0 shadow-sm d-flex align-items-center mb-3">
                        <i class="fa-solid fa-circle-info fa-lg me-3 text-info"></i>
                        <div>
                            <strong>Purchase Order Import Workspace:</strong> Review and verify the parsed product names, codes, and quantities below. Missing categories, brands, units, and warehouses will be created automatically in their master databases.
                        </div>
                    </div>

                    <!-- Statistics Summary -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-3">
                            <div class="card bg-light border-0 shadow-sm">
                                <div class="card-body p-3 text-center">
                                    <h6 class="text-muted mb-1 small text-uppercase font-weight-bold">Total Items</h6>
                                    <h4 class="m-0 font-weight-bold" id="statTotalItems">0</h4>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card bg-light border-0 shadow-sm text-success">
                                <div class="card-body p-3 text-center">
                                    <h6 class="text-muted mb-1 small text-uppercase font-weight-bold">New Products</h6>
                                    <h4 class="m-0 font-weight-bold" id="statNewItems">0</h4>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card bg-light border-0 shadow-sm text-primary">
                                <div class="card-body p-3 text-center">
                                    <h6 class="text-muted mb-1 small text-uppercase font-weight-bold">Exact Matches</h6>
                                    <h4 class="m-0 font-weight-bold" id="statExactMatches">0</h4>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card bg-light border-0 shadow-sm text-warning">
                                <div class="card-body p-3 text-center">
                                    <h6 class="text-muted mb-1 small text-uppercase font-weight-bold">Similar Matches</h6>
                                    <h4 class="m-0 font-weight-bold" id="statSimilarMatches">0</h4>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Editable Verification Table -->
                    <div class="table-responsive shadow-sm rounded border border-light" style="max-height: 450px; overflow-y: auto;">
                        <table class="table table-hover align-middle mb-0" id="verificationTable" style="min-width: 1850px; font-size: 0.85rem;">
                            <thead class="table-dark sticky-top">
                                <tr>
                                    <th style="width: 4%;">Status</th>
                                    <th style="width: 7%;">Action</th>
                                    <th style="width: 8%;">Code *</th>
                                    <th style="width: 25%;">Product Name *</th>
                                    <th style="width: 6%;">HSN</th>
                                    <th style="width: 10%;">Category</th>
                                    <th style="width: 10%;">Brand</th>
                                    <th style="width: 6%;">Unit</th>
                                    <th style="width: 9%;">Warehouse</th>
                                    <th style="width: 5%;">Qty *</th>
                                    <th style="width: 6%;">Purchase</th>
                                    <th style="width: 6%;">Sales</th>
                                    <th style="width: 6%;">MRP</th>
                                    <th style="width: 4%;">GST%</th>
                                    <th style="width: 3%;" class="text-center"><i class="fa-solid fa-trash"></i></th>
                                </tr>
                            </thead>
                            <tbody>
                                <!-- Dynamic rows -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light border-0 p-3">
                <button type="button" class="btn btn-secondary px-3" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-outline-primary d-none px-3" id="btnBackToUpload" onclick="resetImportModal()"><i class="fa-solid fa-arrow-left me-1"></i> Upload New File</button>
                <button type="button" class="btn btn-success d-none px-4 font-weight-bold" id="btnCommitImport" onclick="commitVerifiedImport()"><i class="fa-solid fa-check me-1"></i> Confirm & Import</button>
            </div>
        </div>
    </div>
</div>

<!-- Datalists for auto-complete suggestions -->
<datalist id="importCategoriesDatalist"></datalist>
<datalist id="importBrandsDatalist"></datalist>
<datalist id="importUnitsDatalist"></datalist>
<datalist id="importWarehousesDatalist"></datalist>

@section Scripts {
    <script>
        var productsList = @Json.Serialize(Model.ProductLookups);
        if (productsList) {
            productsList = productsList.map(function(p) {
                return {
                    id: window.getVal(p, 'id'),
                    productCode: window.getVal(p, 'productCode'),
                    productName: window.getVal(p, 'productName'),
                    salesPrice: window.getVal(p, 'salesPrice'),
                    purchasePrice: window.getVal(p, 'purchasePrice'),
                    gstPercentage: window.getVal(p, 'gstPercentage'),
                    categoryId: window.getVal(p, 'categoryId'),
                    currentStock: window.getVal(p, 'currentStock')
                };
            });
        }

        function showForm() {
            $('#listView').hide();
            $('#formView').show();
            $('#orderForm')[0].reset();
            $('#OrderNumber').val("PO-" + Date.now().toString().slice(-6));
            $('#itemsTable tbody').empty();
            $('#SupplierId').val('').trigger('change');
            $('#Status').val('Pending');
            $('#poDocument').val('');
            $('#DocumentPath').val('');
            $('#poDocumentLink').hide();
            $('#WithGST').prop('checked', false);
            $('.gst-column').hide();
            addRow();
        }

        function hideForm() {
            $('#formView').hide();
            $('#listView').show();
        }

        function addRow(existingItem) {
            var catOptionsHtml = '<option value="">All Categories</option>';
            var categoriesList = @Json.Serialize(Model.Categories.Select(c => new { id = c.Id, categoryName = c.CategoryName }));
            if (categoriesList) {
                categoriesList = categoriesList.map(function(c) {
                    return {
                        id: window.getVal(c, 'id'),
                        categoryName: window.getVal(c, 'categoryName')
                    };
                });
            }
            categoriesList.forEach(function(c) {
                catOptionsHtml += `<option value="${c.id}">${c.categoryName}</option>`;
            });

            var optionsHtml = '<option value="">Select Product</option>';
            productsList.forEach(function(p) {
                var optionText = `${p.productName} (${p.productCode}) | Stock: ${p.currentStock || 0} | Cost: ₹${(p.purchasePrice || 0).toFixed(2)} | GST: ${p.gstPercentage || 0}%`;
                optionsHtml += `<option value="${p.id}">${optionText}</option>`;
            });

            var rowHtml = `
                <tr class="grid-item-row">
                    <td>
                        <select class="form-select select2-category" onchange="onCategorySelect(this)">
                            ${catOptionsHtml}
                        </select>
                    </td>
                    <td>
                        <select class="form-select select2-row" onchange="onProductSelect(this)" required>
                            ${optionsHtml}
                        </select>
                    </td>
                    <td>
                        <input type="number" class="form-control qty-input" value="1" min="1" oninput="calculateRow(this)" required />
                    </td>
                    <td>
                        <input type="number" class="form-control rate-input" value="0.00" step="0.01" oninput="calculateRow(this)" required />
                    </td>
                    <td class="gst-column">
                        <input type="number" class="form-control gst-input" value="18" oninput="calculateRow(this)" required />
                    </td>
                    <td>
                        <input type="text" class="form-control total-input" value="0.00" readonly />
                    </td>
                    <td class="text-center">
                        <button type="button" class="btn btn-sm btn-outline-danger" onclick="removeRow(this)"><i class="fa-solid fa-trash"></i></button>
                    </td>
                </tr>
            `;
            var $row = $(rowHtml);
            $('#itemsTable tbody').append($row);
            window.initializeSelect2($row.find('.select2-row'));
            window.initializeSelect2($row.find('.select2-category'));

            if ($('#WithGST').is(':checked')) {
                $row.find('.gst-column').show();
            } else {
                $row.find('.gst-column').hide();
                $row.find('.gst-input').val(0);
            }

            if (existingItem) {
                $row.find('.select2-row').val(existingItem.productId).trigger('change');
                $row.find('.qty-input').val(existingItem.quantity);
                $row.find('.rate-input').val(existingItem.rate);
                $row.find('.gst-input').val(existingItem.taxPercentage);
                $row.find('.total-input').val((existingItem.quantity * existingItem.rate).toFixed(2));
            }
        }

        function removeRow(btn) {
            $(btn).closest('tr').remove();
            calculateTotals();
        }

        function onCategorySelect(select) {
            var catId = $(select).val();
            var $row = $(select).closest('tr');
            var $prodSelect = $row.find('.select2-row');
            
            $prodSelect.empty();
            $prodSelect.append('<option value="">Select Product</option>');
            
            productsList.forEach(function(p) {
                if (!catId || p.categoryId == catId) {
                    var optionText = `${p.productName} (${p.productCode}) | Stock: ${p.currentStock || 0} | Cost: ₹${(p.purchasePrice || 0).toFixed(2)} | GST: ${p.gstPercentage || 0}%`;
                    $prodSelect.append(`<option value="${p.id}">${optionText}</option>`);
                }
            });
            $prodSelect.trigger('change');
        }

        function onProductSelect(select) {
            var prodId = $(select).val();
            var product = productsList.find(p => p.id == prodId);
            var $row = $(select).closest('tr');
            if (product) {
                $row.find('.rate-input').val(product.purchasePrice);
                $row.find('.gst-input').val(product.gstPercentage);
            }
            calculateRow(select);
        }

        function calculateRow(elem) {
            var $row = $(elem).closest('tr');
            var qty = parseFloat($row.find('.qty-input').val()) || 0;
            var rate = parseFloat($row.find('.rate-input').val()) || 0;
            $row.find('.total-input').val((qty * rate).toFixed(2));
            calculateTotals();
        }

        function toggleGST(elem) {
            var isChecked = $(elem).is(':checked');
            if (isChecked) {
                $('.gst-column').show();
            } else {
                $('.gst-column').hide();
                $('.gst-input').val(0);
            }
            calculateTotals();
        }

        function calculateTotals() {
            var subTotal = 0;
            var totalGST = 0;
            var withGst = $('#WithGST').is(':checked');

            $('#itemsTable tbody tr').each(function() {
                var qty = parseFloat($(this).find('.qty-input').val()) || 0;
                var rate = parseFloat($(this).find('.rate-input').val()) || 0;
                var gst = withGst ? (parseFloat($(this).find('.gst-input').val()) || 0) : 0;
                
                var lineTotal = qty * rate;
                var lineGST = lineTotal * (gst / 100);

                subTotal += lineTotal;
                totalGST += lineGST;
            });

            var grandTotal = subTotal + totalGST;

            $('#lblSubTotal').text('₹' + subTotal.toFixed(2));
            $('#lblTotalGST').text('₹' + totalGST.toFixed(2));
            $('#lblGrandTotal').text('₹' + grandTotal.toFixed(2));

            if (withGst) {
                $('#divTotalGST').show();
            } else {
                $('#divTotalGST').hide();
            }
        }

        function saveOrder() {
            var items = [];
            var isValid = true;
            $('#itemsTable tbody tr').each(function() {
                var prodId = $(this).find('.select2-row').val();
                var qty = parseFloat($(this).find('.qty-input').val()) || 0;
                var rate = parseFloat($(this).find('.rate-input').val()) || 0;
                if (!prodId || qty <= 0 || rate <= 0) {
                    isValid = false;
                    return false;
                }
                var product = productsList.find(p => p.id == prodId);
                var gst = $('#WithGST').is(':checked') ? (parseFloat($(this).find('.gst-input').val()) || 0) : 0;
                items.push({
                    productId: parseInt(prodId),
                    quantity: qty,
                    rate: rate,
                    taxPercentage: gst,
                    taxAmount: qty * rate * (gst / 100),
                    amount: (qty * rate) + (qty * rate * (gst / 100))
                });
            });

            var supplierId = $('#SupplierId').val();
            if (!supplierId) {
                ErpApp.notify('Please select a supplier.', 'warning', 'Validation Error');
                $('#SupplierId').focus();
                return;
            }

            if (!isValid || items.length === 0) {
                ErpApp.notify('Please fill all required fields and add at least one valid line item.', 'warning', 'Validation Error');
                return;
            }

            var order = {
                id: parseInt($('#Id').val()) || 0,
                orderNumber: $('#OrderNumber').val(),
                orderDate: $('#OrderDate').val(),
                supplierId: parseInt(supplierId),
                subTotal: parseFloat($('#lblSubTotal').text().replace('₹', '')) || 0,
                taxAmount: parseFloat($('#lblTotalGST').text().replace('₹', '')) || 0,
                grandTotal: parseFloat($('#lblGrandTotal').text().replace('₹', '')) || 0,
                status: $('#Status').val(),
                documentPath: $('#DocumentPath').val(),
                items: items,
                withGST: $('#WithGST').is(':checked')
            };

            var $btn = $('#btnSaveOrder, [onclick="saveOrder()"]').first();
            ErpApp.setButtonLoading($btn, true, 'Saving Purchase Order...');

            $.ajax({
                url: '/Purchase/SaveOrder',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(order),
                success: function(res) {
                    ErpApp.setButtonLoading($btn, false);
                    if (res && res.success) {
                        ErpApp.notify(res.message || 'Purchase Order saved successfully.', 'success');
                        setTimeout(function() { location.reload(); }, 600);
                    } else {
                        ErpApp.notify(res.message || 'Failed to save purchase order.', 'error');
                        if (res.errors) ErpApp.showFieldErrors('#orderForm', res.errors);
                    }
                },
                error: function(xhr) {
                    ErpApp.setButtonLoading($btn, false);
                    var msg = xhr.responseJSON?.message || 'Failed to save purchase order.';
                    ErpApp.notify(msg, 'error');
                }
            });
        }

        function deleteOrder(id) {
            ErpApp.confirmDelete({
                url: '/Purchase/DeleteOrder',
                id: id,
                rowElement: '#row-' + id,
                message: 'Do you want to delete this purchase order?'
            });
        }

        function convertOrderToInvoice(id) {
            Swal.fire({
                title: 'Convert order?',
                text: 'This will create a purchase invoice from this order.',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#16a34a',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Convert'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.post('/Purchase/ConvertOrderToInvoice', { id: id }, function(res) {
                        if (res.success) {
                            Swal.fire('Converted!', res.message, 'success').then(() => {
                                window.location.href = '/Purchase/Invoice';
                            });
                        } else {
                            Swal.fire('Error!', res.message || 'Conversion failed.', 'error');
                        }
                    });
                }
            });
        }

        $('#poDocument').on('change', function(e) {
            var file = e.target.files[0];
            if (!file) return;
            var formData = new FormData();
            formData.append('file', file);
            $('#uploadingDocSpinner').show();
            $('#poDocumentLink').hide();
            
            $.ajax({
                url: '/Purchase/UploadDocument',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function(res) {
                    $('#uploadingDocSpinner').hide();
                    if (res.success) {
                        $('#DocumentPath').val(res.filePath);
                        $('#poDocumentLink').attr('href', res.filePath).show();
                    } else {
                        Swal.fire('Error', res.message || 'Failed to upload document', 'error');
                    }
                },
                error: function() {
                    $('#uploadingDocSpinner').hide();
                    Swal.fire('Error', 'Failed to upload document', 'error');
                }
            });
        });

        var uploadModal;
        $(function () {
            uploadModal = new bootstrap.Modal(document.getElementById('uploadModal'));

            // File Upload and Verification Logic
            var importedProducts = [];
            var importCategories = [];
            var importBrands = [];
            var importUnits = [];
            var importWarehouses = [];

            // Bind click to the drop zone
            $('#importDropZone').on('click', function () {
                $('#importFileSelect').click();
            });

            // Bind drag-and-drop events
            $('#importDropZone').on('dragover', function (e) {
                e.preventDefault();
                e.stopPropagation();
                $(this).addClass('bg-primary bg-opacity-10 border-primary');
            });

            // Bind dragleave event
            $('#importDropZone').on('dragleave', function (e) {
                e.preventDefault();
                e.stopPropagation();
                $(this).removeClass('bg-primary bg-opacity-10 border-primary');
            });

            // Bind drop event
            $('#importDropZone').on('drop', function (e) {
                e.preventDefault();
                e.stopPropagation();
                $(this).removeClass('bg-primary bg-opacity-10 border-primary');

                var files = e.originalEvent.dataTransfer.files;
                if (files.length > 0) {
                    $('#importFileSelect')[0].files = files;
                    $('#importFileSelect').trigger('change');
                }
            });

            $('#importFileSelect').on('change', function (e) {
                var file = e.target.files[0];
                if (!file) return;

                var formData = new FormData();
                formData.append('file', file);

                Swal.fire({
                    title: 'Analyzing Document...',
                    html: 'Extracting product information and matching with database, please wait...',
                    allowOutsideClick: false,
                    didOpen: function () {
                        Swal.showLoading();
                    }
                });

                $.ajax({
                    url: '/Masters/PreviewImport',
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (res) {
                        Swal.close();
                        if (res.success) {
                            importedProducts = res.items;
                            importCategories = res.categories || [];
                            importBrands = res.brands || [];
                            importUnits = res.units || [];
                            importWarehouses = res.warehouses || [];

                            // Render Verification Table
                            renderVerificationTable();

                            // Show workspace sections
                            $('#uploadFileSection').addClass('d-none');
                            $('#verificationSection').removeClass('d-none');
                            $('#btnBackToUpload').removeClass('d-none');
                            $('#btnCommitImport').removeClass('d-none');
                        } else {
                            Swal.fire('Import Error', res.message || 'Failed to parse file.', 'error');
                            $('#importFileSelect').val('');
                        }
                    },
                    error: function (xhr, err) {
                        Swal.close();
                        Swal.fire('Error', 'An error occurred while uploading and parsing the document.', 'error');
                        $('#importFileSelect').val('');
                    }
                });
            });

            function populateDatalist(selector, items) {
                var dl = $(selector);
                dl.empty();
                if (items) {
                    items.forEach(function (item) {
                        dl.append(`<option value="${item}"></option>`);
                    });
                }
            }

            window.renderVerificationTable = function () {
                var tbody = $('#verificationTable tbody');
                tbody.empty();

                if (importedProducts.length === 0) {
                    tbody.append('<tr><td colspan="15" class="text-center text-muted py-4">No products found to import.</td></tr>');
                    updateStats(0, 0, 0, 0);
                    return;
                }

                var stats = { total: 0, news: 0, exacts: 0, similars: 0 };

                importedProducts.forEach(function (item, index) {
                    stats.total++;
                    var statusBadge = '';
                    var actionSelect = '';

                    if (item.matchStatus === 'ExactMatch') {
                        stats.exacts++;
                        statusBadge = `<span class="badge bg-primary text-uppercase shadow-sm py-1.5 px-2.5" title="Exact match in database"><i class="fa-solid fa-check-double me-1"></i> Match</span>`;
                        actionSelect = `
                            <select class="form-select form-select-sm item-action" data-index="${index}">
                                <option value="UpdateExisting" selected>Update Existing</option>
                                <option value="CreateNew">Import as New</option>
                                <option value="Ignore">Skip</option>
                            </select>`;
                    } else if (item.matchStatus === 'SimilarMatch') {
                        stats.similars++;
                        statusBadge = `<span class="badge bg-warning text-dark text-uppercase shadow-sm py-1.5 px-2.5" title="Similar to: ${item.similarMatchedName}"><i class="fa-solid fa-triangle-exclamation me-1"></i> Similar</span>
                                       <div class="small text-muted mt-1" style="font-size: 0.7rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">Ref: ${item.similarMatchedName}</div>`;
                        actionSelect = `
                            <select class="form-select form-select-sm item-action" data-index="${index}">
                                <option value="UpdateExisting" selected>Update Matched</option>
                                <option value="CreateNew">Import as New</option>
                                <option value="Ignore">Skip</option>
                            </select>`;
                    } else {
                        stats.news++;
                        statusBadge = `<span class="badge bg-success text-uppercase shadow-sm py-1.5 px-2.5"><i class="fa-solid fa-plus me-1"></i> New</span>`;
                        actionSelect = `
                            <select class="form-select form-select-sm item-action" data-index="${index}">
                                <option value="CreateNew" selected>Import</option>
                                <option value="Ignore">Skip</option>
                            </select>`;
                    }

                    // Dynamically build select options for lookup tables
                    var catOptionsHtml = '';
                    var catMatched = false;
                    importCategories.forEach(function(catName) {
                        var selected = '';
                        if (item.categoryName && catName.toLowerCase() === item.categoryName.toLowerCase()) {
                            selected = 'selected';
                            catMatched = true;
                        }
                        catOptionsHtml += `<option value="${catName}" ${selected}>${catName}</option>`;
                    });
                    if (!catMatched && item.categoryName) {
                        catOptionsHtml += `<option value="${item.categoryName}" selected>${item.categoryName} (New)</option>`;
                    } else if (!item.categoryName) {
                        catOptionsHtml = `<option value="Power Tools" selected>Power Tools</option>` + catOptionsHtml;
                    }

                    var brandOptionsHtml = '<option value="">No Brand</option>';
                    var brandMatched = false;
                    importBrands.forEach(function(brandName) {
                        var selected = '';
                        if (item.brandName && brandName.toLowerCase() === item.brandName.toLowerCase()) {
                            selected = 'selected';
                            brandMatched = true;
                        }
                        brandOptionsHtml += `<option value="${brandName}" ${selected}>${brandName}</option>`;
                    });
                    if (!brandMatched && item.brandName) {
                        brandOptionsHtml += `<option value="${item.brandName}" selected>${item.brandName} (New)</option>`;
                    }

                    var unitOptionsHtml = '';
                    var unitMatched = false;
                    importUnits.forEach(function(unitSymbol) {
                        var selected = '';
                        if (item.unitName && unitSymbol.toLowerCase() === item.unitName.toLowerCase()) {
                            selected = 'selected';
                            unitMatched = true;
                        }
                        unitOptionsHtml += `<option value="${unitSymbol}" ${selected}>${unitSymbol}</option>`;
                    });
                    if (!unitMatched && item.unitName) {
                        unitOptionsHtml += `<option value="${item.unitName}" selected>${item.unitName} (New)</option>`;
                    } else if (!item.unitName) {
                        var defaultUnit = importUnits.length > 0 ? importUnits[0] : "nos";
                        unitOptionsHtml = `<option value="${defaultUnit}" selected>${defaultUnit}</option>` + unitOptionsHtml;
                    }

                    var whOptionsHtml = '';
                    var whMatched = false;
                    importWarehouses.forEach(function(whName) {
                        var selected = '';
                        if (item.warehouseName && whName.toLowerCase() === item.warehouseName.toLowerCase()) {
                            selected = 'selected';
                            whMatched = true;
                        }
                        whOptionsHtml += `<option value="${whName}" ${selected}>${whName}</option>`;
                    });
                    if (!whMatched && item.warehouseName) {
                        whOptionsHtml += `<option value="${item.warehouseName}" selected>${item.warehouseName} (New)</option>`;
                    } else if (!item.warehouseName) {
                        var defaultWh = importWarehouses.length > 0 ? importWarehouses[0] : "Main Warehouse";
                        whOptionsHtml = `<option value="${defaultWh}" selected>${defaultWh}</option>` + whOptionsHtml;
                    }

                    var rowHtml = `
                        <tr data-index="${index}">
                            <td>${statusBadge}</td>
                            <td>${actionSelect}</td>
                            <td><input type="text" class="form-control form-control-sm item-code font-weight-semibold" value="${item.productCode || ''}"></td>
                            <td><input type="text" class="form-control form-control-sm item-name font-weight-semibold" value="${item.productName || ''}"></td>
                            <td><input type="text" class="form-control form-control-sm item-hsn" value="${item.hsnCode || ''}"></td>
                            <td>
                                <select class="form-select form-select-sm item-category">
                                    ${catOptionsHtml}
                                </select>
                            </td>
                            <td>
                                <select class="form-select form-select-sm item-brand">
                                    ${brandOptionsHtml}
                                </select>
                            </td>
                            <td>
                                <select class="form-select form-select-sm item-unit">
                                    ${unitOptionsHtml}
                                </select>
                            </td>
                            <td>
                                <select class="form-select form-select-sm item-warehouse">
                                    ${whOptionsHtml}
                                </select>
                            </td>
                            <td><input type="number" class="form-control form-control-sm item-qty" value="${item.openingStock || 1}" step="1" min="1"></td>
                            <td><input type="number" class="form-control form-control-sm item-purchase" value="${item.purchasePrice || 0}" step="0.01"></td>
                            <td><input type="number" class="form-control form-control-sm item-sales" value="${item.salesPrice || 0}" step="0.01"></td>
                            <td><input type="number" class="form-control form-control-sm item-mrp" value="${item.mrp || 0}" step="0.01"></td>
                            <td><input type="number" class="form-control form-control-sm item-gst" value="${item.gstPercentage || 18}"></td>
                            <td class="text-center">
                                <button type="button" class="btn btn-sm btn-outline-danger" onclick="removeImportRow(${index})">
                                    <i class="fa-solid fa-trash-can"></i>
                                </button>
                            </td>
                        </tr>
                    `;
                    tbody.append(rowHtml);
                });

                updateStats(stats.total, stats.news, stats.exacts, stats.similars);
            };

            window.removeImportRow = function (index) {
                importedProducts.splice(index, 1);
                renderVerificationTable();
            };

            function updateStats(total, news, exacts, similars) {
                $('#statTotalItems').text(total);
                $('#statNewItems').text(news);
                $('#statExactMatches').text(exacts);
                $('#statSimilarMatches').text(similars);
            }

            window.resetImportModal = function () {
                $('#importFileSelect').val('');
                importedProducts = [];
                $('#uploadFileSection').removeClass('d-none');
                $('#verificationSection').addClass('d-none');
                $('#btnBackToUpload').addClass('d-none');
                $('#btnCommitImport').addClass('d-none');
                $('#verificationTable tbody').empty();
            };

            window.commitVerifiedImport = function () {
                var payload = [];
                var isValid = true;

                $('#verificationTable tbody tr').each(function () {
                    var row = $(this);
                    var idx = parseInt(row.data('index'));
                    var code = row.find('.item-code').val().trim();
                    var name = row.find('.item-name').val().trim();
                    var action = row.find('.item-action').val();

                    if (action === 'Ignore') return;

                    if (!name) {
                        row.find('.item-name').addClass('is-invalid');
                        isValid = false;
                    } else {
                        row.find('.item-name').removeClass('is-invalid');
                    }

                    payload.push({
                        productCode: code,
                        productName: name,
                        hsnCode: row.find('.item-hsn').val().trim(),
                        categoryName: row.find('.item-category').val().trim(),
                        brandName: row.find('.item-brand').val().trim(),
                        unitName: row.find('.item-unit').val().trim(),
                        warehouseName: row.find('.item-warehouse').val().trim(),
                        openingStock: parseFloat(row.find('.item-qty').val()) || 0,
                        purchasePrice: parseFloat(row.find('.item-purchase').val()) || 0,
                        salesPrice: parseFloat(row.find('.item-sales').val()) || 0,
                        mrp: parseFloat(row.find('.item-mrp').val()) || 0,
                        gstPercentage: parseFloat(row.find('.item-gst').val()) || 0,
                        existingProductId: importedProducts[idx].existingProductId || importedProducts[idx].ExistingProductId || null,
                        actionType: action
                    });
                });

                if (!isValid) {
                    Swal.fire('Validation Error', 'Please ensure all active products have a valid Name.', 'warning');
                    return;
                }

                if (payload.length === 0) {
                    Swal.fire('Information', 'No items are selected for import.', 'info');
                    return;
                }

                Swal.fire({
                    title: 'Importing Products...',
                    html: `Saving ${payload.length} products to database and auto-generating masters...`,
                    allowOutsideClick: false,
                    didOpen: function () {
                        Swal.showLoading();
                    }
                });

                $.ajax({
                    url: '/Masters/CommitImport',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(payload),
                    success: function (res) {
                        Swal.close();
                        if (res.success && res.items) {
                            Swal.fire('Import Complete!', 'Successfully imported products and auto-created masters. Autofilling Purchase Order line items...', 'success').then(function () {
                                // Close the modal
                                uploadModal.hide();

                                // Reload productsList dynamic variable so new products are selectable in all dropdowns
                                $.getJSON('/api/erp/products', function(data) {
                                    if (data) {
                                        productsList = data.map(function(p) {
                                            return {
                                                id: window.getVal(p, 'id'),
                                                productCode: window.getVal(p, 'productCode'),
                                                productName: window.getVal(p, 'productName'),
                                                salesPrice: window.getVal(p, 'salesPrice'),
                                                purchasePrice: window.getVal(p, 'purchasePrice'),
                                                gstPercentage: window.getVal(p, 'gstPercentage'),
                                                categoryId: window.getVal(p, 'categoryId'),
                                                currentStock: window.getVal(p, 'currentStock')
                                            };
                                        });
                                    }
                                }).always(function() {
                                    // Empty current itemsTable
                                    $('#itemsTable tbody').empty();

                                    // Populate table with parsed items
                                    res.items.forEach(function (item) {
                                        addParsedRow(item);
                                    });
                                    calculateTotals();
                                });
                            });
                        }
                        else {
                            Swal.fire('Import Failed', res.message || 'Failed to save products.', 'error');
                        }
                    },
                    error: function () {
                        Swal.close();
                        Swal.fire('Error', 'An error occurred while saving products.', 'error');
                    }
                });
            };
        });

        function openImportModal() {
            resetImportModal();
            uploadModal.show();
        }

        // Helper to add a row pre-filled with parsed product and values
        function addParsedRow(item) {
            var catOptionsHtml = '<option value="">All Categories</option>';
            var categoriesList = @Json.Serialize(Model.Categories.Select(c => new { id = c.Id, categoryName = c.CategoryName }));
            if (categoriesList) {
                categoriesList = categoriesList.map(function(c) {
                    return {
                        id: window.getVal(c, 'id'),
                        categoryName: window.getVal(c, 'categoryName')
                    };
                });
            }
            categoriesList.forEach(function(c) {
                var selected = c.id == item.categoryId ? 'selected' : '';
                catOptionsHtml += `<option value="${c.id}" ${selected}>${c.categoryName}</option>`;
            });

            var optionsHtml = '<option value="">Select Product</option>';
            productsList.forEach(function(p) {
                var selected = p.id == item.productId ? 'selected' : '';
                var optionText = `${p.productName} (${p.productCode}) | Stock: ${p.currentStock || 0} | Cost: ₹${(p.purchasePrice || 0).toFixed(2)} | GST: ${p.gstPercentage || 0}%`;
                optionsHtml += `<option value="${p.id}" ${selected}>${optionText}</option>`;
            });

            var itemQty = item.qty || item.quantity || 1;
            var itemRate = item.rate || 0;
            var totalAmount = (itemQty * itemRate).toFixed(2);

            var rowHtml = `
                <tr class="grid-item-row">
                    <td>
                        <select class="form-select select2-category" onchange="onCategorySelect(this)">
                            ${catOptionsHtml}
                        </select>
                    </td>
                    <td>
                        <select class="form-select select2-row" onchange="onProductSelect(this)" required>
                            ${optionsHtml}
                        </select>
                    </td>
                    <td>
                        <input type="number" class="form-control qty-input" value="${itemQty}" min="1" oninput="calculateRow(this)" required />
                    </td>
                    <td>
                        <input type="number" class="form-control rate-input" value="${itemRate.toFixed(2)}" step="0.01" oninput="calculateRow(this)" required />
                    </td>
                    <td>
                        <input type="text" class="form-control total-input" value="${totalAmount}" readonly />
                    </td>
                    <td class="text-center">
                        <button type="button" class="btn btn-sm btn-outline-danger" onclick="removeRow(this)"><i class="fa-solid fa-trash"></i></button>
                    </td>
                </tr>
            `;
            var $row = $(rowHtml);
            $('#itemsTable tbody').append($row);
            window.initializeSelect2($row.find('.select2-row'));
            window.initializeSelect2($row.find('.select2-category'));
        }
    </script>
}

