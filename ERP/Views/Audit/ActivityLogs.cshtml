@model ERP.ViewModels.LoginHistoryPageViewModel
@{
    ViewData["Title"] = "Company Context Switch Activity";
}

<div class="container-fluid p-3 p-md-4">
    <!-- Breadcrumb & Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a href="/" class="text-decoration-none">Home</a></li>
                    <li class="breadcrumb-item"><a href="/Audit/LoginHistory" class="text-decoration-none">Login History</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Context Switch Logs</li>
                </ol>
            </nav>
            <h3 class="fw-bold mb-0 text-dark">
                <i class="fa-solid fa-shuffle text-info me-2"></i>Company Context Switch Activity
            </h3>
            <p class="text-muted small mb-0">Audit history of Super Admin company context transitions.</p>
        </div>

        <div class="mt-2 mt-md-0">
            <a href="/Audit/LoginHistory" class="btn btn-outline-primary btn-sm">
                <i class="fa-solid fa-clock-rotate-left me-1"></i> Back to Login History
            </a>
        </div>
    </div>

    <!-- Activity Table Card -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <h6 class="fw-bold mb-0 text-dark">
                <i class="fa-solid fa-list me-2 text-secondary"></i>Context Transition Records
            </h6>
            <span class="badge bg-light text-dark border">
                Total: @Model.TotalCount records
            </span>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 text-nowrap">
                <thead class="table-light text-muted small text-uppercase">
                    <tr>
                        <th class="ps-3">Timestamp</th>
                        <th>User</th>
                        <th>Role</th>
                        <th>Previous Context</th>
                        <th>New Context</th>
                        <th>Description</th>
                        <th>IP Address</th>
                    </tr>
                </thead>
                <tbody class="small">
                    @if (Model.ActivityLogs.Any())
                    {
                        foreach (var item in Model.ActivityLogs)
                        {
                            <tr>
                                <td class="ps-3 font-monospace">
                                    <i class="fa-regular fa-clock text-muted me-1"></i>
                                    @item.Timestamp.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")
                                </td>
                                <td>
                                    <span class="fw-semibold text-dark">@item.Username</span>
                                </td>
                                <td>
                                    <span class="badge bg-purple text-white">@item.Role</span>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.PreviousCompanyCode))
                                    {
                                        <span class="badge bg-light text-dark border font-monospace">@item.PreviousCompanyCode</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary text-white font-monospace">System (All)</span>
                                    }
                                </td>
                                <td>
                                    <i class="fa-solid fa-arrow-right text-muted mx-1"></i>
                                    @if (!string.IsNullOrEmpty(item.NewCompanyCode))
                                    {
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle font-monospace">@item.NewCompanyCode</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary text-white font-monospace">System (All)</span>
                                    }
                                </td>
                                <td>
                                    <span class="text-muted">@item.Description</span>
                                </td>
                                <td class="font-monospace text-muted">
                                    @(item.IPAddress ?? "—")
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="fa-solid fa-shuffle fs-1 d-block mb-3 text-secondary"></i>
                                <div class="fw-semibold">No context switch logs found</div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .bg-purple {
        background-color: #6f42c1;
    }
</style>
