@model ERP.ViewModels.AuditLogPageViewModel
@{
    ViewData["Title"] = "Audit Trail & Activity Logs";
}

<div class="container-fluid p-3 p-md-4">
    <!-- Breadcrumb & Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a href="/" class="text-decoration-none">Home</a></li>
                    <li class="breadcrumb-item"><a href="/Settings" class="text-decoration-none">Settings</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Audit Trail</li>
                </ol>
            </nav>
            <h3 class="fw-bold mb-0 text-dark">
                <i class="fa-solid fa-shield-halved text-primary me-2"></i>Audit Trail & Activity Logs
            </h3>
            <p class="text-muted small mb-0">Immutable, tenant-scoped audit record of system activities, master CRUD changes, and security events.</p>
        </div>

        <div class="d-flex gap-2 mt-2 mt-md-0">
            <a href="@Url.Action("ExportCsv", "Audit", Model.Filter)" class="btn btn-outline-success btn-sm">
                <i class="fa-solid fa-file-csv me-1"></i> Export to CSV
            </a>
            <a href="/Audit/LoginHistory" class="btn btn-outline-secondary btn-sm">
                <i class="fa-solid fa-clock-rotate-left me-1"></i> Login History
            </a>
        </div>
    </div>

    <!-- Statistical Metric Cards -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-body p-3 d-flex align-items-center">
                    <div class="rounded-3 bg-primary-subtle text-primary p-3 me-3">
                        <i class="fa-solid fa-list-check fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Total Audit Logs</div>
                        <h4 class="fw-bold mb-0 text-dark">@Model.Statistics.TotalLogs.ToString("N0")</h4>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-body p-3 d-flex align-items-center">
                    <div class="rounded-3 bg-warning-subtle text-warning p-3 me-3">
                        <i class="fa-solid fa-triangle-exclamation fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Security Events</div>
                        <h4 class="fw-bold mb-0 text-warning">@Model.Statistics.SecurityEvents.ToString("N0")</h4>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-body p-3 d-flex align-items-center">
                    <div class="rounded-3 bg-success-subtle text-success p-3 me-3">
                        <i class="fa-solid fa-pen-to-square fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">CRUD Changes</div>
                        <h4 class="fw-bold mb-0 text-success">@Model.Statistics.CrudChanges.ToString("N0")</h4>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-body p-3 d-flex align-items-center">
                    <div class="rounded-3 bg-info-subtle text-info p-3 me-3">
                        <i class="fa-solid fa-shuffle fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Context Switches</div>
                        <h4 class="fw-bold mb-0 text-info">@Model.Statistics.ContextSwitches.ToString("N0")</h4>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter Card -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-3">
            <form method="get" action="/Audit/Logs" id="filterForm">
                <div class="row g-2 align-items-end">
                    <div class="col-12 col-sm-6 col-md-3 col-lg-2">
                        <label class="form-label small fw-semibold text-muted mb-1">From Date</label>
                        <input type="date" name="DateFrom" class="form-control form-control-sm" value="@(Model.Filter.DateFrom?.ToString("yyyy-MM-dd"))" />
                    </div>
                    <div class="col-12 col-sm-6 col-md-3 col-lg-2">
                        <label class="form-label small fw-semibold text-muted mb-1">To Date</label>
                        <input type="date" name="DateTo" class="form-control form-control-sm" value="@(Model.Filter.DateTo?.ToString("yyyy-MM-dd"))" />
                    </div>
                    <div class="col-12 col-sm-6 col-md-3 col-lg-2">
                        <label class="form-label small fw-semibold text-muted mb-1">Module</label>
                        <select name="Module" class="form-select form-select-sm">
                            <option value="">All Modules</option>
                            @foreach (var m in Model.AvailableModules)
                            {
                                <option value="@m" selected="@(Model.Filter.Module == m)">@m</option>
                            }
                        </select>
                    </div>
                    <div class="col-12 col-sm-6 col-md-3 col-lg-2">
                        <label class="form-label small fw-semibold text-muted mb-1">Action</label>
                        <select name="Action" class="form-select form-select-sm">
                            <option value="">All Actions</option>
                            @foreach (var a in Model.AvailableActions)
                            {
                                <option value="@a" selected="@(Model.Filter.Action == a)">@a</option>
                            }
                        </select>
                    </div>

                    @if (Model.IsSuperAdmin)
                    {
                        <div class="col-12 col-sm-6 col-md-3 col-lg-2">
                            <label class="form-label small fw-semibold text-muted mb-1">Company</label>
                            <select name="CompanyId" class="form-select form-select-sm">
                                <option value="">All Companies (System Wide)</option>
                                <option value="-1" selected="@(Model.Filter.CompanyId == -1)">System-Wide Events</option>
                                @foreach (var c in Model.AvailableCompanies)
                                {
                                    <option value="@c.Id" selected="@(Model.Filter.CompanyId == c.Id)">@c.CompanyCode - @c.CompanyName</option>
                                }
                            </select>
                        </div>
                    }

                    <div class="col-12 col-sm-6 col-md-3 col-lg-2">
                        <label class="form-label small fw-semibold text-muted mb-1">Keyword Search</label>
                        <input type="text" name="SearchTerm" class="form-control form-control-sm" placeholder="Entity, description, user..." value="@Model.Filter.SearchTerm" />
                    </div>

                    <div class="col-12 col-sm-6 col-md-3 col-lg-1 d-flex gap-1">
                        <button type="submit" class="btn btn-primary btn-sm w-100" title="Apply Filters">
                            <i class="fa-solid fa-filter"></i>
                        </button>
                        <a href="/Audit/Logs" class="btn btn-outline-secondary btn-sm" title="Reset Filters">
                            <i class="fa-solid fa-rotate-left"></i>
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Audit Log Table Card -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <h6 class="fw-bold mb-0 text-dark">
                <i class="fa-solid fa-list-check me-2 text-secondary"></i>Audit Log Entries
            </h6>
            <span class="badge bg-light text-dark border">
                Showing @Model.Logs.Count of @Model.TotalCount records
            </span>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-uppercase fs-8 text-muted fw-bold">
                    <tr>
                        <th class="ps-3" style="width: 14%;">Timestamp (UTC)</th>
                        <th style="width: 13%;">User</th>
                        @if (Model.IsSuperAdmin)
                        {
                            <th style="width: 12%;">Company</th>
                        }
                        <th style="width: 12%;">Module</th>
                        <th style="width: 12%;">Action</th>
                        <th style="width: 25%;">Description</th>
                        <th class="text-center" style="width: 8%;">Severity</th>
                        <th class="text-center" style="width: 6%;">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Logs != null && Model.Logs.Any())
                    {
                        foreach (var item in Model.Logs)
                        {
                            var severityBadge = item.Severity switch
                            {
                                "Critical" => "bg-danger text-white",
                                "Danger" => "bg-danger-subtle text-danger border border-danger-subtle",
                                "Warning" => "bg-warning-subtle text-warning border border-warning-subtle",
                                _ => "bg-success-subtle text-success border border-success-subtle"
                            };

                            var actionBadge = item.Action switch
                            {
                                "CREATE" => "bg-success-subtle text-success border border-success-subtle",
                                "UPDATE" => "bg-primary-subtle text-primary border border-primary-subtle",
                                "DELETE" => "bg-danger-subtle text-danger border border-danger-subtle",
                                "LOGIN" => "bg-info-subtle text-info border border-info-subtle",
                                "LOGOUT" => "bg-secondary-subtle text-secondary border border-secondary-subtle",
                                "COMPANY_SWITCH" => "bg-purple-subtle text-purple border border-purple-subtle",
                                _ => "bg-light text-dark border"
                            };

                            <tr>
                                <td class="ps-3 text-nowrap">
                                    <div class="fw-semibold text-dark">@item.Timestamp.ToString("yyyy-MM-dd")</div>
                                    <div class="text-muted small">@item.Timestamp.ToString("HH:mm:ss") UTC</div>
                                </td>
                                <td>
                                    <div class="fw-bold text-dark"><i class="fa-solid fa-user small text-muted me-1"></i>@item.UserName</div>
                                    <div class="text-muted fs-8">@(item.IpAddress ?? "N/A")</div>
                                </td>
                                @if (Model.IsSuperAdmin)
                                {
                                    <td>
                                        @if (item.Company != null)
                                        {
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                                                @item.Company.CompanyCode
                                            </span>
                                        }
                                        else if (item.CompanyId.HasValue)
                                        {
                                            <span class="badge bg-light text-dark border">#@item.CompanyId</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary border">System</span>
                                        }
                                    </td>
                                }
                                <td>
                                    <span class="fw-semibold text-secondary">@item.Module</span>
                                    @if (!string.IsNullOrEmpty(item.EntityName))
                                    {
                                        <div class="text-muted fs-8">@item.EntityName @(!string.IsNullOrEmpty(item.EntityId) ? $"#{item.EntityId}" : "")</div>
                                    }
                                </td>
                                <td>
                                    <span class="badge @actionBadge px-2 py-1 fs-8 fw-semibold">
                                        @item.Action
                                    </span>
                                </td>
                                <td>
                                    <div class="text-dark small text-truncate" style="max-width: 320px;" title="@item.Description">
                                        @item.Description
                                    </div>
                                </td>
                                <td class="text-center">
                                    <span class="badge @severityBadge px-2 py-1 fs-8">
                                        @item.Severity
                                    </span>
                                </td>
                                <td class="text-center">
                                    <button type="button" class="btn btn-sm btn-outline-primary btn-view-details" data-id="@item.Id" title="View Full Details">
                                        <i class="fa-solid fa-eye"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="@(Model.IsSuperAdmin ? 8 : 7)" class="text-center py-5 text-muted">
                                <i class="fa-solid fa-shield-halved fs-1 d-block mb-3 text-secondary opacity-50"></i>
                                <h6>No Audit Log Records Found</h6>
                                <p class="small mb-0">Try adjusting your filters or search criteria.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination Footer -->
        @if (Model.TotalCount > Model.Filter.PageSize)
        {
            var totalPages = (int)Math.Ceiling((double)Model.TotalCount / Model.Filter.PageSize);
            var currentPage = Model.Filter.Page;

            <div class="card-footer bg-white py-3 d-flex justify-content-between align-items-center">
                <div class="text-muted small">
                    Page @currentPage of @totalPages
                </div>
                <nav aria-label="Audit log navigation">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                            <a class="page-link" href="@Url.Action("Logs", "Audit", new { Page = currentPage - 1, DateFrom = Model.Filter.DateFrom?.ToString("yyyy-MM-dd"), DateTo = Model.Filter.DateTo?.ToString("yyyy-MM-dd"), Module = Model.Filter.Module, Action = Model.Filter.Action, CompanyId = Model.Filter.CompanyId, SearchTerm = Model.Filter.SearchTerm })">Previous</a>
                        </li>
                        @for (int p = Math.Max(1, currentPage - 2); p <= Math.Min(totalPages, currentPage + 2); p++)
                        {
                            <li class="page-item @(p == currentPage ? "active" : "")">
                                <a class="page-link" href="@Url.Action("Logs", "Audit", new { Page = p, DateFrom = Model.Filter.DateFrom?.ToString("yyyy-MM-dd"), DateTo = Model.Filter.DateTo?.ToString("yyyy-MM-dd"), Module = Model.Filter.Module, Action = Model.Filter.Action, CompanyId = Model.Filter.CompanyId, SearchTerm = Model.Filter.SearchTerm })">@p</a>
                            </li>
                        }
                        <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                            <a class="page-link" href="@Url.Action("Logs", "Audit", new { Page = currentPage + 1, DateFrom = Model.Filter.DateFrom?.ToString("yyyy-MM-dd"), DateTo = Model.Filter.DateTo?.ToString("yyyy-MM-dd"), Module = Model.Filter.Module, Action = Model.Filter.Action, CompanyId = Model.Filter.CompanyId, SearchTerm = Model.Filter.SearchTerm })">Next</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>

<!-- Audit Log Details Modal -->
<div class="modal fade" id="logDetailsModal" tabindex="-1" aria-labelledby="logDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white py-3">
                <h5 class="modal-title fw-bold" id="logDetailsModalLabel">
                    <i class="fa-solid fa-shield-halved me-2"></i>Audit Log Record Details
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div id="modalLoadingSpinner" class="text-center py-4">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>

                <div id="modalContentArea" style="display: none;">
                    <!-- Overview Metadata Table -->
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <table class="table table-sm table-bordered mb-0">
                                <tbody>
                                    <tr><th class="bg-light text-muted w-40">Record ID</th><td id="detLogId" class="fw-bold"></td></tr>
                                    <tr><th class="bg-light text-muted">Timestamp</th><td id="detTimestamp"></td></tr>
                                    <tr><th class="bg-light text-muted">User</th><td id="detUser" class="fw-semibold"></td></tr>
                                    <tr><th class="bg-light text-muted">Company</th><td id="detCompany"></td></tr>
                                    <tr><th class="bg-light text-muted">Severity</th><td id="detSeverity"></td></tr>
                                </tbody>
                            </table>
                        </div>
                        <div class="col-md-6">
                            <table class="table table-sm table-bordered mb-0">
                                <tbody>
                                    <tr><th class="bg-light text-muted w-40">Module</th><td id="detModule" class="fw-semibold"></td></tr>
                                    <tr><th class="bg-light text-muted">Action</th><td id="detAction"></td></tr>
                                    <tr><th class="bg-light text-muted">Entity Target</th><td id="detEntity"></td></tr>
                                    <tr><th class="bg-light text-muted">IP Address</th><td id="detIpAddress"></td></tr>
                                    <tr><th class="bg-light text-muted">Status</th><td id="detStatus"></td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Description -->
                    <div class="mb-4">
                        <label class="fw-semibold small text-muted text-uppercase mb-1">Description</label>
                        <div id="detDescription" class="p-3 bg-light rounded-2 border text-dark"></div>
                    </div>

                    <!-- Field-by-Field Diff Table (Old vs New Values) -->
                    <div id="diffSection" class="mb-3">
                        <label class="fw-semibold small text-muted text-uppercase mb-1">
                            <i class="fa-solid fa-code-compare me-1"></i>Changed Values (Old vs New)
                        </label>
                        <div class="table-responsive border rounded-2">
                            <table class="table table-sm table-hover align-middle mb-0">
                                <thead class="table-light fs-8 text-uppercase fw-bold text-muted">
                                    <tr>
                                        <th style="width: 30%;">Field Name</th>
                                        <th style="width: 35%;" class="text-danger">Previous Value</th>
                                        <th style="width: 35%;" class="text-success">New Value</th>
                                    </tr>
                                </thead>
                                <tbody id="diffTableBody">
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light border-top py-2 px-4">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            $('.btn-view-details').on('click', function () {
                const id = $(this).data('id');
                const modal = new bootstrap.Modal(document.getElementById('logDetailsModal'));
                modal.show();

                $('#modalLoadingSpinner').show();
                $('#modalContentArea').hide();

                $.get(`/Audit/GetLogDetails/${id}`, function (res) {
                    $('#modalLoadingSpinner').hide();

                    if (res.success && res.data) {
                        const d = res.data;
                        $('#detLogId').text('#' + d.id);
                        $('#detTimestamp').text(d.timestampFormatted);
                        $('#detUser').text(d.userName);
                        $('#detCompany').text(d.companyName || 'System-Wide');
                        $('#detSeverity').html(`<span class="badge ${d.severity === 'Warning' ? 'bg-warning text-dark' : (d.severity === 'Danger' ? 'bg-danger' : 'bg-success')}">${d.severity}</span>`);
                        $('#detModule').text(d.module);
                        $('#detAction').html(`<span class="badge bg-primary">${d.action}</span>`);
                        $('#detEntity').text(d.entityName ? `${d.entityName} ${d.entityId ? '#' + d.entityId : ''}` : 'N/A');
                        $('#detIpAddress').text(d.ipAddress || 'Unknown');
                        $('#detStatus').html(`<span class="badge bg-success-subtle text-success">${d.status}</span>`);
                        $('#detDescription').text(d.description || 'No additional description.');

                        const diffBody = $('#diffTableBody');
                        diffBody.empty();

                        if (d.fieldDiffs && d.fieldDiffs.length > 0) {
                            $('#diffSection').show();
                            d.fieldDiffs.forEach(diff => {
                                const row = `
                                    <tr>
                                        <td class="fw-semibold text-dark">${diff.fieldName}</td>
                                        <td class="text-danger bg-danger-subtle bg-opacity-25 font-monospace small">${escapeHtml(diff.oldValue)}</td>
                                        <td class="text-success bg-success-subtle bg-opacity-25 font-monospace small">${escapeHtml(diff.newValue)}</td>
                                    </tr>
                                `;
                                diffBody.append(row);
                            });
                        } else {
                            if (d.rawNewValues) {
                                $('#diffSection').show();
                                diffBody.append(`
                                    <tr>
                                        <td class="fw-semibold text-dark">Data Payload</td>
                                        <td class="text-muted font-monospace small">(None)</td>
                                        <td class="text-success font-monospace small">${escapeHtml(d.rawNewValues)}</td>
                                    </tr>
                                `);
                            } else {
                                $('#diffSection').hide();
                            }
                        }

                        $('#modalContentArea').show();
                    } else {
                        $('#modalContentArea').html(`<div class="alert alert-danger">${res.message || 'Failed to load details.'}</div>`).show();
                    }
                }).fail(function () {
                    $('#modalLoadingSpinner').hide();
                    $('#modalContentArea').html('<div class="alert alert-danger">An error occurred while fetching log details.</div>').show();
                });
            });

            function escapeHtml(text) {
                if (!text) return '';
                return text
                    .replace(/&/g, "&amp;")
                    .replace(/</g, "&lt;")
                    .replace(/>/g, "&gt;")
                    .replace(/"/g, "&quot;")
                    .replace(/'/g, "&#039;");
            }
        });
    </script>
}
