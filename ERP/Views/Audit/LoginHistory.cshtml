@model ERP.ViewModels.LoginHistoryPageViewModel
@{
    ViewData["Title"] = "Login History & Session Tracking";
}

<div class="container-fluid p-3 p-md-4">
    <!-- Breadcrumb & Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a href="/" class="text-decoration-none">Home</a></li>
                    <li class="breadcrumb-item"><a href="/Settings" class="text-decoration-none">Settings</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Login History</li>
                </ol>
            </nav>
            <h3 class="fw-bold mb-0 text-dark">
                <i class="fa-solid fa-clock-rotate-left text-primary me-2"></i>Login History & Sessions
            </h3>
            <p class="text-muted small mb-0">Audit login attempts, device origins, session durations, and multi-tenant security events.</p>
        </div>

        @if (Model.IsSuperAdmin)
        {
            <div class="mt-2 mt-md-0">
                <a href="/Audit/ActivityLogs" class="btn btn-outline-secondary btn-sm">
                    <i class="fa-solid fa-shuffle me-1"></i> View Context Switch Logs
                </a>
            </div>
        }
    </div>

    <!-- Filter Card -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-3">
            <form method="get" action="/Audit/LoginHistory" id="filterForm">
                <div class="row g-2 align-items-end">
                    <div class="col-12 col-sm-6 col-md-3 col-lg-2">
                        <label class="form-label small fw-semibold text-muted mb-1">From Date</label>
                        <input type="date" name="DateFrom" class="form-control form-control-sm" value="@(Model.Filter.DateFrom?.ToString("yyyy-MM-dd"))" />
                    </div>
                    <div class="col-12 col-sm-6 col-md-3 col-lg-2">
                        <label class="form-label small fw-semibold text-muted mb-1">To Date</label>
                        <input type="date" name="DateTo" class="form-control form-control-sm" value="@(Model.Filter.DateTo?.ToString("yyyy-MM-dd"))" />
                    </div>
                    <div class="col-12 col-sm-6 col-md-3 col-lg-2">
                        <label class="form-label small fw-semibold text-muted mb-1">Status</label>
                        <select name="Status" class="form-select form-select-sm">
                            <option value="">All Statuses</option>
                            <option value="Success" selected="@(Model.Filter.Status == "Success")">Success</option>
                            <option value="Failed" selected="@(Model.Filter.Status == "Failed")">Failed</option>
                            <option value="LoggedOut" selected="@(Model.Filter.Status == "LoggedOut")">Logged Out</option>
                        </select>
                    </div>

                    @if (Model.IsSuperAdmin)
                    {
                        <div class="col-12 col-sm-6 col-md-3 col-lg-3">
                            <label class="form-label small fw-semibold text-muted mb-1">Company</label>
                            <select name="CompanyId" class="form-select form-select-sm">
                                <option value="">All Companies (System Wide)</option>
                                <option value="-1" selected="@(Model.Filter.CompanyId == -1)">System Super Admins Only (No Company)</option>
                                @foreach (var c in Model.AvailableCompanies)
                                {
                                    <option value="@c.Id" selected="@(Model.Filter.CompanyId == c.Id)">@c.CompanyCode - @c.CompanyName</option>
                                }
                            </select>
                        </div>
                    }

                    <div class="col-12 col-sm-6 col-md-3 col-lg-2">
                        <label class="form-label small fw-semibold text-muted mb-1">Username</label>
                        <input type="text" name="Username" class="form-control form-control-sm" placeholder="Search user..." value="@Model.Filter.Username" />
                    </div>

                    <div class="col-12 col-sm-6 col-md-3 col-lg-1 d-flex gap-1">
                        <button type="submit" class="btn btn-primary btn-sm w-100" title="Apply Filters">
                            <i class="fa-solid fa-filter"></i>
                        </button>
                        <a href="/Audit/LoginHistory" class="btn btn-outline-secondary btn-sm" title="Reset Filters">
                            <i class="fa-solid fa-rotate-left"></i>
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- History Table Card -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <h6 class="fw-bold mb-0 text-dark">
                <i class="fa-solid fa-list-check me-2 text-secondary"></i>Authentication Log Records
            </h6>
            <span class="badge bg-light text-dark border">
                Total: @Model.TotalCount records
            </span>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 text-nowrap">
                <thead class="table-light text-muted small text-uppercase">
                    <tr>
                        <th class="ps-3">Date & Time</th>
                        <th>User</th>
                        <th>Role</th>
                        <th>Company</th>
                        <th>Status</th>
                        <th>Logout Time</th>
                        <th>IP Address</th>
                        <th>Device & OS</th>
                        <th>Browser</th>
                    </tr>
                </thead>
                <tbody class="small">
                    @if (Model.Histories.Any())
                    {
                        foreach (var item in Model.Histories)
                        {
                            <tr>
                                <td class="ps-3 font-monospace">
                                    <i class="fa-regular fa-clock text-muted me-1"></i>
                                    @item.LoginTime.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")
                                </td>
                                <td>
                                    <span class="fw-semibold text-dark">@item.Username</span>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.Role))
                                    {
                                        <span class="badge @(item.Role == "Super Admin" ? "bg-purple text-white" : item.Role == "CompanyAdmin" || item.Role == "Admin" ? "bg-primary" : "bg-info text-dark")">
                                            @item.Role
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td>
                                    @if (item.CompanyId.HasValue && !string.IsNullOrEmpty(item.CompanyCode))
                                    {
                                        <span class="badge bg-light text-dark border font-monospace">
                                            <i class="fa-solid fa-building me-1 text-secondary"></i>@item.CompanyCode
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary text-white font-monospace">
                                            <i class="fa-solid fa-shield-halved me-1"></i>System
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (item.Status == "Success")
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">
                                            <i class="fa-solid fa-check-circle me-1"></i>Active / Success
                                        </span>
                                    }
                                    else if (item.Status == "LoggedOut")
                                    {
                                        <span class="badge bg-light text-secondary border">
                                            <i class="fa-solid fa-arrow-right-from-bracket me-1"></i>Logged Out
                                        </span>
                                    }
                                    else if (item.Status == "SessionExpired")
                                    {
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle">
                                            <i class="fa-solid fa-hourglass-end me-1"></i>Expired
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle" title="@item.FailureReason">
                                            <i class="fa-solid fa-circle-xmark me-1"></i>Failed (@(item.FailureReason ?? "Denied"))
                                        </span>
                                    }
                                </td>
                                <td class="font-monospace text-muted">
                                    @if (item.LogoutTime.HasValue)
                                    {
                                        @item.LogoutTime.Value.ToLocalTime().ToString("HH:mm:ss")
                                    }
                                    else
                                    {
                                        <span>—</span>
                                    }
                                </td>
                                <td class="font-monospace text-muted">
                                    @(item.IPAddress ?? "Unknown")
                                </td>
                                <td>
                                    <span>
                                        @if (item.Device == "Mobile")
                                        {
                                            <i class="fa-solid fa-mobile-screen text-muted me-1"></i>
                                        }
                                        else if (item.Device == "Tablet")
                                        {
                                            <i class="fa-solid fa-tablet-screen-button text-muted me-1"></i>
                                        }
                                        else
                                        {
                                            <i class="fa-solid fa-desktop text-muted me-1"></i>
                                        }
                                        @(item.OperatingSystem ?? "Unknown")
                                    </span>
                                </td>
                                <td>
                                    <i class="fa-regular fa-compass text-muted me-1"></i>
                                    @(item.Browser ?? "Browser")
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center py-5 text-muted">
                                <i class="fa-solid fa-shield-cat fs-1 d-block mb-3 text-secondary"></i>
                                <div class="fw-semibold">No login history records found</div>
                                <p class="small text-muted mb-0">Try changing your date or status filters.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        @if (Model.TotalPages > 1)
        {
            <div class="card-footer bg-white d-flex justify-content-between align-items-center py-2">
                <span class="small text-muted">
                    Page @Model.Filter.Page of @Model.TotalPages
                </span>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                            <a class="page-link" href="@Url.Action("LoginHistory", new { Page = Model.Filter.Page - 1, DateFrom = Model.Filter.DateFrom?.ToString("yyyy-MM-dd"), DateTo = Model.Filter.DateTo?.ToString("yyyy-MM-dd"), Status = Model.Filter.Status, CompanyId = Model.Filter.CompanyId, Username = Model.Filter.Username })">
                                Previous
                            </a>
                        </li>
                        <li class="page-item active">
                            <span class="page-link">@Model.Filter.Page</span>
                        </li>
                        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                            <a class="page-link" href="@Url.Action("LoginHistory", new { Page = Model.Filter.Page + 1, DateFrom = Model.Filter.DateFrom?.ToString("yyyy-MM-dd"), DateTo = Model.Filter.DateTo?.ToString("yyyy-MM-dd"), Status = Model.Filter.Status, CompanyId = Model.Filter.CompanyId, Username = Model.Filter.Username })">
                                Next
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>

<style>
    .bg-purple {
        background-color: #6f42c1;
    }
</style>
