@model VoucherPageViewModel
@{
    ViewData["Title"] = "Receipt Voucher";
}

<div id="listView">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="m-0 fw-bold text-primary"><i class="fa-solid fa-hand-holding-dollar me-2"></i> Receipt Vouchers</h4>
            <p class="text-muted small m-0 mt-1">Record customer collections, incoming revenue, and cash/bank receipt entries</p>
        </div>
        <button class="btn btn-primary shadow-sm" onclick="showForm()"><i class="fa-solid fa-plus me-1.5"></i> New Receipt Voucher</button>
    </div>

    <!-- Filters Row -->
    <div class="card mb-3 no-print shadow-sm border-0">
        <div class="card-body p-3">
            <div class="row g-3 align-items-center">
                <div class="col-12 col-sm-6 col-md-4">
                    <label class="form-label fw-semibold mb-1 small text-muted">From Date</label>
                    <input type="date" id="filterFromDate" class="form-control form-control-sm" />
                </div>
                <div class="col-12 col-sm-6 col-md-4">
                    <label class="form-label fw-semibold mb-1 small text-muted">To Date</label>
                    <input type="date" id="filterToDate" class="form-control form-control-sm" />
                </div>
                <div class="col-12 col-sm-12 col-md-4 d-flex gap-2 align-self-end">
                    <button class="btn btn-sm btn-primary w-100" onclick="applyFilters()"><i class="fa-solid fa-filter me-1"></i> Filter</button>
                    <button class="btn btn-sm btn-outline-secondary w-100" onclick="resetFilters()"><i class="fa-solid fa-rotate me-1"></i> Reset</button>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover datatable align-middle">
                    <thead class="table-light text-uppercase fs-8 fw-bold text-muted">
                        <tr>
                            <th>Voucher No</th>
                            <th>Date</th>
                            <th>Reference No</th>
                            <th>Total Amount</th>
                            <th>Narration</th>
                            <th class="text-center no-print">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var v in Model.Vouchers)
                        {
                            <tr id="row-@v.Id">
                                <td class="fw-bold text-primary">@v.VoucherNumber</td>
                                <td>@v.VoucherDate.ToString("dd-MM-yyyy")</td>
                                <td>@v.ReferenceNumber</td>
                                <td class="fw-bold text-dark">₹@v.TotalAmount.ToString("N2")</td>
                                <td class="fs-8 text-muted">@v.Narration</td>
                                <td class="text-center no-print">
                                    <div class="btn-group">
                                        <button class="btn btn-sm btn-outline-primary" onclick="editVoucher(@v.Id)" title="Edit"><i class="fa-solid fa-pen"></i></button>
                                        <button class="btn btn-sm btn-outline-secondary" onclick="ErpPrint.printBillById('voucher', @v.Id)" title="Print"><i class="fa-solid fa-print"></i></button>
                                        <button class="btn btn-sm btn-outline-danger" onclick="deleteVoucher(@v.Id)" title="Delete"><i class="fa-solid fa-trash"></i></button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div id="formView" style="display:none">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="m-0 fw-bold text-primary" id="formTitle"><i class="fa-solid fa-plus me-2"></i> Record Receipt Voucher</h4>
        <button class="btn btn-outline-secondary" onclick="hideForm()"><i class="fa-solid fa-arrow-left me-1.5"></i> Back to List</button>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <form id="voucherForm">
                <input type="hidden" id="Id" name="Id" value="0" />
                <div class="row g-3 mb-4">
                    <div class="col-12 col-sm-6 col-md-4">
                        <label class="form-label fw-semibold text-dark">Voucher Number <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-hashtag text-muted"></i></span>
                            <input type="text" id="VoucherNumber" class="form-control border-start-0 fw-bold" required />
                        </div>
                    </div>
                    <div class="col-12 col-sm-6 col-md-4">
                        <label class="form-label fw-semibold text-dark">Voucher Date <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="fa-regular fa-calendar text-muted"></i></span>
                            <input type="date" id="VoucherDate" class="form-control border-start-0" required value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        </div>
                    </div>
                    <div class="col-12 col-sm-6 col-md-4">
                        <label class="form-label fw-semibold text-dark">Reference Number</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-receipt text-muted"></i></span>
                            <input type="text" id="ReferenceNumber" class="form-control border-start-0" placeholder="e.g. Cheque/NEFT/UPI Ref" />
                        </div>
                    </div>
                </div>

                <hr class="my-4" />

                <div class="d-flex justify-content-between align-items-center mb-2">
                    <div>
                        <h5 class="m-0 fw-bold text-dark"><i class="fa-solid fa-list-check me-2 text-primary"></i> Debit & Credit Ledger Allocations</h5>
                        <p class="text-muted fs-8 m-0 mt-1">Add rows to debit/credit ledgers. Total Debit must equal Total Credit before saving.</p>
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-primary" onclick="addRow()"><i class="fa-solid fa-plus me-1"></i> Add Row</button>
                </div>

                <div class="table-responsive mb-4">
                    <table class="table table-bordered align-middle shadow-sm" id="itemsTable">
                        <thead class="table-light text-uppercase fs-8 fw-bold text-muted">
                            <tr>
                                <th style="width: 40%">Ledger Account *</th>
                                <th style="width: 20%">Debit Amount (Dr) *</th>
                                <th style="width: 20%">Credit Amount (Cr) *</th>
                                <th style="width: 15%">Particulars</th>
                                <th style="width: 5%" class="text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>

                <div class="d-flex justify-content-between flex-wrap gap-3 mb-4">
                    <div class="flex-grow-1" style="max-width: 500px;">
                        <label class="form-label fw-semibold text-dark">Narration <span class="text-danger">*</span></label>
                        <textarea id="Narration" class="form-control" rows="3" placeholder="Receipt description or customer collection remarks..." required></textarea>
                    </div>
                    
                    <div class="summary-calc-card text-end ms-auto shadow-sm">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Total Debit (Dr):</span>
                            <span id="lblTotalDebit" class="fw-bold text-dark">₹0.00</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Total Credit (Cr):</span>
                            <span id="lblTotalCredit" class="fw-bold text-dark">₹0.00</span>
                        </div>
                        <div class="d-flex justify-content-between border-top pt-2 mt-2">
                            <span class="fw-bold text-dark">Difference:</span>
                            <span id="lblDifference" class="fw-bold text-danger">₹0.00</span>
                        </div>
                    </div>
                </div>

                <!-- Sticky Bottom Actions Bar -->
                <div class="d-flex justify-content-end gap-2 border-top pt-3 sticky-bottom bg-white">
                    <button type="button" class="btn btn-secondary px-3" onclick="hideForm()">Cancel</button>
                    <button type="button" class="btn btn-primary px-4 shadow-sm" onclick="saveVoucher()"><i class="fa-solid fa-floppy-disk me-1.5"></i> Save Receipt Voucher</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var ledgersList = @Json.Serialize(Model.LedgerLookups);

        function showForm() {
            $('#listView').hide();
            $('#formView').show();
            $('#voucherForm')[0].reset();
            $('#Id').val('0');
            $('#VoucherNumber').val("VR-" + Date.now().toString().slice(-6));
            $('#VoucherDate').val('@DateTime.Today.ToString("yyyy-MM-dd")');
            $('#itemsTable tbody').empty();
            addRow();
            addRow();
        }

        function editVoucher(id) {
            ErpVoucher.editVoucher(id, ledgersList);
        }

        function hideForm() {
            $('#formView').hide();
            $('#listView').show();
        }

        function addRow() {
            var optionsHtml = '<option value="">Select Ledger Account</option>';
            ledgersList.forEach(function(l) {
                optionsHtml += `<option value="${l.id}">${l.ledgerName} (${l.ledgerCode})</option>`;
            });

            var rowHtml = `
                <tr class="grid-item-row">
                    <td>
                        <select class="form-select select2-row" required>
                            ${optionsHtml}
                        </select>
                    </td>
                    <td>
                        <input type="number" class="form-control debit-input" value="0.00" step="0.01" oninput="onDebitInput(this)" required />
                    </td>
                    <td>
                        <input type="number" class="form-control credit-input" value="0.00" step="0.01" oninput="onCreditInput(this)" required />
                    </td>
                    <td>
                        <input type="text" class="form-control particulars-input" />
                    </td>
                    <td class="text-center">
                        <button type="button" class="btn btn-sm btn-outline-danger" onclick="removeRow(this)"><i class="fa-solid fa-trash"></i></button>
                    </td>
                </tr>
            `;
            var $row = $(rowHtml);
            $('#itemsTable tbody').append($row);
            window.initializeSelect2($row.find('.select2-row'));
        }

        function removeRow(btn) {
            $(btn).closest('tr').remove();
            calculateTotals();
        }

        function onDebitInput(input) {
            var val = parseFloat($(input).val()) || 0;
            if (val > 0) {
                $(input).closest('tr').find('.credit-input').val('0.00');
            }
            calculateTotals();
        }

        function onCreditInput(input) {
            var val = parseFloat($(input).val()) || 0;
            if (val > 0) {
                $(input).closest('tr').find('.debit-input').val('0.00');
            }
            calculateTotals();
        }

        function calculateTotals() {
            var totalDebit = 0;
            var totalCredit = 0;

            $('#itemsTable tbody tr').each(function() {
                var db = parseFloat($(this).find('.debit-input').val()) || 0;
                var cr = parseFloat($(this).find('.credit-input').val()) || 0;
                totalDebit += db;
                totalCredit += cr;
            });

            var diff = Math.abs(totalDebit - totalCredit);

            $('#lblTotalDebit').text('₹' + totalDebit.toFixed(2));
            $('#lblTotalCredit').text('₹' + totalCredit.toFixed(2));
            $('#lblDifference').text('₹' + diff.toFixed(2));

            if (diff === 0) {
                $('#lblDifference').removeClass('text-danger').addClass('text-success');
            } else {
                $('#lblDifference').removeClass('text-success').addClass('text-danger');
            }
        }

        function saveVoucher() {
            var items = [];
            var isValid = true;
            var totalAmount = 0;

            $('#itemsTable tbody tr').each(function(index) {
                var ledgerId = $(this).find('.select2-row').val();
                var db = parseFloat($(this).find('.debit-input').val()) || 0;
                var cr = parseFloat($(this).find('.credit-input').val()) || 0;
                var particulars = $(this).find('.particulars-input').val();

                if (!ledgerId || (db === 0 && cr === 0)) {
                    isValid = false;
                    return false;
                }

                items.push({
                    ledgerId: parseInt(ledgerId),
                    debitAmount: db,
                    creditAmount: cr,
                    particulars: particulars || "",
                    sortOrder: index + 1
                });

                if (db > 0) totalAmount += db;
            });

            var dbTotal = parseFloat($('#lblTotalDebit').text().replace('₹', '')) || 0;
            var crTotal = parseFloat($('#lblTotalCredit').text().replace('₹', '')) || 0;

            if (dbTotal !== crTotal || dbTotal === 0) {
                Swal.fire('Error!', 'Voucher debit and credit totals must balance and be greater than zero.', 'error');
                return;
            }

            if (items.length === 0 || !isValid || !$('#VoucherNumber').val() || !$('#Narration').val()) {
                Swal.fire('Error!', 'Please fill all required fields.', 'error');
                return;
            }

            var voucher = {
                id: parseInt($('#Id').val()) || 0,
                voucherNumber: $('#VoucherNumber').val(),
                voucherDate: $('#VoucherDate').val(),
                voucherType: "Receipt",
                referenceNumber: $('#ReferenceNumber').val(),
                narration: $('#Narration').val(),
                totalAmount: totalAmount,
                items: items
            };

            $.ajax({
                url: '/Accounts/SaveVoucher',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(voucher),
                success: function(res) {
                    if (res.success) {
                        Swal.fire('Saved!', res.message, 'success').then(() => { location.reload(); });
                    } else {
                        Swal.fire('Error!', res.message, 'error');
                    }
                },
                error: function(xhr) {
                    Swal.fire('Error!', xhr.responseJSON?.message || 'Failed to save voucher.', 'error');
                }
            });
        }

        function deleteVoucher(id) {
            Swal.fire({
                title: 'Are you sure?',
                text: "Do you want to delete this voucher?",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                confirmButtonText: 'Yes, delete!'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.post('/Accounts/DeleteVoucher', { id: id }, function(res) {
                        if (res.success) {
                            Swal.fire('Deleted!', 'Voucher deleted.', 'success');
                            $('#row-' + id).fadeOut(300, function() { $(this).remove(); });
                        }
                    });
                }
            });
        }
    </script>
}

