@model BookPageViewModel
@{
    ViewData["Title"] = "Bank Book";
}

<div class="card">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <h5 class="m-0"><i class="fa-solid fa-building-columns me-2"></i> Bank Book</h5>
    </div>
    <div class="card-body">
        <form method="get" class="row g-3 mb-4">
            <div class="col-auto">
                <label class="visually-hidden">Start Date</label>
                <input type="date" class="form-control" name="startDate" value="@Model.StartDate" />
            </div>
            <div class="col-auto">
                <label class="visually-hidden">End Date</label>
                <input type="date" class="form-control" name="endDate" value="@Model.EndDate" />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary"><i class="fa-solid fa-filter me-1"></i> Filter</button>
            </div>
        </form>

        <div class="table-responsive">
            <table class="table table-hover datatable align-middle">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Voucher No</th>
                        <th>Particulars</th>
                        <th class="text-end">Debit (In)</th>
                        <th class="text-end">Credit (Out)</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null)
                    {
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>@item.Voucher?.VoucherDate.ToString("dd-MM-yyyy")</td>
                                <td>@item.Voucher?.VoucherNumber</td>
                                <td>@item.Particulars</td>
                                <td class="text-end font-weight-semibold text-success">@(item.DebitAmount > 0 ? "₹" + item.DebitAmount.ToString("N2") : "-")</td>
                                <td class="text-end font-weight-semibold text-danger">@(item.CreditAmount > 0 ? "₹" + item.CreditAmount.ToString("N2") : "-")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

