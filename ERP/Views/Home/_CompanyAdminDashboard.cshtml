@model ERP.ViewModels.CompanyAdminDashboardViewModel
@{
    var m = Model;
}

<!-- Company Header Banner with Date Filter -->
<div class="card border-0 shadow-sm mb-4 text-white rounded-3 overflow-hidden position-relative no-print" style="background: linear-gradient(135deg, #1e293b 0%, #0f172a 50%, #1e1b4b 100%);">
    <div class="card-body p-4 position-relative z-1">
        <div class="row align-items-center g-3">
            <div class="col-12 col-lg-7">
                <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
                    <span class="badge bg-primary px-3 py-1.5 rounded-pill fs-8 fw-semibold">
                        <i class="fa-solid fa-building me-1"></i>@m.CompanyCode
                    </span>
                    <span class="badge bg-white bg-opacity-20 text-white px-2.5 py-1 rounded-pill fs-8">
                        <i class="fa-solid fa-calendar-check me-1"></i>Period: @m.FilterFrom.ToString("dd MMM yyyy") – @m.FilterTo.ToString("dd MMM yyyy")
                    </span>
                </div>
                <h3 class="fw-bold m-0 text-white">@m.CompanyName 👋</h3>
                <p class="text-white-50 m-0 mt-1.5 small">Real-time trading overview of sales, procurement, inventory, receivables, and profit margins.</p>
            </div>
            
            <div class="col-12 col-lg-5 text-lg-end d-flex flex-column flex-sm-row gap-2 justify-content-lg-end align-items-sm-center">
                <!-- Date Filter Selector Form -->
                <form method="get" action="/Home/Index" class="d-flex gap-2 align-items-center" id="periodFilterForm">
                    <select name="Period" class="form-select form-select-sm bg-white text-dark fw-semibold" onchange="this.form.submit()" style="min-width: 140px;">
                        <option value="Today" selected="@(m.Filter.Period == "Today")">Today</option>
                        <option value="Yesterday" selected="@(m.Filter.Period == "Yesterday")">Yesterday</option>
                        <option value="ThisWeek" selected="@(m.Filter.Period == "ThisWeek")">This Week</option>
                        <option value="ThisMonth" selected="@(m.Filter.Period == "ThisMonth" || string.IsNullOrEmpty(m.Filter.Period))">This Month</option>
                        <option value="LastMonth" selected="@(m.Filter.Period == "LastMonth")">Last Month</option>
                        <option value="ThisYear" selected="@(m.Filter.Period == "ThisYear")">This Year</option>
                    </select>
                </form>

                <div class="d-flex gap-2">
                    @if (m.CanCreateSales)
                    {
                        <a href="/Sales/Invoice" class="btn btn-primary btn-sm px-3 shadow-sm border-0" style="background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);">
                            <i class="fa-solid fa-plus me-1"></i>New Sale
                        </a>
                    }
                    @if (m.CanCreatePurchases)
                    {
                        <a href="/Purchase/Invoice" class="btn btn-light bg-white bg-opacity-10 text-white border-white border-opacity-20 btn-sm px-3 hover-shadow">
                            <i class="fa-solid fa-cart-plus me-1"></i>New Purchase
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Primary Trading KPI Cards (Row 1) -->
<div class="row g-3 mb-4">
    <!-- Card 1: Sales -->
    @if (m.CanViewSales)
    {
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100 rounded-3">
                <div class="card-body p-3.5">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-muted small fw-bold text-uppercase tracking-wider">Period Sales</span>
                        <div class="avatar bg-primary bg-opacity-10 text-primary rounded-3 p-2.5 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                            <i class="fa-solid fa-file-invoice-dollar fs-5"></i>
                        </div>
                    </div>
                    <h3 class="fw-bold text-dark m-0 mb-1 fs-3">₹@m.PeriodSales.ToString("N0")</h3>
                    <div class="d-flex align-items-center justify-content-between">
                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill fs-8 fw-semibold px-2 py-0.5">
                            <i class="fa-solid fa-arrow-trend-up me-1"></i>@m.PeriodSalesCount Invoices
                        </span>
                        <span class="text-muted fs-8">Today: ₹@m.TodaySales.ToString("N0")</span>
                    </div>
                </div>
                <div class="progress" style="height: 3px;">
                    <div class="progress-bar bg-primary" role="progressbar" style="width: 75%"></div>
                </div>
            </div>
        </div>
    }

    <!-- Card 2: Purchases -->
    @if (m.CanViewPurchases)
    {
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100 rounded-3">
                <div class="card-body p-3.5">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-muted small fw-bold text-uppercase tracking-wider">Period Purchases</span>
                        <div class="avatar bg-success bg-opacity-10 text-success rounded-3 p-2.5 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                            <i class="fa-solid fa-cart-flatbed fs-5"></i>
                        </div>
                    </div>
                    <h3 class="fw-bold text-dark m-0 mb-1 fs-3">₹@m.PeriodPurchases.ToString("N0")</h3>
                    <div class="d-flex align-items-center justify-content-between">
                        <span class="badge bg-info-subtle text-info border border-info-subtle rounded-pill fs-8 fw-semibold px-2 py-0.5">
                            <i class="fa-solid fa-truck-ramp-box me-1"></i>@m.PeriodPurchasesCount Orders
                        </span>
                        <span class="text-muted fs-8">Today: ₹@m.TodayPurchases.ToString("N0")</span>
                    </div>
                </div>
                <div class="progress" style="height: 3px;">
                    <div class="progress-bar bg-success" role="progressbar" style="width: 60%"></div>
                </div>
            </div>
        </div>
    }

    <!-- Card 3: Total Receivables -->
    @if (m.CanViewAccounts)
    {
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100 rounded-3">
                <div class="card-body p-3.5">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-muted small fw-bold text-uppercase tracking-wider">Outstanding Receivables</span>
                        <div class="avatar bg-warning bg-opacity-10 text-warning rounded-3 p-2.5 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                            <i class="fa-solid fa-hand-holding-dollar fs-5"></i>
                        </div>
                    </div>
                    <h3 class="fw-bold text-dark m-0 mb-1 fs-3">₹@m.TotalReceivables.ToString("N0")</h3>
                    <div class="d-flex align-items-center justify-content-between">
                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle rounded-pill fs-8 fw-semibold px-2 py-0.5">
                            <i class="fa-solid fa-clock me-1"></i>Customer Dues
                        </span>
                        <a href="/Accounts/CashBook" class="text-primary text-decoration-none fs-8">View Cash Book</a>
                    </div>
                </div>
                <div class="progress" style="height: 3px;">
                    <div class="progress-bar bg-warning" role="progressbar" style="width: 45%"></div>
                </div>
            </div>
        </div>

        <!-- Card 4: Total Payables -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100 rounded-3">
                <div class="card-body p-3.5">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-muted small fw-bold text-uppercase tracking-wider">Outstanding Payables</span>
                        <div class="avatar bg-danger bg-opacity-10 text-danger rounded-3 p-2.5 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                            <i class="fa-solid fa-credit-card fs-5"></i>
                        </div>
                    </div>
                    <h3 class="fw-bold text-dark m-0 mb-1 fs-3">₹@m.TotalPayables.ToString("N0")</h3>
                    <div class="d-flex align-items-center justify-content-between">
                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill fs-8 fw-semibold px-2 py-0.5">
                            <i class="fa-solid fa-file-signature me-1"></i>Vendor Dues
                        </span>
                        <span class="text-muted fs-8">Payable Total</span>
                    </div>
                </div>
                <div class="progress" style="height: 3px;">
                    <div class="progress-bar bg-danger" role="progressbar" style="width: 35%"></div>
                </div>
            </div>
        </div>
    }
</div>

<!-- Secondary KPI Row (Inventory, Masters, Margin) -->
<div class="row g-3 mb-4">
    <!-- Stock Valuation Card -->
    @if (m.CanViewInventory)
    {
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100 rounded-3">
                <div class="card-body p-3.5">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-muted small fw-bold text-uppercase tracking-wider">Available Stock Value</span>
                        <div class="avatar bg-secondary bg-opacity-10 text-secondary rounded-3 p-2.5 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                            <i class="fa-solid fa-warehouse fs-5"></i>
                        </div>
                    </div>
                    <h3 class="fw-bold text-dark m-0 mb-1 fs-3">₹@m.AvailableStockValue.ToString("N0")</h3>
                    <div class="d-flex align-items-center justify-content-between">
                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill fs-8 fw-semibold px-2 py-0.5">
                            <i class="fa-solid fa-boxes-stacked me-1"></i>@m.TotalProducts SKUs
                        </span>
                        <span class="text-muted fs-8">Valuation</span>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Low Stock Alert Card -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100 rounded-3">
            <div class="card-body p-3.5">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted small fw-bold text-uppercase tracking-wider">Low Stock Warnings</span>
                    <div class="avatar bg-danger bg-opacity-10 text-danger rounded-3 p-2.5 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                        <i class="fa-solid fa-triangle-exclamation fs-5"></i>
                    </div>
                </div>
                <h3 class="fw-bold @(m.LowStockCount > 0 ? "text-danger" : "text-dark") m-0 mb-1 fs-3">@m.LowStockCount</h3>
                <div class="d-flex align-items-center justify-content-between">
                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill fs-8 fw-semibold px-2 py-0.5">
                        <i class="fa-solid fa-bell me-1"></i>@m.OutOfStockCount Out of Stock
                    </span>
                    <a href="/Masters/Product" class="text-primary text-decoration-none fs-8">Catalog</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Customers & Suppliers -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100 rounded-3">
            <div class="card-body p-3.5">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted small fw-bold text-uppercase tracking-wider">Customers & Vendors</span>
                    <div class="avatar bg-info bg-opacity-10 text-info rounded-3 p-2.5 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                        <i class="fa-solid fa-users fs-5"></i>
                    </div>
                </div>
                <h3 class="fw-bold text-dark m-0 mb-1 fs-3">@m.TotalCustomers <span class="fs-6 fw-normal text-muted">/ @m.TotalSuppliers</span></h3>
                <div class="d-flex align-items-center justify-content-between">
                    <span class="badge bg-info-subtle text-info border border-info-subtle rounded-pill fs-8 fw-semibold px-2 py-0.5">
                        <i class="fa-solid fa-user-check me-1"></i>Trading Parties
                    </span>
                    <span class="text-muted fs-8">Active Directory</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Financial Margin Card -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100 rounded-3">
            <div class="card-body p-3.5">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted small fw-bold text-uppercase tracking-wider">Gross Margin</span>
                    <div class="avatar bg-purple-subtle text-purple rounded-3 p-2.5 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                        <i class="fa-solid fa-chart-pie fs-5"></i>
                    </div>
                </div>
                <h3 class="fw-bold text-dark m-0 mb-1 fs-3">₹@m.GrossProfit.ToString("N0")</h3>
                <div class="d-flex align-items-center justify-content-between">
                    <span class="badge bg-purple-subtle text-purple border border-purple-subtle rounded-pill fs-8 fw-semibold px-2 py-0.5">
                        <i class="fa-solid fa-percent me-1"></i>@m.NetMarginPercentage% Margin
                    </span>
                    <span class="text-muted fs-8">Period Profit</span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Charts Section Row (Trend & Category Distribution) -->
<div class="row g-3 mb-4">
    <!-- Area / Line Chart: 30-Day Trend -->
    <div class="col-12 col-lg-8">
        <div class="card border-0 shadow-sm h-100 rounded-3">
            <div class="card-header bg-white border-bottom p-3.5 d-flex align-items-center justify-content-between">
                <div>
                    <h6 class="m-0 fw-bold text-dark"><i class="fa-solid fa-chart-line text-primary me-2"></i>Daily Sales & Purchase Trend</h6>
                    <span class="text-muted fs-8">Period trading volume trajectory</span>
                </div>
                <span class="badge bg-light text-dark border"><i class="fa-solid fa-circle text-primary me-1 fs-9"></i>Sales vs <i class="fa-solid fa-circle text-success me-1 fs-9"></i>Purchases</span>
            </div>
            <div class="card-body p-3.5">
                <div style="height: 280px; position: relative;">
                    <canvas id="salesPurchaseTrendChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Doughnut Chart: Category Distribution -->
    <div class="col-12 col-lg-4">
        <div class="card border-0 shadow-sm h-100 rounded-3">
            <div class="card-header bg-white border-bottom p-3.5 d-flex align-items-center justify-content-between">
                <div>
                    <h6 class="m-0 fw-bold text-dark"><i class="fa-solid fa-chart-pie text-secondary me-2"></i>Stock Valuation by Category</h6>
                    <span class="text-muted fs-8">Top category inventory share</span>
                </div>
            </div>
            <div class="card-body p-3.5 d-flex flex-column align-items-center justify-content-center">
                <div style="height: 220px; width: 100%; position: relative;">
                    <canvas id="categoryDistributionChart"></canvas>
                </div>
                <div class="text-muted small mt-2 text-center">
                    Inventory Value: <span class="fw-bold text-dark">₹@m.AvailableStockValue.ToString("N0")</span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Tabular Feeds (Recent Sales, Purchases, Low Stock Alerts) -->
<div class="row g-3 mb-4">
    <!-- Recent Sales Table -->
    <div class="col-12 col-lg-6">
        <div class="card border-0 shadow-sm h-100 rounded-3">
            <div class="card-header bg-white py-3 d-flex align-items-center justify-content-between border-bottom">
                <h6 class="fw-bold mb-0 text-dark"><i class="fa-solid fa-file-invoice text-primary me-2"></i>Recent Sales Invoices</h6>
                @if (m.CanViewSales)
                {
                    <a href="/Sales/Invoice" class="btn btn-sm btn-outline-primary">View All</a>
                }
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light fs-8 text-uppercase text-muted fw-bold">
                        <tr>
                            <th class="ps-3">Invoice</th>
                            <th>Customer</th>
                            <th>Date</th>
                            <th class="text-end">Amount</th>
                            <th class="text-center">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (m.RecentSales != null && m.RecentSales.Any())
                        {
                            foreach (var s in m.RecentSales)
                            {
                                <tr>
                                    <td class="ps-3 fw-bold text-dark">@s.InvoiceNo</td>
                                    <td class="small text-dark">@s.CustomerName</td>
                                    <td class="small text-muted">@s.InvoiceDate.ToString("dd MMM yyyy")</td>
                                    <td class="text-end fw-semibold text-dark">₹@s.GrandTotal.ToString("N0")</td>
                                    <td class="text-center">
                                        <span class="badge bg-success-subtle text-success border border-success-subtle fs-8">@(s.Status ?? "Completed")</span>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted small">No sales records found for this period.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Recent Purchases Table -->
    <div class="col-12 col-lg-6">
        <div class="card border-0 shadow-sm h-100 rounded-3">
            <div class="card-header bg-white py-3 d-flex align-items-center justify-content-between border-bottom">
                <h6 class="fw-bold mb-0 text-dark"><i class="fa-solid fa-cart-shopping text-success me-2"></i>Recent Purchase Invoices</h6>
                @if (m.CanViewPurchases)
                {
                    <a href="/Purchase/Invoice" class="btn btn-sm btn-outline-success">View All</a>
                }
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light fs-8 text-uppercase text-muted fw-bold">
                        <tr>
                            <th class="ps-3">Bill No</th>
                            <th>Vendor / Supplier</th>
                            <th>Date</th>
                            <th class="text-end">Amount</th>
                            <th class="text-center">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (m.RecentPurchases != null && m.RecentPurchases.Any())
                        {
                            foreach (var p in m.RecentPurchases)
                            {
                                <tr>
                                    <td class="ps-3 fw-bold text-dark">@p.InvoiceNo</td>
                                    <td class="small text-dark">@p.SupplierName</td>
                                    <td class="small text-muted">@p.InvoiceDate.ToString("dd MMM yyyy")</td>
                                    <td class="text-end fw-semibold text-dark">₹@p.GrandTotal.ToString("N0")</td>
                                    <td class="text-center">
                                        <span class="badge bg-info-subtle text-info border border-info-subtle fs-8">@(p.Status ?? "Received")</span>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted small">No purchase records found for this period.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Low Stock Alerts & Recent Activities -->
<div class="row g-3">
    <!-- Low Stock Alert Panel -->
    <div class="col-12 col-lg-6">
        <div class="card border-0 shadow-sm h-100 rounded-3">
            <div class="card-header bg-white py-3 d-flex align-items-center justify-content-between border-bottom">
                <h6 class="fw-bold mb-0 text-dark"><i class="fa-solid fa-boxes-stacked text-warning me-2"></i>Low Stock Alert Items</h6>
                <a href="/Masters/Product" class="btn btn-sm btn-outline-warning">Stock Catalog</a>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light fs-8 text-uppercase text-muted fw-bold">
                        <tr>
                            <th class="ps-3">Code</th>
                            <th>Product Name</th>
                            <th>Category</th>
                            <th class="text-center">Current</th>
                            <th class="text-center">Reorder</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (m.LowStockProducts != null && m.LowStockProducts.Any())
                        {
                            foreach (var item in m.LowStockProducts)
                            {
                                <tr>
                                    <td class="ps-3 fw-bold text-dark small">@item.ProductCode</td>
                                    <td class="small text-dark">@item.ProductName</td>
                                    <td><span class="badge bg-light text-dark border fs-8">@item.CategoryName</span></td>
                                    <td class="text-center fw-bold text-danger">@item.CurrentStock @item.UnitName</td>
                                    <td class="text-center text-muted small">@item.ReorderLevel</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted small">All stock items are currently above their reorder thresholds.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Company Audit & Security Activity Feed -->
    <div class="col-12 col-lg-6">
        <div class="card border-0 shadow-sm h-100 rounded-3">
            <div class="card-header bg-white py-3 d-flex align-items-center justify-content-between border-bottom">
                <h6 class="fw-bold mb-0 text-dark"><i class="fa-solid fa-shield-halved text-secondary me-2"></i>Recent Company Activity</h6>
                @if (m.CanViewAudit)
                {
                    <a href="/Audit/Logs" class="btn btn-sm btn-outline-secondary">Audit Trail</a>
                }
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light fs-8 text-uppercase text-muted fw-bold">
                        <tr>
                            <th class="ps-3">Time</th>
                            <th>User</th>
                            <th>Action</th>
                            <th>Description</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (m.RecentActivities != null && m.RecentActivities.Any())
                        {
                            foreach (var act in m.RecentActivities)
                            {
                                <tr>
                                    <td class="ps-3 text-nowrap small text-muted">@act.Timestamp.ToString("dd MMM HH:mm")</td>
                                    <td class="small fw-semibold text-dark">@act.UserName</td>
                                    <td><span class="badge bg-primary-subtle text-primary border border-primary-subtle fs-8">@act.Action</span></td>
                                    <td class="small text-dark text-truncate" style="max-width: 200px;" title="@act.Description">@act.Description</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4 text-muted small">No recent activity logged for this company.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            // Chart.js 30-day Trend Chart Initialization
            var trendCtx = document.getElementById('salesPurchaseTrendChart');
            if (trendCtx) {
                var trendLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(m.Charts.TrendLabels));
                var salesData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(m.Charts.SalesTrendValues));
                var purchaseData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(m.Charts.PurchaseTrendValues));

                new Chart(trendCtx, {
                    type: 'line',
                    data: {
                        labels: trendLabels,
                        datasets: [
                            {
                                label: 'Sales (₹)',
                                data: salesData,
                                borderColor: '#3b82f6',
                                backgroundColor: 'rgba(59, 130, 246, 0.08)',
                                fill: true,
                                tension: 0.35,
                                borderWidth: 2.5,
                                pointRadius: 3,
                                pointHoverRadius: 5
                            },
                            {
                                label: 'Purchases (₹)',
                                data: purchaseData,
                                borderColor: '#10b981',
                                backgroundColor: 'rgba(16, 185, 129, 0.08)',
                                fill: true,
                                tension: 0.35,
                                borderWidth: 2.5,
                                pointRadius: 3,
                                pointHoverRadius: 5
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        interaction: { intersect: false, mode: 'index' },
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                callbacks: {
                                    label: function(context) {
                                        return context.dataset.label + ': ₹' + Number(context.raw).toLocaleString();
                                    }
                                }
                            }
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                ticks: {
                                    callback: function(val) { return '₹' + Number(val).toLocaleString(); },
                                    color: '#94a3b8'
                                },
                                grid: { color: '#f1f5f9' }
                            },
                            x: {
                                ticks: { color: '#94a3b8' },
                                grid: { display: false }
                            }
                        }
                    }
                });
            }

            // Chart.js Category Distribution Doughnut
            var catCtx = document.getElementById('categoryDistributionChart');
            if (catCtx) {
                var catLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(m.Charts.CategoryLabels));
                var catValues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(m.Charts.CategoryStockValues));

                new Chart(catCtx, {
                    type: 'doughnut',
                    data: {
                        labels: catLabels,
                        datasets: [{
                            data: catValues,
                            backgroundColor: ['#3b82f6', '#10b981', '#f59e0b', '#8b5cf6', '#ec4899', '#64748b'],
                            borderWidth: 2,
                            borderColor: '#ffffff',
                            hoverOffset: 4
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        cutout: '70%',
                        plugins: {
                            legend: { position: 'bottom', labels: { boxWidth: 12, font: { size: 11 } } },
                            tooltip: {
                                callbacks: {
                                    label: function(context) {
                                        return context.label + ': ₹' + Number(context.raw).toLocaleString();
                                    }
                                }
                            }
                        }
                    }
                });
            }
        });
    </script>
}
