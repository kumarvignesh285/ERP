@model HomeDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<!-- Dashboard Header -->
<div class="d-flex justify-content-between align-items-center mb-4 dashboard-header-row">
    <h4 class="dashboard-page-title text-uppercase m-0">Dashboard</h4>
</div>

<!-- KPI Cards Grid (Row 1) -->
<div class="row mb-3">
    <!-- Card 1: Today's Sales -->
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="premium-kpi-card card-blue-tint">
            <div class="kpi-card-body">
                <div class="kpi-card-details">
                    <span class="kpi-title">Today's Sales</span>
                    <h3 class="kpi-value">₹@Model.TodaySales.ToString("N0")</h3>
                    <span class="kpi-trend trend-up"><i class="fa-solid fa-arrow-trend-up me-1"></i>Daily invoices</span>
                </div>
                <div class="kpi-card-icon-container">
                    <i class="fa-solid fa-file-invoice-dollar"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Card 2: Today's Purchases -->
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="premium-kpi-card card-green-tint">
            <div class="kpi-card-body">
                <div class="kpi-card-details">
                    <span class="kpi-title">Today's Purchases</span>
                    <h3 class="kpi-value">₹@Model.TodayPurchases.ToString("N0")</h3>
                    <span class="kpi-trend"><i class="fa-solid fa-truck-ramp-box me-1"></i>Daily receipts</span>
                </div>
                <div class="kpi-card-icon-container">
                    <i class="fa-solid fa-cart-flatbed"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Card 3: Receivables -->
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="premium-kpi-card card-grey-tint">
            <div class="kpi-card-body">
                <div class="kpi-card-details">
                    <span class="kpi-title">Receivables</span>
                    <h3 class="kpi-value">₹@Model.TotalReceivables.ToString("N0")</h3>
                    <span class="kpi-trend"><i class="fa-solid fa-hand-holding-dollar me-1"></i>Outstanding collections</span>
                </div>
                <div class="kpi-card-icon-container">
                    <i class="fa-solid fa-file-invoice"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Card 4: Payables -->
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="premium-kpi-card card-purple-tint">
            <div class="kpi-card-body">
                <div class="kpi-card-details">
                    <span class="kpi-title">Payables</span>
                    <h3 class="kpi-value">₹@Model.TotalPayables.ToString("N0")</h3>
                    <span class="kpi-trend"><i class="fa-solid fa-file-signature me-1"></i>Outstanding payments</span>
                </div>
                <div class="kpi-card-icon-container">
                    <i class="fa-solid fa-credit-card"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- KPI Cards Grid (Row 2) -->
<div class="row mb-4">
    <!-- Card 5: Stock Value -->
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="premium-kpi-card card-teal-tint">
            <div class="kpi-card-body">
                <div class="kpi-card-details">
                    <span class="kpi-title">Stock Value</span>
                    <h3 class="kpi-value">₹@Model.AvailableStockValue.ToString("N0")</h3>
                    <span class="kpi-trend"><i class="fa-solid fa-boxes-stacked me-1"></i>Total inventory value</span>
                </div>
                <div class="kpi-card-icon-container">
                    <i class="fa-solid fa-warehouse"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Card 7: Customer Master -->
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="premium-kpi-card card-orange-tint">
            <div class="kpi-card-body">
                <div class="kpi-card-details">
                    <span class="kpi-title">Total Customers</span>
                    <h3 class="kpi-value">@Model.CustomerCount</h3>
                    <span class="kpi-trend"><i class="fa-solid fa-user-tag me-1"></i>Active accounts</span>
                </div>
                <div class="kpi-card-icon-container">
                    <i class="fa-solid fa-users"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Card 8: Supplier Master -->
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="premium-kpi-card card-red-tint">
            <div class="kpi-card-body">
                <div class="kpi-card-details">
                    <span class="kpi-title">Total Suppliers</span>
                    <h3 class="kpi-value">@Model.SupplierCount</h3>
                    <span class="kpi-trend"><i class="fa-solid fa-truck-field me-1"></i>Active vendors</span>
                </div>
                <div class="kpi-card-icon-container">
                    <i class="fa-solid fa-truck-moving"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Charts Section Row 1 -->
<div class="row mb-4">
    <!-- Area Chart: Sales & Purchase Trend -->
    <div class="col-lg-7 mb-4">
        <div class="premium-chart-card card h-100">
            <div class="card-header-clean">
                <span class="chart-card-title">Sales & Purchase Trend</span>
            </div>
            <div class="card-body">
                <div class="chart-container-large">
                    <canvas id="salesTrendLineChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Donut Chart: Revenue vs Expense Analysis -->
    <div class="col-lg-5 mb-4">
        <div class="premium-chart-card card h-100">
            <div class="card-header-clean">
                <span class="chart-card-title">Revenue vs Expense Analysis</span>
            </div>
            <div class="card-body d-flex align-items-center">
                <div class="row w-100 align-items-center">
                    <div class="col-sm-7 position-relative d-flex justify-content-center">
                        <div class="donut-chart-wrapper">
                            <canvas id="revenuePieChart"></canvas>
                            <div class="donut-center-label">
                                <span class="donut-number">40</span>
                                <span class="donut-unit">%</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-5 mt-3 mt-sm-0">
                        <ul class="donut-legend-list">
                            <li>
                                <span class="legend-color-dot color-active"></span>
                                <span class="legend-label">Revenue</span>
                                <span class="legend-val">75%</span>
                            </li>
                            <li>
                                <span class="legend-color-dot color-expired"></span>
                                <span class="legend-label">Expenses</span>
                                <span class="legend-val">45%</span>
                            </li>
                            <li>
                                <span class="legend-color-dot color-trial"></span>
                                <span class="legend-label">Net Profit</span>
                                <span class="legend-val">30%</span>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Charts Section Row 2 -->
<div class="row mb-4">
    <!-- Bar Chart: Weekly Transaction Activity -->
    <div class="col-lg-7 mb-4">
        <div class="premium-chart-card card h-100">
            <div class="card-header-clean">
                <span class="chart-card-title">Weekly Transaction Volume</span>
            </div>
            <div class="card-body">
                <div class="chart-container-large">
                    <canvas id="weeklyTransactionsBarChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Progress Bars: Module Usage Summary -->
    <div class="col-lg-5 mb-4">
        <div class="premium-chart-card card h-100">
            <div class="card-header-clean">
                <span class="chart-card-title">Module Activity Summary</span>
            </div>
            <div class="card-body py-4">
                <div class="progress-bar-stack">
                    <!-- Progress Item 1 -->
                    <div class="progress-item mb-3">
                        <div class="d-flex justify-content-between mb-1">
                            <span class="progress-label">Billing & Invoices</span>
                            <span class="progress-val">89%</span>
                        </div>
                        <div class="progress progress-sm">
                            <div class="progress-bar bg-blue" role="progressbar" style="width: 89%" aria-valuenow="89" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                    </div>
                    <!-- Progress Item 2 -->
                    <div class="progress-item mb-3">
                        <div class="d-flex justify-content-between mb-1">
                            <span class="progress-label">Inventory & Stock Control</span>
                            <span class="progress-val">76%</span>
                        </div>
                        <div class="progress progress-sm">
                            <div class="progress-bar bg-blue-dark" role="progressbar" style="width: 76%" aria-valuenow="76" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                    </div>
                    <!-- Progress Item 3 -->
                    <div class="progress-item mb-3">
                        <div class="d-flex justify-content-between mb-1">
                            <span class="progress-label">Accounts Ledger</span>
                            <span class="progress-val">72%</span>
                        </div>
                        <div class="progress progress-sm">
                            <div class="progress-bar bg-teal" role="progressbar" style="width: 72%" aria-valuenow="72" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                    </div>
                    <!-- Progress Item 4 -->
                    <div class="progress-item mb-3">
                        <div class="d-flex justify-content-between mb-1">
                            <span class="progress-label">CRM Leads</span>
                            <span class="progress-val">65%</span>
                        </div>
                        <div class="progress progress-sm">
                            <div class="progress-bar bg-green" role="progressbar" style="width: 65%" aria-valuenow="65" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                    </div>
                    <!-- Progress Item 5 -->
                    <div class="progress-item mb-3">
                        <div class="d-flex justify-content-between mb-1">
                            <span class="progress-label">Reports & Analytics</span>
                            <span class="progress-val">58%</span>
                        </div>
                        <div class="progress progress-sm">
                            <div class="progress-bar bg-green-light" role="progressbar" style="width: 58%" aria-valuenow="58" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                    </div>
                    <!-- Progress Item 6 -->
                    <div class="progress-item mb-3">
                        <div class="d-flex justify-content-between mb-1">
                            <span class="progress-label">Purchases & Goods Entry</span>
                            <span class="progress-val">54%</span>
                        </div>
                        <div class="progress progress-sm">
                            <div class="progress-bar bg-purple" role="progressbar" style="width: 54%" aria-valuenow="54" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                    </div>
                    <!-- Progress Item 7 -->
                    <div class="progress-item mb-2">
                        <div class="d-flex justify-content-between mb-1">
                            <span class="progress-label">System Config Setup</span>
                            <span class="progress-val">42%</span>
                        </div>
                        <div class="progress progress-sm">
                            <div class="progress-bar bg-purple-light" role="progressbar" style="width: 42%" aria-valuenow="42" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Grid Actions & System Alerts -->
<div class="row">
    <!-- Quick Actions -->
    <div class="col-lg-6 mb-4">
        <div class="premium-chart-card card h-100">
            <div class="card-header-clean">
                <span class="chart-card-title">Quick Actions</span>
            </div>
            <div class="card-body">
                <div class="row g-3 quick-actions-grid">
                    <!-- Action 1: Create Sales Invoice -->
                    <div class="col-6">
                        <a href="/Sales/Invoice" class="quick-action-button action-orange">
                            <div class="action-icon-circle">
                                <i class="fa-solid fa-file-invoice-dollar"></i>
                            </div>
                            <span class="action-text">Sales Invoice</span>
                        </a>
                    </div>
                    <!-- Action 2: Record Purchase Invoice -->
                    <div class="col-6">
                        <a href="/Purchase/Invoice" class="quick-action-button action-purple">
                            <div class="action-icon-circle">
                                <i class="fa-solid fa-cart-flatbed"></i>
                            </div>
                            <span class="action-text">Purchase Invoice</span>
                        </a>
                    </div>
                    <!-- Action 3: Add Customer Master -->
                    <div class="col-6">
                        <a href="/Masters/Customer" class="quick-action-button action-pink">
                            <div class="action-icon-circle">
                                <i class="fa-solid fa-user-plus"></i>
                            </div>
                            <span class="action-text">Add Customer</span>
                        </a>
                    </div>
                    <!-- Action 4: Register Product -->
                    <div class="col-6">
                        <a href="/Masters/Product" class="quick-action-button action-green">
                            <div class="action-icon-circle">
                                <i class="fa-solid fa-boxes-packing"></i>
                            </div>
                            <span class="action-text">Add Product</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- System Alerts -->
    <div class="col-lg-6 mb-4">
        <div class="premium-chart-card card h-100">
            <div class="card-header-clean">
                <span class="chart-card-title">System Notifications</span>
            </div>
            <div class="card-body p-0">
                @if (Model.SystemAlerts == null || !Model.SystemAlerts.Any())
                {
                    <div class="p-5 text-center text-muted">
                        <i class="fa-solid fa-bell-slash fa-2x mb-3 text-secondary" style="opacity: 0.4;"></i>
                        <p class="m-0 fs-7">All clear! No pending notifications.</p>
                    </div>
                }
                else
                {
                    <div class="alerts-list">
                        @foreach (var alert in Model.SystemAlerts)
                        {
                            var isWarning = alert.NotificationType == "LowStock" || alert.NotificationType == "ApprovalPending";
                            <div class="alert-item">
                                <div class="alert-icon-container @(isWarning ? "bg-alert-orange" : "bg-alert-red")">
                                    <i class="fa-solid @(alert.NotificationType == "LowStock" ? "fa-triangle-exclamation" : alert.NotificationType == "ApprovalPending" ? "fa-clock" : "fa-bell")"></i>
                                </div>
                                <div class="alert-content">
                                    <span class="alert-item-title">@alert.NotificationType</span>
                                    <span class="alert-item-desc">@alert.Message</span>
                                </div>
                                @if (!string.IsNullOrEmpty(alert.LinkUrl))
                                {
                                    <a href="@alert.LinkUrl" class="btn btn-dark-alert">Resolve</a>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Line Chart: Sales & Purchase Trend
            var ctxArea = document.getElementById('salesTrendLineChart');
            if (ctxArea) {
                var ctx = ctxArea.getContext('2d');
                if (ctx) {
                    var salesGradient = ctx.createLinearGradient(0, 0, 0, 300);
                    salesGradient.addColorStop(0, 'rgba(59, 130, 246, 0.2)');
                    salesGradient.addColorStop(1, 'rgba(59, 130, 246, 0.0)');

                    new Chart(ctxArea, {
                        type: 'line',
                        data: {
                            labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'],
                            datasets: [{
                                label: 'Sales',
                                data: [12000, 19000, 3000, 5000, 20000, 30000, 45000, 35000, 40000, 38000, 42000, 50000],
                                borderColor: '#3b82f6',
                                borderWidth: 2.5,
                                backgroundColor: salesGradient,
                                tension: 0.35,
                                fill: true,
                                pointBackgroundColor: '#ffffff',
                                pointBorderColor: '#3b82f6',
                                pointBorderWidth: 2,
                                pointHoverRadius: 6,
                                pointRadius: 4
                            }, {
                                label: 'Purchases',
                                data: [8000, 15000, 2000, 4000, 18000, 22000, 38000, 30000, 32000, 35000, 33000, 41000],
                                borderColor: '#f97316',
                                borderWidth: 2,
                                backgroundColor: 'transparent',
                                tension: 0.35,
                                pointBackgroundColor: '#ffffff',
                                pointBorderColor: '#f97316',
                                pointBorderWidth: 1.5,
                                pointHoverRadius: 5,
                                pointRadius: 3
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: {
                                    display: true,
                                    position: 'top',
                                    labels: { boxWidth: 12, usePointStyle: true, font: { family: 'Inter', weight: 600 } }
                                }
                            },
                            scales: {
                                y: {
                                    ticks: { color: '#94a3b8' },
                                    grid: { color: '#f1f5f9' },
                                    border: { dash: [4, 4] }
                                },
                                x: {
                                    ticks: { color: '#94a3b8' },
                                    grid: { display: false }
                                }
                            }
                        }
                    });
                }
            }

            // Doughnut Chart: Revenue vs Expense
            var ctxPie = document.getElementById('revenuePieChart');
            if (ctxPie) {
                new Chart(ctxPie, {
                    type: 'doughnut',
                    data: {
                        labels: ['Revenue', 'Expenses', 'Net Profit'],
                        datasets: [{
                            data: [75, 45, 30],
                            backgroundColor: ['#22c55e', '#ef4444', '#a855f7'],
                            borderWidth: 3,
                            borderColor: '#ffffff',
                            hoverOffset: 4
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        cutout: '75%',
                        plugins: {
                            legend: { display: false }
                        }
                    }
                });
            }

            // Bar Chart: Weekly Transaction Volumes
            var ctxBar = document.getElementById('weeklyTransactionsBarChart');
            if (ctxBar) {
                new Chart(ctxBar, {
                    type: 'bar',
                    data: {
                        labels: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'],
                        datasets: [{
                            label: 'Transactions',
                            data: [65, 78, 124, 98, 85, 112, 54],
                            backgroundColor: '#3b82f6',
                            borderRadius: 6,
                            barThickness: 24,
                            maxBarThickness: 32
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false }
                        },
                        scales: {
                            y: {
                                ticks: { color: '#94a3b8' },
                                grid: { color: '#f1f5f9' },
                                border: { dash: [4, 4] }
                            },
                            x: {
                                ticks: { color: '#94a3b8' },
                                grid: { display: false }
                            }
                        }
                    }
                });
            }
        });
    </script>
}
