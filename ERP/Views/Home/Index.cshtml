@model ERP.ViewModels.UnifiedDashboardViewModel
@{
    ViewData["Title"] = Model.IsSuperAdminDashboard ? "Super Admin Dashboard" : $"{Model.ActiveCompanyName ?? "Company"} Dashboard";
}

<div class="container-fluid p-3 p-md-4">
    @if (Model.IsSuperAdminDashboard && Model.SuperAdminModel != null)
    {
        <partial name="_SuperAdminDashboard" model="Model.SuperAdminModel" />
    }
    else if (Model.CompanyAdminModel != null)
    {
        <partial name="_CompanyAdminDashboard" model="Model.CompanyAdminModel" />
    }
</div>

@section Scripts {
    @if (Model.CompanyAdminModel != null)
    {
        <script>
            $(function () {
                // Chart.js 30-day Trend Chart Initialization
                var trendCtx = document.getElementById('salesPurchaseTrendChart');
                if (trendCtx) {
                    var trendLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CompanyAdminModel.Charts.TrendLabels));
                    var salesData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CompanyAdminModel.Charts.SalesTrendValues));
                    var purchaseData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CompanyAdminModel.Charts.PurchaseTrendValues));

                    new Chart(trendCtx, {
                        type: 'line',
                        data: {
                            labels: trendLabels,
                            datasets: [
                                {
                                    label: 'Sales (₹)',
                                    data: salesData,
                                    borderColor: '#3b82f6',
                                    backgroundColor: 'rgba(59, 130, 246, 0.08)',
                                    fill: true,
                                    tension: 0.35,
                                    borderWidth: 2.5,
                                    pointRadius: 3,
                                    pointHoverRadius: 5
                                },
                                {
                                    label: 'Purchases (₹)',
                                    data: purchaseData,
                                    borderColor: '#10b981',
                                    backgroundColor: 'rgba(16, 185, 129, 0.08)',
                                    fill: true,
                                    tension: 0.35,
                                    borderWidth: 2.5,
                                    pointRadius: 3,
                                    pointHoverRadius: 5
                                }
                            ]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            interaction: { intersect: false, mode: 'index' },
                            plugins: {
                                legend: { display: false },
                                tooltip: {
                                    callbacks: {
                                        label: function(context) {
                                            return context.dataset.label + ': ₹' + Number(context.raw).toLocaleString();
                                        }
                                    }
                                }
                            },
                            scales: {
                                y: {
                                    beginAtZero: true,
                                    ticks: {
                                        callback: function(val) { return '₹' + Number(val).toLocaleString(); },
                                        color: '#94a3b8'
                                    },
                                    grid: { color: '#f1f5f9' }
                                },
                                x: {
                                    ticks: { color: '#94a3b8' },
                                    grid: { display: false }
                                }
                            }
                        }
                    });
                }

                // Chart.js Category Distribution Doughnut
                var catCtx = document.getElementById('categoryDistributionChart');
                if (catCtx) {
                    var catLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CompanyAdminModel.Charts.CategoryLabels));
                    var catValues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CompanyAdminModel.Charts.CategoryStockValues));

                    new Chart(catCtx, {
                        type: 'doughnut',
                        data: {
                            labels: catLabels,
                            datasets: [{
                                data: catValues,
                                backgroundColor: ['#3b82f6', '#10b981', '#f59e0b', '#8b5cf6', '#ec4899', '#64748b'],
                                borderWidth: 2,
                                borderColor: '#ffffff',
                                hoverOffset: 4
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            cutout: '70%',
                            plugins: {
                                legend: { position: 'bottom', labels: { boxWidth: 12, font: { size: 11 } } },
                                tooltip: {
                                    callbacks: {
                                        label: function(context) {
                                            return context.label + ': ₹' + Number(context.raw).toLocaleString();
                                        }
                                    }
                                }
                            }
                        }
                    });
                }
            });
        </script>
    }
}
