@model ERP.ViewModels.SuperAdminDashboardViewModel
@{
    var m = Model;
}

<!-- Super Admin System Banner -->
<div class="card border-0 shadow-sm mb-4 text-white rounded-3 overflow-hidden position-relative no-print" style="background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 50%, #312e81 100%);">
    <div class="card-body p-4 position-relative z-1">
        <div class="row align-items-center g-3">
            <div class="col-12 col-md-7 col-lg-8">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="badge bg-danger-subtle text-danger px-3 py-1.5 rounded-pill fs-8 fw-bold">
                        <i class="fa-solid fa-crown me-1"></i>Super Admin Mode
                    </span>
                    <span class="badge bg-white bg-opacity-20 text-white px-2.5 py-1 rounded-pill fs-8">
                        <i class="fa-solid fa-network-wired me-1"></i>System-Wide Overview
                    </span>
                    <span class="text-white-50 small"><i class="fa-regular fa-calendar me-1"></i>@DateTime.UtcNow.ToString("dd MMMM yyyy")</span>
                </div>
                <h3 class="fw-bold m-0 text-white">Platform Administration Dashboard 🛡️</h3>
                <p class="text-white-50 m-0 mt-1.5 small">Centralized overview of all tenant companies, platform-wide trade metrics, global security, and audit logs.</p>
            </div>
            <div class="col-12 col-md-5 col-lg-4 text-md-end d-flex gap-2 justify-content-md-end flex-wrap">
                <a href="/Company" class="btn btn-primary px-3 shadow-sm border-0" style="background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);">
                    <i class="fa-solid fa-building me-1.5"></i>Manage Companies
                </a>
                <a href="/Settings/Users" class="btn btn-light bg-white bg-opacity-10 text-white border-white border-opacity-20 px-3 hover-shadow">
                    <i class="fa-solid fa-user-plus me-1.5"></i>Users & Roles
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Super Admin System KPIs (Row 1 - Platform Core) -->
<div class="row g-3 mb-4">
    <!-- Card 1: Total Companies -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100 rounded-3">
            <div class="card-body p-3.5">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted small fw-bold text-uppercase tracking-wider">Tenant Companies</span>
                    <div class="avatar bg-primary bg-opacity-10 text-primary rounded-3 p-2.5 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                        <i class="fa-solid fa-city fs-5"></i>
                    </div>
                </div>
                <h3 class="fw-bold text-dark m-0 mb-1 fs-3">@m.TotalCompanies</h3>
                <div class="d-flex align-items-center justify-content-between">
                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill fs-8 fw-semibold px-2 py-0.5">
                        <i class="fa-solid fa-circle-check me-1"></i>@m.ActiveCompanies Active
                    </span>
                    <span class="text-muted fs-8">@(m.InactiveCompanies) Inactive</span>
                </div>
            </div>
            <div class="progress" style="height: 3px;">
                <div class="progress-bar bg-primary" role="progressbar" style="width: @(m.TotalCompanies > 0 ? (m.ActiveCompanies * 100 / m.TotalCompanies) : 0)%"></div>
            </div>
        </div>
    </div>

    <!-- Card 2: Total System Users -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100 rounded-3">
            <div class="card-body p-3.5">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted small fw-bold text-uppercase tracking-wider">Total Users</span>
                    <div class="avatar bg-info bg-opacity-10 text-info rounded-3 p-2.5 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                        <i class="fa-solid fa-users fs-5"></i>
                    </div>
                </div>
                <h3 class="fw-bold text-dark m-0 mb-1 fs-3">@m.TotalUsers</h3>
                <div class="d-flex align-items-center justify-content-between">
                    <span class="badge bg-info-subtle text-info border border-info-subtle rounded-pill fs-8 fw-semibold px-2 py-0.5">
                        <i class="fa-solid fa-user-shield me-1"></i>@m.TotalRoles Roles
                    </span>
                    <span class="text-muted fs-8">@m.ActiveUsers Active</span>
                </div>
            </div>
            <div class="progress" style="height: 3px;">
                <div class="progress-bar bg-info" role="progressbar" style="width: @(m.TotalUsers > 0 ? (m.ActiveUsers * 100 / m.TotalUsers) : 0)%"></div>
            </div>
        </div>
    </div>

    <!-- Card 3: Platform Sales -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100 rounded-3">
            <div class="card-body p-3.5">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted small fw-bold text-uppercase tracking-wider">Platform Total Sales</span>
                    <div class="avatar bg-success bg-opacity-10 text-success rounded-3 p-2.5 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                        <i class="fa-solid fa-file-invoice-dollar fs-5"></i>
                    </div>
                </div>
                <h3 class="fw-bold text-dark m-0 mb-1 fs-3">₹@m.TotalPlatformSales.ToString("N0")</h3>
                <div class="d-flex align-items-center justify-content-between">
                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill fs-8 fw-semibold px-2 py-0.5">
                        <i class="fa-solid fa-arrow-trend-up me-1"></i>All Companies
                    </span>
                    <span class="text-muted fs-8">Lifetime Volume</span>
                </div>
            </div>
            <div class="progress" style="height: 3px;">
                <div class="progress-bar bg-success" role="progressbar" style="width: 80%"></div>
            </div>
        </div>
    </div>

    <!-- Card 4: Platform Purchases -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100 rounded-3">
            <div class="card-body p-3.5">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted small fw-bold text-uppercase tracking-wider">Platform Purchases</span>
                    <div class="avatar bg-warning bg-opacity-10 text-warning rounded-3 p-2.5 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                        <i class="fa-solid fa-cart-flatbed fs-5"></i>
                    </div>
                </div>
                <h3 class="fw-bold text-dark m-0 mb-1 fs-3">₹@m.TotalPlatformPurchases.ToString("N0")</h3>
                <div class="d-flex align-items-center justify-content-between">
                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle rounded-pill fs-8 fw-semibold px-2 py-0.5">
                        <i class="fa-solid fa-boxes-packing me-1"></i>Procurement
                    </span>
                    <span class="text-muted fs-8">All Companies</span>
                </div>
            </div>
            <div class="progress" style="height: 3px;">
                <div class="progress-bar bg-warning" role="progressbar" style="width: 65%"></div>
            </div>
        </div>
    </div>
</div>

<!-- Secondary KPI Row (Security & Assets) -->
<div class="row g-3 mb-4">
    <div class="col-12 col-md-4">
        <div class="card border-0 shadow-sm p-3 h-100 rounded-3 d-flex flex-row align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-3 bg-success-subtle text-success p-3">
                    <i class="fa-solid fa-shield-check fs-4"></i>
                </div>
                <div>
                    <div class="text-muted small fw-bold text-uppercase">Logins Today</div>
                    <h4 class="fw-bold mb-0 text-dark">@m.SuccessfulLoginsToday</h4>
                </div>
            </div>
            <span class="badge bg-success-subtle text-success">@m.ActiveSessions Active Sessions</span>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card border-0 shadow-sm p-3 h-100 rounded-3 d-flex flex-row align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-3 bg-danger-subtle text-danger p-3">
                    <i class="fa-solid fa-shield-halved fs-4"></i>
                </div>
                <div>
                    <div class="text-muted small fw-bold text-uppercase">Failed Login Attempts</div>
                    <h4 class="fw-bold mb-0 text-danger">@m.FailedLoginsToday</h4>
                </div>
            </div>
            <a href="/Audit/LoginHistory" class="btn btn-sm btn-outline-danger">Inspect Logs</a>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card border-0 shadow-sm p-3 h-100 rounded-3 d-flex flex-row align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-3 bg-purple-subtle text-purple p-3">
                    <i class="fa-solid fa-layer-group fs-4"></i>
                </div>
                <div>
                    <div class="text-muted small fw-bold text-uppercase">Platform Catalog</div>
                    <h4 class="fw-bold mb-0 text-dark">@m.TotalProducts SKUs</h4>
                </div>
            </div>
            <div class="text-end">
                <span class="text-muted fs-8 d-block">@m.TotalCustomers Customers</span>
                <span class="text-muted fs-8 d-block">@m.TotalSuppliers Suppliers</span>
            </div>
        </div>
    </div>
</div>

<!-- Multi-Company Performance Matrix Table -->
<div class="card border-0 shadow-sm mb-4 rounded-3">
    <div class="card-header bg-white py-3.5 d-flex flex-wrap align-items-center justify-content-between gap-2 border-bottom">
        <div>
            <h6 class="fw-bold mb-0 text-dark"><i class="fa-solid fa-building-user text-primary me-2"></i>Tenant Companies Activity & Performance Matrix</h6>
            <span class="text-muted fs-8">Real-time trading breakdown per company tenant</span>
        </div>
        <div class="d-flex gap-2">
            <a href="/Company" class="btn btn-sm btn-outline-primary"><i class="fa-solid fa-gear me-1"></i>Company Setup</a>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light text-uppercase fs-8 text-muted fw-bold">
                <tr>
                    <th class="ps-3" style="width: 25%;">Company Name & Code</th>
                    <th style="width: 15%;">City / Location</th>
                    <th class="text-center" style="width: 10%;">Users</th>
                    <th class="text-end" style="width: 15%;">Total Sales</th>
                    <th class="text-end" style="width: 15%;">Total Purchases</th>
                    <th class="text-center" style="width: 10%;">Status</th>
                    <th class="text-center" style="width: 10%;">Switch Context</th>
                </tr>
            </thead>
            <tbody>
                @if (m.Companies != null && m.Companies.Any())
                {
                    foreach (var c in m.Companies)
                    {
                        <tr>
                            <td class="ps-3">
                                <div class="fw-bold text-dark">@c.CompanyName</div>
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle fs-8">@c.CompanyCode</span>
                            </td>
                            <td>
                                <span class="text-muted"><i class="fa-solid fa-location-dot me-1 text-secondary"></i>@c.City</span>
                            </td>
                            <td class="text-center">
                                <span class="badge bg-light text-dark border"><i class="fa-solid fa-users me-1 text-muted"></i>@c.UserCount</span>
                            </td>
                            <td class="text-end fw-semibold text-dark">
                                ₹@c.TotalSales.ToString("N0")
                            </td>
                            <td class="text-end fw-semibold text-secondary">
                                ₹@c.TotalPurchases.ToString("N0")
                            </td>
                            <td class="text-center">
                                @if (c.IsActive)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 fs-8">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1 fs-8">Inactive</span>
                                }
                            </td>
                            <td class="text-center">
                                <form method="post" action="/Company/SwitchCompany" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="companyId" value="@c.CompanyId" />
                                    <input type="hidden" name="returnUrl" value="/" />
                                    <button type="submit" class="btn btn-sm btn-outline-primary px-2 py-1 fs-8 fw-semibold" title="Switch to @c.CompanyName dashboard">
                                        <i class="fa-solid fa-arrow-right-to-bracket me-1"></i>Switch
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="fa-solid fa-city fs-1 d-block mb-3 text-secondary opacity-50"></i>
                            <h6>No Companies Configured</h6>
                            <p class="small mb-0">Create your first company tenant to begin monitoring trading activities.</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Global Recent Audit Activities & Quick Actions -->
<div class="row g-3">
    <!-- Recent System Audit Feed -->
    <div class="col-12 col-lg-8">
        <div class="card border-0 shadow-sm h-100 rounded-3">
            <div class="card-header bg-white py-3.5 d-flex align-items-center justify-content-between border-bottom">
                <div>
                    <h6 class="fw-bold mb-0 text-dark"><i class="fa-solid fa-shield-halved text-primary me-2"></i>Global Platform Activity Feed</h6>
                    <span class="text-muted fs-8">Recent administrative, security, and master data changes across tenants</span>
                </div>
                <a href="/Audit/Logs" class="btn btn-sm btn-outline-secondary">View All Logs</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light fs-8 text-uppercase text-muted fw-bold">
                            <tr>
                                <th class="ps-3" style="width: 18%;">Time (UTC)</th>
                                <th style="width: 15%;">User</th>
                                <th style="width: 15%;">Company</th>
                                <th style="width: 12%;">Action</th>
                                <th style="width: 40%;">Description</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (m.RecentActivities != null && m.RecentActivities.Any())
                            {
                                foreach (var act in m.RecentActivities)
                                {
                                    var badgeColor = act.Severity switch
                                    {
                                        "Warning" => "bg-warning-subtle text-warning border border-warning-subtle",
                                        "Danger" => "bg-danger-subtle text-danger border border-danger-subtle",
                                        _ => "bg-success-subtle text-success border border-success-subtle"
                                    };

                                    <tr>
                                        <td class="ps-3 text-nowrap">
                                            <div class="small fw-semibold text-dark">@act.Timestamp.ToString("yyyy-MM-dd")</div>
                                            <div class="text-muted fs-8">@act.Timestamp.ToString("HH:mm:ss")</div>
                                        </td>
                                        <td class="small fw-semibold text-dark">
                                            <i class="fa-solid fa-user small text-muted me-1"></i>@act.UserName
                                        </td>
                                        <td>
                                            <span class="badge bg-light text-dark border">@act.CompanyCode</span>
                                        </td>
                                        <td>
                                            <span class="badge @badgeColor px-2 py-0.5 fs-8">@act.Action</span>
                                        </td>
                                        <td class="small text-dark text-truncate" style="max-width: 280px;" title="@act.Description">
                                            @act.Description
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-4 text-muted small">No recent activity logged.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Shortcuts Card -->
    <div class="col-12 col-lg-4">
        <div class="card border-0 shadow-sm h-100 rounded-3">
            <div class="card-header bg-white py-3.5 border-bottom">
                <h6 class="fw-bold mb-0 text-dark"><i class="fa-solid fa-bolt text-warning me-2"></i>Administrative Shortcuts</h6>
                <span class="text-muted fs-8">One-click management actions</span>
            </div>
            <div class="card-body p-3 d-flex flex-column gap-2">
                <a href="/Company" class="btn btn-outline-primary text-start p-2.5 rounded-3 d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center gap-2">
                        <i class="fa-solid fa-building text-primary fs-5"></i>
                        <div>
                            <div class="fw-bold text-dark">Create & Provision Company</div>
                            <div class="text-muted fs-8">Onboard new tenant with admin account</div>
                        </div>
                    </div>
                    <i class="fa-solid fa-chevron-right text-muted fs-8"></i>
                </a>

                <a href="/Settings/Users" class="btn btn-outline-secondary text-start p-2.5 rounded-3 d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center gap-2">
                        <i class="fa-solid fa-users-gear text-secondary fs-5"></i>
                        <div>
                            <div class="fw-bold text-dark">Platform User Directory</div>
                            <div class="text-muted fs-8">Manage users across all companies</div>
                        </div>
                    </div>
                    <i class="fa-solid fa-chevron-right text-muted fs-8"></i>
                </a>

                <a href="/Settings/Roles" class="btn btn-outline-secondary text-start p-2.5 rounded-3 d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center gap-2">
                        <i class="fa-solid fa-shield-alt text-secondary fs-5"></i>
                        <div>
                            <div class="fw-bold text-dark">Role & Permission Matrix</div>
                            <div class="text-muted fs-8">Configure screen level access</div>
                        </div>
                    </div>
                    <i class="fa-solid fa-chevron-right text-muted fs-8"></i>
                </a>

                <a href="/Audit/Logs" class="btn btn-outline-secondary text-start p-2.5 rounded-3 d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center gap-2">
                        <i class="fa-solid fa-shield-halved text-secondary fs-5"></i>
                        <div>
                            <div class="fw-bold text-dark">Audit Trail & Activity Logs</div>
                            <div class="text-muted fs-8">Search immutable system events</div>
                        </div>
                    </div>
                    <i class="fa-solid fa-chevron-right text-muted fs-8"></i>
                </a>

                <a href="/Audit/LoginHistory" class="btn btn-outline-secondary text-start p-2.5 rounded-3 d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center gap-2">
                        <i class="fa-solid fa-clock-rotate-left text-secondary fs-5"></i>
                        <div>
                            <div class="fw-bold text-dark">Login History & Sessions</div>
                            <div class="text-muted fs-8">Authentication logs and active sessions</div>
                        </div>
                    </div>
                    <i class="fa-solid fa-chevron-right text-muted fs-8"></i>
                </a>
            </div>
        </div>
    </div>
</div>
