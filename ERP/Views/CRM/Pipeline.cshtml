@model IEnumerable<ERP.Models.Lead>
@{
    ViewData["Title"] = "CRM Pipeline";
    var groups = Model?.GroupBy(x => x.Status).ToList();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="m-0 font-weight-bold text-primary"><i class="fa-solid fa-chart-line me-2"></i> CRM Pipeline</h4>
</div>

<div class="row">
    @if(groups != null)
    {
        var stages = new[] { "New", "Contacted", "Qualified", "Lost" };
        foreach(var stage in stages)
        {
            var leadsInStage = groups.FirstOrDefault(g => g.Key == stage)?.ToList() ?? new List<ERP.Models.Lead>();
            <div class="col-md-3">
                <div class="card bg-light">
                    <div class="card-header bg-white font-weight-bold border-bottom">
                        @stage <span class="badge bg-secondary float-end">@leadsInStage.Count</span>
                    </div>
                    <div class="card-body" style="min-height: 400px; max-height: 600px; overflow-y: auto;">
                        @foreach(var lead in leadsInStage)
                        {
                            <div class="card mb-3 shadow-sm">
                                <div class="card-body p-3">
                                    <h6 class="card-title text-primary font-weight-bold mb-1">@lead.LeadName</h6>
                                    <p class="card-text text-muted small mb-2">@lead.CompanyName</p>
                                    <div class="d-flex justify-content-between align-items-center">
                                        <small><i class="fa-solid fa-phone me-1"></i> @lead.Phone</small>
                                        <a href="/CRM/Leads" class="btn btn-sm btn-outline-primary py-0"><i class="fa-solid fa-eye"></i></a>
                                    </div>
                                </div>
                            </div>
                        }
                        @if(!leadsInStage.Any())
                        {
                            <div class="text-center text-muted mt-5">
                                <i class="fa-solid fa-inbox fa-2x mb-2 opacity-50"></i>
                                <p>No leads in this stage.</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    }
</div>
