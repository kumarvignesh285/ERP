@model CrmLookupPageViewModel<Opportunity>
@{
    ViewData["Title"] = "Opportunities";
    var leads = Model?.Leads ?? new List<Lead>();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="m-0 fw-bold text-primary"><i class="fa-solid fa-briefcase me-2"></i> Sales Opportunities</h4>
        <p class="text-muted small m-0 mt-1">Track deal pipeline, estimated revenue, probability, and deal stages</p>
    </div>
    <button class="btn btn-primary shadow-sm" data-bs-toggle="modal" data-bs-target="#oppModal"><i class="fa-solid fa-plus me-1.5"></i> Add Opportunity</button>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover datatable align-middle">
                <thead class="table-light text-uppercase fs-8 fw-bold text-muted">
                    <tr>
                        <th>Opportunity Name</th>
                        <th>Lead</th>
                        <th>Expected Value</th>
                        <th>Close Date</th>
                        <th>Stage</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if(Model != null)
                    {
                        foreach (var item in Model.Items)
                        {
                            var stageClass = item.Stage switch {
                                "Closed Won" => "bg-success-subtle text-success border border-success-subtle",
                                "Closed Lost" => "bg-danger-subtle text-danger border border-danger-subtle",
                                _ => "bg-primary-subtle text-primary border border-primary-subtle"
                            };
                            <tr>
                                <td class="fw-bold text-primary">@item.OpportunityName</td>
                                <td class="fw-semibold text-dark">@(item.Lead?.LeadName)</td>
                                <td class="fw-bold text-dark">₹@item.ExpectedRevenue.ToString("N2")</td>
                                <td>@(item.CloseDate?.ToString("dd-MM-yyyy"))</td>
                                <td>
                                    <span class="badge @stageClass fw-semibold">@item.Stage</span>
                                </td>
                                <td class="text-center">
                                    <button class="btn btn-sm btn-outline-danger" onclick="deleteOpp(@item.Id)" title="Delete"><i class="fa-solid fa-trash"></i></button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="oppModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-briefcase me-2"></i>Add / Edit Opportunity</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="SaveOpportunity" method="post">
                <div class="modal-body p-4">
                    <input type="hidden" name="Id" id="Id" value="0" />
                    <div class="row g-3 mb-3">
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold text-dark">Opportunity Name <span class="text-danger">*</span></label>
                            <input type="text" name="OpportunityName" class="form-control" required placeholder="e.g. Enterprise Software License" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold text-dark">Lead <span class="text-danger">*</span></label>
                            <select name="LeadId" class="form-select" required>
                                <option value="">Select Lead Account</option>
                                @if(leads.Any())
                                {
                                    foreach(var l in leads)
                                    {
                                        <option value="@l.Id">@l.LeadName - @l.CompanyName</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold text-dark">Expected Deal Value (₹)</label>
                            <input type="number" step="0.01" name="ExpectedRevenue" class="form-control" placeholder="0.00" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold text-dark">Win Probability (%)</label>
                            <input type="number" name="Probability" class="form-control" placeholder="e.g. 75" />
                        </div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold text-dark">Expected Close Date</label>
                            <input type="date" name="CloseDate" class="form-control" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold text-dark">Pipeline Stage</label>
                            <select name="Stage" class="form-select">
                                <option>Prospecting</option>
                                <option>Qualification</option>
                                <option>Proposal</option>
                                <option>Negotiation</option>
                                <option>Closed Won</option>
                                <option>Closed Lost</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary px-3" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary px-4 shadow-sm"><i class="fa-solid fa-floppy-disk me-1.5"></i>Save Opportunity</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function deleteOpp(id) {
            Swal.fire({
                title: 'Are you sure?',
                text: "Do you want to delete this opportunity?",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                confirmButtonText: 'Yes, delete!'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.post('/CRM/DeleteOpportunity', { id: id }, function(res) {
                        if (res.success) {
                            location.reload();
                        }
                    });
                }
            });
        }
    </script>
}

