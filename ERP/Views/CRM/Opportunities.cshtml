@model CrmLookupPageViewModel<Opportunity>
@{
    ViewData["Title"] = "Opportunities";
    var leads = Model?.Leads ?? new List<Lead>();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="m-0 font-weight-bold text-primary"><i class="fa-solid fa-briefcase me-2"></i> Opportunities</h4>
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#oppModal"><i class="fa-solid fa-plus me-1"></i> Add Opportunity</button>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover datatable align-middle">
                <thead>
                    <tr>
                        <th>Opportunity Name</th>
                        <th>Lead</th>
                        <th>Expected Value</th>
                        <th>Close Date</th>
                        <th>Stage</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if(Model != null)
                    {
                        foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="font-weight-bold">@item.OpportunityName</td>
                                <td>@(item.Lead?.LeadName)</td>
                                <td class="font-weight-semibold">₹@item.ExpectedRevenue.ToString("N2")</td>
                                <td>@(item.CloseDate?.ToString("dd-MM-yyyy"))</td>
                                <td>
                                    <span class="badge @(item.Stage == "Closed Won" ? "bg-success" : (item.Stage == "Closed Lost" ? "bg-danger" : "bg-primary"))">@item.Stage</span>
                                </td>
                                <td class="text-center">
                                    <button class="btn btn-sm btn-outline-danger" onclick="deleteOpp(@item.Id)"><i class="fa-solid fa-trash"></i></button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="oppModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">Add/Edit Opportunity</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="SaveOpportunity" method="post">
                <div class="modal-body">
                    <input type="hidden" name="Id" id="Id" value="0" />
                    <div class="mb-3">
                        <label class="form-label">Opportunity Name *</label>
                        <input type="text" name="OpportunityName" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Lead *</label>
                        <select name="LeadId" class="form-select" required>
                            <option value="">Select Lead</option>
                            @if(leads.Any())
                            {
                                foreach(var l in leads)
                                {
                                    <option value="@l.Id">@l.LeadName - @l.CompanyName</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Expected Value</label>
                            <input type="number" step="0.01" name="ExpectedRevenue" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Probability (%)</label>
                            <input type="number" name="Probability" class="form-control" />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Expected Close</label>
                            <input type="date" name="CloseDate" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Stage</label>
                            <select name="Stage" class="form-select">
                                <option>Prospecting</option>
                                <option>Qualification</option>
                                <option>Proposal</option>
                                <option>Negotiation</option>
                                <option>Closed Won</option>
                                <option>Closed Lost</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary">Save Opportunity</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function deleteOpp(id) {
            Swal.fire({
                title: 'Are you sure?',
                text: "Do you want to delete this opportunity?",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                confirmButtonText: 'Yes, delete!'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.post('/CRM/DeleteOpportunity', { id: id }, function(res) {
                        if (res.success) {
                            location.reload();
                        }
                    });
                }
            });
        }
    </script>
}

