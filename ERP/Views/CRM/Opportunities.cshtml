@model CrmLookupPageViewModel<Opportunity>
@{
    ViewData["Title"] = "Opportunities";
    var leads = Model?.Leads ?? new List<Lead>();
}

@Html.AntiForgeryToken()

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="m-0 fw-bold text-primary"><i class="fa-solid fa-briefcase me-2"></i> Sales Opportunities</h4>
        <p class="text-muted small m-0 mt-1">Track deal pipeline, estimated revenue, probability, and deal stages</p>
    </div>
    <button class="btn btn-primary shadow-sm" data-bs-toggle="modal" data-bs-target="#oppModal"><i class="fa-solid fa-plus me-1.5"></i> Add Opportunity</button>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover datatable align-middle">
                <thead class="table-light text-uppercase fs-8 fw-bold text-muted">
                    <tr>
                        <th>Opportunity Name</th>
                        <th>Lead</th>
                        <th>Expected Value</th>
                        <th>Close Date</th>
                        <th>Stage</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if(Model != null)
                    {
                        foreach (var item in Model.Items)
                        {
                            var stageClass = item.Stage switch {
                                "Closed Won" => "bg-success-subtle text-success border border-success-subtle",
                                "Closed Lost" => "bg-danger-subtle text-danger border border-danger-subtle",
                                _ => "bg-primary-subtle text-primary border border-primary-subtle"
                            };
                            <tr id="row-@item.Id">
                                <td class="fw-bold text-primary">@item.OpportunityName</td>
                                <td class="fw-semibold text-dark">@(item.Lead?.LeadName)</td>
                                <td class="fw-bold text-dark">₹@item.ExpectedRevenue.ToString("N2")</td>
                                <td>@(item.CloseDate?.ToString("dd-MM-yyyy"))</td>
                                <td>
                                    <span class="badge @stageClass fw-semibold">@item.Stage</span>
                                </td>
                                <td class="text-center">
                                    <button class="btn btn-sm btn-outline-danger" onclick="deleteOpp(@item.Id)" title="Delete"><i class="fa-solid fa-trash"></i></button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="oppModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-briefcase me-2"></i>Add / Edit Opportunity</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="CRM" asp-action="SaveOpportunity" method="post" id="oppForm">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>
                    <input type="hidden" asp-for="Form.Id" id="Id" value="0" />
                    <div class="row g-3 mb-3">
                        <div class="col-12 col-md-6">
                            <label asp-for="Form.OpportunityName" class="form-label fw-semibold text-dark">Opportunity Name <span class="text-danger">*</span></label>
                            <input asp-for="Form.OpportunityName" id="OpportunityName" class="form-control" required placeholder="e.g. Enterprise Software License" />
                            <span asp-validation-for="Form.OpportunityName" class="text-danger small mt-1 d-block"></span>
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="Form.LeadId" class="form-label fw-semibold text-dark">Lead <span class="text-danger">*</span></label>
                            <select asp-for="Form.LeadId" id="LeadId" class="form-select" required>
                                <option value="">Select Lead Account</option>
                                @if(leads.Any())
                                {
                                    foreach(var l in leads)
                                    {
                                        <option value="@l.Id">@l.LeadName - @l.CompanyName</option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="Form.LeadId" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-12 col-md-6">
                            <label asp-for="Form.ExpectedRevenue" class="form-label fw-semibold text-dark">Expected Deal Value (₹)</label>
                            <input asp-for="Form.ExpectedRevenue" type="number" step="0.01" id="ExpectedRevenue" class="form-control" placeholder="0.00" />
                            <span asp-validation-for="Form.ExpectedRevenue" class="text-danger small mt-1 d-block"></span>
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="Form.Probability" class="form-label fw-semibold text-dark">Win Probability (%)</label>
                            <input asp-for="Form.Probability" type="number" id="Probability" class="form-control" placeholder="e.g. 75" />
                            <span asp-validation-for="Form.Probability" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-12 col-md-6">
                            <label asp-for="Form.CloseDate" class="form-label fw-semibold text-dark">Expected Close Date</label>
                            <input asp-for="Form.CloseDate" type="date" id="CloseDate" class="form-control" />
                            <span asp-validation-for="Form.CloseDate" class="text-danger small mt-1 d-block"></span>
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="Form.Stage" class="form-label fw-semibold text-dark">Pipeline Stage</label>
                            <select asp-for="Form.Stage" id="Stage" class="form-select">
                                <option value="Prospecting">Prospecting</option>
                                <option value="Qualification">Qualification</option>
                                <option value="Proposal">Proposal</option>
                                <option value="Negotiation">Negotiation</option>
                                <option value="Closed Won">Closed Won</option>
                                <option value="Closed Lost">Closed Lost</option>
                            </select>
                            <span asp-validation-for="Form.Stage" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary px-3" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary px-4 shadow-sm" id="submitBtn"><i class="fa-solid fa-floppy-disk me-1.5"></i>Save Opportunity</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        var oppModal;
        $(function () {
            oppModal = new bootstrap.Modal(document.getElementById('oppModal'));

            $('#oppForm').on('submit', function (e) {
                e.preventDefault();
                ErpApp.submitForm(this, {
                    modal: oppModal,
                    reloadPage: true
                });
            });
        });

        function deleteOpp(id) {
            ErpApp.confirmDelete({
                url: '/CRM/DeleteOpportunity',
                id: id,
                rowElement: '#row-' + id,
                message: 'Do you want to delete this opportunity?'
            });
        }
    </script>
}

