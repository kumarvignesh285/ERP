@model ERP.ViewModels.Reporting.ReportResultViewModel<object>
@{
    ViewData["Title"] = Model.ReportTitle;
    var currentType = Model.ReportType;
    var filter = Model.Filter;
}

<!-- Print Header -->
<div class="report-print-header">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1 class="company-title">@Model.ActiveCompanyName</h1>
            <h2 class="report-title">@Model.ReportTitle</h2>
            <div class="report-meta">
                Period: @(filter.FromDate?.ToString("dd-MMM-yyyy") ?? "Start") to @(filter.ToDate?.ToString("dd-MMM-yyyy") ?? "Today") | 
                Generated: @DateTime.Now.ToString("dd-MMM-yyyy HH:mm")
            </div>
        </div>
    </div>
</div>

<!-- Page Title -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2 no-print">
    <div>
        <h4 class="m-0 fw-bold text-dark"><i class="fa-solid fa-bag-shopping text-info me-2"></i> @Model.ReportTitle</h4>
        <p class="text-muted small m-0 mt-0.5">@Model.ReportDescription</p>
    </div>
    <div class="d-flex gap-2">
        <a href="@Url.Action("Index", "Reports")" class="btn btn-sm btn-outline-secondary">
            <i class="fa-solid fa-gauge me-1"></i> Dashboard
        </a>
    </div>
</div>

<!-- 12 Sub-Report Navigation Tabs -->
<div class="card border-0 shadow-sm mb-3 no-print report-subnav">
    <div class="card-body p-2">
        <div class="nav nav-pills nav-fill flex-nowrap overflow-auto gap-1">
            <a href="@Url.Action("Purchase", "Reports", new { reportType = "DailyPurchase", DatePreset = filter.DatePreset, FromDate = filter.FromDate, ToDate = filter.ToDate })" 
               class="nav-link fs-8 py-1.5 px-2.5 text-nowrap @(currentType == "DailyPurchase" ? "active" : "")">
                <i class="fa-solid fa-calendar-day me-1"></i> Daily
            </a>
            <a href="@Url.Action("Purchase", "Reports", new { reportType = "MonthlyPurchase", DatePreset = filter.DatePreset, FromDate = filter.FromDate, ToDate = filter.ToDate })" 
               class="nav-link fs-8 py-1.5 px-2.5 text-nowrap @(currentType == "MonthlyPurchase" ? "active" : "")">
                <i class="fa-solid fa-calendar-days me-1"></i> Monthly
            </a>
            <a href="@Url.Action("Purchase", "Reports", new { reportType = "PurchaseRegister", DatePreset = filter.DatePreset, FromDate = filter.FromDate, ToDate = filter.ToDate })" 
               class="nav-link fs-8 py-1.5 px-2.5 text-nowrap @(currentType == "PurchaseRegister" ? "active" : "")">
                <i class="fa-solid fa-book me-1"></i> Register
            </a>
            <a href="@Url.Action("Purchase", "Reports", new { reportType = "SupplierWise", DatePreset = filter.DatePreset, FromDate = filter.FromDate, ToDate = filter.ToDate })" 
               class="nav-link fs-8 py-1.5 px-2.5 text-nowrap @(currentType == "SupplierWise" ? "active" : "")">
                <i class="fa-solid fa-truck me-1"></i> Supplier-wise
            </a>
            <a href="@Url.Action("Purchase", "Reports", new { reportType = "ProductWise", DatePreset = filter.DatePreset, FromDate = filter.FromDate, ToDate = filter.ToDate })" 
               class="nav-link fs-8 py-1.5 px-2.5 text-nowrap @(currentType == "ProductWise" ? "active" : "")">
                <i class="fa-solid fa-box me-1"></i> Product-wise
            </a>
            <a href="@Url.Action("Purchase", "Reports", new { reportType = "PurchaseReturn", DatePreset = filter.DatePreset, FromDate = filter.FromDate, ToDate = filter.ToDate })" 
               class="nav-link fs-8 py-1.5 px-2.5 text-nowrap @(currentType == "PurchaseReturn" ? "active" : "")">
                <i class="fa-solid fa-rotate-left me-1"></i> Returns (Debit Notes)
            </a>
            <a href="@Url.Action("Purchase", "Reports", new { reportType = "PurchaseOrder", DatePreset = filter.DatePreset, FromDate = filter.FromDate, ToDate = filter.ToDate })" 
               class="nav-link fs-8 py-1.5 px-2.5 text-nowrap @(currentType == "PurchaseOrder" ? "active" : "")">
                <i class="fa-solid fa-file-lines me-1"></i> Orders (PO)
            </a>
            <a href="@Url.Action("Purchase", "Reports", new { reportType = "PendingPO", DatePreset = filter.DatePreset, FromDate = filter.FromDate, ToDate = filter.ToDate })" 
               class="nav-link fs-8 py-1.5 px-2.5 text-nowrap @(currentType == "PendingPO" ? "active text-warning" : "")">
                <i class="fa-solid fa-clock me-1"></i> Pending POs
            </a>
            <a href="@Url.Action("Purchase", "Reports", new { reportType = "GoodsReceipt", DatePreset = filter.DatePreset, FromDate = filter.FromDate, ToDate = filter.ToDate })" 
               class="nav-link fs-8 py-1.5 px-2.5 text-nowrap @(currentType == "GoodsReceipt" ? "active" : "")">
                <i class="fa-solid fa-truck-ramp-box me-1"></i> GRN Report
            </a>
            <a href="@Url.Action("Purchase", "Reports", new { reportType = "PurchasePayment", DatePreset = filter.DatePreset, FromDate = filter.FromDate, ToDate = filter.ToDate })" 
               class="nav-link fs-8 py-1.5 px-2.5 text-nowrap @(currentType == "PurchasePayment" ? "active" : "")">
                <i class="fa-solid fa-credit-card me-1"></i> Payments
            </a>
            <a href="@Url.Action("Purchase", "Reports", new { reportType = "PriceHistory", DatePreset = filter.DatePreset, FromDate = filter.FromDate, ToDate = filter.ToDate })" 
               class="nav-link fs-8 py-1.5 px-2.5 text-nowrap @(currentType == "PriceHistory" ? "active" : "")">
                <i class="fa-solid fa-chart-line me-1"></i> Price History
            </a>
            <a href="@Url.Action("Purchase", "Reports", new { reportType = "PurchaseTax", DatePreset = filter.DatePreset, FromDate = filter.FromDate, ToDate = filter.ToDate })" 
               class="nav-link fs-8 py-1.5 px-2.5 text-nowrap @(currentType == "PurchaseTax" ? "active" : "")">
                <i class="fa-solid fa-percent me-1"></i> Tax Summary (ITC)
            </a>
        </div>
    </div>
</div>

<!-- Filter Bar -->
<partial name="_ReportFilterBar" model="filter" />

<!-- Summary Metric Cards -->
@if (Model.SummaryCards.Any())
{
    <div class="row g-3 mb-4 report-summary-cards">
        @foreach (var card in Model.SummaryCards)
        {
            <div class="col-6 col-md-4 col-xl-2">
                <div class="card border-0 shadow-sm bg-@card.ColorClass bg-opacity-10 h-100">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="text-muted fs-8 fw-bold text-uppercase">@card.Title</span>
                            <i class="fa-solid @card.Icon text-@card.ColorClass fs-6"></i>
                        </div>
                        <h4 class="fw-bold text-@card.ColorClass m-0">@card.Value</h4>
                        @if (!string.IsNullOrEmpty(card.Subtitle))
                        {
                            <span class="text-muted fs-9">@card.Subtitle</span>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}

<!-- Data Table Card -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-transparent border-0 pt-3 px-3 d-flex justify-content-between align-items-center">
        <h6 class="fw-bold m-0 text-dark">
            <i class="fa-solid fa-table-list text-info me-1.5"></i> @Model.ReportTitle Data Table
        </h6>
        <span class="badge bg-light text-muted border fs-8">@Model.TotalRecords Records</span>
    </div>
    <div class="card-body p-3">
        <div class="table-responsive">
            @if (currentType == "DailyPurchase")
            {
                <table class="table table-hover align-middle datatable w-100 fs-8">
                    <thead class="bg-light">
                        <tr>
                            <th>Date</th>
                            <th class="text-center">Bills</th>
                            <th class="text-end">Gross Purchases</th>
                            <th class="text-end">Discounts</th>
                            <th class="text-end">Input Tax</th>
                            <th class="text-end">Net Purchases</th>
                            <th class="text-end">Paid Amount</th>
                            <th class="text-end">Balance Payable</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Data.Cast<ERP.ViewModels.Reporting.DailyPurchaseDto>())
                        {
                            <tr>
                                <td class="fw-semibold">@row.DateDisplay</td>
                                <td class="text-center">@row.BillCount</td>
                                <td class="text-end">₹@row.GrossPurchase.ToString("N2")</td>
                                <td class="text-end text-danger">₹@row.DiscountAmount.ToString("N2")</td>
                                <td class="text-end text-success">₹@row.TaxAmount.ToString("N2")</td>
                                <td class="text-end fw-bold text-info">₹@row.NetPurchase.ToString("N2")</td>
                                <td class="text-end fw-bold text-success">₹@row.PaidAmount.ToString("N2")</td>
                                <td class="text-end fw-bold @(row.BalanceAmount > 0 ? "text-danger" : "text-muted")">₹@row.BalanceAmount.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else if (currentType == "PurchaseRegister")
            {
                <table class="table table-hover align-middle datatable w-100 fs-8">
                    <thead class="bg-light">
                        <tr>
                            <th>Bill #</th>
                            <th>Date</th>
                            <th>Supplier</th>
                            <th>GSTIN</th>
                            <th>Ref #</th>
                            <th class="text-end">SubTotal</th>
                            <th class="text-end">Tax (ITC)</th>
                            <th class="text-end">Grand Total</th>
                            <th class="text-end">Paid</th>
                            <th class="text-end">Balance</th>
                            <th class="text-center">Status</th>
                            <th class="text-center no-print">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Data.Cast<ERP.ViewModels.Reporting.PurchaseRegisterDto>())
                        {
                            <tr>
                                <td>
                                    <a href="/Purchase/Invoice" class="fw-bold text-info text-decoration-none">
                                        @row.InvoiceNumber
                                    </a>
                                </td>
                                <td>@row.InvoiceDate.ToString("dd-MMM-yyyy")</td>
                                <td class="fw-semibold">@row.SupplierName</td>
                                <td class="text-muted font-monospace fs-9">@(row.GSTNumber ?? "-")</td>
                                <td>@(row.ReferenceNumber ?? "-")</td>
                                <td class="text-end">₹@row.SubTotal.ToString("N2")</td>
                                <td class="text-end text-success">₹@row.TaxAmount.ToString("N2")</td>
                                <td class="text-end fw-bold text-dark">₹@row.GrandTotal.ToString("N2")</td>
                                <td class="text-end text-success">₹@row.PaidAmount.ToString("N2")</td>
                                <td class="text-end fw-bold @(row.BalanceAmount > 0 ? "text-danger" : "text-muted")">₹@row.BalanceAmount.ToString("N2")</td>
                                <td class="text-center">
                                    <span class="badge @(row.Status == "Paid" || row.Status == "Completed" ? "bg-success" : row.Status == "Draft" ? "bg-secondary" : "bg-warning text-dark") rounded-pill">
                                        @row.Status
                                    </span>
                                </td>
                                <td class="text-center no-print">
                                    <a href="/Purchase/Invoice" class="btn btn-xs btn-outline-info" title="Drill-down to Purchase Screen">
                                        <i class="fa-solid fa-arrow-up-right-from-square"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else if (currentType == "SupplierWise")
            {
                <table class="table table-hover align-middle datatable w-100 fs-8">
                    <thead class="bg-light">
                        <tr>
                            <th>Code</th>
                            <th>Supplier Name</th>
                            <th>Mobile</th>
                            <th>City</th>
                            <th class="text-center">Bills</th>
                            <th class="text-end">Total Procurement</th>
                            <th class="text-end">Paid Amount</th>
                            <th class="text-end">Outstanding Payable</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model.Data.Cast<ERP.ViewModels.Reporting.SupplierWisePurchaseDto>())
                        {
                            <tr>
                                <td class="font-monospace text-muted">@s.SupplierCode</td>
                                <td class="fw-bold text-dark">@s.SupplierName</td>
                                <td>@(s.Mobile ?? "-")</td>
                                <td>@(s.City ?? "-")</td>
                                <td class="text-center">@s.BillCount</td>
                                <td class="text-end fw-bold text-info">₹@s.TotalPurchaseAmount.ToString("N2")</td>
                                <td class="text-end text-success">₹@s.PaidAmount.ToString("N2")</td>
                                <td class="text-end fw-bold @(s.BalanceAmount > 0 ? "text-danger" : "text-muted")">₹@s.BalanceAmount.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else if (currentType == "ProductWise")
            {
                <table class="table table-hover align-middle datatable w-100 fs-8">
                    <thead class="bg-light">
                        <tr>
                            <th>Code</th>
                            <th>Product Name</th>
                            <th>Category</th>
                            <th class="text-end">Quantity Procured</th>
                            <th class="text-end">Avg Cost Rate</th>
                            <th class="text-end">Input Tax</th>
                            <th class="text-end">Total Spend</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.Data.Cast<ERP.ViewModels.Reporting.ProductWisePurchaseDto>())
                        {
                            <tr>
                                <td class="font-monospace text-muted">@p.ProductCode</td>
                                <td class="fw-bold text-dark">@p.ProductName</td>
                                <td><span class="badge bg-light text-secondary border">@p.CategoryName</span></td>
                                <td class="text-end fw-semibold">@p.QuantityPurchased.ToString("N2") @p.UnitName</td>
                                <td class="text-end">₹@p.AverageRate.ToString("N2")</td>
                                <td class="text-end text-success">₹@p.TotalTaxAmount.ToString("N2")</td>
                                <td class="text-end fw-bold text-info">₹@p.TotalPurchaseAmount.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else if (currentType == "PurchaseReturn")
            {
                <table class="table table-hover align-middle datatable w-100 fs-8">
                    <thead class="bg-light">
                        <tr>
                            <th>Debit Note #</th>
                            <th>Date</th>
                            <th>Supplier</th>
                            <th>Original Invoice</th>
                            <th>Reason</th>
                            <th class="text-end">SubTotal</th>
                            <th class="text-end">Tax Reversed</th>
                            <th class="text-end">Debit Total</th>
                            <th class="text-center">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.Data.Cast<ERP.ViewModels.Reporting.PurchaseReturnReportDto>())
                        {
                            <tr>
                                <td class="fw-bold text-danger">@r.ReturnNumber</td>
                                <td>@r.ReturnDate.ToString("dd-MMM-yyyy")</td>
                                <td class="fw-semibold">@r.SupplierName</td>
                                <td>@(r.OriginalInvoiceNumber ?? "-")</td>
                                <td>@(r.Reason ?? "-")</td>
                                <td class="text-end">₹@r.SubTotal.ToString("N2")</td>
                                <td class="text-end">₹@r.TaxAmount.ToString("N2")</td>
                                <td class="text-end fw-bold text-danger">₹@r.GrandTotal.ToString("N2")</td>
                                <td class="text-center"><span class="badge bg-secondary rounded-pill">@r.Status</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else if (currentType == "PurchaseOrder" || currentType == "PendingPO")
            {
                <table class="table table-hover align-middle datatable w-100 fs-8">
                    <thead class="bg-light">
                        <tr>
                            <th>PO #</th>
                            <th>Order Date</th>
                            <th>Delivery Due</th>
                            <th>Supplier</th>
                            <th>Ref #</th>
                            <th class="text-end">Order Value</th>
                            <th class="text-center">Status</th>
                            <th class="text-center no-print">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var po in Model.Data.Cast<ERP.ViewModels.Reporting.PurchaseOrderReportDto>())
                        {
                            <tr>
                                <td class="fw-bold">@po.OrderNumber</td>
                                <td>@po.OrderDate.ToString("dd-MMM-yyyy")</td>
                                <td>@(po.ExpectedDeliveryDate?.ToString("dd-MMM-yyyy") ?? "-")</td>
                                <td class="fw-semibold">@po.SupplierName</td>
                                <td>@(po.ReferenceNumber ?? "-")</td>
                                <td class="text-end fw-bold text-primary">₹@po.GrandTotal.ToString("N2")</td>
                                <td class="text-center">
                                    <span class="badge @(po.Status == "Completed" ? "bg-success" : po.Status == "Pending" ? "bg-warning text-dark" : "bg-secondary") rounded-pill">
                                        @po.Status
                                    </span>
                                </td>
                                <td class="text-center no-print">
                                    <a href="/Purchase/Order" class="btn btn-xs btn-outline-primary" title="Drill-down to PO">
                                        <i class="fa-solid fa-arrow-up-right-from-square"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else if (currentType == "GoodsReceipt")
            {
                <table class="table table-hover align-middle datatable w-100 fs-8">
                    <thead class="bg-light">
                        <tr>
                            <th>GRN #</th>
                            <th>GRN Date</th>
                            <th>Supplier</th>
                            <th>PO Reference</th>
                            <th>Challan #</th>
                            <th class="text-end">Value</th>
                            <th class="text-center">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var grn in Model.Data.Cast<ERP.ViewModels.Reporting.GoodsReceiptReportDto>())
                        {
                            <tr>
                                <td class="fw-bold text-info">@grn.GrnNumber</td>
                                <td>@grn.GrnDate.ToString("dd-MMM-yyyy")</td>
                                <td class="fw-semibold">@grn.SupplierName</td>
                                <td>@(grn.PurchaseOrderNumber ?? "-")</td>
                                <td>@(grn.ChallanNumber ?? "-")</td>
                                <td class="text-end fw-bold">₹@grn.GrandTotal.ToString("N2")</td>
                                <td class="text-center"><span class="badge bg-secondary rounded-pill">@grn.Status</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else if (currentType == "PriceHistory")
            {
                <table class="table table-hover align-middle datatable w-100 fs-8">
                    <thead class="bg-light">
                        <tr>
                            <th>Product Code</th>
                            <th>Product Name</th>
                            <th>Invoice Date</th>
                            <th>Supplier</th>
                            <th>Invoice #</th>
                            <th class="text-end">Qty Procured</th>
                            <th class="text-end">Purchase Rate (Unit Cost)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ph in Model.Data.Cast<ERP.ViewModels.Reporting.PurchasePriceHistoryDto>())
                        {
                            <tr>
                                <td class="font-monospace text-muted">@ph.ProductCode</td>
                                <td class="fw-bold">@ph.ProductName</td>
                                <td>@ph.InvoiceDate.ToString("dd-MMM-yyyy")</td>
                                <td>@ph.SupplierName</td>
                                <td>@ph.InvoiceNumber</td>
                                <td class="text-end">@ph.Quantity.ToString("N2")</td>
                                <td class="text-end fw-bold text-success">₹@ph.PurchaseRate.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <!-- Generic fallback for PurchaseTax, PurchasePayment, etc. -->
                <table class="table table-hover align-middle datatable w-100 fs-8">
                    <thead class="bg-light">
                        <tr>
                            @if (currentType == "PurchaseTax")
                            {
                                <th class="text-center">Tax Slab %</th>
                                <th class="text-end">Taxable Value</th>
                                <th class="text-end">CGST (ITC)</th>
                                <th class="text-end">SGST (ITC)</th>
                                <th class="text-end">IGST (ITC)</th>
                                <th class="text-end">Total ITC Available</th>
                            }
                            else if (currentType == "PurchasePayment")
                            {
                                <th>Bill #</th>
                                <th>Date</th>
                                <th>Supplier</th>
                                <th class="text-end">Grand Total</th>
                                <th class="text-end">Paid Amount</th>
                                <th class="text-end">Balance Payable</th>
                                <th class="text-center">Payment Status</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @if (currentType == "PurchaseTax")
                        {
                            foreach (var pt in Model.Data.Cast<ERP.ViewModels.Reporting.PurchaseTaxSummaryDto>())
                            {
                                <tr>
                                    <td class="text-center fw-bold"><span class="badge bg-light text-dark border">@pt.TaxPercentage.ToString("N0")%</span></td>
                                    <td class="text-end">₹@pt.TaxableAmount.ToString("N2")</td>
                                    <td class="text-end text-success">₹@pt.CGSTAmount.ToString("N2")</td>
                                    <td class="text-end text-success">₹@pt.SGSTAmount.ToString("N2")</td>
                                    <td class="text-end text-success">₹@pt.IGSTAmount.ToString("N2")</td>
                                    <td class="text-end fw-bold text-success">₹@pt.TotalTaxAmount.ToString("N2")</td>
                                </tr>
                            }
                        }
                        else if (currentType == "PurchasePayment")
                        {
                            foreach (var pp in Model.Data.Cast<ERP.ViewModels.Reporting.PurchasePaymentReportDto>())
                            {
                                <tr>
                                    <td class="fw-semibold">@pp.InvoiceNumber</td>
                                    <td>@pp.InvoiceDate.ToString("dd-MMM-yyyy")</td>
                                    <td>@pp.SupplierName</td>
                                    <td class="text-end">₹@pp.GrandTotal.ToString("N2")</td>
                                    <td class="text-end fw-bold text-success">₹@pp.PaidAmount.ToString("N2")</td>
                                    <td class="text-end @(pp.BalanceAmount > 0 ? "text-danger" : "text-muted")">₹@pp.BalanceAmount.ToString("N2")</td>
                                    <td class="text-center">
                                        <span class="badge @(pp.PaymentStatus == "Fully Paid" ? "bg-success" : pp.PaymentStatus == "Partially Paid" ? "bg-warning text-dark" : "bg-danger") rounded-pill">
                                            @pp.PaymentStatus
                                        </span>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>
