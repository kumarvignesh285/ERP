@model ERP.ViewModels.Reporting.ReportResultViewModel<object>
@{
    ViewData["Title"] = Model.ReportTitle;
    var currentType = Model.ReportType;
    var filter = Model.Filter;
}

<!-- Print-Only Header -->
<div class="report-print-header">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1 class="company-title">@Model.ActiveCompanyName</h1>
            <h2 class="report-title">@Model.ReportTitle</h2>
            <div class="report-meta">
                Period: @(filter.FromDate?.ToString("dd-MMM-yyyy") ?? "Start") to @(filter.ToDate?.ToString("dd-MMM-yyyy") ?? "Today") | 
                Generated: @DateTime.Now.ToString("dd-MMM-yyyy HH:mm")
            </div>
        </div>
    </div>
</div>

<!-- Header -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2 no-print">
    <div>
        <h4 class="m-0 fw-bold text-dark"><i class="fa-solid fa-shield-halved text-primary me-2"></i> @Model.ReportTitle</h4>
        <p class="text-muted small m-0 mt-0.5">@Model.ReportDescription</p>
    </div>
    <div class="d-flex gap-2">
        <a href="@Url.Action("Index", "Reports")" class="btn btn-sm btn-outline-secondary">
            <i class="fa-solid fa-gauge me-1"></i> Dashboard
        </a>
    </div>
</div>

<!-- 7 Audit Sub-Report Navigation Tabs -->
<div class="card border-0 shadow-sm mb-3 no-print report-subnav">
    <div class="card-body p-2">
        <div class="nav nav-pills nav-fill flex-nowrap overflow-auto gap-1">
            <a href="@Url.Action("Audit", "Reports", new { reportType = "AuditTrail", DatePreset = filter.DatePreset, FromDate = filter.FromDate, ToDate = filter.ToDate })" 
               class="nav-link fs-8 py-1.5 px-2.5 text-nowrap @(currentType == "AuditTrail" ? "active" : "")">
                <i class="fa-solid fa-list-check me-1"></i> Audit Trail
            </a>
            <a href="@Url.Action("Audit", "Reports", new { reportType = "EmployeeSales", DatePreset = filter.DatePreset, FromDate = filter.FromDate, ToDate = filter.ToDate })" 
               class="nav-link fs-8 py-1.5 px-2.5 text-nowrap @(currentType == "EmployeeSales" ? "active" : "")">
                <i class="fa-solid fa-user-tie me-1"></i> Staff Sales
            </a>
            <a href="@Url.Action("Audit", "Reports", new { reportType = "LoginHistory", DatePreset = filter.DatePreset, FromDate = filter.FromDate, ToDate = filter.ToDate })" 
               class="nav-link fs-8 py-1.5 px-2.5 text-nowrap @(currentType == "LoginHistory" ? "active" : "")">
                <i class="fa-solid fa-right-to-bracket me-1"></i> Logins
            </a>
            <a href="@Url.Action("Audit", "Reports", new { reportType = "UserActivity", DatePreset = filter.DatePreset, FromDate = filter.FromDate, ToDate = filter.ToDate })" 
               class="nav-link fs-8 py-1.5 px-2.5 text-nowrap @(currentType == "UserActivity" ? "active" : "")">
                <i class="fa-solid fa-shoe-prints me-1"></i> User Activity
            </a>
            <a href="@Url.Action("Audit", "Reports", new { reportType = "BillModifications", DatePreset = filter.DatePreset, FromDate = filter.FromDate, ToDate = filter.ToDate })" 
               class="nav-link fs-8 py-1.5 px-2.5 text-nowrap @(currentType == "BillModifications" ? "active" : "")">
                <i class="fa-solid fa-pen-to-square me-1"></i> Bill Modifications
            </a>
            <a href="@Url.Action("Audit", "Reports", new { reportType = "DeletedTransactions", DatePreset = filter.DatePreset, FromDate = filter.FromDate, ToDate = filter.ToDate })" 
               class="nav-link fs-8 py-1.5 px-2.5 text-nowrap @(currentType == "DeletedTransactions" ? "active" : "")">
                <i class="fa-solid fa-trash-can me-1 text-danger"></i> Voided / Deleted
            </a>
            <a href="@Url.Action("Audit", "Reports", new { reportType = "CashierSales", DatePreset = filter.DatePreset, FromDate = filter.FromDate, ToDate = filter.ToDate })" 
               class="nav-link fs-8 py-1.5 px-2.5 text-nowrap @(currentType == "CashierSales" ? "active" : "")">
                <i class="fa-solid fa-cash-register me-1"></i> Cashier Billing
            </a>
        </div>
    </div>
</div>

<!-- Filter Bar -->
<partial name="_ReportFilterBar" model="filter" />

<!-- Summary Metric Cards -->
@if (Model.SummaryCards.Any())
{
    <div class="row g-3 mb-4 report-summary-cards">
        @foreach (var card in Model.SummaryCards)
        {
            <div class="col-6 col-md-4 col-xl-2">
                <div class="card border-0 shadow-sm bg-@card.ColorClass bg-opacity-10 h-100">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="text-muted fs-8 fw-bold text-uppercase">@card.Title</span>
                            <i class="fa-solid @card.Icon text-@card.ColorClass fs-6"></i>
                        </div>
                        <h4 class="fw-bold text-@card.ColorClass m-0">@card.Value</h4>
                        @if (!string.IsNullOrEmpty(card.Subtitle))
                        {
                            <span class="text-muted fs-9">@card.Subtitle</span>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}

<!-- Data Table Card -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-transparent border-0 pt-3 px-3 d-flex justify-content-between align-items-center">
        <h6 class="fw-bold m-0 text-dark">
            <i class="fa-solid fa-table-list text-primary me-1.5"></i> @Model.ReportTitle Data Table
        </h6>
        <span class="badge bg-light text-muted border fs-8">@Model.TotalRecords Records</span>
    </div>
    <div class="card-body p-3">
        <div class="table-responsive">
            @if (currentType == "AuditTrail" || currentType == "BillModifications" || currentType == "DeletedTransactions")
            {
                <table class="table table-hover align-middle datatable w-100 fs-8">
                    <thead class="bg-light">
                        <tr>
                            <th>Timestamp</th>
                            <th>User</th>
                            <th>Action</th>
                            <th>Module</th>
                            <th>Entity</th>
                            <th>Description</th>
                            <th>IP Address</th>
                            <th class="text-center">Severity</th>
                            <th class="text-center">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Data.Cast<ERP.ViewModels.Reporting.AuditTrailReportDto>())
                        {
                            <tr>
                                <td class="text-nowrap fw-semibold">@row.Timestamp.ToString("dd-MMM-yyyy HH:mm:ss")</td>
                                <td class="fw-bold text-primary">@row.UserName</td>
                                <td>
                                    <span class="badge bg-@(row.Action == "Create" ? "success" : row.Action == "Update" ? "warning text-dark" : row.Action == "Delete" ? "danger" : "light text-dark border")">
                                        @row.Action
                                    </span>
                                </td>
                                <td><span class="badge bg-light text-dark border">@row.Module</span></td>
                                <td>@(row.EntityName ?? "-") @(string.IsNullOrEmpty(row.EntityId) ? "" : $"#{row.EntityId}")</td>
                                <td class="text-muted text-break" style="max-width: 250px;">@(row.Description ?? "-")</td>
                                <td><span class="font-monospace text-muted">@(row.IpAddress ?? "-")</span></td>
                                <td class="text-center">
                                    <span class="badge bg-@(row.Severity == "Critical" || row.Severity == "High" ? "danger" : row.Severity == "Medium" ? "warning text-dark" : "info")">
                                        @row.Severity
                                    </span>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-@(row.Status == "Success" ? "success" : "danger")">
                                        @row.Status
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else if (currentType == "EmployeeSales" || currentType == "CashierSales")
            {
                <table class="table table-hover align-middle datatable w-100 fs-8">
                    <thead class="bg-light">
                        <tr>
                            <th>Code</th>
                            <th>Employee / Staff Name</th>
                            <th>Designation</th>
                            <th class="text-center">Invoices Handled</th>
                            <th class="text-end">Total Billed Revenue</th>
                            <th class="text-end">Average Ticket Value</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Data.Cast<ERP.ViewModels.Reporting.EmployeeSalesReportDto>())
                        {
                            <tr>
                                <td class="fw-bold">@row.EmployeeCode</td>
                                <td class="fw-semibold">@row.EmployeeName</td>
                                <td>@(row.Designation ?? "Sales Executive")</td>
                                <td class="text-center"><span class="badge bg-light text-dark border">@row.InvoiceCount</span></td>
                                <td class="text-end fw-bold text-primary">₹@row.TotalSalesAmount.ToString("N2")</td>
                                <td class="text-end fw-semibold text-success">₹@row.AverageInvoiceValue.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else if (currentType == "LoginHistory")
            {
                <table class="table table-hover align-middle datatable w-100 fs-8">
                    <thead class="bg-light">
                        <tr>
                            <th>Login Time</th>
                            <th>Username</th>
                            <th>Assigned Role</th>
                            <th>IP Address</th>
                            <th>Browser</th>
                            <th>Operating System</th>
                            <th>Device</th>
                            <th class="text-center">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Data.Cast<ERP.ViewModels.Reporting.LoginHistoryReportDto>())
                        {
                            <tr>
                                <td class="fw-semibold">@row.LoginTime.ToString("dd-MMM-yyyy HH:mm:ss")</td>
                                <td class="fw-bold text-primary">@row.Username</td>
                                <td><span class="badge bg-light text-dark border">@(row.Role ?? "User")</span></td>
                                <td><span class="font-monospace">@(row.IPAddress ?? "-")</span></td>
                                <td>@(row.Browser ?? "-")</td>
                                <td>@(row.OperatingSystem ?? "-")</td>
                                <td>@(row.Device ?? "-")</td>
                                <td class="text-center">
                                    <span class="badge bg-@(row.Status == "Success" ? "success" : "danger")">
                                        @row.Status
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else if (currentType == "UserActivity")
            {
                <table class="table table-hover align-middle datatable w-100 fs-8">
                    <thead class="bg-light">
                        <tr>
                            <th>Timestamp</th>
                            <th>Username</th>
                            <th>Role</th>
                            <th>Activity Type</th>
                            <th>Description</th>
                            <th>IP Address</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Data.Cast<ERP.ViewModels.Reporting.UserActivityReportDto>())
                        {
                            <tr>
                                <td class="fw-semibold">@row.Timestamp.ToString("dd-MMM-yyyy HH:mm:ss")</td>
                                <td class="fw-bold text-primary">@row.Username</td>
                                <td><span class="badge bg-light text-dark border">@(row.Role ?? "User")</span></td>
                                <td><span class="badge bg-info bg-opacity-10 text-info border">@row.ActivityType</span></td>
                                <td>@(row.Description ?? "-")</td>
                                <td><span class="font-monospace text-muted">@(row.IPAddress ?? "-")</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            if ($('.datatable').length) {
                $('.datatable').DataTable({
                    responsive: true,
                    pageLength: 25,
                    order: [],
                    language: {
                        search: "_INPUT_",
                        searchPlaceholder: "Search records..."
                    }
                });
            }
        });
    </script>
}
