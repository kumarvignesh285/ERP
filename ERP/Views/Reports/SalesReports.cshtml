@model IEnumerable<ERP.Models.SalesInvoice>
@{
    ViewData["Title"] = "Sales Reports";
}

<!-- Filters Row -->
<div class="card mb-3 no-print">
    <div class="card-body p-3">
        <div class="row g-2 align-items-center">
            <div class="col-md-3">
                <label class="form-label font-weight-semibold mb-1 small text-muted">From Date</label>
                <input type="date" id="filterFromDate" class="form-control form-control-sm" />
            </div>
            <div class="col-md-3">
                <label class="form-label font-weight-semibold mb-1 small text-muted">To Date</label>
                <input type="date" id="filterToDate" class="form-control form-control-sm" />
            </div>
            <div class="col-md-3">
                <label class="form-label font-weight-semibold mb-1 small text-muted">Status</label>
                <select id="filterStatus" class="form-select form-select-sm">
                    <option value="">All Statuses</option>
                    @foreach (var s in Model.Where(p => !string.IsNullOrEmpty(p.Status)).Select(p => p.Status).Distinct())
                    {
                        <option value="@s">@s</option>
                    }
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2 align-self-end">
                <button class="btn btn-sm btn-primary w-100" onclick="applyFilters()"><i class="fa-solid fa-filter me-1"></i> Filter</button>
                <button class="btn btn-sm btn-outline-secondary w-100" onclick="resetFilters()"><i class="fa-solid fa-rotate me-1"></i> Reset</button>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <h5 class="m-0"><i class="fa-solid fa-chart-bar me-2"></i> Sales Reports</h5>
        <button class="btn btn-light btn-sm" onclick="window.print()"><i class="fa-solid fa-print me-1"></i> Print</button>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover datatable align-middle">
                <thead>
                    <tr>
                        <th>Invoice No</th>
                        <th>Date</th>
                        <th>Customer</th>
                        <th>Status</th>
                        <th class="text-end">Total Amount</th>
                    </tr>
                </thead>
                <tbody>
                    @if(Model != null)
                    {
                        foreach(var item in Model)
                        {
                            <tr>
                                <td class="font-weight-bold">@item.InvoiceNumber</td>
                                <td>@item.InvoiceDate.ToString("dd-MM-yyyy")</td>
                                <td>@(item.Customer?.CustomerName ?? "Cash Customer")</td>
                                <td><span class="badge bg-success">@item.Status</span></td>
                                <td class="text-end font-weight-semibold">₹@item.GrandTotal.ToString("N2")</td>
                            </tr>
                        }
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <th colspan="4" class="text-end font-weight-bold">Grand Total:</th>
                        <th class="text-end font-weight-bold text-primary">₹@(Model?.Sum(x => x.GrandTotal).ToString("N2") ?? "0.00")</th>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>
