@model IEnumerable<ERP.Models.PurchaseInvoice>
@{
    ViewData["Title"] = "Purchase Reports";
}

<div class="card">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <h5 class="m-0"><i class="fa-solid fa-file-invoice me-2"></i> Purchase Reports</h5>
        <button class="btn btn-light btn-sm" onclick="window.print()"><i class="fa-solid fa-print me-1"></i> Print</button>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover datatable align-middle">
                <thead>
                    <tr>
                        <th>Invoice No</th>
                        <th>Date</th>
                        <th>Supplier</th>
                        <th>Status</th>
                        <th class="text-end">Total Amount</th>
                    </tr>
                </thead>
                <tbody>
                    @if(Model != null)
                    {
                        foreach(var item in Model)
                        {
                            <tr>
                                <td class="font-weight-bold">@item.InvoiceNumber</td>
                                <td>@item.InvoiceDate.ToString("dd-MM-yyyy")</td>
                                <td>@(item.Supplier?.SupplierName)</td>
                                <td><span class="badge bg-primary">@item.Status</span></td>
                                <td class="text-end font-weight-semibold">₹@item.GrandTotal.ToString("N2")</td>
                            </tr>
                        }
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <th colspan="4" class="text-end font-weight-bold">Grand Total:</th>
                        <th class="text-end font-weight-bold text-primary">₹@(Model?.Sum(x => x.GrandTotal).ToString("N2") ?? "0.00")</th>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>
