@model IEnumerable<ERP.Models.PurchaseInvoice>
@{
    ViewData["Title"] = "Purchase Reports";
    var totalInvoices = Model?.Count() ?? 0;
    var totalSpent = Model?.Sum(x => x.GrandTotal) ?? 0m;
    var activeSuppliers = Model?.Where(x => x.Supplier != null).Select(x => x.SupplierId).Distinct().Count() ?? 0;
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h4 class="m-0 fw-bold text-primary"><i class="fa-solid fa-file-invoice me-2"></i> Purchase Reports & Procurement</h4>
        <p class="text-muted small m-0 mt-1">Track supplier purchases, procurement costs, and purchase invoice history</p>
    </div>
    <div class="d-flex gap-2 no-print">
        <button class="btn btn-outline-secondary shadow-sm" onclick="window.print()"><i class="fa-solid fa-print me-1.5"></i> Print Report</button>
        <button class="btn btn-outline-success shadow-sm" onclick="alert('Exporting to Excel...')"><i class="fa-solid fa-file-excel me-1.5"></i> Export Excel</button>
    </div>
</div>

<!-- Summary KPI Cards -->
<div class="row g-3 mb-4 no-print">
    <div class="col-12 col-sm-6 col-md-4">
        <div class="card border-0 shadow-sm bg-primary bg-opacity-10 h-100">
            <div class="card-body p-3 d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Purchase Orders</span>
                    <h3 class="m-0 fw-bold text-primary mt-1">@totalInvoices</h3>
                </div>
                <div class="avatar bg-primary text-white rounded-3 p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                    <i class="fa-solid fa-cart-shopping fs-5"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-md-4">
        <div class="card border-0 shadow-sm bg-danger bg-opacity-10 h-100">
            <div class="card-body p-3 d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Total Procurement Cost</span>
                    <h3 class="m-0 fw-bold text-danger mt-1">₹@totalSpent.ToString("N2")</h3>
                </div>
                <div class="avatar bg-danger text-white rounded-3 p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                    <i class="fa-solid fa-hand-holding-dollar fs-5"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-md-4">
        <div class="card border-0 shadow-sm bg-info bg-opacity-10 h-100">
            <div class="card-body p-3 d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Active Suppliers</span>
                    <h3 class="m-0 fw-bold text-info mt-1">@activeSuppliers</h3>
                </div>
                <div class="avatar bg-info text-white rounded-3 p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                    <i class="fa-solid fa-truck-field fs-5"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Filters Panel -->
<div class="card mb-4 no-print shadow-sm border-0">
    <div class="card-body p-3">
        <div class="row g-3 align-items-center">
            <div class="col-12 col-sm-6 col-md-3">
                <label class="form-label fw-semibold mb-1 small text-muted">From Date</label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light border-end-0"><i class="fa-regular fa-calendar text-muted"></i></span>
                    <input type="date" id="filterFromDate" class="form-control border-start-0" />
                </div>
            </div>
            <div class="col-12 col-sm-6 col-md-3">
                <label class="form-label fw-semibold mb-1 small text-muted">To Date</label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light border-end-0"><i class="fa-regular fa-calendar text-muted"></i></span>
                    <input type="date" id="filterToDate" class="form-control border-start-0" />
                </div>
            </div>
            <div class="col-12 col-sm-6 col-md-3">
                <label class="form-label fw-semibold mb-1 small text-muted">Status</label>
                <select id="filterStatus" class="form-select form-select-sm">
                    <option value="">All Statuses</option>
                    @if (Model != null)
                    {
                        foreach (var s in Model.Where(p => !string.IsNullOrEmpty(p.Status)).Select(p => p.Status).Distinct())
                        {
                            <option value="@s">@s</option>
                        }
                    }
                </select>
            </div>
            <div class="col-12 col-sm-6 col-md-3 d-flex gap-2 align-self-end">
                <button class="btn btn-sm btn-primary w-100 shadow-sm" onclick="applyFilters()"><i class="fa-solid fa-filter me-1"></i> Filter</button>
                <button class="btn btn-sm btn-outline-secondary w-100" onclick="resetFilters()"><i class="fa-solid fa-rotate me-1"></i> Reset</button>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive" style="max-height: 600px;">
            <table class="table table-hover datatable align-middle mb-0">
                <thead class="table-light text-uppercase fs-8 fw-bold text-muted sticky-top">
                    <tr>
                        <th class="ps-4">Invoice No</th>
                        <th>Date</th>
                        <th>Supplier Name</th>
                        <th>Status</th>
                        <th class="text-end pe-4">Total Amount</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null)
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-primary">@item.InvoiceNumber</td>
                                <td>@item.InvoiceDate.ToString("dd-MM-yyyy")</td>
                                <td class="fw-semibold text-dark">@(item.Supplier?.SupplierName)</td>
                                <td>
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle fw-semibold">
                                        <i class="fa-solid fa-circle-check me-1"></i>@item.Status
                                    </span>
                                </td>
                                <td class="text-end pe-4 fw-bold text-dark">₹@item.GrandTotal.ToString("N2")</td>
                            </tr>
                        }
                    }
                </tbody>
                <tfoot class="table-light border-top">
                    <tr class="fw-bold fs-7">
                        <td colspan="4" class="text-end ps-4">Grand Total:</td>
                        <td class="text-end pe-4 text-primary fs-6">₹@(Model?.Sum(x => x.GrandTotal).ToString("N2") ?? "0.00")</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>
