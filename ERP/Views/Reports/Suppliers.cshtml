@model ERP.ViewModels.Reporting.ReportResultViewModel<object>
@{
    ViewData["Title"] = Model.ReportTitle;
    var currentType = Model.ReportType;
    var filter = Model.Filter;
}

<!-- Print-Only Header -->
<div class="report-print-header">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1 class="company-title">@Model.ActiveCompanyName</h1>
            <h2 class="report-title">@Model.ReportTitle</h2>
            <div class="report-meta">
                Period: @(filter.FromDate?.ToString("dd-MMM-yyyy") ?? "Start") to @(filter.ToDate?.ToString("dd-MMM-yyyy") ?? "Today") | 
                Generated: @DateTime.Now.ToString("dd-MMM-yyyy HH:mm")
            </div>
        </div>
    </div>
</div>

<!-- Header -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2 no-print">
    <div>
        <h4 class="m-0 fw-bold text-dark"><i class="fa-solid fa-truck-field text-primary me-2"></i> @Model.ReportTitle</h4>
        <p class="text-muted small m-0 mt-0.5">@Model.ReportDescription</p>
    </div>
    <div class="d-flex gap-2">
        <a href="@Url.Action("Index", "Reports")" class="btn btn-sm btn-outline-secondary">
            <i class="fa-solid fa-gauge me-1"></i> Dashboard
        </a>
    </div>
</div>

<!-- 5 Supplier Sub-Report Navigation Tabs -->
<div class="card border-0 shadow-sm mb-3 no-print report-subnav">
    <div class="card-body p-2">
        <div class="nav nav-pills nav-fill flex-nowrap overflow-auto gap-1">
            <a href="@Url.Action("Suppliers", "Reports", new { reportType = "SupplierList", DatePreset = filter.DatePreset, FromDate = filter.FromDate, ToDate = filter.ToDate })" 
               class="nav-link fs-8 py-1.5 px-2.5 text-nowrap @(currentType == "SupplierList" ? "active" : "")">
                <i class="fa-solid fa-address-book me-1"></i> Directory
            </a>
            <a href="@Url.Action("Suppliers", "Reports", new { reportType = "TopSuppliers", DatePreset = filter.DatePreset, FromDate = filter.FromDate, ToDate = filter.ToDate })" 
               class="nav-link fs-8 py-1.5 px-2.5 text-nowrap @(currentType == "TopSuppliers" ? "active" : "")">
                <i class="fa-solid fa-award me-1 text-warning"></i> Top Vendors
            </a>
            <a href="@Url.Action("Suppliers", "Reports", new { reportType = "PurchaseHistory", SupplierId = filter.SupplierId, DatePreset = filter.DatePreset, FromDate = filter.FromDate, ToDate = filter.ToDate })" 
               class="nav-link fs-8 py-1.5 px-2.5 text-nowrap @(currentType == "PurchaseHistory" ? "active" : "")">
                <i class="fa-solid fa-receipt me-1"></i> Bills History
            </a>
            <a href="@Url.Action("Suppliers", "Reports", new { reportType = "Outstanding", DatePreset = filter.DatePreset, FromDate = filter.FromDate, ToDate = filter.ToDate })" 
               class="nav-link fs-8 py-1.5 px-2.5 text-nowrap @(currentType == "Outstanding" ? "active" : "")">
                <i class="fa-solid fa-file-invoice-dollar me-1"></i> Outstanding Payables
            </a>
            <a href="@Url.Action("Suppliers", "Reports", new { reportType = "PaymentHistory", SupplierId = filter.SupplierId, DatePreset = filter.DatePreset, FromDate = filter.FromDate, ToDate = filter.ToDate })" 
               class="nav-link fs-8 py-1.5 px-2.5 text-nowrap @(currentType == "PaymentHistory" ? "active" : "")">
                <i class="fa-solid fa-money-bill-transfer me-1"></i> Payment History
            </a>
        </div>
    </div>
</div>

<!-- Filter Bar -->
<partial name="_ReportFilterBar" model="filter" />

<!-- Summary Metric Cards -->
@if (Model.SummaryCards.Any())
{
    <div class="row g-3 mb-4 report-summary-cards">
        @foreach (var card in Model.SummaryCards)
        {
            <div class="col-6 col-md-4 col-xl-2">
                <div class="card border-0 shadow-sm bg-@card.ColorClass bg-opacity-10 h-100">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="text-muted fs-8 fw-bold text-uppercase">@card.Title</span>
                            <i class="fa-solid @card.Icon text-@card.ColorClass fs-6"></i>
                        </div>
                        <h4 class="fw-bold text-@card.ColorClass m-0">@card.Value</h4>
                        @if (!string.IsNullOrEmpty(card.Subtitle))
                        {
                            <span class="text-muted fs-9">@card.Subtitle</span>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}

<!-- Data Table Card -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-transparent border-0 pt-3 px-3 d-flex justify-content-between align-items-center">
        <h6 class="fw-bold m-0 text-dark">
            <i class="fa-solid fa-table-list text-primary me-1.5"></i> @Model.ReportTitle Data Table
        </h6>
        <span class="badge bg-light text-muted border fs-8">@Model.TotalRecords Records</span>
    </div>
    <div class="card-body p-3">
        <div class="table-responsive">
            @if (currentType == "SupplierList")
            {
                <table class="table table-hover align-middle datatable w-100 fs-8">
                    <thead class="bg-light">
                        <tr>
                            <th>Code</th>
                            <th>Vendor Name</th>
                            <th>Mobile</th>
                            <th>Email</th>
                            <th>GSTIN</th>
                            <th>City / State</th>
                            <th class="text-end">Credit Limit</th>
                            <th class="text-end">Current Balance</th>
                            <th class="text-center">Joined</th>
                            <th class="text-center no-print">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Data.Cast<ERP.ViewModels.Reporting.SupplierMasterReportDto>())
                        {
                            <tr>
                                <td class="fw-bold">@row.SupplierCode</td>
                                <td class="fw-semibold">@row.SupplierName</td>
                                <td>@(row.Mobile ?? "-")</td>
                                <td>@(row.Email ?? "-")</td>
                                <td><span class="font-monospace">@(row.GSTNumber ?? "-")</span></td>
                                <td>@(row.City ?? "-") @(string.IsNullOrEmpty(row.State) ? "" : $", {row.State}")</td>
                                <td class="text-end">₹@row.CreditLimit.ToString("N2")</td>
                                <td class="text-end fw-bold @(row.CurrentBalance > 0 ? "text-danger" : "text-success")">
                                    ₹@row.CurrentBalance.ToString("N2")
                                </td>
                                <td class="text-center text-muted">@row.CreatedAt.ToString("dd-MMM-yyyy")</td>
                                <td class="text-center no-print">
                                    <a href="@Url.Action("Suppliers", "Reports", new { reportType = "PurchaseHistory", SupplierId = row.SupplierId })" class="btn btn-xs btn-outline-primary" title="Purchase Bills">
                                        <i class="fa-solid fa-receipt"></i>
                                    </a>
                                    <a href="@Url.Action("Accounts", "Reports", new { reportType = "SupplierLedger", SupplierId = row.SupplierId })" class="btn btn-xs btn-outline-secondary" title="Supplier Ledger">
                                        <i class="fa-solid fa-book-open"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else if (currentType == "TopSuppliers")
            {
                <table class="table table-hover align-middle datatable w-100 fs-8">
                    <thead class="bg-light">
                        <tr>
                            <th>Supplier Code</th>
                            <th>Supplier Name</th>
                            <th>Mobile</th>
                            <th>City</th>
                            <th class="text-center">Total Bills</th>
                            <th class="text-end">Total Purchased</th>
                            <th class="text-end">Total Disbursed</th>
                            <th class="text-end">Balance Payable</th>
                            <th class="text-center no-print">Bills</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Data.Cast<ERP.ViewModels.Reporting.SupplierWisePurchaseDto>())
                        {
                            <tr>
                                <td class="fw-bold">@row.SupplierCode</td>
                                <td class="fw-semibold">@row.SupplierName</td>
                                <td>@(row.Mobile ?? "-")</td>
                                <td>@(row.City ?? "-")</td>
                                <td class="text-center"><span class="badge bg-light text-dark border">@row.BillCount</span></td>
                                <td class="text-end fw-bold text-primary">₹@row.TotalPurchaseAmount.ToString("N2")</td>
                                <td class="text-end text-success">₹@row.PaidAmount.ToString("N2")</td>
                                <td class="text-end fw-bold @(row.BalanceAmount > 0 ? "text-danger" : "text-muted")">
                                    ₹@row.BalanceAmount.ToString("N2")
                                </td>
                                <td class="text-center no-print">
                                    <a href="@Url.Action("Suppliers", "Reports", new { reportType = "PurchaseHistory", SupplierId = row.SupplierId })" class="btn btn-xs btn-outline-primary">
                                        <i class="fa-solid fa-clock-rotate-left"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else if (currentType == "PurchaseHistory")
            {
                <table class="table table-hover align-middle datatable w-100 fs-8">
                    <thead class="bg-light">
                        <tr>
                            <th>Bill #</th>
                            <th>Date</th>
                            <th>Supplier</th>
                            <th>Vendor Ref #</th>
                            <th>GSTIN</th>
                            <th class="text-end">Taxable</th>
                            <th class="text-end">Tax</th>
                            <th class="text-end">Grand Total</th>
                            <th class="text-end">Disbursed</th>
                            <th class="text-end">Balance Due</th>
                            <th class="text-center">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Data.Cast<ERP.ViewModels.Reporting.PurchaseRegisterDto>())
                        {
                            <tr>
                                <td class="fw-bold">@row.InvoiceNumber</td>
                                <td>@row.InvoiceDate.ToString("dd-MMM-yyyy")</td>
                                <td>@row.SupplierName</td>
                                <td>@(row.ReferenceNumber ?? "-")</td>
                                <td><span class="font-monospace">@(row.GSTNumber ?? "-")</span></td>
                                <td class="text-end">₹@row.SubTotal.ToString("N2")</td>
                                <td class="text-end">₹@row.TaxAmount.ToString("N2")</td>
                                <td class="text-end fw-bold text-primary">₹@row.GrandTotal.ToString("N2")</td>
                                <td class="text-end text-success">₹@row.PaidAmount.ToString("N2")</td>
                                <td class="text-end fw-bold @(row.BalanceAmount > 0 ? "text-danger" : "text-muted")">₹@row.BalanceAmount.ToString("N2")</td>
                                <td class="text-center"><span class="badge bg-light text-dark border">@row.Status</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else if (currentType == "Outstanding")
            {
                <table class="table table-hover align-middle datatable w-100 fs-8">
                    <thead class="bg-light">
                        <tr>
                            <th>Supplier Code</th>
                            <th>Supplier Name</th>
                            <th>Phone</th>
                            <th>City</th>
                            <th class="text-end">Credit Limit</th>
                            <th class="text-end">Total Billed</th>
                            <th class="text-end">Total Paid</th>
                            <th class="text-end">Balance Payable</th>
                            <th class="text-center">Overdue Bills</th>
                            <th class="text-center no-print">Ledger</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Data.Cast<ERP.ViewModels.Reporting.OutstandingReportDto>())
                        {
                            <tr>
                                <td class="fw-bold">@row.EntityCode</td>
                                <td class="fw-semibold">@row.EntityName</td>
                                <td>@(row.ContactPhone ?? "-")</td>
                                <td>@(row.City ?? "-")</td>
                                <td class="text-end">₹@row.CreditLimit.ToString("N2")</td>
                                <td class="text-end">₹@row.TotalInvoiced.ToString("N2")</td>
                                <td class="text-end text-success">₹@row.TotalPaid.ToString("N2")</td>
                                <td class="text-end fw-bold text-danger">₹@row.NetOutstanding.ToString("N2")</td>
                                <td class="text-center">
                                    <span class="badge bg-@(row.OverdueBillsCount > 0 ? "danger" : "light text-muted")">
                                        @row.OverdueBillsCount
                                    </span>
                                </td>
                                <td class="text-center no-print">
                                    <a href="@Url.Action("Accounts", "Reports", new { reportType = "SupplierLedger", SupplierId = row.EntityId })" class="btn btn-xs btn-outline-primary">
                                        <i class="fa-solid fa-book-open"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else if (currentType == "PaymentHistory")
            {
                <table class="table table-hover align-middle datatable w-100 fs-8">
                    <thead class="bg-light">
                        <tr>
                            <th>Invoice #</th>
                            <th>Invoice Date</th>
                            <th>Supplier Name</th>
                            <th class="text-end">Bill Amount</th>
                            <th class="text-end">Paid Amount</th>
                            <th class="text-end">Remaining Balance</th>
                            <th class="text-center">Settlement Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Data.Cast<ERP.ViewModels.Reporting.PurchasePaymentReportDto>())
                        {
                            <tr>
                                <td class="fw-bold">@row.InvoiceNumber</td>
                                <td>@row.InvoiceDate.ToString("dd-MMM-yyyy")</td>
                                <td>@row.SupplierName</td>
                                <td class="text-end">₹@row.GrandTotal.ToString("N2")</td>
                                <td class="text-end fw-bold text-success">₹@row.PaidAmount.ToString("N2")</td>
                                <td class="text-end fw-bold @(row.BalanceAmount > 0 ? "text-danger" : "text-muted")">₹@row.BalanceAmount.ToString("N2")</td>
                                <td class="text-center">
                                    <span class="badge bg-@(row.PaymentStatus == "Fully Paid" ? "success" : row.PaymentStatus == "Partially Paid" ? "warning text-dark" : "danger")">
                                        @row.PaymentStatus
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            if ($('.datatable').length) {
                $('.datatable').DataTable({
                    responsive: true,
                    pageLength: 25,
                    order: [],
                    language: {
                        search: "_INPUT_",
                        searchPlaceholder: "Search records..."
                    }
                });
            }
        });
    </script>
}
