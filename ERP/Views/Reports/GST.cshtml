@model ERP.ViewModels.Reporting.ReportResultViewModel<object>
@{
    ViewData["Title"] = Model.ReportTitle;
    var currentType = Model.ReportType;
    var filter = Model.Filter;
}

<!-- Print-Only Header -->
<div class="report-print-header">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1 class="company-title">@Model.ActiveCompanyName</h1>
            <h2 class="report-title">@Model.ReportTitle</h2>
            <div class="report-meta">
                Period: @(filter.FromDate?.ToString("dd-MMM-yyyy") ?? "Start") to @(filter.ToDate?.ToString("dd-MMM-yyyy") ?? "Today") | 
                Generated: @DateTime.Now.ToString("dd-MMM-yyyy HH:mm")
            </div>
        </div>
    </div>
</div>

<!-- Header -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2 no-print">
    <div>
        <h4 class="m-0 fw-bold text-dark"><i class="fa-solid fa-file-invoice text-primary me-2"></i> @Model.ReportTitle</h4>
        <p class="text-muted small m-0 mt-0.5">@Model.ReportDescription</p>
    </div>
    <div class="d-flex gap-2">
        <a href="@Url.Action("Index", "Reports")" class="btn btn-sm btn-outline-secondary">
            <i class="fa-solid fa-gauge me-1"></i> Dashboard
        </a>
    </div>
</div>

<!-- Statutory Notice Banner -->
<div class="alert alert-info py-2 px-3 mb-3 border-0 shadow-sm d-flex align-items-center gap-2 fs-8 no-print">
    <i class="fa-solid fa-circle-info fs-6 text-info"></i>
    <div>
        <strong>GST Filing Advisory:</strong> These summaries represent management preparatory data computed from transaction line items (HSN, CGST, SGST, IGST). Please cross-reconcile with your official GST Portal GSTR-2B before submitting statutory GSTR-1 and GSTR-3B filings.
    </div>
</div>

<!-- 10 GST Sub-Report Navigation Tabs -->
<div class="card border-0 shadow-sm mb-3 no-print report-subnav">
    <div class="card-body p-2">
        <div class="nav nav-pills nav-fill flex-nowrap overflow-auto gap-1">
            <a href="@Url.Action("GST", "Reports", new { reportType = "GstSalesSummary", DatePreset = filter.DatePreset, FromDate = filter.FromDate, ToDate = filter.ToDate })" 
               class="nav-link fs-8 py-1.5 px-2.5 text-nowrap @(currentType == "GstSalesSummary" ? "active" : "")">
                <i class="fa-solid fa-file-export me-1"></i> GSTR-1 Sales
            </a>
            <a href="@Url.Action("GST", "Reports", new { reportType = "GstPurchaseSummary", DatePreset = filter.DatePreset, FromDate = filter.FromDate, ToDate = filter.ToDate })" 
               class="nav-link fs-8 py-1.5 px-2.5 text-nowrap @(currentType == "GstPurchaseSummary" ? "active" : "")">
                <i class="fa-solid fa-file-import me-1"></i> GSTR-2/3B (ITC)
            </a>
            <a href="@Url.Action("GST", "Reports", new { reportType = "HsnSales", DatePreset = filter.DatePreset, FromDate = filter.FromDate, ToDate = filter.ToDate })" 
               class="nav-link fs-8 py-1.5 px-2.5 text-nowrap @(currentType == "HsnSales" ? "active" : "")">
                <i class="fa-solid fa-barcode me-1"></i> HSN Sales
            </a>
            <a href="@Url.Action("GST", "Reports", new { reportType = "HsnPurchase", DatePreset = filter.DatePreset, FromDate = filter.FromDate, ToDate = filter.ToDate })" 
               class="nav-link fs-8 py-1.5 px-2.5 text-nowrap @(currentType == "HsnPurchase" ? "active" : "")">
                <i class="fa-solid fa-boxes-packing me-1"></i> HSN Purchase
            </a>
            <a href="@Url.Action("GST", "Reports", new { reportType = "CgstSummary", DatePreset = filter.DatePreset, FromDate = filter.FromDate, ToDate = filter.ToDate })" 
               class="nav-link fs-8 py-1.5 px-2.5 text-nowrap @(currentType == "CgstSummary" ? "active" : "")">
                <i class="fa-solid fa-landmark me-1"></i> CGST Summary
            </a>
            <a href="@Url.Action("GST", "Reports", new { reportType = "SgstSummary", DatePreset = filter.DatePreset, FromDate = filter.FromDate, ToDate = filter.ToDate })" 
               class="nav-link fs-8 py-1.5 px-2.5 text-nowrap @(currentType == "SgstSummary" ? "active" : "")">
                <i class="fa-solid fa-building me-1"></i> SGST Summary
            </a>
            <a href="@Url.Action("GST", "Reports", new { reportType = "IgstSummary", DatePreset = filter.DatePreset, FromDate = filter.FromDate, ToDate = filter.ToDate })" 
               class="nav-link fs-8 py-1.5 px-2.5 text-nowrap @(currentType == "IgstSummary" ? "active" : "")">
                <i class="fa-solid fa-map-location-dot me-1"></i> IGST Summary
            </a>
            <a href="@Url.Action("GST", "Reports", new { reportType = "TaxRateSummary", DatePreset = filter.DatePreset, FromDate = filter.FromDate, ToDate = filter.ToDate })" 
               class="nav-link fs-8 py-1.5 px-2.5 text-nowrap @(currentType == "TaxRateSummary" ? "active" : "")">
                <i class="fa-solid fa-percent me-1"></i> Tax Slab Breakdown
            </a>
            <a href="@Url.Action("GST", "Reports", new { reportType = "SalesReturnTax", DatePreset = filter.DatePreset, FromDate = filter.FromDate, ToDate = filter.ToDate })" 
               class="nav-link fs-8 py-1.5 px-2.5 text-nowrap @(currentType == "SalesReturnTax" ? "active" : "")">
                <i class="fa-solid fa-rotate-left me-1"></i> Sales Return Tax
            </a>
            <a href="@Url.Action("GST", "Reports", new { reportType = "PurchaseReturnTax", DatePreset = filter.DatePreset, FromDate = filter.FromDate, ToDate = filter.ToDate })" 
               class="nav-link fs-8 py-1.5 px-2.5 text-nowrap @(currentType == "PurchaseReturnTax" ? "active" : "")">
                <i class="fa-solid fa-backward me-1"></i> Purchase Return Tax
            </a>
        </div>
    </div>
</div>

<!-- Filter Bar -->
<partial name="_ReportFilterBar" model="filter" />

<!-- Summary Metric Cards -->
@if (Model.SummaryCards.Any())
{
    <div class="row g-3 mb-4 report-summary-cards">
        @foreach (var card in Model.SummaryCards)
        {
            <div class="col-6 col-md-4 col-xl-2">
                <div class="card border-0 shadow-sm bg-@card.ColorClass bg-opacity-10 h-100">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="text-muted fs-8 fw-bold text-uppercase">@card.Title</span>
                            <i class="fa-solid @card.Icon text-@card.ColorClass fs-6"></i>
                        </div>
                        <h4 class="fw-bold text-@card.ColorClass m-0">@card.Value</h4>
                        @if (!string.IsNullOrEmpty(card.Subtitle))
                        {
                            <span class="text-muted fs-9">@card.Subtitle</span>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}

<!-- Data Table Card -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-transparent border-0 pt-3 px-3 d-flex justify-content-between align-items-center">
        <h6 class="fw-bold m-0 text-dark">
            <i class="fa-solid fa-table-list text-primary me-1.5"></i> @Model.ReportTitle Data Table
        </h6>
        <span class="badge bg-light text-muted border fs-8">@Model.TotalRecords Records</span>
    </div>
    <div class="card-body p-3">
        <div class="table-responsive">
            @if (currentType == "GstSalesSummary")
            {
                <table class="table table-hover align-middle datatable w-100 fs-8">
                    <thead class="bg-light">
                        <tr>
                            <th>Supply Nature / Category</th>
                            <th class="text-center">Invoices</th>
                            <th class="text-end">Taxable Value</th>
                            <th class="text-end">CGST Amount</th>
                            <th class="text-end">SGST Amount</th>
                            <th class="text-end">IGST Amount</th>
                            <th class="text-end">Total Tax</th>
                            <th class="text-end">Invoice Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Data.Cast<ERP.ViewModels.Reporting.GstSalesSummaryDto>())
                        {
                            <tr>
                                <td class="fw-bold"><i class="fa-solid fa-shield-halved text-primary me-1.5"></i> @row.SupplyType</td>
                                <td class="text-center">@row.InvoiceCount</td>
                                <td class="text-end fw-semibold">₹@row.TaxableValue.ToString("N2")</td>
                                <td class="text-end">₹@row.CGSTAmount.ToString("N2")</td>
                                <td class="text-end">₹@row.SGSTAmount.ToString("N2")</td>
                                <td class="text-end">₹@row.IGSTAmount.ToString("N2")</td>
                                <td class="text-end fw-bold text-danger">₹@row.TotalTax.ToString("N2")</td>
                                <td class="text-end fw-bold text-primary">₹@row.InvoiceTotal.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else if (currentType == "GstPurchaseSummary")
            {
                <table class="table table-hover align-middle datatable w-100 fs-8">
                    <thead class="bg-light">
                        <tr>
                            <th>Supply Nature</th>
                            <th class="text-center">Bills</th>
                            <th class="text-end">Taxable Value</th>
                            <th class="text-end">Eligible CGST (ITC)</th>
                            <th class="text-end">Eligible SGST (ITC)</th>
                            <th class="text-end">Eligible IGST (ITC)</th>
                            <th class="text-end">Total ITC Available</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Data.Cast<ERP.ViewModels.Reporting.GstPurchaseSummaryDto>())
                        {
                            <tr>
                                <td class="fw-bold"><i class="fa-solid fa-box text-success me-1.5"></i> @row.SupplyType</td>
                                <td class="text-center">@row.BillCount</td>
                                <td class="text-end fw-semibold">₹@row.TaxableValue.ToString("N2")</td>
                                <td class="text-end">₹@row.EligibleCGST.ToString("N2")</td>
                                <td class="text-end">₹@row.EligibleSGST.ToString("N2")</td>
                                <td class="text-end">₹@row.EligibleIGST.ToString("N2")</td>
                                <td class="text-end fw-bold text-success">₹@row.TotalITC.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else if (currentType == "HsnSales" || currentType == "HsnPurchase")
            {
                <table class="table table-hover align-middle datatable w-100 fs-8">
                    <thead class="bg-light">
                        <tr>
                            <th>HSN Code</th>
                            <th>Description</th>
                            <th>UQC</th>
                            <th class="text-end">Total Qty</th>
                            <th class="text-end">Taxable Value</th>
                            <th class="text-center">Rate</th>
                            <th class="text-end">CGST</th>
                            <th class="text-end">SGST</th>
                            <th class="text-end">IGST</th>
                            <th class="text-end">Total Tax</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Data.Cast<ERP.ViewModels.Reporting.HsnSummaryDto>())
                        {
                            <tr>
                                <td class="fw-bold font-monospace text-primary">@row.HSNCode</td>
                                <td>@row.Description</td>
                                <td><span class="badge bg-light text-muted border">@row.UnitName</span></td>
                                <td class="text-end">@row.TotalQuantity.ToString("N2")</td>
                                <td class="text-end fw-semibold">₹@row.TaxableValue.ToString("N2")</td>
                                <td class="text-center">@row.RateOfTax%</td>
                                <td class="text-end">₹@row.CGSTAmount.ToString("N2")</td>
                                <td class="text-end">₹@row.SGSTAmount.ToString("N2")</td>
                                <td class="text-end">₹@row.IGSTAmount.ToString("N2")</td>
                                <td class="text-end fw-bold text-danger">₹@row.TotalTax.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <table class="table table-hover align-middle datatable w-100 fs-8">
                    <thead class="bg-light">
                        <tr>
                            <th>Tax Rate Slab</th>
                            <th class="text-end">Taxable Value</th>
                            <th class="text-end">CGST Amount</th>
                            <th class="text-end">SGST Amount</th>
                            <th class="text-end">IGST Amount</th>
                            <th class="text-end">Total Tax Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Data.Cast<ERP.ViewModels.Reporting.TaxRateSummaryDto>())
                        {
                            <tr>
                                <td class="fw-bold">
                                    <span class="badge bg-primary bg-opacity-10 text-primary fs-8 px-2.5 py-1">
                                        @row.TaxRate% GST
                                    </span>
                                </td>
                                <td class="text-end fw-semibold">₹@row.TaxableValue.ToString("N2")</td>
                                <td class="text-end">₹@row.CGSTAmount.ToString("N2")</td>
                                <td class="text-end">₹@row.SGSTAmount.ToString("N2")</td>
                                <td class="text-end">₹@row.IGSTAmount.ToString("N2")</td>
                                <td class="text-end fw-bold text-danger">₹@row.TotalTax.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            if ($('.datatable').length) {
                $('.datatable').DataTable({
                    responsive: true,
                    pageLength: 25,
                    order: [],
                    language: {
                        search: "_INPUT_",
                        searchPlaceholder: "Search records..."
                    }
                });
            }
        });
    </script>
}
