@model ERP.ViewModels.Reporting.ReportResultViewModel<object>
@{
    ViewData["Title"] = Model.ReportTitle;
    var currentType = Model.ReportType;
    var filter = Model.Filter;
}

<!-- Print-Only Header -->
<div class="report-print-header">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1 class="company-title">@Model.ActiveCompanyName</h1>
            <h2 class="report-title">@Model.ReportTitle</h2>
            <div class="report-meta">
                Period: @(filter.FromDate?.ToString("dd-MMM-yyyy") ?? "Start") to @(filter.ToDate?.ToString("dd-MMM-yyyy") ?? "Today") | 
                Generated: @DateTime.Now.ToString("dd-MMM-yyyy HH:mm")
            </div>
        </div>
    </div>
</div>

<!-- Header -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2 no-print">
    <div>
        <h4 class="m-0 fw-bold text-dark"><i class="fa-solid fa-cart-shopping text-primary me-2"></i> @Model.ReportTitle</h4>
        <p class="text-muted small m-0 mt-0.5">@Model.ReportDescription</p>
    </div>
    <div class="d-flex gap-2">
        <a href="@Url.Action("Index", "Reports")" class="btn btn-sm btn-outline-secondary">
            <i class="fa-solid fa-gauge me-1"></i> Dashboard
        </a>
    </div>
</div>

<!-- 14 Sub-Report Navigation Tabs -->
<div class="card border-0 shadow-sm mb-3 no-print report-subnav">
    <div class="card-body p-2">
        <div class="nav nav-pills nav-fill flex-nowrap overflow-auto gap-1">
            <a href="@Url.Action("Sales", "Reports", new { reportType = "DailySales", DatePreset = filter.DatePreset, FromDate = filter.FromDate, ToDate = filter.ToDate })" 
               class="nav-link fs-8 py-1.5 px-2.5 text-nowrap @(currentType == "DailySales" ? "active" : "")">
                <i class="fa-solid fa-calendar-day me-1"></i> Daily
            </a>
            <a href="@Url.Action("Sales", "Reports", new { reportType = "MonthlySales", DatePreset = filter.DatePreset, FromDate = filter.FromDate, ToDate = filter.ToDate })" 
               class="nav-link fs-8 py-1.5 px-2.5 text-nowrap @(currentType == "MonthlySales" ? "active" : "")">
                <i class="fa-solid fa-calendar-days me-1"></i> Monthly
            </a>
            <a href="@Url.Action("Sales", "Reports", new { reportType = "YearlySales", DatePreset = filter.DatePreset, FromDate = filter.FromDate, ToDate = filter.ToDate })" 
               class="nav-link fs-8 py-1.5 px-2.5 text-nowrap @(currentType == "YearlySales" ? "active" : "")">
                <i class="fa-solid fa-calendar me-1"></i> Yearly
            </a>
            <a href="@Url.Action("Sales", "Reports", new { reportType = "SalesRegister", DatePreset = filter.DatePreset, FromDate = filter.FromDate, ToDate = filter.ToDate })" 
               class="nav-link fs-8 py-1.5 px-2.5 text-nowrap @(currentType == "SalesRegister" ? "active" : "")">
                <i class="fa-solid fa-book me-1"></i> Register
            </a>
            <a href="@Url.Action("Sales", "Reports", new { reportType = "ProductWise", DatePreset = filter.DatePreset, FromDate = filter.FromDate, ToDate = filter.ToDate })" 
               class="nav-link fs-8 py-1.5 px-2.5 text-nowrap @(currentType == "ProductWise" ? "active" : "")">
                <i class="fa-solid fa-box me-1"></i> Product-wise
            </a>
            <a href="@Url.Action("Sales", "Reports", new { reportType = "CategoryWise", DatePreset = filter.DatePreset, FromDate = filter.FromDate, ToDate = filter.ToDate })" 
               class="nav-link fs-8 py-1.5 px-2.5 text-nowrap @(currentType == "CategoryWise" ? "active" : "")">
                <i class="fa-solid fa-layer-group me-1"></i> Category-wise
            </a>
            <a href="@Url.Action("Sales", "Reports", new { reportType = "BrandWise", DatePreset = filter.DatePreset, FromDate = filter.FromDate, ToDate = filter.ToDate })" 
               class="nav-link fs-8 py-1.5 px-2.5 text-nowrap @(currentType == "BrandWise" ? "active" : "")">
                <i class="fa-solid fa-tag me-1"></i> Brand-wise
            </a>
            <a href="@Url.Action("Sales", "Reports", new { reportType = "CustomerWise", DatePreset = filter.DatePreset, FromDate = filter.FromDate, ToDate = filter.ToDate })" 
               class="nav-link fs-8 py-1.5 px-2.5 text-nowrap @(currentType == "CustomerWise" ? "active" : "")">
                <i class="fa-solid fa-users me-1"></i> Customer-wise
            </a>
            <a href="@Url.Action("Sales", "Reports", new { reportType = "SalespersonWise", DatePreset = filter.DatePreset, FromDate = filter.FromDate, ToDate = filter.ToDate })" 
               class="nav-link fs-8 py-1.5 px-2.5 text-nowrap @(currentType == "SalespersonWise" ? "active" : "")">
                <i class="fa-solid fa-user-tie me-1"></i> Salesperson
            </a>
            <a href="@Url.Action("Sales", "Reports", new { reportType = "SalesReturn", DatePreset = filter.DatePreset, FromDate = filter.FromDate, ToDate = filter.ToDate })" 
               class="nav-link fs-8 py-1.5 px-2.5 text-nowrap @(currentType == "SalesReturn" ? "active" : "")">
                <i class="fa-solid fa-rotate-left me-1"></i> Returns
            </a>
            <a href="@Url.Action("Sales", "Reports", new { reportType = "Discount", DatePreset = filter.DatePreset, FromDate = filter.FromDate, ToDate = filter.ToDate })" 
               class="nav-link fs-8 py-1.5 px-2.5 text-nowrap @(currentType == "Discount" ? "active" : "")">
                <i class="fa-solid fa-percent me-1"></i> Discounts
            </a>
            <a href="@Url.Action("Sales", "Reports", new { reportType = "PaymentCollection", DatePreset = filter.DatePreset, FromDate = filter.FromDate, ToDate = filter.ToDate })" 
               class="nav-link fs-8 py-1.5 px-2.5 text-nowrap @(currentType == "PaymentCollection" ? "active" : "")">
                <i class="fa-solid fa-hand-holding-dollar me-1"></i> Collections
            </a>
            <a href="@Url.Action("Sales", "Reports", new { reportType = "BillDetails", DatePreset = filter.DatePreset, FromDate = filter.FromDate, ToDate = filter.ToDate })" 
               class="nav-link fs-8 py-1.5 px-2.5 text-nowrap @(currentType == "BillDetails" ? "active" : "")">
                <i class="fa-solid fa-list-check me-1"></i> Bill Details
            </a>
            <a href="@Url.Action("Sales", "Reports", new { reportType = "CancelledSales", DatePreset = filter.DatePreset, FromDate = filter.FromDate, ToDate = filter.ToDate })" 
               class="nav-link fs-8 py-1.5 px-2.5 text-nowrap text-danger @(currentType == "CancelledSales" ? "active bg-danger text-white" : "")">
                <i class="fa-solid fa-ban me-1"></i> Cancelled
            </a>
        </div>
    </div>
</div>

<!-- Filter Bar -->
<partial name="_ReportFilterBar" model="filter" />

<!-- Summary Metric Cards -->
@if (Model.SummaryCards.Any())
{
    <div class="row g-3 mb-4 report-summary-cards">
        @foreach (var card in Model.SummaryCards)
        {
            <div class="col-6 col-md-4 col-xl-2">
                <div class="card border-0 shadow-sm bg-@card.ColorClass bg-opacity-10 h-100">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="text-muted fs-8 fw-bold text-uppercase">@card.Title</span>
                            <i class="fa-solid @card.Icon text-@card.ColorClass fs-6"></i>
                        </div>
                        <h4 class="fw-bold text-@card.ColorClass m-0">@card.Value</h4>
                        @if (!string.IsNullOrEmpty(card.Subtitle))
                        {
                            <span class="text-muted fs-9">@card.Subtitle</span>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}

<!-- Data Table Card -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-transparent border-0 pt-3 px-3 d-flex justify-content-between align-items-center">
        <h6 class="fw-bold m-0 text-dark">
            <i class="fa-solid fa-table-list text-primary me-1.5"></i> @Model.ReportTitle Data Table
        </h6>
        <span class="badge bg-light text-muted border fs-8">@Model.TotalRecords Records</span>
    </div>
    <div class="card-body p-3">
        <div class="table-responsive">
            @if (currentType == "DailySales")
            {
                <table class="table table-hover align-middle datatable w-100 fs-8">
                    <thead class="bg-light">
                        <tr>
                            <th>Date</th>
                            <th class="text-center">Invoices</th>
                            <th class="text-end">Gross Sales</th>
                            <th class="text-end">Discounts</th>
                            <th class="text-end">Tax Amount</th>
                            <th class="text-end">Net Sales</th>
                            <th class="text-end">Collected</th>
                            <th class="text-end">Balance</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Data.Cast<ERP.ViewModels.Reporting.DailySalesDto>())
                        {
                            <tr>
                                <td class="fw-semibold">@row.DateDisplay</td>
                                <td class="text-center">@row.InvoiceCount</td>
                                <td class="text-end">₹@row.GrossSales.ToString("N2")</td>
                                <td class="text-end text-danger">₹@row.DiscountAmount.ToString("N2")</td>
                                <td class="text-end">₹@row.TaxAmount.ToString("N2")</td>
                                <td class="text-end fw-bold text-primary">₹@row.NetSales.ToString("N2")</td>
                                <td class="text-end fw-bold text-success">₹@row.PaidAmount.ToString("N2")</td>
                                <td class="text-end fw-bold @(row.BalanceAmount > 0 ? "text-danger" : "text-muted")">₹@row.BalanceAmount.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else if (currentType == "MonthlySales")
            {
                <table class="table table-hover align-middle datatable w-100 fs-8">
                    <thead class="bg-light">
                        <tr>
                            <th>Month</th>
                            <th class="text-center">Invoices</th>
                            <th class="text-end">Gross Turnover</th>
                            <th class="text-end">Tax Collected</th>
                            <th class="text-end">Net Sales</th>
                            <th class="text-end">Paid Amount</th>
                            <th class="text-end">Growth Rate</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Data.Cast<ERP.ViewModels.Reporting.MonthlySalesDto>())
                        {
                            <tr>
                                <td class="fw-semibold">@row.MonthName</td>
                                <td class="text-center">@row.InvoiceCount</td>
                                <td class="text-end">₹@row.GrossSales.ToString("N2")</td>
                                <td class="text-end">₹@row.TaxAmount.ToString("N2")</td>
                                <td class="text-end fw-bold text-primary">₹@row.NetSales.ToString("N2")</td>
                                <td class="text-end text-success">₹@row.PaidAmount.ToString("N2")</td>
                                <td class="text-end fw-bold @(row.GrowthRate >= 0 ? "text-success" : "text-danger")">
                                    <i class="fa-solid @(row.GrowthRate >= 0 ? "fa-arrow-up" : "fa-arrow-down") me-0.5"></i> @row.GrowthRate.ToString("N2")%
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else if (currentType == "SalesRegister")
            {
                <table class="table table-hover align-middle datatable w-100 fs-8">
                    <thead class="bg-light">
                        <tr>
                            <th>Invoice #</th>
                            <th>Date</th>
                            <th>Customer</th>
                            <th>GSTIN</th>
                            <th>Salesperson</th>
                            <th class="text-end">SubTotal</th>
                            <th class="text-end">Tax</th>
                            <th class="text-end">Grand Total</th>
                            <th class="text-end">Paid</th>
                            <th class="text-end">Balance</th>
                            <th class="text-center">Status</th>
                            <th class="text-center no-print">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Data.Cast<ERP.ViewModels.Reporting.SalesRegisterDto>())
                        {
                            <tr>
                                <td>
                                    <a href="/Sales/Invoice?id=@row.InvoiceId" class="fw-bold text-primary text-decoration-none" title="View Invoice">
                                        @row.InvoiceNumber
                                    </a>
                                </td>
                                <td>@row.InvoiceDate.ToString("dd-MMM-yyyy")</td>
                                <td class="fw-semibold">@row.CustomerName</td>
                                <td class="text-muted font-monospace fs-9">@(row.GSTNumber ?? "-")</td>
                                <td>@(row.Salesperson ?? "-")</td>
                                <td class="text-end">₹@row.SubTotal.ToString("N2")</td>
                                <td class="text-end">₹@row.TaxAmount.ToString("N2")</td>
                                <td class="text-end fw-bold text-dark">₹@row.GrandTotal.ToString("N2")</td>
                                <td class="text-end text-success">₹@row.PaidAmount.ToString("N2")</td>
                                <td class="text-end fw-bold @(row.BalanceAmount > 0 ? "text-danger" : "text-muted")">₹@row.BalanceAmount.ToString("N2")</td>
                                <td class="text-center">
                                    <span class="badge @(row.Status == "Paid" || row.Status == "Completed" ? "bg-success" : row.Status == "Draft" ? "bg-secondary" : "bg-warning text-dark") rounded-pill">
                                        @row.Status
                                    </span>
                                </td>
                                <td class="text-center no-print">
                                    <a href="/Sales/Invoice" class="btn btn-xs btn-outline-primary" title="Drill-down to Invoice Screen">
                                        <i class="fa-solid fa-arrow-up-right-from-square"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else if (currentType == "ProductWise")
            {
                <table class="table table-hover align-middle datatable w-100 fs-8">
                    <thead class="bg-light">
                        <tr>
                            <th>Code</th>
                            <th>Product Name</th>
                            <th>Category</th>
                            <th>Brand</th>
                            <th class="text-end">Quantity Sold</th>
                            <th class="text-end">Avg Rate</th>
                            <th class="text-end">Tax</th>
                            <th class="text-end">Total Sales</th>
                            <th class="text-end">% of Revenue</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Data.Cast<ERP.ViewModels.Reporting.ProductWiseSalesDto>())
                        {
                            <tr>
                                <td class="font-monospace text-muted">@row.ProductCode</td>
                                <td class="fw-bold text-dark">@row.ProductName</td>
                                <td><span class="badge bg-light text-secondary border">@row.CategoryName</span></td>
                                <td><span class="badge bg-light text-secondary border">@row.BrandName</span></td>
                                <td class="text-end fw-semibold">@row.QuantitySold.ToString("N2") @row.UnitName</td>
                                <td class="text-end">₹@row.AverageRate.ToString("N2")</td>
                                <td class="text-end">₹@row.TotalTaxAmount.ToString("N2")</td>
                                <td class="text-end fw-bold text-success">₹@row.TotalSalesAmount.ToString("N2")</td>
                                <td class="text-end text-muted">@row.PercentageOfTotal.ToString("N1")%</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else if (currentType == "CategoryWise")
            {
                <table class="table table-hover align-middle datatable w-100 fs-8">
                    <thead class="bg-light">
                        <tr>
                            <th>Category Name</th>
                            <th class="text-center">Products Sold</th>
                            <th class="text-end">Total Quantity</th>
                            <th class="text-end">Total Revenue</th>
                            <th class="text-end">% Contribution</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Data.Cast<ERP.ViewModels.Reporting.CategoryWiseSalesDto>())
                        {
                            <tr>
                                <td class="fw-bold text-dark">@row.CategoryName</td>
                                <td class="text-center">@row.ProductCount</td>
                                <td class="text-end fw-semibold">@row.QuantitySold.ToString("N0")</td>
                                <td class="text-end fw-bold text-primary">₹@row.TotalSalesAmount.ToString("N2")</td>
                                <td class="text-end fw-semibold">@row.PercentageOfTotal.ToString("N2")%</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else if (currentType == "CustomerWise")
            {
                <table class="table table-hover align-middle datatable w-100 fs-8">
                    <thead class="bg-light">
                        <tr>
                            <th>Code</th>
                            <th>Customer Name</th>
                            <th>Mobile</th>
                            <th>City</th>
                            <th class="text-center">Invoices</th>
                            <th class="text-end">Total Invoiced</th>
                            <th class="text-end">Total Paid</th>
                            <th class="text-end">Balance Receivable</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Data.Cast<ERP.ViewModels.Reporting.CustomerWiseSalesDto>())
                        {
                            <tr>
                                <td class="font-monospace text-muted">@row.CustomerCode</td>
                                <td class="fw-bold text-dark">@row.CustomerName</td>
                                <td>@(row.MobileNumber ?? "-")</td>
                                <td>@(row.City ?? "-")</td>
                                <td class="text-center">@row.InvoiceCount</td>
                                <td class="text-end fw-bold text-primary">₹@row.TotalSalesAmount.ToString("N2")</td>
                                <td class="text-end text-success">₹@row.PaidAmount.ToString("N2")</td>
                                <td class="text-end fw-bold @(row.BalanceAmount > 0 ? "text-danger" : "text-muted")">₹@row.BalanceAmount.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else if (currentType == "SalesReturn")
            {
                <table class="table table-hover align-middle datatable w-100 fs-8">
                    <thead class="bg-light">
                        <tr>
                            <th>Return #</th>
                            <th>Date</th>
                            <th>Customer</th>
                            <th>Original Invoice</th>
                            <th>Return Reason</th>
                            <th class="text-end">SubTotal</th>
                            <th class="text-end">Tax</th>
                            <th class="text-end">Credit Total</th>
                            <th class="text-center">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Data.Cast<ERP.ViewModels.Reporting.SalesReturnReportDto>())
                        {
                            <tr>
                                <td class="fw-bold text-danger">@row.ReturnNumber</td>
                                <td>@row.ReturnDate.ToString("dd-MMM-yyyy")</td>
                                <td class="fw-semibold">@row.CustomerName</td>
                                <td>@(row.OriginalInvoiceNumber ?? "-")</td>
                                <td>@(row.Reason ?? "-")</td>
                                <td class="text-end">₹@row.SubTotal.ToString("N2")</td>
                                <td class="text-end">₹@row.TaxAmount.ToString("N2")</td>
                                <td class="text-end fw-bold text-danger">₹@row.GrandTotal.ToString("N2")</td>
                                <td class="text-center"><span class="badge bg-secondary rounded-pill">@row.Status</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else if (currentType == "BillDetails")
            {
                <table class="table table-hover align-middle datatable w-100 fs-8">
                    <thead class="bg-light">
                        <tr>
                            <th>Invoice #</th>
                            <th>Date</th>
                            <th>Customer</th>
                            <th>Product Name</th>
                            <th>HSN</th>
                            <th class="text-end">Qty</th>
                            <th class="text-end">Rate</th>
                            <th class="text-end">Discount</th>
                            <th class="text-end">Tax %</th>
                            <th class="text-end">Tax Amt</th>
                            <th class="text-end">Item Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Data.Cast<ERP.ViewModels.Reporting.BillDetailsReportDto>())
                        {
                            <tr>
                                <td class="fw-semibold">@row.InvoiceNumber</td>
                                <td>@row.InvoiceDate.ToString("dd-MMM-yyyy")</td>
                                <td>@row.CustomerName</td>
                                <td class="fw-bold">@row.ProductName</td>
                                <td class="font-monospace fs-9">@(row.HSNCode ?? "-")</td>
                                <td class="text-end">@row.Quantity.ToString("N2") @row.UnitName</td>
                                <td class="text-end">₹@row.Rate.ToString("N2")</td>
                                <td class="text-end text-danger">₹@row.DiscountAmount.ToString("N2")</td>
                                <td class="text-end">@row.TaxPercentage.ToString("N1")%</td>
                                <td class="text-end">₹@row.TaxAmount.ToString("N2")</td>
                                <td class="text-end fw-bold text-primary">₹@row.ItemAmount.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <!-- Generic fallback for BrandWise, SalespersonWise, Discount, PaymentCollection, CancelledSales -->
                <table class="table table-hover align-middle datatable w-100 fs-8">
                    <thead class="bg-light">
                        <tr>
                            @if (currentType == "BrandWise")
                            {
                                <th>Brand Name</th>
                                <th class="text-end">Quantity Sold</th>
                                <th class="text-end">Total Sales</th>
                                <th class="text-end">% Contribution</th>
                            }
                            else if (currentType == "SalespersonWise")
                            {
                                <th>Salesperson</th>
                                <th class="text-center">Bills</th>
                                <th class="text-end">Total Turnover</th>
                                <th class="text-end">Avg Ticket Size</th>
                                <th class="text-end">Collected</th>
                                <th class="text-end">Outstanding</th>
                            }
                            else if (currentType == "Discount")
                            {
                                <th>Invoice #</th>
                                <th>Date</th>
                                <th>Customer</th>
                                <th class="text-end">SubTotal</th>
                                <th class="text-end">Discount Amount</th>
                                <th class="text-end">Discount %</th>
                                <th class="text-end">Final Total</th>
                            }
                            else if (currentType == "PaymentCollection")
                            {
                                <th>Invoice #</th>
                                <th>Date</th>
                                <th>Customer</th>
                                <th class="text-end">Grand Total</th>
                                <th class="text-end">Paid Amount</th>
                                <th class="text-end">Balance</th>
                                <th class="text-center">Payment Status</th>
                            }
                            else if (currentType == "CancelledSales")
                            {
                                <th>Invoice #</th>
                                <th>Original Date</th>
                                <th>Customer</th>
                                <th class="text-end">Cancelled Value</th>
                                <th>Cancelled By</th>
                                <th>Notes / Reason</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @if (currentType == "BrandWise")
                        {
                            foreach (var b in Model.Data.Cast<ERP.ViewModels.Reporting.BrandWiseSalesDto>())
                            {
                                <tr>
                                    <td class="fw-bold">@b.BrandName</td>
                                    <td class="text-end">@b.QuantitySold.ToString("N0")</td>
                                    <td class="text-end fw-bold text-primary">₹@b.TotalSalesAmount.ToString("N2")</td>
                                    <td class="text-end">@b.PercentageOfTotal.ToString("N2")%</td>
                                </tr>
                            }
                        }
                        else if (currentType == "SalespersonWise")
                        {
                            foreach (var sp in Model.Data.Cast<ERP.ViewModels.Reporting.SalespersonWiseSalesDto>())
                            {
                                <tr>
                                    <td class="fw-bold">@sp.Salesperson</td>
                                    <td class="text-center">@sp.InvoiceCount</td>
                                    <td class="text-end fw-bold text-primary">₹@sp.TotalSalesAmount.ToString("N2")</td>
                                    <td class="text-end">₹@sp.AverageTicketSize.ToString("N2")</td>
                                    <td class="text-end text-success">₹@sp.PaidAmount.ToString("N2")</td>
                                    <td class="text-end text-danger">₹@sp.OutstandingAmount.ToString("N2")</td>
                                </tr>
                            }
                        }
                        else if (currentType == "Discount")
                        {
                            foreach (var d in Model.Data.Cast<ERP.ViewModels.Reporting.DiscountReportDto>())
                            {
                                <tr>
                                    <td class="fw-semibold">@d.InvoiceNumber</td>
                                    <td>@d.InvoiceDate.ToString("dd-MMM-yyyy")</td>
                                    <td>@d.CustomerName</td>
                                    <td class="text-end">₹@d.SubTotal.ToString("N2")</td>
                                    <td class="text-end fw-bold text-danger">₹@d.DiscountAmount.ToString("N2")</td>
                                    <td class="text-end fw-semibold">@d.DiscountPercentage.ToString("N1")%</td>
                                    <td class="text-end fw-bold">₹@d.GrandTotal.ToString("N2")</td>
                                </tr>
                            }
                        }
                        else if (currentType == "PaymentCollection")
                        {
                            foreach (var pc in Model.Data.Cast<ERP.ViewModels.Reporting.PaymentCollectionReportDto>())
                            {
                                <tr>
                                    <td class="fw-semibold">@pc.InvoiceNumber</td>
                                    <td>@pc.InvoiceDate.ToString("dd-MMM-yyyy")</td>
                                    <td>@pc.CustomerName</td>
                                    <td class="text-end">₹@pc.GrandTotal.ToString("N2")</td>
                                    <td class="text-end fw-bold text-success">₹@pc.PaidAmount.ToString("N2")</td>
                                    <td class="text-end @(pc.BalanceAmount > 0 ? "text-danger" : "text-muted")">₹@pc.BalanceAmount.ToString("N2")</td>
                                    <td class="text-center">
                                        <span class="badge @(pc.PaymentStatus == "Fully Paid" ? "bg-success" : pc.PaymentStatus == "Partially Paid" ? "bg-warning text-dark" : "bg-danger") rounded-pill">
                                            @pc.PaymentStatus
                                        </span>
                                    </td>
                                </tr>
                            }
                        }
                        else if (currentType == "CancelledSales")
                        {
                            foreach (var cs in Model.Data.Cast<ERP.ViewModels.Reporting.CancelledSalesReportDto>())
                            {
                                <tr>
                                    <td class="fw-bold text-danger">@cs.InvoiceNumber</td>
                                    <td>@cs.InvoiceDate.ToString("dd-MMM-yyyy")</td>
                                    <td>@cs.CustomerName</td>
                                    <td class="text-end fw-bold text-danger">₹@cs.GrandTotal.ToString("N2")</td>
                                    <td>@(cs.CreatedBy ?? "-")</td>
                                    <td class="text-muted">@(cs.Notes ?? "-")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>
