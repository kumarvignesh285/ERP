@model IEnumerable<ERP.Models.Product>
@{
    ViewData["Title"] = "Inventory Reports";
}

<!-- Filters Row -->
<div class="card mb-3 no-print">
    <div class="card-body p-3">
        <div class="row g-2 align-items-center">
            <div class="col-md-4">
                <label class="form-label font-weight-semibold mb-1 small text-muted">Category</label>
                <select id="filterCategory" class="form-select form-select-sm select2">
                    <option value="">All Categories</option>
                    @foreach (var cat in Model.Where(p => p.Category != null).Select(p => p.Category!.CategoryName).Distinct())
                    {
                        <option value="@cat">@cat</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label font-weight-semibold mb-1 small text-muted">Brand</label>
                <select id="filterBrand" class="form-select form-select-sm select2">
                    <option value="">All Brands</option>
                    @foreach (var b in Model.Where(p => p.Brand != null).Select(p => p.Brand!.BrandName).Distinct())
                    {
                        <option value="@b">@b</option>
                    }
                </select>
            </div>
            <div class="col-md-4 d-flex gap-2 align-self-end">
                <button class="btn btn-sm btn-primary w-100" onclick="applyFilters()"><i class="fa-solid fa-filter me-1"></i> Filter</button>
                <button class="btn btn-sm btn-outline-secondary w-100" onclick="resetFilters()"><i class="fa-solid fa-rotate me-1"></i> Reset</button>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <h5 class="m-0"><i class="fa-solid fa-boxes-stacked me-2"></i> Inventory Reports</h5>
        <button class="btn btn-light btn-sm" onclick="window.print()"><i class="fa-solid fa-print me-1"></i> Print</button>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover datatable align-middle">
                <thead>
                    <tr>
                        <th>Product Code</th>
                        <th>Product Name</th>
                        <th>Category</th>
                        <th>Brand</th>
                        <th class="text-end">Current Stock</th>
                    </tr>
                </thead>
                <tbody>
                    @if(Model != null)
                    {
                        foreach(var item in Model)
                        {
                            <tr>
                                <td class="font-weight-bold">@item.ProductCode</td>
                                <td>@item.ProductName</td>
                                <td>@(item.Category?.CategoryName)</td>
                                <td>@(item.Brand?.BrandName)</td>
                                <td class="text-end">
                                    <span class="badge @(item.CurrentStock <= item.ReorderLevel ? "bg-danger" : "bg-success") fs-7">
                                        @item.CurrentStock @item.Unit?.UnitName
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
