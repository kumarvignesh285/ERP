@model IEnumerable<ERP.Models.Product>
@{
    ViewData["Title"] = "Inventory Reports";
}

<div class="card">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <h5 class="m-0"><i class="fa-solid fa-boxes-stacked me-2"></i> Inventory Reports</h5>
        <button class="btn btn-light btn-sm" onclick="window.print()"><i class="fa-solid fa-print me-1"></i> Print</button>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover datatable align-middle">
                <thead>
                    <tr>
                        <th>Product Code</th>
                        <th>Product Name</th>
                        <th>Category</th>
                        <th>Brand</th>
                        <th class="text-end">Current Stock</th>
                    </tr>
                </thead>
                <tbody>
                    @if(Model != null)
                    {
                        foreach(var item in Model)
                        {
                            <tr>
                                <td class="font-weight-bold">@item.ProductCode</td>
                                <td>@item.ProductName</td>
                                <td>@(item.Category?.CategoryName)</td>
                                <td>@(item.Brand?.BrandName)</td>
                                <td class="text-end">
                                    <span class="badge @(item.CurrentStock <= item.ReorderLevel ? "bg-danger" : "bg-success") fs-7">
                                        @item.CurrentStock @item.Unit?.UnitName
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
