@model IEnumerable<ERP.Models.Product>
@{
    ViewData["Title"] = "Inventory Reports";
    var totalProducts = Model?.Count() ?? 0;
    var lowStockCount = Model?.Count(p => p.CurrentStock <= p.ReorderLevel) ?? 0;
    var optimalStockCount = Model?.Count(p => p.CurrentStock > p.ReorderLevel) ?? 0;
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h4 class="m-0 fw-bold text-primary"><i class="fa-solid fa-boxes-stacked me-2"></i> Inventory Reports & Stock Valuation</h4>
        <p class="text-muted small m-0 mt-1">Monitor real-time stock levels, reorder alerts, category & brand breakdown</p>
    </div>
    <div class="d-flex gap-2 no-print">
        <button class="btn btn-outline-secondary shadow-sm" onclick="window.print()"><i class="fa-solid fa-print me-1.5"></i> Print Report</button>
        <button class="btn btn-outline-success shadow-sm" onclick="alert('Exporting to Excel...')"><i class="fa-solid fa-file-excel me-1.5"></i> Export Excel</button>
    </div>
</div>

<!-- Summary KPI Cards -->
<div class="row g-3 mb-4 no-print">
    <div class="col-12 col-sm-6 col-md-4">
        <div class="card border-0 shadow-sm bg-primary bg-opacity-10 h-100">
            <div class="card-body p-3 d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Total Catalog Products</span>
                    <h3 class="m-0 fw-bold text-primary mt-1">@totalProducts</h3>
                </div>
                <div class="avatar bg-primary text-white rounded-3 p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                    <i class="fa-solid fa-box-open fs-5"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-md-4">
        <div class="card border-0 shadow-sm bg-success bg-opacity-10 h-100">
            <div class="card-body p-3 d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Optimal Stock Items</span>
                    <h3 class="m-0 fw-bold text-success mt-1">@optimalStockCount</h3>
                </div>
                <div class="avatar bg-success text-white rounded-3 p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                    <i class="fa-solid fa-cubes-stacked fs-5"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-md-4">
        <div class="card border-0 shadow-sm bg-danger bg-opacity-10 h-100">
            <div class="card-body p-3 d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Low Stock Alerts</span>
                    <h3 class="m-0 fw-bold text-danger mt-1">@lowStockCount</h3>
                </div>
                <div class="avatar bg-danger text-white rounded-3 p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                    <i class="fa-solid fa-triangle-exclamation fs-5"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Filters Panel -->
<div class="card mb-4 no-print shadow-sm border-0">
    <div class="card-body p-3">
        <div class="row g-3 align-items-center">
            <div class="col-12 col-sm-6 col-md-4">
                <label class="form-label fw-semibold mb-1 small text-muted">Category</label>
                <select id="filterCategory" class="form-select form-select-sm select2">
                    <option value="">All Categories</option>
                    @if (Model != null)
                    {
                        foreach (var cat in Model.Where(p => p.Category != null).Select(p => p.Category!.CategoryName).Distinct())
                        {
                            <option value="@cat">@cat</option>
                        }
                    }
                </select>
            </div>
            <div class="col-12 col-sm-6 col-md-4">
                <label class="form-label fw-semibold mb-1 small text-muted">Brand</label>
                <select id="filterBrand" class="form-select form-select-sm select2">
                    <option value="">All Brands</option>
                    @if (Model != null)
                    {
                        foreach (var b in Model.Where(p => p.Brand != null).Select(p => p.Brand!.BrandName).Distinct())
                        {
                            <option value="@b">@b</option>
                        }
                    }
                </select>
            </div>
            <div class="col-12 col-sm-12 col-md-4 d-flex gap-2 align-self-end">
                <button class="btn btn-sm btn-primary w-100 shadow-sm" onclick="applyFilters()"><i class="fa-solid fa-filter me-1"></i> Filter</button>
                <button class="btn btn-sm btn-outline-secondary w-100" onclick="resetFilters()"><i class="fa-solid fa-rotate me-1"></i> Reset</button>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive" style="max-height: 600px;">
            <table class="table table-hover datatable align-middle mb-0">
                <thead class="table-light text-uppercase fs-8 fw-bold text-muted sticky-top">
                    <tr>
                        <th class="ps-4">Product Code</th>
                        <th>Product Name</th>
                        <th>Category</th>
                        <th>Brand</th>
                        <th class="text-end pe-4">Current Stock</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null)
                    {
                        foreach (var item in Model)
                        {
                            var isLow = item.CurrentStock <= item.ReorderLevel;
                            <tr>
                                <td class="ps-4 fw-bold text-primary">@item.ProductCode</td>
                                <td class="fw-semibold text-dark">@item.ProductName</td>
                                <td>@(item.Category?.CategoryName)</td>
                                <td>@(item.Brand?.BrandName)</td>
                                <td class="text-end pe-4">
                                    <span class="badge @(isLow ? "bg-danger-subtle text-danger border border-danger-subtle" : "bg-success-subtle text-success border border-success-subtle") fw-bold px-2.5 py-1.5">
                                        @if(isLow) { <i class="fa-solid fa-triangle-exclamation me-1"></i> }
                                        @item.CurrentStock @item.Unit?.UnitName
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
