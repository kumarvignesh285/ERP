@model AccountingReportsViewModel
@{
    ViewData["Title"] = "Accounting Reports";
    var tb = Model.TrialBalance;
    var pnl = Model.ProfitAndLoss;
    var bs = Model.BalanceSheet;
    
    var totalDebit = tb?.Sum(x => x.Debit) ?? 0m;
    var totalCredit = tb?.Sum(x => x.Credit) ?? 0m;
    var netProfit = pnl?.NetProfit ?? 0m;
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h4 class="m-0 fw-bold text-primary"><i class="fa-solid fa-calculator me-2"></i> Accounting Reports & Financial Statements</h4>
        <p class="text-muted small m-0 mt-1">Trial Balance, Profit & Loss statement, and Balance Sheet analysis</p>
    </div>
    <div class="d-flex gap-2 no-print">
        <button class="btn btn-outline-secondary shadow-sm" onclick="window.print()"><i class="fa-solid fa-print me-1.5"></i> Print Report</button>
        <button class="btn btn-outline-success shadow-sm" onclick="alert('Exporting Financial Report...')"><i class="fa-solid fa-file-excel me-1.5"></i> Export Excel</button>
    </div>
</div>

<!-- Financial Summary Cards -->
<div class="row g-3 mb-4 no-print">
    <div class="col-12 col-sm-6 col-md-4">
        <div class="card border-0 shadow-sm bg-primary bg-opacity-10 h-100">
            <div class="card-body p-3 d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Trial Balance Total</span>
                    <h3 class="m-0 fw-bold text-primary mt-1">₹@totalDebit.ToString("N2")</h3>
                </div>
                <div class="avatar bg-primary text-white rounded-3 p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                    <i class="fa-solid fa-scale-balanced fs-5"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-md-4">
        <div class="card border-0 shadow-sm bg-success bg-opacity-10 h-100">
            <div class="card-body p-3 d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Net Profit</span>
                    <h3 class="m-0 fw-bold text-success mt-1">₹@netProfit.ToString("N2")</h3>
                </div>
                <div class="avatar bg-success text-white rounded-3 p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                    <i class="fa-solid fa-chart-line-up fs-5"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-md-4">
        <div class="card border-0 shadow-sm bg-info bg-opacity-10 h-100">
            <div class="card-body p-3 d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Total Assets</span>
                    <h3 class="m-0 fw-bold text-info mt-1">₹@(bs?.TotalAssets.ToString("N2") ?? "0.00")</h3>
                </div>
                <div class="avatar bg-info text-white rounded-3 p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                    <i class="fa-solid fa-building-columns fs-5"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<ul class="nav nav-pills mb-4 gap-2 no-print" id="reportTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active fw-bold px-3 py-2 shadow-sm" id="tb-tab" data-bs-toggle="tab" data-bs-target="#tb" type="button" role="tab"><i class="fa-solid fa-list-ol me-1.5"></i> Trial Balance</button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link fw-bold px-3 py-2 shadow-sm" id="pnl-tab" data-bs-toggle="tab" data-bs-target="#pnl" type="button" role="tab"><i class="fa-solid fa-chart-pie me-1.5"></i> Profit & Loss</button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link fw-bold px-3 py-2 shadow-sm" id="bs-tab" data-bs-toggle="tab" data-bs-target="#bs" type="button" role="tab"><i class="fa-solid fa-vault me-1.5"></i> Balance Sheet</button>
    </li>
</ul>

<div class="tab-content" id="reportTabsContent">
    <!-- Trial Balance -->
    <div class="tab-pane fade show active" id="tb" role="tabpanel">
        <div class="card shadow-sm border-0">
            <div class="card-body p-0">
                <div class="table-responsive" style="max-height: 600px;">
                    <table class="table table-hover datatable align-middle mb-0">
                        <thead class="table-light text-uppercase fs-8 fw-bold text-muted sticky-top">
                            <tr>
                                <th class="ps-4">Account Group</th>
                                <th>Ledger Account</th>
                                <th class="text-end">Debit (Dr)</th>
                                <th class="text-end pe-4">Credit (Cr)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if(tb != null)
                            {
                                foreach(var item in tb)
                                {
                                    <tr>
                                        <td class="ps-4 text-muted fs-8">@item.GroupName</td>
                                        <td class="fw-bold text-dark">@item.LedgerName</td>
                                        <td class="text-end text-success fw-bold">@(item.Debit > 0 ? "₹" + item.Debit.ToString("N2") : "-")</td>
                                        <td class="text-end pe-4 text-danger fw-bold">@(item.Credit > 0 ? "₹" + item.Credit.ToString("N2") : "-")</td>
                                    </tr>
                                }
                            }
                        </tbody>
                        <tfoot class="table-light border-top">
                            <tr class="fw-bold fs-7">
                                <td colspan="2" class="text-end ps-4">Total:</td>
                                <td class="text-end text-success fs-6">₹@totalDebit.ToString("N2")</td>
                                <td class="text-end pe-4 text-danger fs-6">₹@totalCredit.ToString("N2")</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Profit & Loss -->
    <div class="tab-pane fade" id="pnl" role="tabpanel">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white p-3 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
                <h6 class="m-0 fw-bold text-primary"><i class="fa-solid fa-file-invoice-dollar me-2"></i> Statement of Profit & Loss</h6>
                <form class="d-flex gap-2" method="get">
                    <input type="date" name="startDate" class="form-control form-control-sm" value="@Model.StartDate" />
                    <input type="date" name="endDate" class="form-control form-control-sm" value="@Model.EndDate" />
                    <button class="btn btn-sm btn-primary px-3 shadow-sm">Filter</button>
                </form>
            </div>
            <div class="card-body p-4 text-center">
                <div class="p-4 bg-success bg-opacity-10 rounded-3 mb-4 d-inline-block px-5 border border-success-subtle">
                    <span class="text-muted small fw-bold text-uppercase">Net Profit</span>
                    <h2 class="fw-bold text-success m-0 mt-1">₹@(pnl?.NetProfit.ToString("N2") ?? "0.00")</h2>
                    <p class="text-muted small m-0 mt-1">For period @Model.StartDate to @Model.EndDate</p>
                </div>
                <div class="row g-4 mt-2">
                    <div class="col-12 col-md-6 border-end">
                        <div class="p-3 bg-light rounded-3">
                            <span class="text-danger fw-bold text-uppercase small"><i class="fa-solid fa-arrow-trend-down me-1"></i> Total Indirect Expenses</span>
                            <h3 class="fw-bold text-dark mt-2 m-0">₹@(pnl?.TotalIndirectExpenses.ToString("N2") ?? "0.00")</h3>
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="p-3 bg-light rounded-3">
                            <span class="text-success fw-bold text-uppercase small"><i class="fa-solid fa-arrow-trend-up me-1"></i> Total Indirect Incomes</span>
                            <h3 class="fw-bold text-dark mt-2 m-0">₹@(pnl?.TotalIndirectIncomes.ToString("N2") ?? "0.00")</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Balance Sheet -->
    <div class="tab-pane fade" id="bs" role="tabpanel">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white p-3 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
                <h6 class="m-0 fw-bold text-primary"><i class="fa-solid fa-building-columns me-2"></i> Balance Sheet</h6>
                <form class="d-flex gap-2" method="get">
                    <input type="date" name="balanceSheetDate" class="form-control form-control-sm" value="@Model.BalanceSheetDate" />
                    <button class="btn btn-sm btn-primary px-3 shadow-sm">Filter</button>
                </form>
            </div>
            <div class="card-body p-4">
                <div class="row g-4">
                    <div class="col-12 col-md-6 border-end">
                        <h5 class="fw-bold text-danger border-bottom pb-2 mb-3"><i class="fa-solid fa-scale-unbalanced me-2"></i> Liabilities</h5>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Capital Account</span>
                            <span class="fw-bold text-dark">₹0.00</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Current Liabilities</span>
                            <span class="fw-bold text-dark">₹0.00</span>
                        </div>
                        <div class="d-flex justify-content-between font-weight-bold border-top pt-3 mt-3 fs-6">
                            <span class="fw-bold text-dark">Total Liabilities</span>
                            <span class="fw-bold text-danger">₹@(bs?.TotalLiabilities.ToString("N2") ?? "0.00")</span>
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <h5 class="fw-bold text-success border-bottom pb-2 mb-3"><i class="fa-solid fa-vault me-2"></i> Assets</h5>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Fixed Assets</span>
                            <span class="fw-bold text-dark">₹0.00</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Current Assets</span>
                            <span class="fw-bold text-dark">₹0.00</span>
                        </div>
                        <div class="d-flex justify-content-between font-weight-bold border-top pt-3 mt-3 fs-6">
                            <span class="fw-bold text-dark">Total Assets</span>
                            <span class="fw-bold text-success">₹@(bs?.TotalAssets.ToString("N2") ?? "0.00")</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

