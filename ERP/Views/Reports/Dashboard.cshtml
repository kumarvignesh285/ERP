@model ERP.ViewModels.Reporting.ReportsDashboardDto
@{
    ViewData["Title"] = "Reports & Analytics Dashboard";
    var filter = (ERP.ViewModels.Reporting.ReportFilterViewModel)(ViewBag.Filter ?? new ERP.ViewModels.Reporting.ReportFilterViewModel());
}

<!-- Print-Only Header -->
<div class="report-print-header">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1 class="company-title">VMR Qubrix ERP</h1>
            <h2 class="report-title">Executive Reports & Analytics Dashboard</h2>
            <div class="report-meta">Generated: @DateTime.Now.ToString("dd-MMM-yyyy HH:mm")</div>
        </div>
    </div>
</div>

<!-- Header with Mode Switcher -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3 no-print">
    <div>
        <div class="d-flex align-items-center gap-2">
            <h4 class="m-0 fw-bold text-dark"><i class="fa-solid fa-chart-line text-primary me-2"></i> Reports & Analytics Dashboard</h4>
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1 rounded-pill fs-8">Advanced Mode</span>
        </div>
        <p class="text-muted small m-0 mt-1">Enterprise reporting overview, liquidity balances, trade trends, and stock alerts.</p>
    </div>

    <div class="d-flex align-items-center gap-2">
        <div class="btn-group shadow-xs" role="group">
            <a href="@Url.Action("Index", "Reports", new { Mode = "Simple" })" class="btn btn-sm btn-outline-secondary">
                <i class="fa-solid fa-store me-1"></i> Simple Mode (Retail)
            </a>
            <button type="button" class="btn btn-sm btn-primary active">
                <i class="fa-solid fa-building me-1"></i> Advanced Mode
            </button>
        </div>
        <button class="btn btn-sm btn-outline-secondary shadow-xs" onclick="window.print()">
            <i class="fa-solid fa-print me-1"></i> Print
        </button>
    </div>
</div>

<!-- Reusable Filter Bar -->
<partial name="_ReportFilterBar" model="filter" />

<!-- 9 Key Summary Metric Cards -->
<div class="row g-3 mb-4 report-summary-cards">
    <div class="col-12 col-sm-6 col-lg-4 col-xl-2-4" style="flex: 1 1 200px;">
        <div class="card border-0 shadow-sm bg-primary bg-opacity-10 h-100">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-muted fs-8 fw-bold text-uppercase">Total Sales</span>
                    <i class="fa-solid fa-cart-shopping text-primary fs-6"></i>
                </div>
                <h4 class="fw-bold text-primary m-0">₹@Model.TotalSales.ToString("N2")</h4>
                <span class="text-muted fs-8">Net Turnover</span>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-lg-4 col-xl-2-4" style="flex: 1 1 200px;">
        <div class="card border-0 shadow-sm bg-info bg-opacity-10 h-100">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-muted fs-8 fw-bold text-uppercase">Total Purchases</span>
                    <i class="fa-solid fa-bag-shopping text-info fs-6"></i>
                </div>
                <h4 class="fw-bold text-info m-0">₹@Model.TotalPurchase.ToString("N2")</h4>
                <span class="text-muted fs-8">Procurement</span>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-lg-4 col-xl-2-4" style="flex: 1 1 200px;">
        <div class="card border-0 shadow-sm bg-success bg-opacity-10 h-100">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-muted fs-8 fw-bold text-uppercase">Gross Trade Margin</span>
                    <i class="fa-solid fa-scale-balanced text-success fs-6"></i>
                </div>
                <h4 class="fw-bold text-success m-0">₹@Model.GrossProfit.ToString("N2")</h4>
                <span class="text-muted fs-8">@(Model.IsGrossProfitReliable ? "Sales vs Purchase" : "Estimated")</span>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-lg-4 col-xl-2-4" style="flex: 1 1 200px;">
        <div class="card border-0 shadow-sm bg-warning bg-opacity-10 h-100">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-muted fs-8 fw-bold text-uppercase">Receivables</span>
                    <i class="fa-solid fa-hand-holding-dollar text-warning fs-6"></i>
                </div>
                <h4 class="fw-bold text-warning m-0">₹@Model.TotalOutstandingReceivable.ToString("N2")</h4>
                <span class="text-muted fs-8">Customer Outstanding</span>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-lg-4 col-xl-2-4" style="flex: 1 1 200px;">
        <div class="card border-0 shadow-sm bg-danger bg-opacity-10 h-100">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-muted fs-8 fw-bold text-uppercase">Payables</span>
                    <i class="fa-solid fa-money-bill-transfer text-danger fs-6"></i>
                </div>
                <h4 class="fw-bold text-danger m-0">₹@Model.TotalOutstandingPayable.ToString("N2")</h4>
                <span class="text-muted fs-8">Supplier Outstanding</span>
            </div>
        </div>
    </div>
</div>

<!-- Secondary KPI Pills -->
<div class="row g-3 mb-4 no-print">
    <div class="col-12 col-sm-4">
        <div class="card border-0 shadow-sm bg-body">
            <div class="card-body p-3 d-flex align-items-center gap-3">
                <div class="avatar bg-primary text-white rounded-3 p-2.5 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                    <i class="fa-solid fa-boxes-stacked fs-5"></i>
                </div>
                <div>
                    <span class="text-muted fs-8 fw-semibold text-uppercase">Active Stock Catalog</span>
                    <h5 class="fw-bold m-0 mt-0.5">@Model.TotalProducts Products</h5>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-4">
        <div class="card border-0 shadow-sm bg-body">
            <div class="card-body p-3 d-flex align-items-center gap-3">
                <div class="avatar bg-warning text-white rounded-3 p-2.5 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                    <i class="fa-solid fa-triangle-exclamation fs-5"></i>
                </div>
                <div>
                    <span class="text-muted fs-8 fw-semibold text-uppercase">Low Stock Alert</span>
                    <h5 class="fw-bold text-warning m-0 mt-0.5">@Model.LowStockCount Items Below Threshold</h5>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-4">
        <div class="card border-0 shadow-sm bg-body">
            <div class="card-body p-3 d-flex align-items-center gap-3">
                <div class="avatar bg-danger text-white rounded-3 p-2.5 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                    <i class="fa-solid fa-circle-xmark fs-5"></i>
                </div>
                <div>
                    <span class="text-muted fs-8 fw-semibold text-uppercase">Out of Stock Alert</span>
                    <h5 class="fw-bold text-danger m-0 mt-0.5">@Model.OutOfStockCount Depleted Items</h5>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Charts Section -->
<div class="row g-4 mb-4 no-print">
    <div class="col-12 col-xl-8">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-transparent border-0 pt-3 px-3 d-flex justify-content-between align-items-center">
                <h6 class="fw-bold m-0 text-dark"><i class="fa-solid fa-chart-area text-primary me-1.5"></i> Sales & Procurement Trend</h6>
                <span class="badge bg-light text-muted border fs-8">Daily Flow</span>
            </div>
            <div class="card-body p-3">
                <div style="height: 280px; position: relative;">
                    <canvas id="salesPurchaseTrendChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-xl-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-transparent border-0 pt-3 px-3 d-flex justify-content-between align-items-center">
                <h6 class="fw-bold m-0 text-dark"><i class="fa-solid fa-chart-pie text-success me-1.5"></i> Payment Terms / Mode</h6>
                <span class="badge bg-light text-muted border fs-8">Breakdown</span>
            </div>
            <div class="card-body p-3 d-flex flex-column align-items-center justify-content-center">
                <div style="height: 220px; width: 100%; position: relative;">
                    <canvas id="paymentModeChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Tables: Top Products, Top Customers, Stock Alerts -->
<div class="row g-4 mb-4">
    <!-- Top 10 Selling Products -->
    <div class="col-12 col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-transparent border-0 pt-3 px-3 d-flex justify-content-between align-items-center">
                <h6 class="fw-bold m-0 text-dark"><i class="fa-solid fa-trophy text-warning me-1.5"></i> Top 10 Selling Products</h6>
                <a href="@Url.Action("Sales", "Reports", new { reportType = "ProductWise" })" class="fs-8 text-primary fw-semibold text-decoration-none no-print">View All <i class="fa-solid fa-arrow-right"></i></a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 fs-8">
                        <thead class="bg-light">
                            <tr>
                                <th>Product</th>
                                <th>Category</th>
                                <th class="text-end">Qty Sold</th>
                                <th class="text-end">Revenue</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.TopProducts.Any())
                            {
                                foreach (var p in Model.TopProducts)
                                {
                                    <tr>
                                        <td>
                                            <span class="fw-bold text-dark d-block">@p.ProductName</span>
                                            <span class="text-muted fs-9">@p.ProductCode</span>
                                        </td>
                                        <td><span class="badge bg-light text-secondary border">@p.CategoryName</span></td>
                                        <td class="text-end fw-semibold">@p.QuantitySold.ToString("N0")</td>
                                        <td class="text-end fw-bold text-success">₹@p.Revenue.ToString("N2")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-4 text-muted">No sales recorded for this period.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Top Customers -->
    <div class="col-12 col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-transparent border-0 pt-3 px-3 d-flex justify-content-between align-items-center">
                <h6 class="fw-bold m-0 text-dark"><i class="fa-solid fa-users text-primary me-1.5"></i> Top Customers</h6>
                <a href="@Url.Action("Sales", "Reports", new { reportType = "CustomerWise" })" class="fs-8 text-primary fw-semibold text-decoration-none no-print">View All <i class="fa-solid fa-arrow-right"></i></a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 fs-8">
                        <thead class="bg-light">
                            <tr>
                                <th>Customer</th>
                                <th class="text-center">Bills</th>
                                <th class="text-end">Total Sales</th>
                                <th class="text-end">Outstanding</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.TopCustomers.Any())
                            {
                                foreach (var c in Model.TopCustomers)
                                {
                                    <tr>
                                        <td>
                                            <span class="fw-bold text-dark d-block">@c.CustomerName</span>
                                            <span class="text-muted fs-9">@c.CustomerCode</span>
                                        </td>
                                        <td class="text-center">@c.InvoiceCount</td>
                                        <td class="text-end fw-bold text-primary">₹@c.TotalSalesAmount.ToString("N2")</td>
                                        <td class="text-end fw-semibold @(c.BalanceAmount > 0 ? "text-danger" : "text-muted")">
                                            ₹@c.BalanceAmount.ToString("N2")
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-4 text-muted">No customer transactions found.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Stock Alerts & Recent Activity -->
<div class="row g-4 mb-4">
    <!-- Stock Alerts -->
    <div class="col-12 col-lg-7">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-transparent border-0 pt-3 px-3 d-flex justify-content-between align-items-center">
                <h6 class="fw-bold m-0 text-dark"><i class="fa-solid fa-triangle-exclamation text-warning me-1.5"></i> Stock Critical Alerts</h6>
                <a href="@Url.Action("Inventory", "Reports", new { reportType = "LowStock" })" class="fs-8 text-primary fw-semibold text-decoration-none no-print">View All <i class="fa-solid fa-arrow-right"></i></a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 fs-8">
                        <thead class="bg-light">
                            <tr>
                                <th>Product</th>
                                <th>Warehouse</th>
                                <th class="text-end">Stock</th>
                                <th class="text-end">Min / Reorder</th>
                                <th class="text-center">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.StockAlerts.Any())
                            {
                                foreach (var a in Model.StockAlerts)
                                {
                                    <tr>
                                        <td>
                                            <span class="fw-bold text-dark d-block">@a.ProductName</span>
                                            <span class="text-muted fs-9">@a.ProductCode</span>
                                        </td>
                                        <td><span class="badge bg-light text-secondary border">@a.WarehouseName</span></td>
                                        <td class="text-end fw-bold @(a.CurrentStock <= 0 ? "text-danger" : "text-warning")">
                                            @a.CurrentStock.ToString("N2") @a.UnitName
                                        </td>
                                        <td class="text-end text-muted">
                                            @a.MinimumStock.ToString("N0") / @a.ReorderLevel.ToString("N0")
                                        </td>
                                        <td class="text-center">
                                            @if (a.CurrentStock <= 0)
                                            {
                                                <span class="badge bg-danger text-white rounded-pill">Out of Stock</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning text-dark rounded-pill">Low Stock</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-4 text-success"><i class="fa-solid fa-circle-check me-1"></i> All product inventory levels are optimal!</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Audit Activity -->
    <div class="col-12 col-lg-5">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-transparent border-0 pt-3 px-3 d-flex justify-content-between align-items-center">
                <h6 class="fw-bold m-0 text-dark"><i class="fa-solid fa-clock-rotate-left text-info me-1.5"></i> Recent Business Activity</h6>
                <a href="@Url.Action("Audit", "Reports", new { reportType = "AuditTrail" })" class="fs-8 text-primary fw-semibold text-decoration-none no-print">Audit Log <i class="fa-solid fa-arrow-right"></i></a>
            </div>
            <div class="card-body p-3">
                @if (Model.RecentActivity.Any())
                {
                    <div class="list-group list-group-flush fs-8">
                        @foreach (var act in Model.RecentActivity)
                        {
                            <div class="list-group-item px-0 py-2 border-bottom">
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="fw-semibold text-dark">
                                        <span class="badge @(act.Action == "DELETE" ? "bg-danger" : act.Action == "CREATE" ? "bg-success" : "bg-primary") me-1">@act.Action</span>
                                        @act.Module - @act.EntityName
                                    </span>
                                    <span class="text-muted fs-9">@act.Timestamp.ToString("dd-MMM HH:mm")</span>
                                </div>
                                <p class="m-0 text-muted fs-8 mt-1 text-truncate">@act.Description</p>
                                <span class="fs-9 text-secondary">By @act.UserName</span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-4 text-muted">No recent activity recorded.</div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Trend Line Chart
            var trendCtx = document.getElementById('salesPurchaseTrendChart');
            if (trendCtx) {
                var labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SalesTrend.Select(x => x.DateLabel)));
                var salesData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SalesTrend.Select(x => x.SalesAmount)));
                var purchaseData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PurchaseTrend.Select(x => x.PurchaseAmount)));

                new Chart(trendCtx, {
                    type: 'line',
                    data: {
                        labels: labels,
                        datasets: [
                            {
                                label: 'Net Sales (₹)',
                                data: salesData,
                                borderColor: '#0d6efd',
                                backgroundColor: 'rgba(13, 110, 253, 0.1)',
                                tension: 0.3,
                                fill: true,
                                borderWidth: 2
                            },
                            {
                                label: 'Net Purchases (₹)',
                                data: purchaseData,
                                borderColor: '#0dcaf0',
                                backgroundColor: 'rgba(13, 202, 240, 0.05)',
                                tension: 0.3,
                                fill: true,
                                borderWidth: 2
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { position: 'top' }
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                ticks: {
                                    callback: function(value) { return '₹' + value.toLocaleString(); }
                                }
                            }
                        }
                    }
                });
            }

            // Payment Mode Doughnut
            var paymentCtx = document.getElementById('paymentModeChart');
            if (paymentCtx) {
                var paymentModes = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PaymentModeBreakdown.Keys));
                var paymentAmounts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PaymentModeBreakdown.Values));

                if (paymentModes.length === 0) {
                    paymentModes = ["Direct / Cash", "Credit"];
                    paymentAmounts = [1, 0];
                }

                new Chart(paymentCtx, {
                    type: 'doughnut',
                    data: {
                        labels: paymentModes,
                        datasets: [{
                            data: paymentAmounts,
                            backgroundColor: ['#0d6efd', '#198754', '#ffc107', '#0dcaf0', '#6f42c1', '#d63384']
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { position: 'bottom' }
                        }
                    }
                });
            }
        });
    </script>
}
