@model ERP.Models.Company
@{
    ViewData["Title"] = "Company Profile";
}

<div class="card max-width-800 mx-auto">
    <div class="card-header bg-primary text-white">
        <i class="fa-solid fa-building me-2"></i> Company Profile Setup
    </div>
    <div class="card-body">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }
        
        <form asp-action="Company" method="post">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="CreatedBy" />
            <input type="hidden" asp-for="CreatedAt" />
            
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="CompanyName" class="form-label font-weight-semibold">Company Name *</label>
                    <input asp-for="CompanyName" class="form-control" required />
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="CompanyCode" class="form-label font-weight-semibold">Company Code *</label>
                    <input asp-for="CompanyCode" class="form-control" required />
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="GSTNumber" class="form-label font-weight-semibold">GSTIN</label>
                    <input asp-for="GSTNumber" class="form-control" />
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="PANNumber" class="form-label font-weight-semibold">PAN Number</label>
                    <input asp-for="PANNumber" class="form-control" />
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Email" class="form-label font-weight-semibold">Email</label>
                    <input asp-for="Email" type="email" class="form-control" />
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Phone" class="form-label font-weight-semibold">Phone Number</label>
                    <input asp-for="Phone" class="form-control" />
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Address" class="form-label font-weight-semibold">Address</label>
                <textarea asp-for="Address" class="form-control" rows="2"></textarea>
            </div>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="City" class="form-label font-weight-semibold">City</label>
                    <input asp-for="City" class="form-control" />
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="State" class="form-label font-weight-semibold">State</label>
                    <input asp-for="State" class="form-control" />
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="Country" class="form-label font-weight-semibold">Country</label>
                    <input asp-for="Country" class="form-control" />
                </div>
            </div>

            <div class="text-end">
                <button type="submit" class="btn btn-primary px-4">
                    <i class="fa-solid fa-save me-2"></i> Save Profile
                </button>
            </div>
        </form>
    </div>
</div>
