@model IEnumerable<ERP.Models.Customer>
@{
    ViewData["Title"] = "Customer Master";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="m-0 font-weight-bold text-primary"><i class="fa-solid fa-users me-2"></i> Customers List</h4>
    <button class="btn btn-primary" onclick="openModal()"><i class="fa-solid fa-plus me-1"></i> Add Customer</button>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover datatable align-middle">
                <thead>
                    <tr>
                        <th>Code</th>
                        <th>Name</th>
                        <th>Mobile</th>
                        <th>Email</th>
                        <th>GSTIN</th>
                        <th>City</th>
                        <th>Balance</th>
                        <th class="text-center no-print">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        <tr id="row-@c.Id">
                            <td class="font-weight-semibold">@c.CustomerCode</td>
                            <td>@c.CustomerName</td>
                            <td>@c.MobileNumber</td>
                            <td>@c.Email</td>
                            <td>@c.GSTNumber</td>
                            <td>@c.City</td>
                            <td>₹@c.OpeningBalance.ToString("N2") (@c.BalanceType)</td>
                            <td class="text-center no-print">
                                <div class="btn-group">
                                    <button class="btn btn-sm btn-outline-primary" onclick="editCustomer(@Json.Serialize(c))"><i class="fa-solid fa-pen-to-square"></i></button>
                                    <button class="btn btn-sm btn-outline-danger" onclick="deleteCustomer(@c.Id)"><i class="fa-solid fa-trash"></i></button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Dialog -->
<div class="modal fade" id="customerModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="modalTitle">Add Customer</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="SaveCustomer" method="post" id="customerForm">
                <div class="modal-body">
                    <input type="hidden" id="Id" name="Id" value="0" />
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label font-weight-semibold">Customer Code *</label>
                            <input type="text" id="CustomerCode" name="CustomerCode" class="form-control" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label font-weight-semibold">Customer Name *</label>
                            <input type="text" id="CustomerName" name="CustomerName" class="form-control" required />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label font-weight-semibold">Contact Person</label>
                            <input type="text" id="ContactPerson" name="ContactPerson" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label font-weight-semibold">Mobile Number</label>
                            <input type="text" id="MobileNumber" name="MobileNumber" class="form-control" />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label font-weight-semibold">Email</label>
                            <input type="email" id="Email" name="Email" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label font-weight-semibold">GSTIN</label>
                            <input type="text" id="GSTNumber" name="GSTNumber" class="form-control" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label font-weight-semibold">Address</label>
                        <textarea id="Address" name="Address" class="form-control" rows="2"></textarea>
                    </div>
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label font-weight-semibold">City</label>
                            <input type="text" id="City" name="City" class="form-control" />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label font-weight-semibold">State</label>
                            <input type="text" id="State" name="State" class="form-control" />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label font-weight-semibold">Credit Limit</label>
                            <input type="number" id="CreditLimit" name="CreditLimit" class="form-control" value="0" step="0.01" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var bootstrapModal;
        document.addEventListener("DOMContentLoaded", function () {
            bootstrapModal = new bootstrap.Modal(document.getElementById('customerModal'));
        });

        function openModal() {
            document.getElementById('customerForm').reset();
            document.getElementById('Id').value = "0";
            document.getElementById('modalTitle').innerText = "Add Customer";
            bootstrapModal.show();
        }

        function editCustomer(customer) {
            document.getElementById('customerForm').reset();
            document.getElementById('Id').value = window.getVal(customer, 'id');
            document.getElementById('CustomerCode').value = window.getVal(customer, 'customerCode');
            document.getElementById('CustomerName').value = window.getVal(customer, 'customerName');
            document.getElementById('ContactPerson').value = window.getVal(customer, 'contactPerson') || "";
            document.getElementById('MobileNumber').value = window.getVal(customer, 'mobileNumber') || "";
            document.getElementById('Email').value = window.getVal(customer, 'email') || "";
            document.getElementById('GSTNumber').value = window.getVal(customer, 'gstNumber') || "";
            document.getElementById('Address').value = window.getVal(customer, 'address') || "";
            document.getElementById('City').value = window.getVal(customer, 'city') || "";
            document.getElementById('State').value = window.getVal(customer, 'state') || "";
            document.getElementById('CreditLimit').value = window.getVal(customer, 'creditLimit') || 0;
            document.getElementById('modalTitle').innerText = "Edit Customer";
            bootstrapModal.show();
        }

        function deleteCustomer(id) {
            Swal.fire({
                title: 'Are you sure?',
                text: "Do you want to delete this customer?",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Yes, delete!'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.post('/Masters/DeleteCustomer', { id: id }, function (res) {
                        if (res.success) {
                            Swal.fire('Deleted!', 'Customer has been deleted.', 'success');
                            $('#row-' + id).fadeOut(300, function() { $(this).remove(); });
                        } else {
                            Swal.fire('Error!', 'Failed to delete.', 'error');
                        }
                    });
                }
            });
        }
    </script>
}
