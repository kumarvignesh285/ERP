@model IEnumerable<ERP.Models.Customer>
@inject ERP.Interfaces.IPermissionService PermissionService
@{
    ViewData["Title"] = "Customer Master";
    var canCreate = await PermissionService.HasPermissionAsync(User, "Customer Master", "Edit");
    var canEdit = await PermissionService.HasPermissionAsync(User, "Customer Master", "Edit");
    var canDelete = await PermissionService.HasPermissionAsync(User, "Customer Master", "Delete");
}

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="m-0 fw-bold text-primary"><i class="fa-solid fa-users me-2"></i> Customer Master</h4>
        <p class="text-muted small m-0 mt-1">Manage client accounts, contact details, GSTIN, credit limits, and balances</p>
    </div>
    @if (canCreate)
    {
        <button class="btn btn-primary shadow-sm" onclick="openModal()">
            <i class="fa-solid fa-user-plus me-1.5"></i> Add New Customer
        </button>
    }
</div>

<!-- Filters Row -->
<div class="card mb-3 no-print shadow-sm border-0">
    <div class="card-body p-3">
        <div class="row g-3 align-items-center">
            <div class="col-12 col-md-8">
                <label class="form-label fw-semibold mb-1 small text-muted">Filter by City</label>
                <select id="filterCity" class="form-select form-select-sm select2">
                    <option value="">All Cities</option>
                    @foreach (var city in Model.Where(c => !string.IsNullOrEmpty(c.City)).Select(c => c.City).Distinct())
                    {
                        <option value="@city">@city</option>
                    }
                </select>
            </div>
            <div class="col-12 col-md-4 d-flex gap-2 align-self-end">
                <button class="btn btn-sm btn-primary w-100" onclick="applyFilters()"><i class="fa-solid fa-filter me-1"></i> Filter</button>
                <button class="btn btn-sm btn-outline-secondary w-100" onclick="resetFilters()"><i class="fa-solid fa-rotate me-1"></i> Reset</button>
            </div>
        </div>
    </div>
</div>

<!-- Datatable Card -->
<div class="card shadow-sm border-0">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover datatable align-middle">
                <thead class="table-light text-uppercase fs-8 fw-bold text-muted">
                    <tr>
                        <th>Code</th>
                        <th>Name</th>
                        <th>Mobile</th>
                        <th>Email</th>
                        <th>GSTIN</th>
                        <th>City</th>
                        <th>Balance</th>
                        <th class="text-center no-print">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        <tr id="row-@c.Id">
                            <td class="fw-bold text-primary">@c.CustomerCode</td>
                            <td class="fw-semibold text-dark">@c.CustomerName</td>
                            <td><i class="fa-solid fa-phone fs-8 text-muted me-1"></i>@c.MobileNumber</td>
                            <td>@c.Email</td>
                            <td><span class="font-monospace fs-8 text-uppercase">@(string.IsNullOrEmpty(c.GSTNumber) ? "-" : c.GSTNumber)</span></td>
                            <td>@c.City</td>
                            <td><span class="fw-semibold">₹@c.OpeningBalance.ToString("N2")</span> <small class="text-muted">(@c.BalanceType)</small></td>
                            <td class="text-center no-print">
                                <div class="btn-group">
                                    @if (canEdit)
                                    {
                                        <button class="btn btn-sm btn-outline-primary" data-item="@System.Text.Json.JsonSerializer.Serialize(new { c.Id, c.CustomerCode, c.CustomerName, c.ContactPerson, c.MobileNumber, c.Email, c.GSTNumber, c.Address, c.City, c.State, c.CreditLimit })" onclick="editCustomer(this)" title="Edit"><i class="fa-solid fa-pen-to-square"></i></button>
                                    }
                                    @if (canDelete)
                                    {
                                        <button class="btn btn-sm btn-outline-danger" onclick="deleteCustomer(@c.Id)" title="Delete"><i class="fa-solid fa-trash"></i></button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Dialog -->
<div class="modal fade" id="customerModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white py-3">
                <h5 class="modal-title fw-bold" id="modalTitle"><i class="fa-solid fa-user-plus me-2"></i> Add Customer</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="SaveCustomer" method="post" id="customerForm">
                <div class="modal-body p-4">
                    <input type="hidden" id="Id" name="Id" value="0" />
                    
                    <div class="row g-3 mb-3">
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold text-dark">Customer Code <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-barcode text-muted"></i></span>
                                <input type="text" id="CustomerCode" name="CustomerCode" class="form-control border-start-0" placeholder="e.g. CUST-001" required />
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold text-dark">Customer Name <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-user text-muted"></i></span>
                                <input type="text" id="CustomerName" name="CustomerName" class="form-control border-start-0" placeholder="Business / Personal Name" required />
                            </div>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold text-dark">Contact Person</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="fa-regular fa-user text-muted"></i></span>
                                <input type="text" id="ContactPerson" name="ContactPerson" class="form-control border-start-0" placeholder="Key contact name" />
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold text-dark">Mobile Number</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-phone text-muted"></i></span>
                                <input type="text" id="MobileNumber" name="MobileNumber" class="form-control border-start-0" placeholder="+91 98765 43210" />
                            </div>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold text-dark">Email Address</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="fa-regular fa-envelope text-muted"></i></span>
                                <input type="email" id="Email" name="Email" class="form-control border-start-0" placeholder="client@company.com" />
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold text-dark">GSTIN Number</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-file-invoice text-muted"></i></span>
                                <input type="text" id="GSTNumber" name="GSTNumber" class="form-control border-start-0 text-uppercase" placeholder="33AAAAA0000A1Z5" />
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-dark">Billing Address</label>
                        <textarea id="Address" name="Address" class="form-control" rows="2" placeholder="Street address, building, area..."></textarea>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-12 col-sm-4">
                            <label class="form-label fw-semibold text-dark">City</label>
                            <input type="text" id="City" name="City" class="form-control" placeholder="Chennai" />
                        </div>
                        <div class="col-12 col-sm-4">
                            <label class="form-label fw-semibold text-dark">State</label>
                            <input type="text" id="State" name="State" class="form-control" placeholder="Tamil Nadu" />
                        </div>
                        <div class="col-12 col-sm-4">
                            <label class="form-label fw-semibold text-dark">Credit Limit (₹)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0">₹</span>
                                <input type="number" id="CreditLimit" name="CreditLimit" class="form-control border-start-0" value="0" step="0.01" />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light border-top py-2 px-4">
                    <button type="button" class="btn btn-secondary px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary px-4 shadow-sm" id="submitBtn">Save Customer</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var bootstrapModal;
        $(function () {
            bootstrapModal = new bootstrap.Modal(document.getElementById('customerModal'));

            $('#customerForm').on('submit', function (e) {
                e.preventDefault();
                ErpApp.submitForm(this, {
                    modal: bootstrapModal,
                    reloadPage: true
                });
            });
        });

        function openModal() {
            ErpApp.clearFieldErrors('#customerForm');
            document.getElementById('customerForm').reset();
            document.getElementById('Id').value = "0";
            document.getElementById('modalTitle').innerHTML = '<i class="fa-solid fa-user-plus me-2"></i> Add Customer';
            document.getElementById('submitBtn').innerText = "Save Customer";
            bootstrapModal.show();
        }

        function editCustomer(btn) {
            ErpApp.clearFieldErrors('#customerForm');
            var customer = $(btn).data('item');
            document.getElementById('customerForm').reset();
            document.getElementById('Id').value = window.getVal(customer, 'id');
            document.getElementById('CustomerCode').value = window.getVal(customer, 'customerCode');
            document.getElementById('CustomerName').value = window.getVal(customer, 'customerName');
            document.getElementById('ContactPerson').value = window.getVal(customer, 'contactPerson') || "";
            document.getElementById('MobileNumber').value = window.getVal(customer, 'mobileNumber') || "";
            document.getElementById('Email').value = window.getVal(customer, 'email') || "";
            document.getElementById('GSTNumber').value = window.getVal(customer, 'gstNumber') || "";
            document.getElementById('Address').value = window.getVal(customer, 'address') || "";
            document.getElementById('City').value = window.getVal(customer, 'city') || "";
            document.getElementById('State').value = window.getVal(customer, 'state') || "";
            document.getElementById('CreditLimit').value = window.getVal(customer, 'creditLimit') || 0;
            document.getElementById('modalTitle').innerHTML = '<i class="fa-solid fa-pen-to-square me-2"></i> Edit Customer';
            document.getElementById('submitBtn').innerText = "Save Changes";
            bootstrapModal.show();
        }

        function deleteCustomer(id) {
            ErpApp.confirmDelete({
                url: '/Masters/DeleteCustomer',
                id: id,
                rowElement: '#row-' + id,
                message: 'Do you want to delete this customer record?'
            });
        }
    </script>
}
