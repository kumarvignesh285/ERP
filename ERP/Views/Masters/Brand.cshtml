@model IEnumerable<ERP.Models.Brand>
@{
    ViewData["Title"] = "Brand Master";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="m-0 font-weight-bold text-primary"><i class="fa-solid fa-copyright me-2"></i> Brands List</h4>
    <button class="btn btn-primary" onclick="openModal()"><i class="fa-solid fa-plus me-1"></i> Add Brand</button>
</div>

<div class="card max-width-600 mx-auto">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover datatable align-middle">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Brand Name</th>
                        <th class="text-center no-print">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in Model)
                    {
                        <tr id="row-@b.Id">
                            <td>@b.Id</td>
                            <td class="font-weight-semibold">@b.BrandName</td>
                            <td class="text-center no-print">
                                <div class="btn-group">
                                    <button class="btn btn-sm btn-outline-primary" onclick="editBrand(@Json.Serialize(b))"><i class="fa-solid fa-pen-to-square"></i></button>
                                    <button class="btn btn-sm btn-outline-danger" onclick="deleteBrand(@b.Id)"><i class="fa-solid fa-trash"></i></button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Dialog -->
<div class="modal fade" id="brandModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="modalTitle">Add Brand</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="SaveBrand" method="post" id="brandForm">
                <div class="modal-body">
                    <input type="hidden" id="Id" name="Id" value="0" />
                    <div class="mb-3">
                        <label class="form-label font-weight-semibold">Brand Name *</label>
                        <input type="text" id="BrandName" name="BrandName" class="form-control" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var bootstrapModal;
        $(function () {
            bootstrapModal = new bootstrap.Modal(document.getElementById('brandModal'));
        });

        function openModal() {
            document.getElementById('brandForm').reset();
            document.getElementById('Id').value = "0";
            document.getElementById('modalTitle').innerText = "Add Brand";
            bootstrapModal.show();
        }

        function editBrand(b) {
            document.getElementById('Id').value = window.getVal(b, 'id');
            document.getElementById('BrandName').value = window.getVal(b, 'brandName');
            document.getElementById('modalTitle').innerText = "Edit Brand";
            bootstrapModal.show();
        }

        function deleteBrand(id) {
            Swal.fire({
                title: 'Are you sure?',
                text: "Do you want to delete this brand?",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Yes, delete!'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.post('/Masters/DeleteBrand', { id: id }, function (res) {
                        if (res.success) {
                            Swal.fire('Deleted!', 'Brand has been deleted.', 'success');
                            $('#row-' + id).fadeOut(300, function() { $(this).remove(); });
                        } else {
                            Swal.fire('Error!', 'Failed to delete.', 'error');
                        }
                    });
                }
            });
        }
    </script>
}
