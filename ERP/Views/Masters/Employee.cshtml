@model IEnumerable<ERP.Models.Employee>
@{
    ViewData["Title"] = "Employee Master";
}

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="m-0 fw-bold text-primary"><i class="fa-solid fa-user-tie me-2"></i> Employee Master</h4>
        <p class="text-muted small m-0 mt-1">Manage staff directory, department assignments, and contact details</p>
    </div>
    <button class="btn btn-primary shadow-sm" onclick="openModal()">
        <i class="fa-solid fa-user-plus me-1.5"></i> Add New Employee
    </button>
</div>

<!-- Filters Row -->
<div class="card mb-3 no-print shadow-sm border-0">
    <div class="card-body p-3">
        <div class="row g-3 align-items-center">
            <div class="col-12 col-md-4">
                <label class="form-label fw-semibold mb-1 small text-muted">Department</label>
                <select id="filterDepartment" class="form-select form-select-sm select2">
                    <option value="">All Departments</option>
                    @foreach (var dept in Model.Where(e => !string.IsNullOrEmpty(e.Department)).Select(e => e.Department).Distinct())
                    {
                        <option value="@dept">@dept</option>
                    }
                </select>
            </div>
            <div class="col-12 col-md-4">
                <label class="form-label fw-semibold mb-1 small text-muted">Designation</label>
                <select id="filterDesignation" class="form-select form-select-sm select2">
                    <option value="">All Designations</option>
                    @foreach (var desig in Model.Where(e => !string.IsNullOrEmpty(e.Designation)).Select(e => e.Designation).Distinct())
                    {
                        <option value="@desig">@desig</option>
                    }
                </select>
            </div>
            <div class="col-12 col-md-4 d-flex gap-2 align-self-end">
                <button class="btn btn-sm btn-primary w-100" onclick="applyFilters()"><i class="fa-solid fa-filter me-1"></i> Filter</button>
                <button class="btn btn-sm btn-outline-secondary w-100" onclick="resetFilters()"><i class="fa-solid fa-rotate me-1"></i> Reset</button>
            </div>
        </div>
    </div>
</div>

<!-- Datatable Card -->
<div class="card shadow-sm border-0">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover datatable align-middle">
                <thead class="table-light text-uppercase fs-8 fw-bold text-muted">
                    <tr>
                        <th>Code</th>
                        <th>Name</th>
                        <th>Designation</th>
                        <th>Department</th>
                        <th>Mobile</th>
                        <th>Email</th>
                        <th class="text-center no-print" style="width: 120px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in Model)
                    {
                        <tr id="row-@e.Id">
                            <td class="fw-bold text-primary">@e.EmployeeCode</td>
                            <td class="fw-bold text-dark">@e.EmployeeName</td>
                            <td><span class="badge bg-light text-secondary border">@e.Designation</span></td>
                            <td><span class="badge bg-light text-secondary border">@e.Department</span></td>
                            <td><i class="fa-solid fa-phone fs-8 text-muted me-1"></i>@e.Mobile</td>
                            <td>@e.Email</td>
                            <td class="text-center no-print">
                                <div class="btn-group">
                                    <button class="btn btn-sm btn-outline-primary" data-item="@System.Text.Json.JsonSerializer.Serialize(new { e.Id, e.EmployeeCode, e.EmployeeName, e.Designation, e.Department, e.Mobile, e.Email })" onclick="editEmployee(this)" title="Edit"><i class="fa-solid fa-pen-to-square"></i></button>
                                    <button class="btn btn-sm btn-outline-danger" onclick="deleteEmployee(@e.Id)" title="Delete"><i class="fa-solid fa-trash"></i></button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Dialog -->
<div class="modal fade" id="employeeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white py-3">
                <h5 class="modal-title fw-bold" id="modalTitle"><i class="fa-solid fa-user-tie me-2"></i> Add Employee</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="SaveEmployee" method="post" id="employeeForm">
                <div class="modal-body p-4">
                    <input type="hidden" id="Id" name="Id" value="0" />
                    
                    <div class="row g-3 mb-3">
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold text-dark">Employee Code <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-id-badge text-muted"></i></span>
                                <input type="text" id="EmployeeCode" name="EmployeeCode" class="form-control border-start-0" placeholder="e.g. EMP-001" required />
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold text-dark">Employee Name <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-user text-muted"></i></span>
                                <input type="text" id="EmployeeName" name="EmployeeName" class="form-control border-start-0" placeholder="Full Name" required />
                            </div>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold text-dark">Designation</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-briefcase text-muted"></i></span>
                                <input type="text" id="Designation" name="Designation" class="form-control border-start-0" placeholder="e.g. Sales Executive, Manager" />
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold text-dark">Department</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-sitemap text-muted"></i></span>
                                <input type="text" id="Department" name="Department" class="form-control border-start-0" placeholder="e.g. Sales, Accounts, Warehouse" />
                            </div>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold text-dark">Mobile Number</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-phone text-muted"></i></span>
                                <input type="text" id="Mobile" name="Mobile" class="form-control border-start-0" placeholder="+91 98765 43210" />
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold text-dark">Email Address</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="fa-regular fa-envelope text-muted"></i></span>
                                <input type="email" id="Email" name="Email" class="form-control border-start-0" placeholder="employee@company.com" />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light border-top py-2 px-4">
                    <button type="button" class="btn btn-secondary px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary px-4 shadow-sm" id="submitBtn">Save Employee</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var bootstrapModal;
        $(function () {
            bootstrapModal = new bootstrap.Modal(document.getElementById('employeeModal'));

            $('#employeeForm').on('submit', function (e) {
                e.preventDefault();
                ErpApp.submitForm(this, {
                    modal: bootstrapModal,
                    reloadPage: true
                });
            });
        });

        function openModal() {
            ErpApp.clearFieldErrors('#employeeForm');
            document.getElementById('employeeForm').reset();
            document.getElementById('Id').value = "0";
            document.getElementById('modalTitle').innerHTML = '<i class="fa-solid fa-user-tie me-2"></i> Add Employee';
            document.getElementById('submitBtn').innerText = "Save Employee";
            bootstrapModal.show();
        }

        function editEmployee(btn) {
            ErpApp.clearFieldErrors('#employeeForm');
            var e = $(btn).data('item');
            document.getElementById('employeeForm').reset();
            document.getElementById('Id').value = window.getVal(e, 'id');
            document.getElementById('EmployeeCode').value = window.getVal(e, 'employeeCode');
            document.getElementById('EmployeeName').value = window.getVal(e, 'employeeName');
            document.getElementById('Designation').value = window.getVal(e, 'designation') || "";
            document.getElementById('Department').value = window.getVal(e, 'department') || "";
            document.getElementById('Mobile').value = window.getVal(e, 'mobile') || "";
            document.getElementById('Email').value = window.getVal(e, 'email') || "";
            document.getElementById('modalTitle').innerHTML = '<i class="fa-solid fa-pen-to-square me-2"></i> Edit Employee';
            document.getElementById('submitBtn').innerText = "Save Changes";
            bootstrapModal.show();
        }

        function deleteEmployee(id) {
            ErpApp.confirmDelete({
                url: '/Masters/DeleteEmployee',
                id: id,
                rowElement: '#row-' + id,
                message: 'Do you want to delete this employee record?'
            });
        }
    </script>
}
