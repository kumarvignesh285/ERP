@model IEnumerable<ERP.Models.Employee>
@{
    ViewData["Title"] = "Employee Master";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="m-0 font-weight-bold text-primary"><i class="fa-solid fa-user-tie me-2"></i> Employees List</h4>
    <button class="btn btn-primary" onclick="openModal()"><i class="fa-solid fa-plus me-1"></i> Add Employee</button>
</div>

<!-- Filters Row -->
<div class="card mb-3 no-print">
    <div class="card-body p-3">
        <div class="row g-2 align-items-center">
            <div class="col-md-4">
                <label class="form-label font-weight-semibold mb-1 small text-muted">Department</label>
                <select id="filterDepartment" class="form-select form-select-sm select2">
                    <option value="">All Departments</option>
                    @foreach (var dept in Model.Where(e => !string.IsNullOrEmpty(e.Department)).Select(e => e.Department).Distinct())
                    {
                        <option value="@dept">@dept</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label font-weight-semibold mb-1 small text-muted">Designation</label>
                <select id="filterDesignation" class="form-select form-select-sm select2">
                    <option value="">All Designations</option>
                    @foreach (var desig in Model.Where(e => !string.IsNullOrEmpty(e.Designation)).Select(e => e.Designation).Distinct())
                    {
                        <option value="@desig">@desig</option>
                    }
                </select>
            </div>
            <div class="col-md-4 d-flex gap-2 align-self-end">
                <button class="btn btn-sm btn-primary w-100" onclick="applyFilters()"><i class="fa-solid fa-filter me-1"></i> Filter</button>
                <button class="btn btn-sm btn-outline-secondary w-100" onclick="resetFilters()"><i class="fa-solid fa-rotate me-1"></i> Reset</button>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover datatable align-middle">
                <thead>
                    <tr>
                        <th>Code</th>
                        <th>Name</th>
                        <th>Designation</th>
                        <th>Department</th>
                        <th>Mobile</th>
                        <th>Email</th>
                        <th class="text-center no-print">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in Model)
                    {
                        <tr id="row-@e.Id">
                            <td class="font-weight-bold">@e.EmployeeCode</td>
                            <td class="font-weight-semibold text-dark">@e.EmployeeName</td>
                            <td>@e.Designation</td>
                            <td>@e.Department</td>
                            <td>@e.Mobile</td>
                            <td>@e.Email</td>
                            <td class="text-center no-print">
                                <div class="btn-group">
                                    <button class="btn btn-sm btn-outline-primary" data-item="@System.Text.Json.JsonSerializer.Serialize(new { e.Id, e.EmployeeCode, e.EmployeeName, e.Designation, e.Department, e.Mobile, e.Email })" onclick="editEmployee(this)"><i class="fa-solid fa-pen-to-square"></i></button>
                                    <button class="btn btn-sm btn-outline-danger" onclick="deleteEmployee(@e.Id)"><i class="fa-solid fa-trash"></i></button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Dialog -->
<div class="modal fade" id="employeeModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="modalTitle">Add Employee</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="SaveEmployee" method="post" id="employeeForm">
                <div class="modal-body">
                    <input type="hidden" id="Id" name="Id" value="0" />
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label font-weight-semibold">Employee Code *</label>
                            <input type="text" id="EmployeeCode" name="EmployeeCode" class="form-control" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label font-weight-semibold">Employee Name *</label>
                            <input type="text" id="EmployeeName" name="EmployeeName" class="form-control" required />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label font-weight-semibold">Designation</label>
                            <input type="text" id="Designation" name="Designation" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label font-weight-semibold">Department</label>
                            <input type="text" id="Department" name="Department" class="form-control" />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label font-weight-semibold">Mobile Number</label>
                            <input type="text" id="Mobile" name="Mobile" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label font-weight-semibold">Email</label>
                            <input type="email" id="Email" name="Email" class="form-control" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary" id="submitBtn">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var bootstrapModal;
        $(function () {
            bootstrapModal = new bootstrap.Modal(document.getElementById('employeeModal'));
        });

        function openModal() {
            document.getElementById('employeeForm').reset();
            document.getElementById('Id').value = "0";
            document.getElementById('modalTitle').innerText = "Add Employee";
            document.getElementById('submitBtn').innerText = "Save";
            bootstrapModal.show();
        }

        function editEmployee(btn) {
            var e = $(btn).data('item');
            document.getElementById('Id').value = window.getVal(e, 'id');
            document.getElementById('EmployeeCode').value = window.getVal(e, 'employeeCode');
            document.getElementById('EmployeeName').value = window.getVal(e, 'employeeName');
            document.getElementById('Designation').value = window.getVal(e, 'designation') || "";
            document.getElementById('Department').value = window.getVal(e, 'department') || "";
            document.getElementById('Mobile').value = window.getVal(e, 'mobile') || "";
            document.getElementById('Email').value = window.getVal(e, 'email') || "";
            document.getElementById('modalTitle').innerText = "Edit Employee";
            document.getElementById('submitBtn').innerText = "Save Changes";
            bootstrapModal.show();
        }

        function deleteEmployee(id) {
            Swal.fire({
                title: 'Are you sure?',
                text: "Do you want to delete this employee?",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Yes, delete!'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.post('/Masters/DeleteEmployee', { id: id }, function (res) {
                        if (res.success) {
                            Swal.fire('Deleted!', 'Employee has been deleted.', 'success');
                            $('#row-' + id).fadeOut(300, function() { $(this).remove(); });
                        } else {
                            Swal.fire('Error!', 'Failed to delete.', 'error');
                        }
                    });
                }
            });
        }
    </script>
}
