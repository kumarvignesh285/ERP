@model BankPageViewModel
@{
    ViewData["Title"] = "Bank Master";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="m-0 font-weight-bold text-primary"><i class="fa-solid fa-building-columns me-2"></i> Bank Accounts List</h4>
    <button class="btn btn-primary" onclick="openModal()"><i class="fa-solid fa-plus me-1"></i> Add Bank Account</button>
</div>

<!-- Filters Row -->
<div class="card mb-3 no-print">
    <div class="card-body p-3">
        <div class="row g-2 align-items-center">
            <div class="col-md-8">
                <label class="form-label font-weight-semibold mb-1 small text-muted">Bank Name</label>
                <select id="filterBank" class="form-select form-select-sm select2">
                    <option value="">All Banks</option>
                    @foreach (var b in Model.Banks.Select(x => x.BankName).Distinct())
                    {
                        <option value="@b">@b</option>
                    }
                </select>
            </div>
            <div class="col-md-4 d-flex gap-2 align-self-end">
                <button class="btn btn-sm btn-primary w-100" onclick="applyFilters()"><i class="fa-solid fa-filter me-1"></i> Filter</button>
                <button class="btn btn-sm btn-outline-secondary w-100" onclick="resetFilters()"><i class="fa-solid fa-rotate me-1"></i> Reset</button>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover datatable align-middle">
                <thead>
                    <tr>
                        <th>Bank Name</th>
                        <th>Branch</th>
                        <th>Account Number</th>
                        <th>IFSC Code</th>
                        <th>Mapped Ledger</th>
                        <th class="text-center no-print">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in Model.Banks)
                    {
                        <tr id="row-@b.Id">
                            <td class="font-weight-bold text-dark">@b.BankName</td>
                            <td>@b.BranchName</td>
                            <td class="font-weight-semibold">@b.AccountNumber</td>
                            <td>@b.IFSCCode</td>
                            <td>@b.Ledger?.LedgerName</td>
                            <td class="text-center no-print">
                                <div class="btn-group">
                                    <button class="btn btn-sm btn-outline-primary" data-item="@System.Text.Json.JsonSerializer.Serialize(new { b.Id, b.BankName, b.BranchName, b.AccountNumber, b.IFSCCode, b.LedgerId })" onclick="editBank(this)"><i class="fa-solid fa-pen-to-square"></i></button>
                                    <button class="btn btn-sm btn-outline-danger" onclick="deleteBank(@b.Id)"><i class="fa-solid fa-trash"></i></button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Dialog -->
<div class="modal fade" id="bankModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="modalTitle">Add Bank Account</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="SaveBank" method="post" id="bankForm">
                <div class="modal-body">
                    <input type="hidden" id="Id" name="Id" value="0" />
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label font-weight-semibold">Bank Name *</label>
                            <input type="text" id="BankName" name="BankName" class="form-control" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label font-weight-semibold">Branch Name *</label>
                            <input type="text" id="BranchName" name="BranchName" class="form-control" required />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label font-weight-semibold">Account Number *</label>
                            <input type="text" id="AccountNumber" name="AccountNumber" class="form-control" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label font-weight-semibold">IFSC Code *</label>
                            <input type="text" id="IFSCCode" name="IFSCCode" class="form-control" required />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label font-weight-semibold">Mapped Accounting Ledger *</label>
                        <select id="LedgerId" name="LedgerId" class="form-select select2" required>
                            <option value="">Select Ledger</option>
                            @foreach (var l in Model.Ledgers)
                            {
                                <option value="@l.Id">@l.LedgerName (@l.LedgerCode)</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary" id="submitBtn">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var bootstrapModal;
        $(function () {
            bootstrapModal = new bootstrap.Modal(document.getElementById('bankModal'));

            $('#bankForm').on('submit', function (e) {
                e.preventDefault();
                ErpApp.submitForm(this, {
                    modal: bootstrapModal,
                    reloadPage: true
                });
            });
        });

        function openModal() {
            ErpApp.clearFieldErrors('#bankForm');
            document.getElementById('bankForm').reset();
            document.getElementById('Id').value = "0";
            $('#LedgerId').val('').trigger('change');
            document.getElementById('modalTitle').innerText = "Add Bank Account";
            document.getElementById('submitBtn').innerText = "Save";
            bootstrapModal.show();
        }

        function editBank(btn) {
            ErpApp.clearFieldErrors('#bankForm');
            var b = $(btn).data('item');
            document.getElementById('bankForm').reset();
            document.getElementById('Id').value = window.getVal(b, 'id');
            document.getElementById('BankName').value = window.getVal(b, 'bankName');
            document.getElementById('BranchName').value = window.getVal(b, 'branchName');
            document.getElementById('AccountNumber').value = window.getVal(b, 'accountNumber');
            document.getElementById('IFSCCode').value = window.getVal(b, 'ifscCode');
            $('#LedgerId').val(window.getVal(b, 'ledgerId')).trigger('change');
            document.getElementById('modalTitle').innerText = "Edit Bank Account";
            document.getElementById('submitBtn').innerText = "Save Changes";
            bootstrapModal.show();
        }

        function deleteBank(id) {
            ErpApp.confirmDelete({
                url: '/Masters/DeleteBank',
                id: id,
                rowElement: '#row-' + id,
                message: 'Do you want to delete this bank account?'
            });
        }
    </script>
}

