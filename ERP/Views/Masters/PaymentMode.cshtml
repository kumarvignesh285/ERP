@model IEnumerable<ERP.Models.PaymentMode>
@{
    ViewData["Title"] = "Payment Modes";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="m-0 font-weight-bold text-primary"><i class="fa-solid fa-credit-card me-2"></i> Payment Modes List</h4>
    <button class="btn btn-primary" onclick="openModal()"><i class="fa-solid fa-plus me-1"></i> Add Payment Mode</button>
</div>

<div class="card max-width-600 mx-auto">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover datatable align-middle">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Mode Name</th>
                        <th>Type</th>
                        <th class="text-center no-print">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var pm in Model)
                    {
                        <tr id="row-@pm.Id">
                            <td>@pm.Id</td>
                            <td class="font-weight-semibold text-dark">@pm.ModeName</td>
                            <td><span class="badge bg-light text-primary">@pm.ModeType</span></td>
                            <td class="text-center no-print">
                                <div class="btn-group">
                                    <button class="btn btn-sm btn-outline-primary" onclick="editPaymentMode(@Json.Serialize(pm))"><i class="fa-solid fa-pen-to-square"></i></button>
                                    <button class="btn btn-sm btn-outline-danger" onclick="deletePaymentMode(@pm.Id)"><i class="fa-solid fa-trash"></i></button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Dialog -->
<div class="modal fade" id="paymentModeModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="modalTitle">Add Payment Mode</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="SavePaymentMode" method="post" id="paymentModeForm">
                <div class="modal-body">
                    <input type="hidden" id="Id" name="Id" value="0" />
                    <div class="mb-3">
                        <label class="form-label font-weight-semibold">Mode Name *</label>
                        <input type="text" id="ModeName" name="ModeName" class="form-control" required placeholder="e.g. UPI / QR Code" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label font-weight-semibold">Mode Type *</label>
                        <select id="ModeType" name="ModeType" class="form-select" required>
                            <option value="Cash">Cash</option>
                            <option value="Bank">Bank</option>
                            <option value="Card">Card</option>
                            <option value="UPI">UPI</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var bootstrapModal;
        document.addEventListener("DOMContentLoaded", function () {
            bootstrapModal = new bootstrap.Modal(document.getElementById('paymentModeModal'));
        });

        function openModal() {
            document.getElementById('paymentModeForm').reset();
            document.getElementById('Id').value = "0";
            document.getElementById('modalTitle').innerText = "Add Payment Mode";
            bootstrapModal.show();
        }

        function editPaymentMode(pm) {
            document.getElementById('Id').value = window.getVal(pm, 'id');
            document.getElementById('ModeName').value = window.getVal(pm, 'modeName');
            document.getElementById('ModeType').value = window.getVal(pm, 'modeType');
            document.getElementById('modalTitle').innerText = "Edit Payment Mode";
            bootstrapModal.show();
        }

        function deletePaymentMode(id) {
            Swal.fire({
                title: 'Are you sure?',
                text: "Do you want to delete this payment mode?",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Yes, delete!'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.post('/Masters/DeletePaymentMode', { id: id }, function (res) {
                        if (res.success) {
                            Swal.fire('Deleted!', 'Payment Mode has been deleted.', 'success');
                            $('#row-' + id).fadeOut(300, function() { $(this).remove(); });
                        } else {
                            Swal.fire('Error!', 'Failed to delete.', 'error');
                        }
                    });
                }
            });
        }
    </script>
}
