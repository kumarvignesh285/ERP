@model IEnumerable<ERP.Models.PaymentMode>
@{
    ViewData["Title"] = "Payment Modes";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="m-0 font-weight-bold text-primary"><i class="fa-solid fa-credit-card me-2"></i> Payment Modes List</h4>
    <button class="btn btn-primary" onclick="openModal()"><i class="fa-solid fa-plus me-1"></i> Add Payment Mode</button>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover datatable align-middle">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Mode Name</th>
                        <th>Type</th>
                        <th class="text-center no-print">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var pm in Model)
                    {
                        <tr id="row-@pm.Id">
                            <td>@pm.Id</td>
                            <td class="font-weight-semibold text-dark">@pm.ModeName</td>
                            @{
                                var badgeClass = pm.ModeType switch
                                {
                                    "Cash" => "badge-cash",
                                    "Bank" => "badge-bank",
                                    "Card" => "badge-card",
                                    "UPI" => "badge-upi",
                                    _ => "badge-other"
                                };
                            }
                            <td><span class="badge @badgeClass">@pm.ModeType</span></td>
                            <td class="text-center no-print">
                                <div class="btn-group">
                                    <button class="btn btn-sm btn-outline-primary" data-item="@System.Text.Json.JsonSerializer.Serialize(new { pm.Id, pm.ModeName, pm.ModeType })" onclick="editPaymentMode(this)"><i class="fa-solid fa-pen-to-square"></i></button>
                                    <button class="btn btn-sm btn-outline-danger" onclick="deletePaymentMode(@pm.Id)"><i class="fa-solid fa-trash"></i></button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Dialog -->
<div class="modal fade" id="paymentModeModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="modalTitle">Add Payment Mode</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="SavePaymentMode" method="post" id="paymentModeForm">
                <div class="modal-body">
                    <input type="hidden" id="Id" name="Id" value="0" />
                    <div class="mb-3">
                        <label class="form-label font-weight-semibold">Mode Name *</label>
                        <input type="text" id="ModeName" name="ModeName" class="form-control" required placeholder="e.g. UPI / QR Code" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label font-weight-semibold">Mode Type *</label>
                        <select id="ModeType" name="ModeType" class="form-select" required>
                            <option value="Cash">Cash</option>
                            <option value="Bank">Bank</option>
                            <option value="Card">Card</option>
                            <option value="UPI">UPI</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary" id="submitBtn">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var bootstrapModal;
        $(function () {
            bootstrapModal = new bootstrap.Modal(document.getElementById('paymentModeModal'));

            $('#paymentModeForm').on('submit', function (e) {
                e.preventDefault();
                ErpApp.submitForm(this, {
                    modal: bootstrapModal,
                    reloadPage: true
                });
            });
        });

        function openModal() {
            ErpApp.clearFieldErrors('#paymentModeForm');
            document.getElementById('paymentModeForm').reset();
            document.getElementById('Id').value = "0";
            document.getElementById('modalTitle').innerText = "Add Payment Mode";
            document.getElementById('submitBtn').innerText = "Save";
            bootstrapModal.show();
        }

        function editPaymentMode(btn) {
            ErpApp.clearFieldErrors('#paymentModeForm');
            var pm = $(btn).data('item');
            document.getElementById('paymentModeForm').reset();
            document.getElementById('Id').value = window.getVal(pm, 'id');
            document.getElementById('ModeName').value = window.getVal(pm, 'modeName');
            document.getElementById('ModeType').value = window.getVal(pm, 'modeType');
            document.getElementById('modalTitle').innerText = "Edit Payment Mode";
            document.getElementById('submitBtn').innerText = "Save Changes";
            bootstrapModal.show();
        }

        function deletePaymentMode(id) {
            ErpApp.confirmDelete({
                url: '/Masters/DeletePaymentMode',
                id: id,
                rowElement: '#row-' + id,
                message: 'Do you want to delete this payment mode?'
            });
        }
    </script>
}
