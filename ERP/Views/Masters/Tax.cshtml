@model IEnumerable<ERP.Models.Tax>
@{
    ViewData["Title"] = "Tax Settings";
}

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="m-0 fw-bold text-primary"><i class="fa-solid fa-percent me-2"></i> Tax Configuration Master</h4>
        <p class="text-muted small m-0 mt-1">Configure GST tax slabs, CGST, SGST, and IGST rate splits</p>
    </div>
    <button class="btn btn-primary shadow-sm" onclick="openModal()">
        <i class="fa-solid fa-plus me-1.5"></i> Add Tax Slab
    </button>
</div>

<!-- Datatable Card -->
<div class="card shadow-sm border-0">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover datatable align-middle">
                <thead class="table-light text-uppercase fs-8 fw-bold text-muted">
                    <tr>
                        <th>Tax Name</th>
                        <th>Total Percentage</th>
                        <th>CGST %</th>
                        <th>SGST %</th>
                        <th>IGST %</th>
                        <th class="text-center no-print" style="width: 120px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in Model)
                    {
                        <tr id="row-@t.Id">
                            <td class="fw-bold text-dark">@t.TaxName</td>
                            <td><span class="badge bg-primary-subtle text-primary border border-primary-subtle font-monospace fw-bold px-2 py-1 fs-7">@t.TaxPercentage%</span></td>
                            <td class="fw-semibold text-muted">@t.CGSTPercentage%</td>
                            <td class="fw-semibold text-muted">@t.SGSTPercentage%</td>
                            <td class="fw-semibold text-muted">@t.IGSTPercentage%</td>
                            <td class="text-center no-print">
                                <div class="btn-group">
                                    <button class="btn btn-sm btn-outline-primary" data-item="@System.Text.Json.JsonSerializer.Serialize(new { t.Id, t.TaxName, t.TaxPercentage, t.CGSTPercentage, t.SGSTPercentage, t.IGSTPercentage })" onclick="editTax(this)" title="Edit"><i class="fa-solid fa-pen-to-square"></i></button>
                                    <button class="btn btn-sm btn-outline-danger" onclick="deleteTax(@t.Id)" title="Delete"><i class="fa-solid fa-trash"></i></button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Dialog -->
<div class="modal fade" id="taxModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white py-3">
                <h5 class="modal-title fw-bold" id="modalTitle"><i class="fa-solid fa-percent me-2"></i> Add Tax Slab</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="SaveTax" method="post" id="taxForm">
                <div class="modal-body p-4">
                    <input type="hidden" id="Id" name="Id" value="0" />
                    
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-dark">Tax Name <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-receipt text-muted"></i></span>
                            <input type="text" id="TaxName" name="TaxName" class="form-control border-start-0" required placeholder="e.g. GST 18%" />
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold text-dark">Tax Percentage <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-percent text-muted"></i></span>
                                <input type="number" id="TaxPercentage" name="TaxPercentage" class="form-control border-start-0" required step="0.01" placeholder="18" />
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold text-dark">IGST Percentage <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-percent text-muted"></i></span>
                                <input type="number" id="IGSTPercentage" name="IGSTPercentage" class="form-control border-start-0" required step="0.01" placeholder="18" />
                            </div>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold text-dark">CGST Percentage <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-percent text-muted"></i></span>
                                <input type="number" id="CGSTPercentage" name="CGSTPercentage" class="form-control border-start-0" required step="0.01" placeholder="9" />
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold text-dark">SGST Percentage <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-percent text-muted"></i></span>
                                <input type="number" id="SGSTPercentage" name="SGSTPercentage" class="form-control border-start-0" required step="0.01" placeholder="9" />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light border-top py-2 px-4">
                    <button type="button" class="btn btn-secondary px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary px-4 shadow-sm" id="submitBtn">Save Tax Slab</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var bootstrapModal;
        $(function () {
            bootstrapModal = new bootstrap.Modal(document.getElementById('taxModal'));

            $('#taxForm').on('submit', function (e) {
                e.preventDefault();
                ErpApp.submitForm(this, {
                    modal: bootstrapModal,
                    reloadPage: true
                });
            });

            // Auto calculations helper
            $('#TaxPercentage').on('input', function() {
                var val = parseFloat($(this).val()) || 0;
                $('#IGSTPercentage').val(val);
                $('#CGSTPercentage').val(val / 2);
                $('#SGSTPercentage').val(val / 2);
            });
        });

        function openModal() {
            ErpApp.clearFieldErrors('#taxForm');
            document.getElementById('taxForm').reset();
            document.getElementById('Id').value = "0";
            document.getElementById('modalTitle').innerHTML = '<i class="fa-solid fa-percent me-2"></i> Add Tax Slab';
            document.getElementById('submitBtn').innerText = "Save Tax Slab";
            bootstrapModal.show();
        }

        function editTax(btn) {
            ErpApp.clearFieldErrors('#taxForm');
            var t = $(btn).data('item');
            document.getElementById('taxForm').reset();
            document.getElementById('Id').value = window.getVal(t, 'id');
            document.getElementById('TaxName').value = window.getVal(t, 'taxName');
            document.getElementById('TaxPercentage').value = window.getVal(t, 'taxPercentage');
            document.getElementById('IGSTPercentage').value = window.getVal(t, 'igstPercentage');
            document.getElementById('CGSTPercentage').value = window.getVal(t, 'cgstPercentage');
            document.getElementById('SGSTPercentage').value = window.getVal(t, 'sgstPercentage');
            document.getElementById('modalTitle').innerHTML = '<i class="fa-solid fa-pen-to-square me-2"></i> Edit Tax Slab';
            document.getElementById('submitBtn').innerText = "Save Changes";
            bootstrapModal.show();
        }

        function deleteTax(id) {
            ErpApp.confirmDelete({
                url: '/Masters/DeleteTax',
                id: id,
                rowElement: '#row-' + id,
                message: 'Do you want to delete this tax slab?'
            });
        }
    </script>
}
