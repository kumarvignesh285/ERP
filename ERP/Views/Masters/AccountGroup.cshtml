@model IEnumerable<ERP.Models.AccountGroup>
@{
    ViewData["Title"] = "Account Group Master";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="m-0 font-weight-bold text-primary"><i class="fa-solid fa-folder me-2"></i> Account Groups List</h4>
    <button class="btn btn-primary" onclick="openModal()"><i class="fa-solid fa-plus me-1"></i> Add Group</button>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover datatable align-middle">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Group Name</th>
                        <th>Type</th>
                        <th>Description</th>
                        <th class="text-center no-print">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var g in Model)
                    {
                        <tr id="row-@g.Id">
                            <td>@g.Id</td>
                            <td class="font-weight-bold text-dark">@g.GroupName</td>
                            <td><span class="badge bg-light text-primary">@g.GroupType</span></td>
                            <td>@g.Description</td>
                            <td class="text-center no-print">
                                <div class="btn-group">
                                    <button class="btn btn-sm btn-outline-primary" data-item="@System.Text.Json.JsonSerializer.Serialize(new { g.Id, g.GroupName, g.GroupType, g.Description })" onclick="editGroup(this)"><i class="fa-solid fa-pen-to-square"></i></button>
                                    <button class="btn btn-sm btn-outline-danger" onclick="deleteGroup(@g.Id)"><i class="fa-solid fa-trash"></i></button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Dialog -->
<div class="modal fade" id="groupModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="modalTitle">Add Account Group</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="SaveAccountGroup" method="post" id="groupForm">
                <div class="modal-body">
                    <input type="hidden" id="Id" name="Id" value="0" />
                    <div class="mb-3">
                        <label class="form-label font-weight-semibold">Group Name *</label>
                        <input type="text" id="GroupName" name="GroupName" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label font-weight-semibold">Group Type *</label>
                        <select id="GroupType" name="GroupType" class="form-select" required>
                            <option value="Asset">Asset</option>
                            <option value="Liability">Liability</option>
                            <option value="Equity">Equity</option>
                            <option value="Income">Income</option>
                            <option value="Expense">Expense</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label font-weight-semibold">Description</label>
                        <textarea id="Description" name="Description" class="form-control" rows="2"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary" id="submitBtn">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var bootstrapModal;
        $(function () {
            bootstrapModal = new bootstrap.Modal(document.getElementById('groupModal'));
        });

        function openModal() {
            document.getElementById('groupForm').reset();
            document.getElementById('Id').value = "0";
            document.getElementById('modalTitle').innerText = "Add Account Group";
            document.getElementById('submitBtn').innerText = "Save";
            bootstrapModal.show();
        }

        function editGroup(btn) {
            var g = $(btn).data('item');
            document.getElementById('Id').value = window.getVal(g, 'id');
            document.getElementById('GroupName').value = window.getVal(g, 'groupName');
            document.getElementById('GroupType').value = window.getVal(g, 'groupType');
            document.getElementById('Description').value = window.getVal(g, 'description') || "";
            document.getElementById('modalTitle').innerText = "Edit Account Group";
            document.getElementById('submitBtn').innerText = "Save Changes";
            bootstrapModal.show();
        }

        function deleteGroup(id) {
            Swal.fire({
                title: 'Are you sure?',
                text: "Do you want to delete this account group?",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Yes, delete!'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.post('/Masters/DeleteAccountGroup', { id: id }, function (res) {
                        if (res.success) {
                            Swal.fire('Deleted!', 'Account Group has been deleted.', 'success');
                            $('#row-' + id).fadeOut(300, function() { $(this).remove(); });
                        } else {
                            Swal.fire('Error!', 'Failed to delete.', 'error');
                        }
                    });
                }
            });
        }
    </script>
}
