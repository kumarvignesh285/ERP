@model AccountGroupPageViewModel
@{
    ViewData["Title"] = "Account Group Master";
}

@Html.AntiForgeryToken()

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="m-0 font-weight-bold text-primary"><i class="fa-solid fa-folder me-2"></i> Account Groups List</h4>
    <button class="btn btn-primary" onclick="openModal()"><i class="fa-solid fa-plus me-1"></i> Add Group</button>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover datatable align-middle">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Group Name</th>
                        <th>Type</th>
                        <th>Description</th>
                        <th class="text-center no-print">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var g in Model.AccountGroups)
                    {
                        <tr id="row-@g.Id">
                            <td>@g.Id</td>
                            <td class="font-weight-bold text-dark">@g.GroupName</td>
                            <td><span class="badge bg-light text-primary">@g.GroupType</span></td>
                            <td>@g.Description</td>
                            <td class="text-center no-print">
                                <div class="btn-group">
                                    <button class="btn btn-sm btn-outline-primary" data-item="@System.Text.Json.JsonSerializer.Serialize(new { g.Id, g.GroupName, g.GroupType, g.Description })" onclick="editGroup(this)"><i class="fa-solid fa-pen-to-square"></i></button>
                                    <button class="btn btn-sm btn-outline-danger" onclick="deleteGroup(@g.Id)"><i class="fa-solid fa-trash"></i></button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Dialog -->
<div class="modal fade" id="groupModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="modalTitle">Add Account Group</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-controller="Masters" asp-action="SaveAccountGroup" method="post" id="groupForm">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>
                    <input type="hidden" asp-for="Form.Id" id="Id" value="0" />
                    <div class="mb-3">
                        <label asp-for="Form.GroupName" class="form-label font-weight-semibold">Group Name *</label>
                        <input asp-for="Form.GroupName" id="GroupName" class="form-control" required />
                        <span asp-validation-for="Form.GroupName" class="text-danger small mt-1 d-block"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Form.GroupType" class="form-label font-weight-semibold">Group Type *</label>
                        <select asp-for="Form.GroupType" id="GroupType" class="form-select" required>
                            <option value="Asset">Asset</option>
                            <option value="Liability">Liability</option>
                            <option value="Equity">Equity</option>
                            <option value="Income">Income</option>
                            <option value="Expense">Expense</option>
                        </select>
                        <span asp-validation-for="Form.GroupType" class="text-danger small mt-1 d-block"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Form.Description" class="form-label font-weight-semibold">Description</label>
                        <textarea asp-for="Form.Description" id="Description" class="form-control" rows="2"></textarea>
                        <span asp-validation-for="Form.Description" class="text-danger small mt-1 d-block"></span>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary" id="submitBtn">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        var bootstrapModal;
        $(function () {
            bootstrapModal = new bootstrap.Modal(document.getElementById('groupModal'));

            $('#groupForm').on('submit', function (e) {
                e.preventDefault();
                ErpApp.submitForm(this, {
                    modal: bootstrapModal,
                    reloadPage: true
                });
            });
        });

        function openModal() {
            ErpApp.clearFieldErrors('#groupForm');
            document.getElementById('groupForm').reset();
            document.getElementById('Id').value = "0";
            document.getElementById('modalTitle').innerText = "Add Account Group";
            document.getElementById('submitBtn').innerText = "Save";
            bootstrapModal.show();
        }

        function editGroup(btn) {
            ErpApp.clearFieldErrors('#groupForm');
            var g = $(btn).data('item');
            document.getElementById('groupForm').reset();
            document.getElementById('Id').value = window.getVal(g, 'id');
            document.getElementById('GroupName').value = window.getVal(g, 'groupName');
            document.getElementById('GroupType').value = window.getVal(g, 'groupType');
            document.getElementById('Description').value = window.getVal(g, 'description') || "";
            document.getElementById('modalTitle').innerText = "Edit Account Group";
            document.getElementById('submitBtn').innerText = "Save Changes";
            bootstrapModal.show();
        }

        function deleteGroup(id) {
            ErpApp.confirmDelete({
                url: '/Masters/DeleteAccountGroup',
                id: id,
                rowElement: '#row-' + id,
                message: 'Do you want to delete this account group?'
            });
        }
    </script>
}
