@model WarehousePageViewModel
@{
    ViewData["Title"] = "Warehouse Master";
}

@Html.AntiForgeryToken()

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="m-0 fw-bold text-primary"><i class="fa-solid fa-warehouse me-2"></i> Warehouses List</h4>
        <p class="text-muted small m-0 mt-1">Manage physical storage facilities, distribution hubs, and stock locations</p>
    </div>
    <button class="btn btn-primary shadow-sm" onclick="openModal()"><i class="fa-solid fa-plus me-1.5"></i> Add Warehouse</button>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover datatable align-middle">
                <thead class="table-light text-uppercase fs-8 fw-bold text-muted">
                    <tr>
                        <th>Code</th>
                        <th>Name</th>
                        <th>City</th>
                        <th>State</th>
                        <th>Contact</th>
                        <th>Status</th>
                        <th class="text-center no-print">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var w in Model.Warehouses)
                    {
                        <tr id="row-@w.Id">
                            <td class="fw-bold text-primary">@w.WarehouseCode</td>
                            <td class="fw-semibold text-dark">@w.WarehouseName</td>
                            <td>@(string.IsNullOrEmpty(w.City) ? "—" : w.City)</td>
                            <td>@(string.IsNullOrEmpty(w.State) ? "—" : w.State)</td>
                            <td><i class="fa-solid fa-phone fs-8 text-muted me-1"></i>@(string.IsNullOrEmpty(w.Phone) ? "—" : w.Phone)</td>
                            <td>
                                @if (w.IsActive)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Inactive</span>
                                }
                            </td>
                            <td class="text-center no-print">
                                <div class="btn-group">
                                    <button class="btn btn-sm btn-outline-primary" data-item="@System.Text.Json.JsonSerializer.Serialize(new { w.Id, w.WarehouseCode, w.WarehouseName, w.Address, w.City, w.State, Phone = w.Phone, ContactNumber = w.Phone })" onclick="editWarehouse(this)" title="Edit"><i class="fa-solid fa-pen-to-square"></i></button>
                                    <button class="btn btn-sm btn-outline-danger" onclick="deleteWarehouse(@w.Id)" title="Delete"><i class="fa-solid fa-trash"></i></button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal with Strongly-Typed Form -->
<div class="modal fade" id="warehouseModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white py-3">
                <h5 class="modal-title fw-bold" id="modalTitle"><i class="fa-solid fa-warehouse me-2"></i> Add Warehouse</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Masters" asp-action="SaveWarehouse" method="post" id="warehouseForm">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>
                    <input type="hidden" asp-for="Form.Id" id="Id" value="0" />

                    <div class="mb-3">
                        <label asp-for="Form.WarehouseCode" class="form-label fw-semibold text-dark">Warehouse Code <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-barcode text-muted"></i></span>
                            <input asp-for="Form.WarehouseCode" id="WarehouseCode" class="form-control border-start-0" placeholder="e.g. WH-01" required />
                        </div>
                        <span asp-validation-for="Form.WarehouseCode" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Form.WarehouseName" class="form-label fw-semibold text-dark">Warehouse Name <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-warehouse text-muted"></i></span>
                            <input asp-for="Form.WarehouseName" id="WarehouseName" class="form-control border-start-0" placeholder="e.g. Central Logistics Hub" required />
                        </div>
                        <span asp-validation-for="Form.WarehouseName" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Form.Address" class="form-label fw-semibold text-dark">Facility Address</label>
                        <textarea asp-for="Form.Address" id="Address" class="form-control" rows="2" placeholder="Street, industrial estate..."></textarea>
                        <span asp-validation-for="Form.Address" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label asp-for="Form.City" class="form-label fw-semibold text-dark">City</label>
                            <input asp-for="Form.City" id="City" class="form-control" placeholder="Chennai" />
                            <span asp-validation-for="Form.City" class="text-danger small mt-1 d-block"></span>
                        </div>
                        <div class="col-6">
                            <label asp-for="Form.State" class="form-label fw-semibold text-dark">State</label>
                            <input asp-for="Form.State" id="State" class="form-control" placeholder="Tamil Nadu" />
                            <span asp-validation-for="Form.State" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Form.ContactNumber" class="form-label fw-semibold text-dark">Contact Phone</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-phone text-muted"></i></span>
                            <input asp-for="Form.ContactNumber" id="ContactNumber" class="form-control border-start-0" placeholder="+91 98765 43210" />
                        </div>
                        <span asp-validation-for="Form.ContactNumber" class="text-danger small mt-1 d-block"></span>
                    </div>
                </div>
                <div class="modal-footer bg-light border-top py-2 px-4">
                    <button type="button" class="btn btn-secondary px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary px-4 shadow-sm" id="submitBtn">Save Warehouse</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        var bootstrapModal;
        $(function () {
            bootstrapModal = new bootstrap.Modal(document.getElementById('warehouseModal'));

            $('#warehouseForm').on('submit', function (e) {
                e.preventDefault();
                ErpApp.submitForm(this, {
                    modal: bootstrapModal,
                    reloadPage: true
                });
            });
        });

        function openModal() {
            ErpApp.clearFieldErrors('#warehouseForm');
            document.getElementById('warehouseForm').reset();
            document.getElementById('Id').value = "0";
            document.getElementById('modalTitle').innerHTML = '<i class="fa-solid fa-warehouse me-2"></i> Add Warehouse';
            document.getElementById('submitBtn').innerText = "Save Warehouse";
            bootstrapModal.show();
        }

        function editWarehouse(btn) {
            ErpApp.clearFieldErrors('#warehouseForm');
            var wh = $(btn).data('item');
            document.getElementById('warehouseForm').reset();
            document.getElementById('Id').value = window.getVal(wh, 'id');
            document.getElementById('WarehouseCode').value = window.getVal(wh, 'warehouseCode');
            document.getElementById('WarehouseName').value = window.getVal(wh, 'warehouseName');
            document.getElementById('Address').value = window.getVal(wh, 'address') || "";
            document.getElementById('City').value = window.getVal(wh, 'city') || "";
            document.getElementById('State').value = window.getVal(wh, 'state') || "";
            document.getElementById('ContactNumber').value = window.getVal(wh, 'contactNumber') || "";
            document.getElementById('modalTitle').innerHTML = '<i class="fa-solid fa-pen-to-square me-2"></i> Edit Warehouse';
            document.getElementById('submitBtn').innerText = "Save Changes";
            bootstrapModal.show();
        }

        function deleteWarehouse(id) {
            ErpApp.confirmDelete({
                url: '/Masters/DeleteWarehouse',
                id: id,
                rowElement: '#row-' + id,
                message: 'Do you want to delete this warehouse location?'
            });
        }
    </script>
}
