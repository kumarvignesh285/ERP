@model IEnumerable<ERP.Models.Warehouse>
@{
    ViewData["Title"] = "Warehouse Master";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="m-0 font-weight-bold text-primary"><i class="fa-solid fa-warehouse me-2"></i> Warehouses List</h4>
    <button class="btn btn-primary" onclick="openModal()"><i class="fa-solid fa-plus me-1"></i> Add Warehouse</button>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover datatable align-middle">
                <thead>
                    <tr>
                        <th>Code</th>
                        <th>Warehouse Name</th>
                        <th>City</th>
                        <th>State</th>
                        <th class="text-center no-print">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var w in Model)
                    {
                        <tr id="row-@w.Id">
                            <td class="font-weight-bold">@w.WarehouseCode</td>
                            <td class="font-weight-semibold text-dark">@w.WarehouseName</td>
                            <td>@w.City</td>
                            <td>@w.State</td>
                            <td class="text-center no-print">
                                <div class="btn-group">
                                    <button class="btn btn-sm btn-outline-primary" data-item="@System.Text.Json.JsonSerializer.Serialize(new { w.Id, w.WarehouseCode, w.WarehouseName, w.Address, w.City, w.State })" onclick="editWarehouse(this)"><i class="fa-solid fa-pen-to-square"></i></button>
                                    <button class="btn btn-sm btn-outline-danger" onclick="deleteWarehouse(@w.Id)"><i class="fa-solid fa-trash"></i></button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Dialog -->
<div class="modal fade" id="warehouseModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="modalTitle">Add Warehouse</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="SaveWarehouse" method="post" id="warehouseForm">
                <div class="modal-body">
                    <input type="hidden" id="Id" name="Id" value="0" />
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label font-weight-semibold">Warehouse Code *</label>
                            <input type="text" id="WarehouseCode" name="WarehouseCode" class="form-control" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label font-weight-semibold">Warehouse Name *</label>
                            <input type="text" id="WarehouseName" name="WarehouseName" class="form-control" required />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label font-weight-semibold">Address</label>
                        <textarea id="Address" name="Address" class="form-control" rows="2"></textarea>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label font-weight-semibold">City</label>
                            <input type="text" id="City" name="City" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label font-weight-semibold">State</label>
                            <input type="text" id="State" name="State" class="form-control" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary" id="submitBtn">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var bootstrapModal;
        $(function () {
            bootstrapModal = new bootstrap.Modal(document.getElementById('warehouseModal'));
        });

        function openModal() {
            document.getElementById('warehouseForm').reset();
            document.getElementById('Id').value = "0";
            document.getElementById('modalTitle').innerText = "Add Warehouse";
            document.getElementById('submitBtn').innerText = "Save";
            bootstrapModal.show();
        }

        function editWarehouse(btn) {
            var w = $(btn).data('item');
            document.getElementById('Id').value = window.getVal(w, 'id');
            document.getElementById('WarehouseCode').value = window.getVal(w, 'warehouseCode');
            document.getElementById('WarehouseName').value = window.getVal(w, 'warehouseName');
            document.getElementById('Address').value = window.getVal(w, 'address') || "";
            document.getElementById('City').value = window.getVal(w, 'city') || "";
            document.getElementById('State').value = window.getVal(w, 'state') || "";
            document.getElementById('modalTitle').innerText = "Edit Warehouse";
            document.getElementById('submitBtn').innerText = "Save Changes";
            bootstrapModal.show();
        }

        function deleteWarehouse(id) {
            Swal.fire({
                title: 'Are you sure?',
                text: "Do you want to delete this warehouse?",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Yes, delete!'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.post('/Masters/DeleteWarehouse', { id: id }, function (res) {
                        if (res.success) {
                            Swal.fire('Deleted!', 'Warehouse has been deleted.', 'success');
                            $('#row-' + id).fadeOut(300, function() { $(this).remove(); });
                        } else {
                            Swal.fire('Error!', 'Failed to delete.', 'error');
                        }
                    });
                }
            });
        }
    </script>
}
