@model IEnumerable<ERP.Models.Category>
@{
    ViewData["Title"] = "Category Master";
}

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="m-0 fw-bold text-primary"><i class="fa-solid fa-layer-group me-2"></i> Category Master</h4>
        <p class="text-muted small m-0 mt-1">Classify products into distinct inventory categories and product lines</p>
    </div>
    <button class="btn btn-primary shadow-sm" onclick="openModal()">
        <i class="fa-solid fa-plus me-1.5"></i> Add New Category
    </button>
</div>

<!-- Datatable Card -->
<div class="card shadow-sm border-0">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover datatable align-middle">
                <thead class="table-light text-uppercase fs-8 fw-bold text-muted">
                    <tr>
                        <th style="width: 80px;">ID</th>
                        <th>Category Name</th>
                        <th class="text-center no-print" style="width: 120px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        <tr id="row-@c.Id">
                            <td class="fw-bold text-muted">#@c.Id</td>
                            <td class="fw-bold text-dark">@c.CategoryName</td>
                            <td class="text-center no-print">
                                <div class="btn-group">
                                    <button class="btn btn-sm btn-outline-primary" data-item="@System.Text.Json.JsonSerializer.Serialize(new { c.Id, c.CategoryName })" onclick="editCategory(this)" title="Edit"><i class="fa-solid fa-pen-to-square"></i></button>
                                    <button class="btn btn-sm btn-outline-danger" onclick="deleteCategory(@c.Id)" title="Delete"><i class="fa-solid fa-trash"></i></button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Dialog -->
<div class="modal fade" id="categoryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white py-3">
                <h5 class="modal-title fw-bold" id="modalTitle"><i class="fa-solid fa-layer-group me-2"></i> Add Category</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="SaveCategory" method="post" id="categoryForm">
                <div class="modal-body p-4">
                    <input type="hidden" id="Id" name="Id" value="0" />
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-dark">Category Name <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-tag text-muted"></i></span>
                            <input type="text" id="CategoryName" name="CategoryName" class="form-control border-start-0" placeholder="e.g. Power Tools, Fasteners..." required />
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light border-top py-2 px-4">
                    <button type="button" class="btn btn-secondary px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary px-4 shadow-sm" id="submitBtn">Save Category</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var bootstrapModal;
        $(function () {
            bootstrapModal = new bootstrap.Modal(document.getElementById('categoryModal'));
        });

        function openModal() {
            document.getElementById('categoryForm').reset();
            document.getElementById('Id').value = "0";
            document.getElementById('modalTitle').innerHTML = '<i class="fa-solid fa-layer-group me-2"></i> Add Category';
            document.getElementById('submitBtn').innerText = "Save Category";
            bootstrapModal.show();
        }

        function editCategory(btn) {
            var c = $(btn).data('item');
            document.getElementById('Id').value = window.getVal(c, 'id');
            document.getElementById('CategoryName').value = window.getVal(c, 'categoryName');
            document.getElementById('modalTitle').innerHTML = '<i class="fa-solid fa-pen-to-square me-2"></i> Edit Category';
            document.getElementById('submitBtn').innerText = "Save Changes";
            bootstrapModal.show();
        }

        function deleteCategory(id) {
            Swal.fire({
                title: 'Are you sure?',
                text: "Do you want to delete this category?",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Yes, delete!'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.post('/Masters/DeleteCategory', { id: id }, function (res) {
                        if (res.success) {
                            Swal.fire('Deleted!', 'Category has been deleted.', 'success');
                            $('#row-' + id).fadeOut(300, function() { $(this).remove(); });
                        } else {
                            Swal.fire('Error!', 'Failed to delete.', 'error');
                        }
                    });
                }
            });
        }
    </script>
}
