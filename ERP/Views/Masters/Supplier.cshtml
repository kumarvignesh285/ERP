@model SupplierPageViewModel
@{
    ViewData["Title"] = "Supplier Master";
}

@Html.AntiForgeryToken()

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="m-0 fw-bold text-primary"><i class="fa-solid fa-truck-field me-2"></i> Supplier Master</h4>
        <p class="text-muted small m-0 mt-1">Manage vendor accounts, procurement contacts, GSTIN, and location details</p>
    </div>
    <button class="btn btn-primary shadow-sm" onclick="openModal()">
        <i class="fa-solid fa-plus me-1.5"></i> Add New Supplier
    </button>
</div>

<!-- Filters Row -->
<div class="card mb-3 no-print shadow-sm border-0">
    <div class="card-body p-3">
        <div class="row g-3 align-items-center">
            <div class="col-12 col-md-8">
                <label class="form-label fw-semibold mb-1 small text-muted">Filter by City</label>
                <select id="filterCity" class="form-select form-select-sm select2">
                    <option value="">All Cities</option>
                    @foreach (var city in Model.Suppliers.Where(s => !string.IsNullOrEmpty(s.City)).Select(s => s.City).Distinct())
                    {
                        <option value="@city">@city</option>
                    }
                </select>
            </div>
            <div class="col-12 col-md-4 d-flex gap-2 align-self-end">
                <button class="btn btn-sm btn-primary w-100" onclick="applyFilters()"><i class="fa-solid fa-filter me-1"></i> Filter</button>
                <button class="btn btn-sm btn-outline-secondary w-100" onclick="resetFilters()"><i class="fa-solid fa-rotate me-1"></i> Reset</button>
            </div>
        </div>
    </div>
</div>

<!-- Datatable Card -->
<div class="card shadow-sm border-0">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover datatable align-middle">
                <thead class="table-light text-uppercase fs-8 fw-bold text-muted">
                    <tr>
                        <th>Code</th>
                        <th>Name</th>
                        <th>Contact</th>
                        <th>Mobile</th>
                        <th>GSTIN</th>
                        <th>City</th>
                        <th>Balance</th>
                        <th class="text-center no-print">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model.Suppliers)
                    {
                        <tr id="row-@s.Id">
                            <td class="fw-bold text-primary">@s.SupplierCode</td>
                            <td class="fw-semibold text-dark">@s.SupplierName</td>
                            <td>@(string.IsNullOrEmpty(s.ContactPerson) ? "—" : s.ContactPerson)</td>
                            <td><i class="fa-solid fa-phone fs-8 text-muted me-1"></i>@s.Mobile</td>
                            <td><span class="font-monospace fs-8 text-uppercase">@(string.IsNullOrEmpty(s.GSTNumber) ? "—" : s.GSTNumber)</span></td>
                            <td>@s.City</td>
                            <td><span class="fw-semibold">₹@s.OpeningBalance.ToString("N2")</span> <small class="text-muted">(@s.BalanceType)</small></td>
                            <td class="text-center no-print">
                                <div class="btn-group">
                                    <button class="btn btn-sm btn-outline-primary" data-item="@System.Text.Json.JsonSerializer.Serialize(new { s.Id, s.SupplierCode, s.SupplierName, s.ContactPerson, Mobile = s.Mobile, MobileNumber = s.Mobile, s.Email, s.GSTNumber, s.Address, s.City, s.State })" onclick="editSupplier(this)" title="Edit"><i class="fa-solid fa-pen-to-square"></i></button>
                                    <button class="btn btn-sm btn-outline-danger" onclick="deleteSupplier(@s.Id)" title="Delete"><i class="fa-solid fa-trash"></i></button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Dialog with Strongly-Typed Form -->
<div class="modal fade" id="supplierModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white py-3">
                <h5 class="modal-title fw-bold" id="modalTitle"><i class="fa-solid fa-plus me-2"></i> Add Supplier</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Masters" asp-action="SaveSupplier" method="post" id="supplierForm">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>
                    <input type="hidden" asp-for="Form.Id" id="Id" value="0" />
                    
                    <div class="row g-3 mb-3">
                        <div class="col-12 col-md-6">
                            <label asp-for="Form.SupplierCode" class="form-label fw-semibold text-dark">Supplier Code <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-barcode text-muted"></i></span>
                                <input asp-for="Form.SupplierCode" id="SupplierCode" class="form-control border-start-0" placeholder="e.g. SUP-001" required />
                            </div>
                            <span asp-validation-for="Form.SupplierCode" class="text-danger small mt-1 d-block"></span>
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="Form.SupplierName" class="form-label fw-semibold text-dark">Supplier Name <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-truck-field text-muted"></i></span>
                                <input asp-for="Form.SupplierName" id="SupplierName" class="form-control border-start-0" placeholder="Vendor / Entity Name" required />
                            </div>
                            <span asp-validation-for="Form.SupplierName" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-12 col-md-6">
                            <label asp-for="Form.ContactPerson" class="form-label fw-semibold text-dark">Contact Person</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="fa-regular fa-user text-muted"></i></span>
                                <input asp-for="Form.ContactPerson" id="ContactPerson" class="form-control border-start-0" placeholder="Sales rep / manager name" />
                            </div>
                            <span asp-validation-for="Form.ContactPerson" class="text-danger small mt-1 d-block"></span>
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="Form.MobileNumber" class="form-label fw-semibold text-dark">Mobile Number</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-phone text-muted"></i></span>
                                <input asp-for="Form.MobileNumber" id="MobileNumber" class="form-control border-start-0" placeholder="+91 98765 43210" />
                            </div>
                            <span asp-validation-for="Form.MobileNumber" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-12 col-md-6">
                            <label asp-for="Form.Email" class="form-label fw-semibold text-dark">Email Address</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="fa-regular fa-envelope text-muted"></i></span>
                                <input asp-for="Form.Email" id="Email" class="form-control border-start-0" placeholder="vendor@supplier.com" />
                            </div>
                            <span asp-validation-for="Form.Email" class="text-danger small mt-1 d-block"></span>
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="Form.GSTNumber" class="form-label fw-semibold text-dark">GSTIN Number</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-file-invoice text-muted"></i></span>
                                <input asp-for="Form.GSTNumber" id="GSTNumber" class="form-control border-start-0 text-uppercase" placeholder="33AAAAA0000A1Z5" />
                            </div>
                            <span asp-validation-for="Form.GSTNumber" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Form.Address" class="form-label fw-semibold text-dark">Warehouse / Office Address</label>
                        <textarea asp-for="Form.Address" id="Address" class="form-control" rows="2" placeholder="Street address, building, industrial area..."></textarea>
                        <span asp-validation-for="Form.Address" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-12 col-sm-6">
                            <label asp-for="Form.City" class="form-label fw-semibold text-dark">City</label>
                            <input asp-for="Form.City" id="City" class="form-control" placeholder="Coimbatore" />
                            <span asp-validation-for="Form.City" class="text-danger small mt-1 d-block"></span>
                        </div>
                        <div class="col-12 col-sm-6">
                            <label asp-for="Form.State" class="form-label fw-semibold text-dark">State</label>
                            <input asp-for="Form.State" id="State" class="form-control" placeholder="Tamil Nadu" />
                            <span asp-validation-for="Form.State" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light border-top py-2 px-4">
                    <button type="button" class="btn btn-secondary px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary px-4 shadow-sm" id="submitBtn">Save Supplier</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        var bootstrapModal;
        $(function () {
            bootstrapModal = new bootstrap.Modal(document.getElementById('supplierModal'));

            $('#supplierForm').on('submit', function (e) {
                e.preventDefault();
                ErpApp.submitForm(this, {
                    modal: bootstrapModal,
                    reloadPage: true
                });
            });
        });

        function openModal() {
            ErpApp.clearFieldErrors('#supplierForm');
            document.getElementById('supplierForm').reset();
            document.getElementById('Id').value = "0";
            document.getElementById('modalTitle').innerHTML = '<i class="fa-solid fa-plus me-2"></i> Add Supplier';
            document.getElementById('submitBtn').innerText = "Save Supplier";
            bootstrapModal.show();
        }

        function editSupplier(btn) {
            ErpApp.clearFieldErrors('#supplierForm');
            var supplier = $(btn).data('item');
            document.getElementById('supplierForm').reset();
            document.getElementById('Id').value = window.getVal(supplier, 'id');
            document.getElementById('SupplierCode').value = window.getVal(supplier, 'supplierCode');
            document.getElementById('SupplierName').value = window.getVal(supplier, 'supplierName');
            document.getElementById('ContactPerson').value = window.getVal(supplier, 'contactPerson') || "";
            document.getElementById('MobileNumber').value = window.getVal(supplier, 'mobileNumber') || "";
            document.getElementById('Email').value = window.getVal(supplier, 'email') || "";
            document.getElementById('GSTNumber').value = window.getVal(supplier, 'gstNumber') || "";
            document.getElementById('Address').value = window.getVal(supplier, 'address') || "";
            document.getElementById('City').value = window.getVal(supplier, 'city') || "";
            document.getElementById('State').value = window.getVal(supplier, 'state') || "";
            document.getElementById('modalTitle').innerHTML = '<i class="fa-solid fa-pen-to-square me-2"></i> Edit Supplier';
            document.getElementById('submitBtn').innerText = "Save Changes";
            bootstrapModal.show();
        }

        function deleteSupplier(id) {
            ErpApp.confirmDelete({
                url: '/Masters/DeleteSupplier',
                id: id,
                rowElement: '#row-' + id,
                message: 'Do you want to delete this supplier record?'
            });
        }
    </script>
}
