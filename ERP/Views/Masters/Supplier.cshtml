@model IEnumerable<ERP.Models.Supplier>
@{
    ViewData["Title"] = "Supplier Master";
}

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="m-0 fw-bold text-primary"><i class="fa-solid fa-truck-field me-2"></i> Supplier Master</h4>
        <p class="text-muted small m-0 mt-1">Manage vendor accounts, procurement contacts, GSTIN, and location details</p>
    </div>
    <button class="btn btn-primary shadow-sm" onclick="openModal()">
        <i class="fa-solid fa-plus me-1.5"></i> Add New Supplier
    </button>
</div>

<!-- Filters Row -->
<div class="card mb-3 no-print shadow-sm border-0">
    <div class="card-body p-3">
        <div class="row g-3 align-items-center">
            <div class="col-12 col-md-8">
                <label class="form-label fw-semibold mb-1 small text-muted">Filter by City</label>
                <select id="filterCity" class="form-select form-select-sm select2">
                    <option value="">All Cities</option>
                    @foreach (var city in Model.Where(s => !string.IsNullOrEmpty(s.City)).Select(s => s.City).Distinct())
                    {
                        <option value="@city">@city</option>
                    }
                </select>
            </div>
            <div class="col-12 col-md-4 d-flex gap-2 align-self-end">
                <button class="btn btn-sm btn-primary w-100" onclick="applyFilters()"><i class="fa-solid fa-filter me-1"></i> Filter</button>
                <button class="btn btn-sm btn-outline-secondary w-100" onclick="resetFilters()"><i class="fa-solid fa-rotate me-1"></i> Reset</button>
            </div>
        </div>
    </div>
</div>

<!-- Datatable Card -->
<div class="card shadow-sm border-0">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover datatable align-middle">
                <thead class="table-light text-uppercase fs-8 fw-bold text-muted">
                    <tr>
                        <th>Code</th>
                        <th>Name</th>
                        <th>Contact Person</th>
                        <th>Mobile</th>
                        <th>Email</th>
                        <th>City</th>
                        <th class="text-center no-print">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model)
                    {
                        <tr id="row-@s.Id">
                            <td class="fw-bold text-primary">@s.SupplierCode</td>
                            <td class="fw-semibold text-dark">@s.SupplierName</td>
                            <td>@s.ContactPerson</td>
                            <td><i class="fa-solid fa-phone fs-8 text-muted me-1"></i>@s.Mobile</td>
                            <td>@s.Email</td>
                            <td>@s.City</td>
                            <td class="text-center no-print">
                                <div class="btn-group">
                                    <button class="btn btn-sm btn-outline-primary" data-item="@System.Text.Json.JsonSerializer.Serialize(new { s.Id, s.SupplierCode, s.SupplierName, s.ContactPerson, s.Mobile, s.Email, s.GSTNumber, s.Address, s.City, s.State, s.Country })" onclick="editSupplier(this)" title="Edit"><i class="fa-solid fa-pen-to-square"></i></button>
                                    <button class="btn btn-sm btn-outline-danger" onclick="deleteSupplier(@s.Id)" title="Delete"><i class="fa-solid fa-trash"></i></button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Dialog -->
<div class="modal fade" id="supplierModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white py-3">
                <h5 class="modal-title fw-bold" id="modalTitle"><i class="fa-solid fa-truck-field me-2"></i> Add Supplier</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="SaveSupplier" method="post" id="supplierForm">
                <div class="modal-body p-4">
                    <input type="hidden" id="Id" name="Id" value="0" />
                    
                    <div class="row g-3 mb-3">
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold text-dark">Supplier Code <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-barcode text-muted"></i></span>
                                <input type="text" id="SupplierCode" name="SupplierCode" class="form-control border-start-0" placeholder="e.g. SUP-001" required />
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold text-dark">Supplier Name <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-truck-moving text-muted"></i></span>
                                <input type="text" id="SupplierName" name="SupplierName" class="form-control border-start-0" placeholder="Vendor / Distributor Name" required />
                            </div>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold text-dark">Contact Person</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="fa-regular fa-user text-muted"></i></span>
                                <input type="text" id="ContactPerson" name="ContactPerson" class="form-control border-start-0" placeholder="Key contact person" />
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold text-dark">Mobile Number</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-phone text-muted"></i></span>
                                <input type="text" id="Mobile" name="Mobile" class="form-control border-start-0" placeholder="+91 98765 43210" />
                            </div>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold text-dark">Email Address</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="fa-regular fa-envelope text-muted"></i></span>
                                <input type="email" id="Email" name="Email" class="form-control border-start-0" placeholder="supplier@vendor.com" />
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold text-dark">GSTIN Number</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-file-invoice text-muted"></i></span>
                                <input type="text" id="GSTNumber" name="GSTNumber" class="form-control border-start-0 text-uppercase" placeholder="33AAAAA0000A1Z5" />
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-dark">Address</label>
                        <textarea id="Address" name="Address" class="form-control" rows="2" placeholder="Warehouse, office, factory address..."></textarea>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-12 col-sm-4">
                            <label class="form-label fw-semibold text-dark">City</label>
                            <input type="text" id="City" name="City" class="form-control" placeholder="Chennai" />
                        </div>
                        <div class="col-12 col-sm-4">
                            <label class="form-label fw-semibold text-dark">State</label>
                            <input type="text" id="State" name="State" class="form-control" placeholder="Tamil Nadu" />
                        </div>
                        <div class="col-12 col-sm-4">
                            <label class="form-label fw-semibold text-dark">Country</label>
                            <input type="text" id="Country" name="Country" class="form-control" value="India" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light border-top py-2 px-4">
                    <button type="button" class="btn btn-secondary px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary px-4 shadow-sm" id="submitBtn">Save Supplier</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var bootstrapModal;
        $(function () {
            bootstrapModal = new bootstrap.Modal(document.getElementById('supplierModal'));
        });

        function openModal() {
            document.getElementById('supplierForm').reset();
            document.getElementById('Id').value = "0";
            document.getElementById('modalTitle').innerHTML = '<i class="fa-solid fa-truck-field me-2"></i> Add Supplier';
            document.getElementById('submitBtn').innerText = "Save Supplier";
            bootstrapModal.show();
        }

        function editSupplier(btn) {
            var supplier = $(btn).data('item');
            document.getElementById('supplierForm').reset();
            document.getElementById('Id').value = window.getVal(supplier, 'id');
            document.getElementById('SupplierCode').value = window.getVal(supplier, 'supplierCode');
            document.getElementById('SupplierName').value = window.getVal(supplier, 'supplierName');
            document.getElementById('ContactPerson').value = window.getVal(supplier, 'contactPerson') || "";
            document.getElementById('Mobile').value = window.getVal(supplier, 'mobile') || "";
            document.getElementById('Email').value = window.getVal(supplier, 'email') || "";
            document.getElementById('GSTNumber').value = window.getVal(supplier, 'gstNumber') || "";
            document.getElementById('Address').value = window.getVal(supplier, 'address') || "";
            document.getElementById('City').value = window.getVal(supplier, 'city') || "";
            document.getElementById('State').value = window.getVal(supplier, 'state') || "";
            document.getElementById('Country').value = window.getVal(supplier, 'country') || "India";
            document.getElementById('modalTitle').innerHTML = '<i class="fa-solid fa-pen-to-square me-2"></i> Edit Supplier';
            document.getElementById('submitBtn').innerText = "Save Changes";
            bootstrapModal.show();
        }

        function deleteSupplier(id) {
            Swal.fire({
                title: 'Are you sure?',
                text: "Do you want to delete this supplier record?",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Yes, delete!'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.post('/Masters/DeleteSupplier', { id: id }, function (res) {
                        if (res.success) {
                            Swal.fire('Deleted!', 'Supplier has been deleted.', 'success');
                            $('#row-' + id).fadeOut(300, function() { $(this).remove(); });
                        } else {
                            Swal.fire('Error!', 'Failed to delete.', 'error');
                        }
                    });
                }
            });
        }
    </script>
}
