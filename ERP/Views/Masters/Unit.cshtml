@model IEnumerable<ERP.Models.Unit>
@{
    ViewData["Title"] = "Unit Master";
}

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="m-0 fw-bold text-primary"><i class="fa-solid fa-scale-balanced me-2"></i> Unit Master</h4>
        <p class="text-muted small m-0 mt-1">Configure units of measurement (PCS, BOX, KG, MTR) for billing & stock tracking</p>
    </div>
    <button class="btn btn-primary shadow-sm" onclick="openModal()">
        <i class="fa-solid fa-plus me-1.5"></i> Add New Unit
    </button>
</div>

<!-- Datatable Card -->
<div class="card shadow-sm border-0">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover datatable align-middle">
                <thead class="table-light text-uppercase fs-8 fw-bold text-muted">
                    <tr>
                        <th style="width: 140px;">Symbol</th>
                        <th>Unit Name</th>
                        <th class="text-center no-print" style="width: 120px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model)
                    {
                        <tr id="row-@u.Id">
                            <td><span class="badge bg-primary-subtle text-primary border border-primary-subtle font-monospace fw-bold px-2 py-1 fs-7">@u.UnitSymbol</span></td>
                            <td class="fw-bold text-dark">@u.UnitName</td>
                            <td class="text-center no-print">
                                <div class="btn-group">
                                    <button class="btn btn-sm btn-outline-primary" data-item="@System.Text.Json.JsonSerializer.Serialize(new { u.Id, u.UnitName, u.UnitSymbol })" onclick="editUnit(this)" title="Edit"><i class="fa-solid fa-pen-to-square"></i></button>
                                    <button class="btn btn-sm btn-outline-danger" onclick="deleteUnit(@u.Id)" title="Delete"><i class="fa-solid fa-trash"></i></button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Dialog -->
<div class="modal fade" id="unitModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white py-3">
                <h5 class="modal-title fw-bold" id="modalTitle"><i class="fa-solid fa-scale-balanced me-2"></i> Add Unit</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="SaveUnit" method="post" id="unitForm">
                <div class="modal-body p-4">
                    <input type="hidden" id="Id" name="Id" value="0" />
                    
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-dark">Unit Symbol <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-ruler-combined text-muted"></i></span>
                            <input type="text" id="UnitSymbol" name="UnitSymbol" class="form-control border-start-0 text-uppercase" placeholder="e.g. PCS, BOX, KG, MTR" required />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-dark">Unit Full Name <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-tag text-muted"></i></span>
                            <input type="text" id="UnitName" name="UnitName" class="form-control border-start-0" placeholder="e.g. Pieces, Boxes, Kilograms" required />
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light border-top py-2 px-4">
                    <button type="button" class="btn btn-secondary px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary px-4 shadow-sm" id="submitBtn">Save Unit</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var bootstrapModal;
        $(function () {
            bootstrapModal = new bootstrap.Modal(document.getElementById('unitModal'));

            $('#unitForm').on('submit', function (e) {
                e.preventDefault();
                ErpApp.submitForm(this, {
                    modal: bootstrapModal,
                    reloadPage: true
                });
            });
        });

        function openModal() {
            ErpApp.clearFieldErrors('#unitForm');
            document.getElementById('unitForm').reset();
            document.getElementById('Id').value = "0";
            document.getElementById('modalTitle').innerHTML = '<i class="fa-solid fa-scale-balanced me-2"></i> Add Unit';
            document.getElementById('submitBtn').innerText = "Save Unit";
            bootstrapModal.show();
        }

        function editUnit(btn) {
            ErpApp.clearFieldErrors('#unitForm');
            var u = $(btn).data('item');
            document.getElementById('unitForm').reset();
            document.getElementById('Id').value = window.getVal(u, 'id');
            document.getElementById('UnitSymbol').value = window.getVal(u, 'unitSymbol');
            document.getElementById('UnitName').value = window.getVal(u, 'unitName');
            document.getElementById('modalTitle').innerHTML = '<i class="fa-solid fa-pen-to-square me-2"></i> Edit Unit';
            document.getElementById('submitBtn').innerText = "Save Changes";
            bootstrapModal.show();
        }

        function deleteUnit(id) {
            ErpApp.confirmDelete({
                url: '/Masters/DeleteUnit',
                id: id,
                rowElement: '#row-' + id,
                message: 'Do you want to delete this unit?'
            });
        }
    </script>
}
