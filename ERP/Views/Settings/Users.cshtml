@model UsersPageViewModel
@{
    ViewData["Title"] = "User Management";
    var roles = Model.Roles;
    var userRoles = Model.UserRoles;
    var lastLogins = Model.LastLogins;
    var companies = Model.Companies;
    var isSuperAdmin = Model.IsSuperAdmin;
}

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="m-0 fw-bold text-primary"><i class="fa-solid fa-users-gear me-2"></i> User Management</h4>
        <p class="text-muted small m-0 mt-1">Manage system operators, company tenant assignments, access roles, and credentials</p>
    </div>
    <div class="d-flex gap-2">
        <a href="/Settings/Roles" class="btn btn-outline-primary"><i class="fa-solid fa-user-shield me-1.5"></i> Roles</a>
        <a href="/Settings/Permissions" class="btn btn-outline-secondary"><i class="fa-solid fa-shield-halved me-1.5"></i> Permissions</a>
        <button class="btn btn-primary shadow-sm" data-bs-toggle="modal" data-bs-target="#userModal"><i class="fa-solid fa-user-plus me-1.5"></i> Add New User</button>
    </div>
</div>

<!-- Filters Bar -->
<div class="card shadow-sm border-0 mb-4 bg-light">
    <div class="card-body p-3">
        <form method="get" asp-action="Users" class="row g-2 align-items-center">
            @if (isSuperAdmin)
            {
                <div class="col-md-3">
                    <label class="form-label small fw-semibold text-muted mb-1">Filter by Company</label>
                    <select name="companyFilter" class="form-select form-select-sm" onchange="this.form.submit()">
                        <option value="">-- All Companies --</option>
                        @foreach (var c in companies)
                        {
                            <!option value="@c.Id" @(Model.SelectedCompanyFilter == c.Id ? "selected" : "")>@c.CompanyName (@c.CompanyCode)</!option>
                        }
                    </select>
                </div>
            }
            <div class="col-md-3">
                <label class="form-label small fw-semibold text-muted mb-1">Filter by Role</label>
                <select name="roleFilter" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">-- All Roles --</option>
                    @foreach (var r in roles)
                    {
                        <!option value="@r" @(Model.SelectedRoleFilter == r ? "selected" : "")>@r</!option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold text-muted mb-1">Status</label>
                <select name="statusFilter" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">-- All Statuses --</option>
                    <!option value="active" @(Model.SelectedStatusFilter == "active" ? "selected" : "")>Active</!option>
                    <!option value="inactive" @(Model.SelectedStatusFilter == "inactive" ? "selected" : "")>Inactive</!option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold text-muted mb-1">Search</label>
                <div class="input-group input-group-sm">
                    <input type="text" name="search" class="form-control" placeholder="Search name, email, phone..." value="@Model.SearchTerm" />
                    <button class="btn btn-primary" type="submit"><i class="fa-solid fa-magnifying-glass"></i></button>
                </div>
            </div>
            <div class="col-md-1 d-flex align-items-end">
                <a href="/Settings/Users" class="btn btn-sm btn-outline-secondary w-100" title="Reset Filters"><i class="fa-solid fa-rotate-left"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Datatable Card -->
<div class="card shadow-sm border-0">
    <div class="card-body">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 mb-4" role="alert">
                <i class="fa-solid fa-circle-check fs-5"></i>
                <div>@TempData["Success"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 mb-4" role="alert">
                <i class="fa-solid fa-triangle-exclamation fs-5"></i>
                <div>@TempData["Error"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        <div class="table-responsive">
            <table class="table table-hover datatable align-middle">
                <thead class="table-light text-uppercase fs-8 fw-bold text-muted">
                    <tr>
                        <th>User / Name</th>
                        <th>Mobile</th>
                        <th>Company</th>
                        <th>Role</th>
                        <th>Status</th>
                        <th>Created Date</th>
                        <th>Last Login</th>
                        <th class="text-center no-print" style="width: 140px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Users != null)
                    {
                        foreach (var item in Model.Users)
                        {
                            var assignedRoles = userRoles.TryGetValue(item.Id, out var currentRoles) ? string.Join(", ", currentRoles) : "Not assigned";
                            var lastLoginTime = lastLogins.TryGetValue(item.Id, out var dt) && dt.HasValue ? dt.Value.ToLocalTime().ToString("dd-MMM-yyyy HH:mm") : "Never";
                            var companyName = item.Company != null ? $"{item.Company.CompanyName} ({item.Company.CompanyCode})" : (item.CompanyId.HasValue ? $"Company #{item.CompanyId}" : "System / Global");
                            <tr id="user-row-@item.Id">
                                <td>
                                    <div class="fw-bold text-dark">@item.FullName</div>
                                    <div class="text-muted small"><i class="fa-regular fa-envelope me-1"></i>@item.Email</div>
                                </td>
                                <td><i class="fa-solid fa-phone me-1 text-muted fs-8"></i>@(string.IsNullOrEmpty(item.Mobile) ? "-" : item.Mobile)</td>
                                <td>
                                    @if (item.Company != null)
                                    {
                                        <span class="badge bg-light text-dark border">
                                            <i class="fa-solid fa-building text-primary me-1"></i>@companyName
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border">System / All</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle fw-semibold px-2 py-1">
                                        <i class="fa-solid fa-shield-halved me-1"></i>@assignedRoles
                                    </span>
                                </td>
                                <td>
                                    <button class="btn btn-sm p-0 toggle-status" data-id="@item.Id" title="Click to toggle status">
                                        @if (item.IsActive)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle fw-bold status-badge"><i class="fa-solid fa-check me-1"></i>Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle fw-medium status-badge"><i class="fa-solid fa-ban me-1"></i>Inactive</span>
                                        }
                                    </button>
                                </td>
                                <td><small class="text-muted">@item.CreatedAt.ToLocalTime().ToString("dd-MMM-yyyy")</small></td>
                                <td><small class="text-muted">@lastLoginTime</small></td>
                                <td class="text-center no-print">
                                    <div class="btn-group">
                                        <button class="btn btn-sm btn-outline-primary edit-user"
                                                data-bs-toggle="modal"
                                                data-bs-target="#userModal"
                                                data-id="@item.Id"
                                                data-full-name="@item.FullName"
                                                data-email="@item.Email"
                                                data-mobile="@item.Mobile"
                                                data-company-id="@(item.CompanyId?.ToString() ?? "")"
                                                data-role="@assignedRoles"
                                                data-active="@item.IsActive.ToString().ToLowerInvariant()"
                                                title="Edit User">
                                            <i class="fa-solid fa-pen-to-square"></i>
                                        </button>
                                        <a href="/Settings/Permissions?userId=@item.Id" class="btn btn-sm btn-outline-info" title="Manage Permissions">
                                            <i class="fa-solid fa-key"></i>
                                        </a>
                                        <button class="btn btn-sm btn-outline-danger delete-user" data-email="@item.Email" data-id="@item.Id" title="Deactivate/Delete User">
                                            <i class="fa-solid fa-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- User Modal -->
<div class="modal fade" id="userModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white py-3">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-user-gear me-2"></i> Add User</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="SaveUser" method="post" id="userForm">
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-dark">Full Name <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-user text-muted"></i></span>
                            <input type="text" name="FullName" class="form-control border-start-0" placeholder="Full name of user" required />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-dark">Email (Username) <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="fa-regular fa-envelope text-muted"></i></span>
                            <input type="email" name="Email" class="form-control border-start-0" placeholder="user@company.com" required />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-dark">Mobile Number</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-phone text-muted"></i></span>
                            <input type="text" name="Mobile" class="form-control border-start-0" placeholder="+91 98765 43210" />
                        </div>
                    </div>
                    @if (isSuperAdmin)
                    {
                        <div class="mb-3">
                            <label class="form-label fw-semibold text-dark">Assigned Company</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-building text-muted"></i></span>
                                <select name="CompanyId" class="form-select border-start-0">
                                    <option value="">-- System / Super Admin (No Company) --</option>
                                    @foreach (var comp in companies)
                                    {
                                        <option value="@comp.Id">@comp.CompanyName (@comp.CompanyCode)</option>
                                    }
                                </select>
                            </div>
                        </div>
                    }
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-dark">Password <span class="text-danger" id="passwordRequiredStar">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-key text-muted"></i></span>
                            <input type="password" name="Password" id="userPassword" class="form-control border-start-0" placeholder="Login password" autocomplete="new-password" />
                            <button type="button" class="btn btn-outline-secondary btn-toggle-password"><i class="fa-regular fa-eye"></i></button>
                        </div>
                        <div class="form-text fs-8 text-muted mt-1" id="passwordHelpText">Required for new users. Leave blank to keep current password when editing.</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-dark">Confirm Password</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-lock text-muted"></i></span>
                            <input type="password" name="ConfirmPassword" id="userConfirmPassword" class="form-control border-start-0" placeholder="Confirm password" autocomplete="new-password" />
                            <button type="button" class="btn btn-outline-secondary btn-toggle-password"><i class="fa-regular fa-eye"></i></button>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-dark">System Role <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-user-shield text-muted"></i></span>
                            <select name="Role" class="form-select border-start-0" required>
                                <option value="">Select role</option>
                                @foreach (var role in roles)
                                {
                                    <option value="@role">@role</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="form-check form-switch pt-2">
                        <input class="form-check-input" type="checkbox" name="IsActive" value="true" checked id="isActiveSwitch" />
                        <input type="hidden" name="IsActive" value="false" />
                        <label class="form-check-label fw-medium text-dark" for="isActiveSwitch">Active User Account</label>
                    </div>
                </div>
                <div class="modal-footer bg-light border-top py-2 px-4">
                    <button type="button" class="btn btn-secondary px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary px-4 shadow-sm">Save User</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            const modal = $('#userModal');

            $('[data-bs-target="#userModal"]:not(.edit-user)').on('click', function () {
                modal.find('.modal-title').html('<i class="fa-solid fa-user-plus me-2"></i> Add User');
                modal.find('input[name="FullName"]').val('');
                modal.find('input[name="Email"]').val('').prop('readonly', false);
                modal.find('input[name="Mobile"]').val('');
                modal.find('input[name="Password"]').val('').prop('required', true);
                modal.find('input[name="ConfirmPassword"]').val('');
                modal.find('#passwordRequiredStar').show();
                modal.find('#passwordHelpText').text('Required for new users.');
                modal.find('select[name="Role"]').val('');
                modal.find('select[name="CompanyId"]').val('');
                modal.find('input[name="IsActive"][type="checkbox"]').prop('checked', true);
            });

            $('.edit-user').on('click', function () {
                const button = $(this);
                modal.find('.modal-title').html('<i class="fa-solid fa-pen-to-square me-2"></i> Edit User');
                modal.find('input[name="FullName"]').val(button.data('full-name'));
                modal.find('input[name="Email"]').val(button.data('email')).prop('readonly', true);
                modal.find('input[name="Mobile"]').val(button.data('mobile'));
                modal.find('input[name="Password"]').val('').prop('required', false);
                modal.find('input[name="ConfirmPassword"]').val('');
                modal.find('#passwordRequiredStar').hide();
                modal.find('#passwordHelpText').text('Leave blank to keep existing password unchanged.');
                modal.find('select[name="Role"]').val(button.data('role'));
                modal.find('select[name="CompanyId"]').val(button.data('company-id'));
                modal.find('input[name="IsActive"][type="checkbox"]').prop('checked', button.data('active') === true);
            });

            // Password confirmation check on form submit and AJAX submit
            $('#userForm').on('submit', function (e) {
                e.preventDefault();
                const p1 = $('#userPassword').val();
                const p2 = $('#userConfirmPassword').val();
                if (p1 && p2 && p1 !== p2) {
                    ErpApp.notify('Passwords do not match. Please re-enter.', 'warning', 'Password Mismatch');
                    return;
                }

                ErpApp.submitForm(this, {
                    modal: '#userModal',
                    reloadPage: true
                });
            });

            // Toggle active status
            $('.toggle-status').on('click', function () {
                const btn = $(this);
                const userId = btn.data('id');

                $.post('/Settings/ToggleUserStatus', { id: userId }, function (res) {
                    if (res && res.success) {
                        if (res.isActive) {
                            btn.html('<span class="badge bg-success-subtle text-success border border-success-subtle fw-bold status-badge"><i class="fa-solid fa-check me-1"></i>Active</span>');
                        } else {
                            btn.html('<span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle fw-medium status-badge"><i class="fa-solid fa-ban me-1"></i>Inactive</span>');
                        }
                        ErpApp.notify(res.message || 'User status updated.', 'success');
                    } else {
                        ErpApp.notify(res?.message || 'Failed to toggle status.', 'error');
                    }
                }).fail(function () {
                    ErpApp.notify('Unable to toggle user status.', 'error');
                });
            });

            // Handle delete user
            $('.delete-user').on('click', function () {
                const email = $(this).data('email');
                const rowId = '#user-row-' + $(this).data('id');

                ErpApp.confirmDelete({
                    url: '/Settings/DeleteUser',
                    id: email,
                    idParamName: 'email',
                    rowElement: rowId,
                    title: 'Deactivate / Delete User?',
                    message: `Are you sure you want to deactivate or remove user '${email}'?`
                });
            });
        });
    </script>
}
