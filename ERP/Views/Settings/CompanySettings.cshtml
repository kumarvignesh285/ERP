@model ERP.Models.Company
@{
    ViewData["Title"] = "Company Settings";
}

<div class="card">
    <div class="card-header bg-primary text-white">
        <i class="fa-solid fa-building me-2"></i> Company Setup & Bill Customization
    </div>
    <div class="card-body">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }

        <ul class="nav nav-tabs mb-4" role="tablist">
            <li class="nav-item">
                <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tabCompany" type="button">Company Details</button>
            </li>
            <li class="nav-item">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabBill" type="button">Bill Type & Logo</button>
            </li>
            <li class="nav-item">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabNumbers" type="button">Bill Number Settings</button>
            </li>
        </ul>

        <form asp-action="CompanySettings" method="post" enctype="multipart/form-data">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="CreatedBy" />
            <input type="hidden" asp-for="CreatedAt" />
            <input type="hidden" asp-for="Logo" />

            <div class="tab-content">
                <div class="tab-pane fade show active" id="tabCompany">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="CompanyName" class="form-label font-weight-semibold">Company Name *</label>
                            <input asp-for="CompanyName" class="form-control" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="CompanyCode" class="form-label font-weight-semibold">Company Code *</label>
                            <input asp-for="CompanyCode" class="form-control" required />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="GSTNumber" class="form-label font-weight-semibold">GSTIN</label>
                            <input asp-for="GSTNumber" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="PANNumber" class="form-label font-weight-semibold">PAN Number</label>
                            <input asp-for="PANNumber" class="form-control" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Email" class="form-label font-weight-semibold">Email</label>
                            <input asp-for="Email" type="email" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Phone" class="form-label font-weight-semibold">Phone Number</label>
                            <input asp-for="Phone" class="form-control" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Website" class="form-label font-weight-semibold">Website</label>
                            <input asp-for="Website" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="CINNumber" class="form-label font-weight-semibold">CIN Number</label>
                            <input asp-for="CINNumber" class="form-control" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Address" class="form-label font-weight-semibold">Billing Address (shown on all bills)</label>
                        <textarea asp-for="Address" class="form-control" rows="3" placeholder="Street, Area, Landmark"></textarea>
                    </div>

                    <div class="row">
                        <div class="col-md-3 mb-3">
                            <label asp-for="City" class="form-label font-weight-semibold">City</label>
                            <input asp-for="City" class="form-control" />
                        </div>
                        <div class="col-md-3 mb-3">
                            <label asp-for="State" class="form-label font-weight-semibold">State</label>
                            <input asp-for="State" class="form-control" />
                        </div>
                        <div class="col-md-3 mb-3">
                            <label asp-for="Pincode" class="form-label font-weight-semibold">Pincode</label>
                            <input asp-for="Pincode" class="form-control" />
                        </div>
                        <div class="col-md-3 mb-3">
                            <label asp-for="Country" class="form-label font-weight-semibold">Country</label>
                            <input asp-for="Country" class="form-control" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="BankDetails" class="form-label font-weight-semibold">Bank Details (shown on bills)</label>
                        <textarea asp-for="BankDetails" class="form-control" rows="2" placeholder="Bank Name, A/C No, IFSC"></textarea>
                    </div>
                </div>

                <div class="tab-pane fade" id="tabBill">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="BillType" class="form-label font-weight-semibold">Default Bill Type *</label>
                            <select asp-for="BillType" class="form-select" required>
                                <option value="Tax Invoice">Tax Invoice</option>
                                <option value="Retail Invoice">Retail Invoice</option>
                                <option value="Proforma Invoice">Proforma Invoice</option>
                                <option value="Bill of Supply">Bill of Supply</option>
                                <option value="Delivery Challan">Delivery Challan</option>
                            </select>
                            <small class="text-muted">This title appears on printed sales & purchase bills.</small>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label font-weight-semibold">Company Logo</label>
                            <input type="file" name="logoFile" class="form-control" accept="image/png,image/jpeg,image/gif,image/webp" />
                            <small class="text-muted">PNG/JPG/GIF/WEBP up to 2 MB. Shown on all printed bills.</small>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.Logo))
                    {
                        <div class="mb-3">
                            <label class="form-label font-weight-semibold">Current Logo Preview</label>
                            <div class="border rounded p-3 bg-light d-inline-block">
                                <img src="@Model.Logo" alt="Company Logo" style="max-height: 100px; max-width: 250px;" />
                            </div>
                        </div>
                    }

                    <div class="mb-3">
                        <label asp-for="BillFooterNote" class="form-label font-weight-semibold">Bill Footer Note</label>
                        <textarea asp-for="BillFooterNote" class="form-control" rows="2" placeholder="Terms & conditions or thank you note on bills"></textarea>
                    </div>
                </div>

                <div class="tab-pane fade" id="tabNumbers">
                    <div class="row">
                        <div class="col-md-6">
                            <h6 class="font-weight-bold text-primary mb-3"><i class="fa-solid fa-file-invoice-dollar me-1"></i> Sales Bill Numbers</h6>
                            <div class="mb-3">
                                <label asp-for="SalesBillPrefix" class="form-label font-weight-semibold">Sales Prefix</label>
                                <input asp-for="SalesBillPrefix" class="form-control" maxlength="20" />
                            </div>
                            <div class="mb-3">
                                <label asp-for="SalesBillStartNumber" class="form-label font-weight-semibold">Sales Start Number</label>
                                <input asp-for="SalesBillStartNumber" type="number" min="1" class="form-control" />
                                <small class="text-muted">Use Reset Sales Counter below to apply this start number.</small>
                            </div>
                            <div class="mb-3">
                                <label asp-for="SalesBillNextNumber" class="form-label font-weight-semibold">Next Sales Number</label>
                                <input asp-for="SalesBillNextNumber" type="number" min="1" class="form-control" />
                            </div>
                            <div class="form-check mb-3">
                                <input class="form-check-input" type="checkbox" name="resetSalesCounter" id="resetSalesCounter" value="true" />
                                <label class="form-check-label" for="resetSalesCounter">Reset sales counter to start number on save</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <h6 class="font-weight-bold text-primary mb-3"><i class="fa-solid fa-file-invoice me-1"></i> Purchase Bill Numbers</h6>
                            <div class="mb-3">
                                <label asp-for="PurchaseBillPrefix" class="form-label font-weight-semibold">Purchase Prefix</label>
                                <input asp-for="PurchaseBillPrefix" class="form-control" maxlength="20" />
                            </div>
                            <div class="mb-3">
                                <label asp-for="PurchaseBillStartNumber" class="form-label font-weight-semibold">Purchase Start Number</label>
                                <input asp-for="PurchaseBillStartNumber" type="number" min="1" class="form-control" />
                            </div>
                            <div class="mb-3">
                                <label asp-for="PurchaseBillNextNumber" class="form-label font-weight-semibold">Next Purchase Number</label>
                                <input asp-for="PurchaseBillNextNumber" type="number" min="1" class="form-control" />
                            </div>
                            <div class="form-check mb-3">
                                <input class="form-check-input" type="checkbox" name="resetPurchaseCounter" id="resetPurchaseCounter" value="true" />
                                <label class="form-check-label" for="resetPurchaseCounter">Reset purchase counter to start number on save</label>
                            </div>
                        </div>
                    </div>
                    <div class="alert alert-info mb-0">
                        <i class="fa-solid fa-circle-info me-1"></i>
                        New sales invoices use prefix + 6-digit number (e.g. @(Model.SalesBillPrefix)@Model.SalesBillNextNumber.ToString("D6")).
                        Purchase bills use @(Model.PurchaseBillPrefix)@Model.PurchaseBillNextNumber.ToString("D6").
                    </div>
                </div>
            </div>

            <div class="text-end mt-4">
                <button type="submit" class="btn btn-primary px-4">
                    <i class="fa-solid fa-save me-2"></i> Save Settings
                </button>
            </div>
        </form>
    </div>
</div>
