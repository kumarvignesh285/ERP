@model IEnumerable<ERP.Models.Product>
@{
    ViewData["Title"] = "Stock Opening Register";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="m-0 fw-bold text-primary"><i class="fa-solid fa-boxes-stacked me-2"></i> Stock Opening Setup</h4>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover datatable align-middle">
                <thead class="text-nowrap">
                    <tr>
                        <th>Product Code</th>
                        <th>Product Name</th>
                        <th>Default Warehouse</th>
                        <th>Unit</th>
                        <th>Current Stock</th>
                        <th>Opening Stock</th>
                        <th class="w-200px text-center no-print">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td class="fw-bold">@p.ProductCode</td>
                            <td class="fw-semibold">@p.ProductName</td>
                            <td>@p.Warehouse?.WarehouseName</td>
                            <td>@p.Unit?.UnitSymbol</td>
                            <td>@p.CurrentStock</td>
                            <td>
                                <form asp-action="SaveStockOpening" method="post" class="d-flex align-items-center gap-2 m-0 stock-opening-form">
                                    <input type="hidden" name="productId" value="@p.Id" />
                                    <input type="number" name="quantity" class="form-control form-control-sm w-100px" value="@p.OpeningStock" step="0.01" required />
                                    <button type="submit" class="btn btn-sm btn-primary"><i class="fa-solid fa-save"></i></button>
                                </form>
                            </td>
                            <td class="text-center no-print">
                                <span class="text-muted fs-8">Saves opening stock slab & updates current</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            $('.stock-opening-form').on('submit', function (e) {
                e.preventDefault();
                ErpApp.submitForm(this, {
                    loadingText: 'Saving...',
                    reloadPage: true
                });
            });
        });
    </script>
}
