@model InventoryPageViewModel<StockTransfer>
@{
    ViewData["Title"] = "Stock Transfer";
}

<div id="listView">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="m-0 font-weight-bold text-primary"><i class="fa-solid fa-right-left me-2"></i> Stock Transfers</h4>
        <button class="btn btn-primary" onclick="showForm()"><i class="fa-solid fa-plus me-1"></i> New Transfer</button>
    </div>

    <!-- Filters Row -->
    <div class="card mb-3 no-print">
        <div class="card-body p-3">
            <div class="row g-2 align-items-center">
                <div class="col-md-3">
                    <label class="form-label font-weight-semibold mb-1 small text-muted">From Date</label>
                    <input type="date" id="filterFromDate" class="form-control form-control-sm" />
                </div>
                <div class="col-md-3">
                    <label class="form-label font-weight-semibold mb-1 small text-muted">To Date</label>
                    <input type="date" id="filterToDate" class="form-control form-control-sm" />
                </div>
                <div class="col-md-3">
                    <label class="form-label font-weight-semibold mb-1 small text-muted">Status</label>
                    <select id="filterStatus" class="form-select form-select-sm">
                        <option value="">All Statuses</option>
                        <option value="Draft">Draft</option>
                        <option value="Pending">Pending</option>
                        <option value="Completed">Completed</option>
                        <option value="Cancelled">Cancelled</option>
                    </select>
                </div>
                <div class="col-md-3 d-flex gap-2 align-self-end">
                    <button class="btn btn-sm btn-primary w-100" onclick="applyFilters()"><i class="fa-solid fa-filter me-1"></i> Filter</button>
                    <button class="btn btn-sm btn-outline-secondary w-100" onclick="resetFilters()"><i class="fa-solid fa-rotate me-1"></i> Reset</button>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover datatable align-middle">
                    <thead>
                        <tr>
                            <th>Transfer No</th>
                            <th>Date</th>
                            <th>From Warehouse</th>
                            <th>To Warehouse</th>
                            <th>Status</th>
                            <th class="text-center no-print">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in Model.Items)
                        {
                            <tr id="row-@t.Id">
                                <td class="font-weight-bold">@t.TransferNumber</td>
                                <td>@t.TransferDate.ToString("dd-MM-yyyy")</td>
                                <td>@t.FromWarehouse?.WarehouseName</td>
                                <td>@t.ToWarehouse?.WarehouseName</td>
                                @{
                                    var statusBadgeClass = t.Status switch
                                    {
                                        "Pending" or "Draft" => "badge-pending",
                                        "Sent" or "Issued" or "Active" => "badge-sent",
                                        "Completed" or "Paid" or "Accepted" or "Approved" => "badge-accepted",
                                        "Cancelled" or "Rejected" or "Expired" => "badge-rejected",
                                        _ => "badge-accepted"
                                    };
                                }
                                <td><span class="badge @statusBadgeClass">@t.Status</span></td>
                                <td class="text-center no-print">
                                    <div class="btn-group">
                                        <button class="btn btn-sm btn-outline-danger" onclick="deleteTransfer(@t.Id)"><i class="fa-solid fa-trash"></i></button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div id="formView" style="display:none">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="m-0 font-weight-bold text-primary"><i class="fa-solid fa-plus me-2"></i> Create Stock Transfer</h4>
        <button class="btn btn-outline-secondary" onclick="hideForm()"><i class="fa-solid fa-arrow-left me-1"></i> Back to List</button>
    </div>

    <div class="card">
        <div class="card-body">
            <form id="transferForm">
                <div class="row">
                    <div class="col-md-3 mb-3">
                        <label class="form-label font-weight-semibold">Transfer Number *</label>
                        <input type="text" id="TransferNumber" class="form-control" required />
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="form-label font-weight-semibold">Transfer Date *</label>
                        <input type="date" id="TransferDate" class="form-control" required value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="form-label font-weight-semibold">From Warehouse *</label>
                        <select id="FromWarehouseId" class="form-select select2" required>
                            <option value="">Select Source Warehouse</option>
                            @foreach (var wh in Model.Warehouses)
                            {
                                <option value="@wh.Id">@wh.WarehouseName</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="form-label font-weight-semibold">To Warehouse *</label>
                        <select id="ToWarehouseId" class="form-select select2" required>
                            <option value="">Select Dest Warehouse</option>
                            @foreach (var wh in Model.Warehouses)
                            {
                                <option value="@wh.Id">@wh.WarehouseName</option>
                            }
                        </select>
                    </div>
                </div>

                <hr />

                <h5>Line Items</h5>
                <div class="table-responsive mb-3">
                    <table class="table table-bordered align-middle" id="itemsTable">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 60%">Product *</th>
                                <th style="width: 30%">Quantity *</th>
                                <th style="width: 10%" class="text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>

                <div class="mb-4">
                    <button type="button" class="btn btn-outline-primary" onclick="addRow()"><i class="fa-solid fa-plus me-1"></i> Add Row</button>
                </div>

                <div class="mb-3">
                    <label class="form-label font-weight-semibold">Remarks</label>
                    <textarea id="Remarks" class="form-control" rows="2"></textarea>
                </div>

                <div class="text-end">
                    <button type="button" class="btn btn-secondary me-2" onclick="hideForm()">Cancel</button>
                    <button type="button" class="btn btn-primary px-4" onclick="saveTransfer()">Save Transfer</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var productsList = @Json.Serialize(Model.ProductLookups);
        if (productsList) {
            productsList = productsList.map(function(p) {
                return {
                    id: window.getVal(p, 'id'),
                    productCode: window.getVal(p, 'productCode'),
                    productName: window.getVal(p, 'productName'),
                    salesPrice: window.getVal(p, 'salesPrice'),
                    purchasePrice: window.getVal(p, 'purchasePrice'),
                    gstPercentage: window.getVal(p, 'gstPercentage'),
                    categoryId: window.getVal(p, 'categoryId')
                };
            });
        }

        function showForm() {
            $('#listView').hide();
            $('#formView').show();
            $('#transferForm')[0].reset();
            $('#TransferNumber').val("TR-" + Date.now().toString().slice(-6));
            $('#itemsTable tbody').empty();
            $('#FromWarehouseId, #ToWarehouseId').val('').trigger('change');
            addRow();
        }

        function hideForm() {
            $('#formView').hide();
            $('#listView').show();
        }

        function addRow() {
            var catOptionsHtml = '<option value="">All Categories</option>';
            var categoriesList = @Json.Serialize(Model.Categories);
            if (categoriesList) {
                categoriesList = categoriesList.map(function(c) {
                    return {
                        id: window.getVal(c, 'id'),
                        categoryName: window.getVal(c, 'categoryName')
                    };
                });
            }
            categoriesList.forEach(function(c) {
                catOptionsHtml += `<option value="${c.id}">${c.categoryName}</option>`;
            });

            var optionsHtml = '<option value="">Select Product</option>';
            productsList.forEach(function(p) {
                optionsHtml += `<option value="${p.id}">${p.productName}</option>`;
            });

            var rowHtml = `
                <tr class="grid-item-row">
                    <td>
                        <select class="form-select select2-row" required>
                            ${optionsHtml}
                        </select>
                    </td>
                    <td>
                        <input type="number" class="form-control qty-input" value="1" min="1" required />
                    </td>
                    <td class="text-center">
                        <button type="button" class="btn btn-sm btn-outline-danger" onclick="removeRow(this)"><i class="fa-solid fa-trash"></i></button>
                    </td>
                </tr>
            `;
            var $row = $(rowHtml);
            $('#itemsTable tbody').append($row);
            window.initializeSelect2($row.find('.select2-row'));
        }

        function removeRow(btn) {
            $(btn).closest('tr').remove();
        }

        function saveTransfer() {
            var items = [];
            var isValid = true;
            $('#itemsTable tbody tr').each(function() {
                var prodId = $(this).find('.select2-row').val();
                var qty = parseFloat($(this).find('.qty-input').val()) || 0;
                if (!prodId || qty <= 0) {
                    isValid = false;
                    return false;
                }
                items.push({
                    productId: parseInt(prodId),
                    quantity: qty
                });
            });

            var fromWh = $('#FromWarehouseId').val();
            var toWh = $('#ToWarehouseId').val();

            if (!fromWh || !toWh || fromWh === toWh || items.length === 0 || !isValid) {
                Swal.fire('Error!', 'Please fill all fields and select distinct warehouses.', 'error');
                return;
            }

            var transfer = {
                id: 0,
                transferNumber: $('#TransferNumber').val(),
                transferDate: $('#TransferDate').val(),
                fromWarehouseId: parseInt(fromWh),
                toWarehouseId: parseInt(toWh),
                remarks: $('#Remarks').val(),
                status: "Completed",
                items: items
            };

            $.ajax({
                url: '/Inventory/SaveStockTransfer',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(transfer),
                success: function(res) {
                    if (res.success) {
                        Swal.fire('Success!', res.message, 'success').then(() => { location.reload(); });
                    }
                }
            });
        }

        function deleteTransfer(id) {
            Swal.fire({
                title: 'Are you sure?',
                text: "Do you want to delete this transfer?",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                confirmButtonText: 'Yes, delete!'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.post('/Inventory/DeleteStockTransfer', { id: id }, function(res) {
                        if (res.success) {
                            Swal.fire('Deleted!', 'Transfer deleted.', 'success');
                            $('#row-' + id).fadeOut(300, function() { $(this).remove(); });
                        }
                    });
                }
            });
        }
    </script>
}

