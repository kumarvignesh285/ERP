@model InventoryPageViewModel<StockAdjustment>
@{
    ViewData["Title"] = "Stock Adjustment";
}

<div id="listView">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="m-0 font-weight-bold text-primary"><i class="fa-solid fa-sliders me-2"></i> Stock Adjustments</h4>
        <button class="btn btn-primary" onclick="showForm()"><i class="fa-solid fa-plus me-1"></i> New Adjustment</button>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover datatable align-middle">
                    <thead>
                        <tr>
                            <th>Adjustment No</th>
                            <th>Date</th>
                            <th>Warehouse</th>
                            <th>Type</th>
                            <th>Remarks</th>
                            <th class="text-center no-print">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in Model.Items)
                        {
                            <tr id="row-@a.Id">
                                <td class="font-weight-bold">@a.AdjustmentNumber</td>
                                <td>@a.AdjustmentDate.ToString("dd-MM-yyyy")</td>
                                <td>@a.Warehouse?.WarehouseName</td>
                                <td>
                                    @if (a.AdjustmentType == "Addition")
                                    {
                                        <span class="badge bg-success">Addition</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Deduction</span>
                                    }
                                </td>
                                <td>@a.Remarks</td>
                                <td class="text-center no-print">
                                    <div class="btn-group">
                                        <button class="btn btn-sm btn-outline-danger" onclick="deleteAdjustment(@a.Id)"><i class="fa-solid fa-trash"></i></button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div id="formView" style="display:none">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="m-0 font-weight-bold text-primary"><i class="fa-solid fa-plus me-2"></i> Create Stock Adjustment</h4>
        <button class="btn btn-outline-secondary" onclick="hideForm()"><i class="fa-solid fa-arrow-left me-1"></i> Back to List</button>
    </div>

    <div class="card">
        <div class="card-body">
            <form id="adjustmentForm">
                <div class="row">
                    <div class="col-md-3 mb-3">
                        <label class="form-label font-weight-semibold">Adjustment Number *</label>
                        <input type="text" id="AdjustmentNumber" class="form-control" required />
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="form-label font-weight-semibold">Adjustment Date *</label>
                        <input type="date" id="AdjustmentDate" class="form-control" required value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="form-label font-weight-semibold">Warehouse *</label>
                        <select id="WarehouseId" class="form-select select2" required>
                            <option value="">Select Warehouse</option>
                            @foreach (var wh in Model.Warehouses)
                            {
                                <option value="@wh.Id">@wh.WarehouseName</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="form-label font-weight-semibold">Adjustment Type *</label>
                        <select id="AdjustmentType" class="form-select" required>
                            <option value="Addition">Addition (+)</option>
                            <option value="Deduction">Deduction (-)</option>
                        </select>
                    </div>
                </div>

                <hr />

                <h5>Line Items</h5>
                <div class="table-responsive mb-3">
                    <table class="table table-bordered align-middle" id="itemsTable">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 50%">Product *</th>
                                <th style="width: 20%">Quantity *</th>
                                <th style="width: 20%">Purchase Rate *</th>
                                <th style="width: 10%" class="text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>

                <div class="mb-4">
                    <button type="button" class="btn btn-outline-primary" onclick="addRow()"><i class="fa-solid fa-plus me-1"></i> Add Row</button>
                </div>

                <div class="mb-3">
                    <label class="form-label font-weight-semibold">Remarks / Reason *</label>
                    <textarea id="Remarks" class="form-control" rows="2" required></textarea>
                </div>

                <div class="text-end">
                    <button type="button" class="btn btn-secondary me-2" onclick="hideForm()">Cancel</button>
                    <button type="button" class="btn btn-primary px-4" onclick="saveAdjustment()">Save Adjustment</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var productsList = @Json.Serialize(Model.ProductLookups);
        if (productsList) {
            productsList = productsList.map(function(p) {
                return {
                    id: window.getVal(p, 'id'),
                    productCode: window.getVal(p, 'productCode'),
                    productName: window.getVal(p, 'productName'),
                    salesPrice: window.getVal(p, 'salesPrice'),
                    purchasePrice: window.getVal(p, 'purchasePrice'),
                    gstPercentage: window.getVal(p, 'gstPercentage'),
                    categoryId: window.getVal(p, 'categoryId')
                };
            });
        }

        function showForm() {
            $('#listView').hide();
            $('#formView').show();
            $('#adjustmentForm')[0].reset();
            $('#AdjustmentNumber').val("ADJ-" + Date.now().toString().slice(-6));
            $('#itemsTable tbody').empty();
            $('#WarehouseId').val('').trigger('change');
            addRow();
        }

        function hideForm() {
            $('#formView').hide();
            $('#listView').show();
        }

        function addRow() {
            var catOptionsHtml = '<option value="">All Categories</option>';
            var categoriesList = @Json.Serialize(Model.Categories);
            if (categoriesList) {
                categoriesList = categoriesList.map(function(c) {
                    return {
                        id: window.getVal(c, 'id'),
                        categoryName: window.getVal(c, 'categoryName')
                    };
                });
            }
            categoriesList.forEach(function(c) {
                catOptionsHtml += `<option value="${c.id}">${c.categoryName}</option>`;
            });

            var optionsHtml = '<option value="">Select Product</option>';
            productsList.forEach(function(p) {
                optionsHtml += `<option value="${p.id}">${p.productName}</option>`;
            });

            var rowHtml = `
                <tr class="grid-item-row">
                    <td>
                        <select class="form-select select2-category" onchange="onCategorySelect(this)">
                            ${catOptionsHtml}
                        </select>
                    </td>
                    <td>
                        <select class="form-select select2-row" onchange="onProductSelect(this)" required>
                            ${optionsHtml}
                        </select>
                    </td>
                    <td>
                        <input type="number" class="form-control qty-input" value="1" min="1" required />
                    </td>
                    <td>
                        <input type="number" class="form-control rate-input" value="0.00" step="0.01" required />
                    </td>
                    <td class="text-center">
                        <button type="button" class="btn btn-sm btn-outline-danger" onclick="removeRow(this)"><i class="fa-solid fa-trash"></i></button>
                    </td>
                </tr>
            `;
            var $row = $(rowHtml);
            $('#itemsTable tbody').append($row);
            window.initializeSelect2($row.find('.select2-row'));
        }

        function removeRow(btn) {
            $(btn).closest('tr').remove();
        }

        function onProductSelect(select) {
            var prodId = $(select).val();
            var product = productsList.find(p => p.id == prodId);
            var $row = $(select).closest('tr');
            if (product) {
                $row.find('.rate-input').val(product.purchasePrice);
            }
        }

        function saveAdjustment() {
            var items = [];
            var isValid = true;
            $('#itemsTable tbody tr').each(function() {
                var prodId = $(this).find('.select2-row').val();
                var qty = parseFloat($(this).find('.qty-input').val()) || 0;
                var rate = parseFloat($(this).find('.rate-input').val()) || 0;
                if (!prodId || qty <= 0) {
                    isValid = false;
                    return false;
                }
                items.push({
                    productId: parseInt(prodId),
                    quantity: qty,
                    rate: rate
                });
            });

            var whId = $('#WarehouseId').val();
            var remarks = $('#Remarks').val();

            if (!whId || !remarks || items.length === 0 || !isValid) {
                Swal.fire('Error!', 'Please fill all required fields.', 'error');
                return;
            }

            var adjustment = {
                id: 0,
                adjustmentNumber: $('#AdjustmentNumber').val(),
                adjustmentDate: $('#AdjustmentDate').val(),
                warehouseId: parseInt(whId),
                adjustmentType: $('#AdjustmentType').val(),
                remarks: remarks,
                items: items
            };

            $.ajax({
                url: '/Inventory/SaveStockAdjustment',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(adjustment),
                success: function(res) {
                    if (res.success) {
                        Swal.fire('Success!', res.message, 'success').then(() => { location.reload(); });
                    }
                }
            });
        }

        function deleteAdjustment(id) {
            Swal.fire({
                title: 'Are you sure?',
                text: "Do you want to delete this adjustment? This will revert stocks!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                confirmButtonText: 'Yes, delete!'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.post('/Inventory/DeleteStockAdjustment', { id: id }, function(res) {
                        if (res.success) {
                            Swal.fire('Deleted!', 'Adjustment deleted.', 'success');
                            $('#row-' + id).fadeOut(300, function() { $(this).remove(); });
                        }
                    });
                }
            });
        }
    </script>
}

