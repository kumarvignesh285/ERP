{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/erp-log-.txt",
          "rollingInterval": "Day",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*",
  "AIChat": {
    "Provider": "OpenAI",
    "ApiKey": "",
    "Model": "gpt-4o-mini",
    "BaseUrl": "https://api.openai.com/v1",
    "MaxTokens": 1200,
    "Temperature": 0.2,
    "RateLimitPerMinute": 30,
    "MonthlyBudgetUsd": 25.0
  },
    "ConnectionStrings": {
        //"DefaultConnection": "Server=DESKTOP-PT442GP;Database=ERPDb;User Id=sa;Password=sa@123;MultipleActiveResultSets=true;TrustServerCertificate=True"
        "DefaultConnection": "Server=5.9.179.194; Database=db65465; User Id=db65465; Password=5q-Kb%L3Qx6_; Encrypt=False; MultipleActiveResultSets=True;TrustServerCertificate=True;"
    }
}
